Current((prevPage) => prevPage + 1);\r\n//       }\r\n//     });\r\n//     if (document.querySelector('#load-more-trigger')) {\r\n//       observer.current.observe(document.querySelector('#load-more-trigger'));\r\n//     }\r\n//     return () => observer.current.disconnect();\r\n//   }, []);\r\n\r\n//   return (\r\n//     <div className=\"view_brand_list\">\r\n//       <div className=\"show_all_product\">\r\n//         <Card title={<div className=\"brand_search\">\r\n//           <p>Explore with Brand</p>\r\n\r\n//           <Input\r\n//             style={{ width: '200px' }}\r\n//             allowClear\r\n//             placeholder=\"Search Brand\"\r\n//             suffix={<SearchOutlined />}\r\n//             onChange={(e) => setSearchInput(e.target.value)}\r\n//           />\r\n\r\n//         </div>} bordered={false}>\r\n//           <div className={`${brandList?.length!=0 ? \"show_all_brand\" : \"text-center\"}`}>\r\n//             {brandList.length === 0 ?\r\n//               <div className='not_found_data'>\r\n//                 <img src=\"https://www.aamtrading.com/assets/img/nproduct.png\"  />\r\n//               </div> :  brandList.map((item, index) => (\r\n//                 <div key={index} className={\"show_all_brands\"}>\r\n//                   <div className=\" show_brand\">\r\n//                     <Card\r\n//                       hoverable\r\n//                       onClick={() => navigate(`/brand-product/${item.brandID}`)}\r\n//                       bordered={false}\r\n//                     >\r\n//                       <div className=\"brand_img\">\r\n//                         {item.imageUrl ? <img src={item.imageUrl} alt={item.brandName} /> : <img src={DefaultLogo} alt=\"Default Logo\" />}\r\n//                       </div>\r\n//                     </Card>\r\n//                   </div>\r\n//                   <p>{item.brandName?.substr(0,8)}.</p>\r\n//                 </div>\r\n//               ))}\r\n//           </div>\r\n//         </Card>\r\n//       </div>\r\n//       {loading && <div className=\"scroll_load\"><span className=\"loaderScroll\"></span></div>}\r\n//       <div id=\"load-more-trigger\" style={{ height: '20px' }} />\r\n//     </div>\r\n//   );\r\n// }\r\n\r\n// export default AllBrandList;\r\n\r\n\r\n\r\n// import React, { useCallback, useEffect, useState, useRef } from \"react\";\r\n// import { Card, Input, Skeleton } from \"antd\";\r\n// import { useNavigate } from \"react-router-dom\";\r\n// import { DotChartOutlined, SearchOutlined } from '@ant-design/icons';\r\n// import _ from 'lodash';\r\n// import { FetchbrandList } from \"../apiService/api\";\r\n// import DefaultLogo from \"../../assest/logo.png\";\r\n// import \"../../style/header.css\";\r\n\r\n// function AllBrandList() {\r\n//   const navigate = useNavigate();\r\n//   const [brandList, setBrandList] = useState([]);\r\n//   const [current, setCurrent] = useState(1);\r\n//   const [searchInput, setSearchInput] = useState(\"\");\r\n//   const [loading, setLoading] = useState(false); // ✅ Set loading to true initially\r\n//   const [isLoading, setIsLoading] = useState(false); // ✅ Set loading to true initially\r\n//   const [hasMore, setHasMore] = useState(true);\r\n//   const triggerRef = useRef(null);\r\n//   const observer = useRef(null);\r\n\r\n//   const loadMoreBrands = async () => {\r\n//     if (loading || !hasMore) return;\r\n//     if (current === 1) {\r\n//       setIsLoading(true)\r\n//     }\r\n//     setLoading(true);\r\n//     try {\r\n//       const res = await FetchbrandList(current, searchInput);\r\n//       if (res.status === 200) {\r\n//         const newBrands = res.data.data;\r\n//         if (newBrands.length === 0) {\r\n//           setHasMore(false);\r\n//         } else {\r\n//           setBrandList((prev) => [...prev, ...newBrands]);\r\n//         }\r\n//       }\r\n//     } catch (error) {\r\n//       console.error(\"Error fetching brand list:\", error);\r\n//     } finally {\r\n//       setLoading(false);\r\n//       setIsLoading(false)\r\n\r\n//     }\r\n//   };\r\n\r\n//   const debouncedLoadMoreBrands = useCallback(_.debounce(loadMoreBrands, 1000), [current, searchInput]);\r\n\r\n//   useEffect(() => {\r\n//     debouncedLoadMoreBrands();\r\n//     return () => {\r\n//       debouncedLoadMoreBrands.cancel();\r\n//     };\r\n//   }, [debouncedLoadMoreBrands]);\r\n\r\n//   useEffect(() => {\r\n//     if (observer.current) observer.current.disconnect();\r\n\r\n//     observer.current = new IntersectionObserver(([entry]) => {\r\n//       if (entry.isIntersecting && hasMore && !loading) {\r\n//         setCurrent((prev) => prev + 1);\r\n//       }\r\n//     });\r\n\r\n//     if (triggerRef.current) observer.current.observe(triggerRef.current);\r\n\r\n//     return () => observer.current?.disconnect();\r\n//   }, [hasMore, loading]);\r\n\r\n//   useEffect(() => {\r\n//     // Reset page and list when search input changes\r\n//     setCurrent(1);\r\n//     setBrandList([]);\r\n//   }, [searchInput]);\r\n\r\n//   return (\r\n//     <div className=\"view_brand_list\">\r\n//       <div className=\"show_all_product\">\r\n//         <Card\r\n//           title={\r\n//             <div className=\"brand_search\">\r\n//               <p>Explore with Brand</p>\r\n//               <Input\r\n//                 style={{ width: '200px' }}\r\n//                 allowClear\r\n//                 placeholder=\"Search Brand\"\r\n//                 suffix={<SearchOutlined />}\r\n//                 onChange={(e) => setSearchInput(e.target.value)}\r\n//               />\r\n//             </div>\r\n//           }\r\n//           bordered={false}\r\n//         >\r\n//           <div className={`${brandList.length ? \"show_all_brand\" : \"text-center\"}`}>\r\n//             {isLoading ? (\r\n//               <div className=\"scroll_load\"><span className=\"loaderScroll\"></span></div>\r\n//             ) : brandList.length === 0 ? (\r\n//               <div className=\"not_found_data\">\r\n//                 <img src=\"https://www.aamtrading.com/assets/img/nproduct.png\" alt=\"No Products\" />\r\n//               </div>\r\n//             ) : (\r\n//               brandList.map((item, index) => (\r\n//                 <div key={index} className=\"show_all_brands\">\r\n//                   <div className=\" show_brand\">\r\n//                     <Card\r\n//                       hoverable\r\n//                       onClick={() => navigate(`/brand-product/${item.brandID}`)}\r\n//                       bordered={false}\r\n//                     >\r\n//                       <div className=\"brand_img\">\r\n//                         {item.imageUrl ? (\r\n//                           <img src={item.imageUrl} alt={item.brandName} />\r\n//                         ) : (\r\n//                           <img src={DefaultLogo} alt=\"Default Logo\" />\r\n//                         )}\r\n//                       </div>\r\n//                     </Card>\r\n//                   </div>\r\n//                   <p>{item.brandName.substr(0, 8)}.</p>\r\n//                 </div>\r\n//               ))\r\n//             )}\r\n//           </div>\r\n//         </Card>\r\n//         <div id=\"load-more-trigger\" ref={triggerRef} style={{ height: '1px', marginTop: '20px' }}>\r\n//           {loading && brandList.length > 0 && (\r\n//             <div className=\"scroll_load\"><span className=\"loaderScroll\"></span></div>\r\n//           )}\r\n//         </div>\r\n//       </div>\r\n//     </div>\r\n//   );\r\n// }\r\n\r\n// export default AllBrandList;\r\n\r\nimport React, { useCallback, useEffect, useState, useRef } from \"react\";\r\nimport { Card, Input, Skeleton, Tooltip } from \"antd\";\r\nimport { useNavigate } from \"react-router-dom\";\r\nimport { DotChartOutlined, SearchOutlined } from '@ant-design/icons';\r\nimport _ from 'lodash';\r\nimport { FetchbrandList } from \"../apiService/api\";\r\nimport DefaultLogo from \"../../assest/logo.png\";\r\nimport \"../../style/header.css\";\r\nimport { encryptCategoryID } from \"../../config/encriptConfig\";\r\n\r\nfunction AllBrandList() {\r\n  const navigate = useNavigate();\r\n  const [brandList, setBrandList] = useState([]);\r\n  const [current, setCurrent] = useState(1);\r\n  const [searchInput, setSearchInput] = useState(\"\");\r\n  const [loading, setLoading] = useState(false);\r\n  const [isLoading, setIsLoading] = useState(false);\r\n  const [hasMore, setHasMore] = useState(true);\r\n  const triggerRef = useRef(null);\r\n  const observer = useRef(null);\r\n  const titleCase = str => str.toLowerCase().split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');\r\n\r\n\r\n\r\n  const loadMoreBrands = async (page = 1, query = searchInput) => {\r\n    if (loading || !hasMore) return;\r\n\r\n    setLoading(true);\r\n    if (page === 1) setIsLoading(true); // Show main loader for first load\r\n\r\n    try {\r\n      const res = await FetchbrandList(page, query);\r\n      if (res.status === 200) {\r\n        const newBrands = res.data.data;\r\n        if (newBrands.length === 0) {\r\n          setHasMore(false);\r\n        } else {\r\n          setBrandList((prev) => (page === 1 ? newBrands : [...prev, ...newBrands]));\r\n        }\r\n      }\r\n    } catch (error) {\r\n      console.error(\"Error fetching brand list:\", error);\r\n    } finally {\r\n      setLoading(false);\r\n      setIsLoading(false);\r\n    }\r\n  };\r\n\r\n  // ✅ Fix: Debounce the API call\r\n  const debouncedSearch = useCallback(_.debounce((query) => {\r\n    setCurrent(1);\r\n    setBrandList([]);\r\n    setHasMore(true);\r\n    loadMoreBrands(1, query);\r\n  }, 500), []);\r\n\r\n  // ✅ Fix: Trigger API when `searchInput` changes\r\n  useEffect(() => {\r\n    debouncedSearch(searchInput);\r\n    return () => debouncedSearch.cancel();\r\n  }, [searchInput]);\r\n\r\n  // ✅ Fix: Call API when page changes\r\n  useEffect(() => {\r\n    if (current > 1) loadMoreBrands(current, searchInput);\r\n  }, [current]);\r\n\r\n  useEffect(() => {\r\n    if (observer.current) observer.current.disconnect();\r\n\r\n    observer.current = new IntersectionObserver(([entry]) => {\r\n      if (entry.isIntersecting && hasMore && !loading) {\r\n        setCurrent((prev) => prev + 1);\r\n      }\r\n    });\r\n\r\n    if (triggerRef.current) observer.current.observe(triggerRef.current);\r\n\r\n    return () => observer.current?.disconnect();\r\n  }, [hasMore, loading]);\r\n\r\n  const manageURl = (name) => {\r\n    const sanitizedCategory = name\r\n      .replace(/[,/&]/g, '') // Remove commas, slashes, ampersands\r\n      .replace(/\\s+/g, '-')  // Replace spaces with hyphens\r\n      .toLowerCase();\r\n    return sanitizedCategory\r\n  }\r\n\r\n\r\n  return (\r\n    <div className=\"view_brand_list\">\r\n      <div className=\"show_all_product\">\r\n        <Card\r\n          title={\r\n            <div className=\"brand_search\">\r\n              <p>Explore with Brand</p>\r\n              <Input\r\n                style={{ width: '200px' }}\r\n                allowClear\r\n                placeholder=\"Search Brand\"\r\n                suffix={<SearchOutlined />}\r\n                onChange={(e) => setSearchInput(e.target.value)}\r\n              />\r\n            </div>\r\n          }\r\n          bordered={false}\r\n        >\r\n          <div className={`${brandList.length ? \"show_all_brand\" : \"text-center\"}`}>\r\n            {isLoading ? (\r\n              <div className=\"scroll_load\"><span className=\"loaderScroll\"></span></div>\r\n            ) : brandList.length === 0 ? (\r\n              <div className=\"not_found_data\">\r\n                <img src=\"https://www.aamtrading.com/assets/img/nproduct.png\" alt=\"No Products\" />\r\n              </div>\r\n            ) : (\r\n              brandList.map((item, index) => (\r\n                <div key={index} className=\"show_all_brands\">\r\n                  <div className=\" show_brand\">\r\n                    <Card\r\n                      hoverable\r\n                      onClick={() => navigate(`/brand-product/${manageURl(item.brandName)}?uid=${encodeURIComponent(encryptCategoryID(item.brandID))}`)}\r\n                      bordered={false}\r\n                    >\r\n                      <div className=\"brand_img\">\r\n                        {item.imageUrl ? (\r\n                          <img\r\n                            src={item.imageUrl || DefaultLogo}\r\n                            onError={(e) => e.currentTarget.src = DefaultLogo}\r\n                            alt={item.brandName}\r\n                          />\r\n                        ) : (\r\n                          <img src={DefaultLogo} alt=\"Default Logo\" />\r\n                        )}\r\n                      </div>\r\n                    </Card>\r\n                  </div>\r\n                  <Tooltip title={titleCase(item.brandName)}>\r\n                    <p>{item.brandName.length > 8 ? titleCase(item.brandName.slice(0, 8)) + \"...\" : titleCase(item.brandName)}</p>\r\n                  </Tooltip>\r\n                </div>\r\n              ))\r\n            )}\r\n          </div>\r\n        </Card>\r\n        <div id=\"load-more-trigger\" ref={triggerRef} style={{ height: '1px', marginTop: '20px' }}>\r\n          {loading && brandList.length > 0 && (\r\n            <div className=\"scroll_load\"><span className=\"loaderScroll\"></span></div>\r\n          )}\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default AllBrandList;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\checkout\\OrderTrack.jsx",["778","779","780","781","782","783","784","785","786","787","788","789"],[],"import React, { useEffect, useState } from \"react\";\r\nimport ShowMap from \"../cart/ShowMap\";\r\nimport { Button, Card, Divider, Image, Skeleton, Space, Tag } from \"antd\";\r\nimport TrackMap from \"./TrackMap\";\r\nimport \"../../style/checkout.css\";\r\nimport TrackStep from \"./TrackStep\";\r\nimport { FiPhoneCall } from \"react-icons/fi\";\r\nimport { MdOutlineChat } from \"react-icons/md\";\r\nimport CancelOrderType from \"./CancelOrderType\";\r\nimport PartnerRating from \"./PartnerRating\";\r\nimport { useLocation, useParams } from \"react-router-dom\";\r\nimport { fetchOrderTrack } from \"../apiService/api\";\r\nimport { useAuth } from \"../auth/context/authContext\";\r\nimport TrackImg from \"../../assest/png/track-img.gif\"\r\n\r\n\r\nfunction OrderTrack() {\r\n  const { id } = useParams()\r\n  const { token } = useAuth()\r\n  // const [current, setCurrent] = useState(0);\r\n  const { state } = useLocation()\r\n  const [trackData, setTrackData] = useState([])\r\n  const [isLoading, setIsLoading] = useState(false)\r\n\r\n  const dispatchedStatus = trackData?.orderTrack?.find(\r\n    (track) => track.orderStatus === \"DISPATCHED\"\r\n  );\r\n\r\n  const PackStatus = trackData?.orderTrack?.find(\r\n    (track) => track.orderStatus === \"PACKED\"\r\n  );\r\n\r\n  const ShowOrderTrack = async () => {\r\n    setIsLoading(true)\r\n    try {\r\n      await fetchOrderTrack(token, id)\r\n        .then((res) => {\r\n          console.log(\"order track\", res);\r\n          if (res.status == 200) {\r\n            setTrackData(res.data.data);\r\n            setIsLoading(false)\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          console.log(err.message);\r\n        });\r\n    } catch (error) {\r\n      console.log(error);\r\n      setIsLoading(false)\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    ShowOrderTrack();\r\n  }, []);\r\n\r\n\r\n  const handleCallClick = (number) => {\r\n    window.location.href = `tel:${number}`;\r\n    console.log(\"get vendor number \", number)\r\n  };\r\n\r\n\r\n  return (\r\n    <div className=\"order_tracks\">\r\n      <Card>\r\n        {/* <TrackMap />/ */}\r\n        <img src={TrackImg} />\r\n      </Card>\r\n      {isLoading ? <Skeleton active /> :\r\n        <>\r\n          <div className=\"oder_way\">\r\n            <div className=\"order_tack\">\r\n              <p>  {trackData?.lastUpdateDateTimeMessage} </p>\r\n              <p>{trackData?.lastUpdateDate}-{trackData?.lastUpdateTime}</p>\r\n            </div>\r\n            {!trackData?.orderOtp ? null : <div className=\"order_place_otp\">\r\n              <p>OTP</p>\r\n              <Tag color=\"blue\" >{trackData?.orderOtp}</Tag>\r\n            </div>}\r\n          </div>\r\n          <div className=\"track_timeline\">\r\n            <TrackStep currentStatus={trackData} />\r\n          </div>\r\n          <Divider dashed />\r\n          {dispatchedStatus && trackData?.deliveryOption === \"DELIVERY\" ?\r\n            <div className=\"delivery_boy_detials\">\r\n\r\n              <div className=\"delivey_boy\">\r\n                <div className=\"del_boy_img\">\r\n                  <Image src={trackData?.vendorDetails?.profilePic} width={80} height={80} style={{ borderRadius: \"6px\" }} />\r\n                </div>\r\n                <div className=\"del_boy_name\">\r\n                  <h5>Delivery Partner Available</h5>\r\n                  <p className=\"delivety_boy_title\">{trackData?.vendorDetails?.vendorName}</p>\r\n                  <p> +91-{trackData?.vendorDetails?.mobileNo}</p>\r\n                </div>\r\n              </div>\r\n              <div className=\"call_msg\">\r\n                <FiPhoneCall className=\"del_boy_suooport\" onClick={() => handleCallClick(trackData?.vendorDetails?.mobileNo)} />\r\n              </div>\r\n            </div> : null}\r\n          {/* <Divider dashed /> */}\r\n          {/* <div className=\"cancel_order_type\">\r\n            \r\n            {trackData?.orderTrack?.length > 0 && !DeliveredStatus ? (\r\n              <CancelOrderType />\r\n            ) : (\r\n              <PartnerRating />\r\n            )}\r\n          </div> */}\r\n        </>\r\n      }\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default OrderTrack;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\Product\\ViewAllProduct.jsx",["790","791","792","793","794","795","796","797","798","799","800","801","802","803"],[],"import { Button, Card, Tooltip } from \"antd\";\r\nimport React, { useEffect, useState } from \"react\";\r\nimport \"../../style/header.css\";\r\nimport { FaHeart } from \"react-icons/fa\";\r\nimport { FaRegHeart } from \"react-icons/fa\";\r\nimport { useLocation, useNavigate } from \"react-router-dom\";\r\n\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { addItem, removeItem, selectCartItems } from \"../../redux/CartSlice\";\r\nimport { fetchSimelarProduct } from \"../apiService/api\";\r\nimport BKDLogo from \"../../assest/bkdlogo.png\";\r\n\r\nfunction ViewAllProduct() {\r\n  const navigate = useNavigate();\r\n  const [wish, setWish] = useState(false);\r\n  const [isWish, setIsWish] = useState(false)\r\n  const dispatch = useDispatch();\r\n  const cartItems = useSelector(selectCartItems);\r\n  const [similarData, setSimilarData] = useState([])\r\n  const [isLoading, setIsLoading] = useState(false)\r\n  const [current, setCurrent] = useState(1)\r\n  const { state } = useLocation()\r\n\r\n  console.log(state)\r\n\r\n  const ShowSimilarPorduct = async () => {\r\n    try {\r\n      await fetchSimelarProduct(state.categoryId, state.itemCatId, current)\r\n        .then((res) => {\r\n          console.log(\"similar product Information\", res);\r\n          if (res.status == 200) {\r\n            setSimilarData(res.data.data);\r\n            setIsLoading(true)\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          console.log(err.message);\r\n        });\r\n    } catch (error) {\r\n      console.log(error);\r\n      setIsLoading(true)\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    ShowSimilarPorduct();\r\n  }, []);\r\n\r\n  const handleAddItem = (item) => {\r\n    dispatch(addItem(item))\r\n\r\n  };\r\n\r\n  useEffect(() => {\r\n    localStorage.setItem(\"cart\", JSON.stringify(cartItems));\r\n  }, [cartItems]);\r\n\r\n\r\n\r\n\r\n\r\n\r\n  const handleDelItem = (item) => {\r\n    dispatch(removeItem(item));\r\n    const cart = JSON.parse(localStorage.getItem(\"cart\")) || []; // Retrieve cart from localStorage\r\n    const updatedCart = cart.filter(cartItem => cartItem.productCode !== item.productCode); // Filter out the item to be removed\r\n    localStorage.setItem(\"cart\", JSON.stringify(updatedCart))\r\n\r\n  };\r\n\r\n  const GoToSimilarProduct = (id) => {\r\n    navigate(`/product/${id}`)\r\n    ShowSimilarPorduct()\r\n  }\r\n\r\n\r\n  return (\r\n    <div className=\"show_pro\">\r\n      <div className=\"show_all_product\">\r\n        <Card title=\"Similar Products\" bordered={false}>\r\n          <div className=\"view_all_pro\">\r\n\r\n            {similarData.map((item) => (\r\n              <>\r\n                <div className=\"product_card\">\r\n                  <Card\r\n                    hoverable\r\n                    disabled={item.stockQty == 0 && true}\r\n                  >\r\n                    <div className=\"card_img\">\r\n                      {item.imageUrl[0] != null ?\r\n                        <img\r\n                          src={item.imageUrl[0]}\r\n                          onError={(e) => e.currentTarget.src = BKDLogo}\r\n                          onClick={() => GoToSimilarProduct(item.productCode)}\r\n                        />\r\n                        :\r\n                        <img\r\n                          src=\"https://cdn3.iconfinder.com/data/icons/online-states/150/Photos-512.png\"\r\n                          onClick={() => navigate(`/product/${item.productCode}`)}\r\n                        />}\r\n                    </div>\r\n\r\n                    <div className=\"pro_name\">\r\n                      <Tooltip title={item.productName}>\r\n                        <p>{item.productName.length > 36 ? item.productName.slice(0, 36) + \"...\" : item.productName}</p>\r\n                      </Tooltip>\r\n                      {item.packSize != \"\" && item.packSize != \"(NIL)\" ? <p>{item.packSize}</p> : <span >variant</span>}\r\n                    </div>\r\n                    <div className=\"add_cart\">\r\n                      <p>{`₹ ${Math.round(item.bkdAmount)} `}</p>\r\n                      {item.bkdAmount != item.price && <p><del>₹ {item.price}</del></p>}\r\n                      {cartItems.find((cartItem) => cartItem.productCode === item.productCode) ? (\r\n                        cartItems.map((cartItem) => {\r\n                          if (cartItem.productCode === item.productCode) {\r\n                            return (\r\n                              <Button.Group size='small' key={cartItem.productCode}>\r\n                                <Button onClick={() => handleDelItem(item)}>-</Button>\r\n                                <Button>{cartItem.unit}</Button> {/* Access quantity from cart item */}\r\n                                <Button onClick={() => handleAddItem(item)}>+</Button>\r\n                              </Button.Group>\r\n                            );\r\n                          }\r\n                          return null;\r\n                        })\r\n                      ) : (\r\n                        <Button type=\"default\" onClick={() => handleAddItem(item)}>Add</Button>\r\n                      )}\r\n                    </div>\r\n                  </Card>\r\n                  {Math.round(item.bkdAmount) != item.price ? <div className=\"cat_tags\">{Math.round((item.price - item.bkdAmount) * 100 / item.price)}% off</div> : null}\r\n\r\n                  <div className=\"wish_list\">\r\n                    {wish != true ? (\r\n                      <FaRegHeart\r\n                        onClick={() => setWish((pre) => !pre)}\r\n                        className=\"no_wish_icon\"\r\n                      />\r\n                    ) : (\r\n                      <FaHeart\r\n                        className=\"wish_icon\"\r\n                        onClick={() => setWish((pre) => !pre)}\r\n                      />\r\n                    )}\r\n                  </div>\r\n                </div>\r\n\r\n\r\n              </>\r\n            ))}\r\n\r\n          </div>\r\n        </Card>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default ViewAllProduct;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\Category\\AllCategoryList.jsx",["804","805","806","807","808","809","810","811"],[],"\r\n\r\nimport React, { useEffect, useState, useRef, useCallback } from 'react';\r\nimport { Button, Card, Drawer, Input, Skeleton } from 'antd';\r\nimport { BiCategory } from 'react-icons/bi';\r\nimport \"../../style/header.css\";\r\nimport { useNavigate } from 'react-router-dom';\r\nimport DefaultLogo from \"../../assest/logo.png\";\r\nimport { FetchCategoryList } from '../apiService/api';\r\nimport { SearchOutlined } from '@ant-design/icons';\r\nimport _ from 'lodash';  // For debounce\r\nimport { encryptCategoryID } from '../../config/encriptConfig';\r\n\r\nconst AllCategoryList = () => {\r\n  const navigate = useNavigate();\r\n  const [searchInput, setSearchInput] = useState(\"\");\r\n\r\n  const [catList, setCatList] = useState([]);\r\n  const [loading, setLoading] = useState(false);\r\n  const titleCase = str => str.toLowerCase().split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');\r\n\r\n\r\n  // Debounced search function using lodash's debounce\r\n  const debouncedSearch = useCallback(_.debounce((value) => {\r\n    setSearchInput(value);\r\n    setCatList([]); // Clear the list when searching\r\n  }, 1000), []); // 500ms delay\r\n\r\n  const handleSearch = (e) => {\r\n    debouncedSearch(e.target.value);\r\n  };\r\n\r\n  const showAllCategoryList = async () => {\r\n    setLoading(true);\r\n    try {\r\n      const res = await FetchCategoryList(searchInput);\r\n      if (res.status === 200) {\r\n        setCatList(res.data.data); // Append new data\r\n        setLoading(false);\r\n      }\r\n    } catch (error) {\r\n      console.log(error);\r\n      setLoading(false);\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    showAllCategoryList();\r\n  }, [searchInput]);\r\n\r\n  const manageURl = (categoryName) => {\r\n    const sanitizedCategory = categoryName\r\n      .replace(/[,/&]/g, '') // Remove commas, slashes, ampersands\r\n      .replace(/\\s+/g, '-')  // Replace spaces with hyphens\r\n      .toLowerCase();\r\n    return sanitizedCategory\r\n  }\r\n\r\n  return (\r\n    <>\r\n      <Card\r\n        title={\r\n          <div className='d-flex justify-content-between'>\r\n            <p>Shop by  Category</p>\r\n            <Input\r\n              style={{ width: '200px' }}\r\n              allowClear\r\n              placeholder=\"Search Category\"\r\n              suffix={<SearchOutlined />}\r\n              onChange={handleSearch}\r\n            />\r\n          </div>\r\n        }\r\n\r\n      >\r\n        <div className={`${catList?.length != 0 ? \"show_cat_drawer\" : \"text-center\"}`}>\r\n          {loading ? <span className=\"loaderScroll\"></span> : catList.map((item) => (\r\n            <div className='cat_listing' key={item.categoryID}>\r\n              <Card bordered={false} onClick={() => navigate(`/category/${manageURl(item.categoryName)}?uid=${encodeURIComponent(encryptCategoryID(item.categoryID))}`)} hoverable>\r\n                <div className=\"draw_cat_item\">\r\n                  {item.imageUrl ? <img\r\n                    src={item.imageUrl || DefaultLogo}\r\n                    onError={(e) => e.currentTarget.src = DefaultLogo}\r\n                    alt=\"Category\"\r\n                  />\r\n                    :\r\n                    <img\r\n                      src={DefaultLogo}\r\n                      alt=\"Default\"\r\n                    />\r\n                  }\r\n                  <p>{item.title}</p>\r\n                </div>\r\n              </Card>\r\n              <div className=\"cat_names\">\r\n                <p>{titleCase(item.categoryName)}</p>\r\n              </div>\r\n            </div>\r\n          ))}\r\n\r\n          {/* Ref attached to the last item for infinite scroll */}\r\n        </div>\r\n\r\n      </Card>\r\n    </>\r\n  );\r\n};\r\n\r\nexport default AllCategoryList;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\Racipe\\AllRecipes.jsx",["812","813","814","815","816","817","818"],[],"import { Card } from 'antd';\r\nimport React, { useEffect, useState } from 'react';\r\nimport \"../../style/product.css\";\r\nimport HeroBanner from '../home/HeroBanner';\r\nimport RecipesBanner from './RecipesBanner';\r\nimport RecipesDetails from './RecipesDetails';\r\nimport { useParams } from 'react-router-dom';\r\nimport { useAuth } from '../auth/context/authContext';\r\nimport { baseURL, fetchAllRacipe, fetchParticularRecipe } from '../apiService/api';\r\nimport axios from 'axios';\r\nimport Footers from '../footer/Footers';\r\n\r\nfunction AllRecipes() {\r\n  const { id } = useParams();\r\n  const { nearStore } = useAuth();\r\n  const [racipeData, setRacipeData] = useState([]);\r\n  const [isLoading, setIsLoading] = useState(true);\r\n\r\n  const ShowRacipeDetails = async () => {\r\n    try {\r\n      const res = await fetchParticularRecipe(id, nearStore?.branchCode);\r\n      // const res = await fetchAllRacipe(id, nearStore?.branchCode);\r\n      if (res.status === 200) {\r\n        setRacipeData(res.data.data);\r\n      }\r\n    } catch (error) {\r\n      console.log(error.message);\r\n    } finally {\r\n      setIsLoading(false);\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    ShowRacipeDetails();\r\n  }, []);\r\n\r\n  return (\r\n    <div className='all_recipes'>\r\n      <div className=\"recipes_datas\">\r\n        <div className=\"bannersss\">\r\n          <RecipesBanner racipeData={racipeData} />\r\n        </div>\r\n        <div className=\"recepes_details\">\r\n          <RecipesDetails racipeData={racipeData} ShowRacipeDetails={ShowRacipeDetails} />\r\n        </div>\r\n      </div>\r\n      <Footers />\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default AllRecipes;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\home\\BrandBaseProduct.jsx",["819","820","821","822","823","824","825","826","827","828","829","830","831","832","833","834","835","836","837","838","839"],[],"import { Badge, Button, Card, Col, Divider, Row, Skeleton, Space, Tag, Tooltip, notification } from \"antd\";\r\nimport React, { useEffect, useRef, useState } from \"react\";\r\nimport Slider from \"react-slick\";\r\nimport \"../../style/header.css\";\r\nimport { FaHeart, FaRegHeart } from \"react-icons/fa\";\r\nimport { useLocation, useNavigate, useParams } from \"react-router-dom\";\r\nimport { MdArrowRightAlt, MdKeyboardBackspace } from \"react-icons/md\";\r\nimport { useScreen } from \"../auth/AuthScreen\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { addItem, removeItem, selectCartItems } from \"../../redux/CartSlice\";\r\nimport { useAuth } from \"../auth/context/authContext\";\r\nimport { AddProductWishlist, FetchBrandProduct, out_of_stock, ProdductLimits } from \"../apiService/api\";\r\nimport { selectBranch } from \"../../redux/OrderSlice\";\r\nimport DefaultImg from \"../../assest/bkdlogo.png\";\r\nimport ProductFilter from \"../Category/ProductFilter\";\r\nimport offerAvailable from \"../../assest/png/offer_apply.png\"\r\nimport { decryptCategoryID, encryptCategoryID } from \"../../config/encriptConfig\";\r\nimport { getOfferImage } from \"../../utils/offerUtils\";\r\n\r\n\r\nfunction BrandBaseProduct() {\r\n    // const { id } = useParams();\r\n    const { token } = useAuth();\r\n    const { screenWidth } = useScreen();\r\n    const [itemType, setItemType] = useState(\"\")\r\n    const [hasMore, setHasMore] = useState(true);\r\n    const [isInitialRender, setIsInitialRender] = useState(true);\r\n    const [filterBy, setFilterBy] = useState(null)\r\n    const [productList, setProductList] = useState([]);\r\n    const [loading, setLoading] = useState(false);\r\n    const [nextLoading, setNextLoading] = useState(false)\r\n    const [current, setCurrent] = useState(1);\r\n    const nearBranch = useSelector(selectBranch);\r\n    const navigate = useNavigate();\r\n    const dispatch = useDispatch();\r\n    const cartItems = useSelector(selectCartItems);\r\n    const observerRef = useRef(null);\r\n    const [wishlist, setWishlist] = useState({});\r\n    const skeletonArray = new Array(12).fill(0);\r\n    const titleCase = str => str?.toLowerCase()?.split(' ').map(word => word?.charAt(0)?.toUpperCase() + word.slice(1))?.join(' ');\r\n\r\n\r\n    const { id } = useParams()\r\n    const searchParams = new URLSearchParams(useLocation().search);\r\n    console.log(\"searchParams\", id)\r\n    const encryptedCode = searchParams.get(\"uid\");\r\n    const routeBrandId = encryptedCode ? decryptCategoryID(decodeURIComponent(encryptedCode)) : null;\r\n    const [selectedBrandId, setSelectedBrandId] = useState(routeBrandId);\r\n\r\n    const handleBrandSelect = (brandId, brandName) => {\r\n        navigate(`/brand-product/${manageURl(brandName)}?uid=${encodeURIComponent(encryptCategoryID(brandId))}`);\r\n    };\r\n\r\n    const handleAddItem = (item) => {\r\n        dispatch(addItem(item));\r\n    };\r\n\r\n    useEffect(() => {\r\n        localStorage.setItem(\"cart\", JSON.stringify(cartItems));\r\n    }, [cartItems]);\r\n\r\n    const handleDelItem = (item) => {\r\n        dispatch(removeItem(item));\r\n        const cart = JSON.parse(localStorage.getItem(\"cart\")) || [];\r\n        const updatedCart = cart.filter(cartItem => cartItem.productCode !== item.productCode);\r\n        localStorage.setItem(\"cart\", JSON.stringify(updatedCart));\r\n    };\r\n\r\n    const HnadleNotLogin = () => {\r\n        notification.error({\r\n            placement: \"topRight\",\r\n            message: \"Please login before add wishlist\",\r\n        });\r\n    };\r\n\r\n    const addToWishList = async (proCode) => {\r\n        setWishlist((prev) => ({ ...prev, [proCode.productCode]: true }));\r\n        const body = {\r\n            productCode: proCode.productCode,\r\n            productName: proCode.productName,\r\n            status: \"ACTIVE\"\r\n        }\r\n        try {\r\n            await AddProductWishlist(token, body)\r\n                .then((res) => {\r\n                    console.log(\"add to  wish\", res);\r\n                    if (res.status == 201) {\r\n                        setCurrent((pre) => pre)\r\n                        if (res.data.data.whislistKey != true) {\r\n                            ShowAllProductList()\r\n                        } else {\r\n                            ShowAllProductList()\r\n                        }\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n                    setWishlist((prev) => ({ ...prev, [proCode]: false }));\r\n                });\r\n        } catch (error) {\r\n            setWishlist((prev) => ({ ...prev, [proCode]: false }));\r\n            console.log(error);\r\n\r\n        }\r\n    };\r\n\r\n    const RemoveToWishList = async (proCode) => {\r\n        setWishlist((prev) => ({ ...prev, [proCode.productCode]: false })); // Immediately update the icon\r\n        // setWishlist((prev) => ({ ...prev, [proCode.isWhislist]: false })); // Immediately update the icon\r\n        const body = { productCode: proCode.productCode, productName: proCode.productName, status: \"INACTIVE\" };\r\n        try {\r\n            await AddProductWishlist(token, body)\r\n                .then((res) => {\r\n                    if (res.status === 201) {\r\n                        ShowAllProductList();\r\n                        setCurrent((pre) => pre)\r\n\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n                    setWishlist((prev) => ({ ...prev, [proCode]: true })); // Revert the icon if the API call fails\r\n\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n            setWishlist((prev) => ({ ...prev, [proCode]: true })); // Revert the icon if the API call fails\r\n        }\r\n    };\r\n\r\n    // const ShowAllProductList = async () => {\r\n    //     setLoading(true);\r\n    //     setNextLoading(true)\r\n    //     try {\r\n    //         const res = await FetchBrandProduct(nearBranch?.details?.branchCode, id, current, token, itemType,\r\n    //             filterBy);\r\n    //         console.log(\"brand product list\", res);\r\n    //         if (res.status === 200) {\r\n    //             setProductList(prevData => [...prevData, ...res.data.data]);\r\n    //             setNoData(res.data.data.length === 0);\r\n    //             setNextLoading(false)\r\n\r\n    //         }\r\n    //     } catch (error) {\r\n    //         console.log(error);\r\n    //     } finally {\r\n    //         setLoading(false);\r\n    //         setNextLoading(false)\r\n\r\n    //     }\r\n    // };\r\n\r\n    // useEffect(() => {\r\n    //     ShowAllProductList();\r\n    // }, [current, filterBy, itemType]);\r\n\r\n    // useEffect(() => {\r\n    //     const observer = new IntersectionObserver(\r\n    //         (entries) => {\r\n    //             if (entries[0].isIntersecting && !loading && !noData) {\r\n    //                 setCurrent(prevPage => prevPage + 1);\r\n    //             }\r\n    //         },\r\n    //         { threshold: 1.0 }\r\n    //     );\r\n\r\n    //     if (observerRef.current) {\r\n    //         observer.observe(observerRef.current);\r\n    //     }\r\n\r\n    //     return () => {\r\n    //         if (observerRef.current) {\r\n    //             observer.unobserve(observerRef.current);\r\n    //         }\r\n    //     };\r\n    // }, [loading, noData]);\r\n\r\n    // useEffect(() => {\r\n    //     setCurrent(1);         // Reset current page to 1\r\n    //     setProductList([]);      // Clear the brand list\r\n\r\n    // }, [filterBy]);\r\n\r\n\r\n\r\n    const ShowAllProductList = async (isInitial = false) => {\r\n        setLoading(true);\r\n        setNextLoading(isInitial);\r\n\r\n        // Calculate the correct page value to pass\r\n        const page = isInitial ? 1 : current + 1;\r\n\r\n        try {\r\n            const res = await FetchBrandProduct(\r\n                nearBranch?.details?.branchCode,\r\n                selectedBrandId,\r\n                page, // Pass the correct page value\r\n                token,\r\n                itemType,\r\n                filterBy\r\n            );\r\n            if (res.status === 200) {\r\n                const fetchData = res.data.data;\r\n                if (fetchData.length === 0) {\r\n                    setHasMore(false);\r\n                } else {\r\n                    setProductList((prevData) =>\r\n                        isInitial ? fetchData : [...prevData, ...fetchData]\r\n                    );\r\n                    setCurrent(page); // Update `current` state\r\n                }\r\n            }\r\n        } catch (error) {\r\n            console.log(error);\r\n        } finally {\r\n            setLoading(false);\r\n            setNextLoading(false);\r\n            if (isInitialRender) setIsInitialRender(false); // Set initial render flag to false\r\n        }\r\n    };\r\n\r\n    useEffect(() => {\r\n        if (selectedBrandId) {\r\n            ShowAllProductList(true); // Initial load and on filter/brand changes\r\n        }\r\n    }, [id, itemType, filterBy, selectedBrandId]);\r\n\r\n    console.log(\"ProdductLimits\", ProdductLimits)\r\n    console.log(\"ProdductLimits\", productList?.length)\r\n\r\n    useEffect(() => {\r\n        if (isInitialRender) return; // Skip observer logic during the initial render\r\n        if (productList?.length == ProdductLimits * current) {\r\n            const observer = new IntersectionObserver(\r\n                (entries) => {\r\n                    if (entries[0].isIntersecting && !loading && hasMore) {\r\n                        ShowAllProductList(false);\r\n                    }\r\n                },\r\n                { threshold: 1.0 }\r\n            );\r\n\r\n            if (observerRef.current) observer.observe(observerRef.current);\r\n\r\n            return () => {\r\n                if (observerRef.current) observer.unobserve(observerRef.current);\r\n            };\r\n        }\r\n    }, [hasMore, loading, isInitialRender]);\r\n\r\n    useEffect(() => {\r\n        setCurrent(1);         // Reset current page to 1\r\n        setProductList([]);      // Clear the brand list\r\n        setHasMore(true);      // Reset hasMore flag\r\n\r\n    }, [filterBy, selectedBrandId]);\r\n\r\n\r\n    const manageURl = (productName) => {\r\n        const sanitizedCategory = productName\r\n            .replace(/[,/&]/g, '') // Remove commas, slashes, ampersands\r\n            .replace(/\\s+/g, '-')  // Replace spaces with hyphens\r\n            .toLowerCase();\r\n        return sanitizedCategory\r\n    }\r\n\r\n    const goToProductDetails = (item) => {\r\n        navigate(`/product/${manageURl(item.productName)}?uid=${encodeURIComponent(encryptCategoryID(item.productCode))}`);\r\n\r\n    }\r\n\r\n    return (\r\n        <div className=\"show_pro\">\r\n            <div className=\"show_all_product\">\r\n                <Card\r\n                    title={\r\n                        <div className=\"d-flex justify-content-between align-items-center\">\r\n                            <Space>\r\n                                <Button type=\"link\" onClick={() => navigate(-1)} icon={<MdKeyboardBackspace className=\"h4\" />} />\r\n                                <p>{titleCase(id)}</p>\r\n                            </Space>\r\n                            <ProductFilter setFilterBy={setFilterBy} setItemType={setItemType} setBrandId={setSelectedBrandId} onBrandSelect={handleBrandSelect} />\r\n                        </div>\r\n                    }\r\n                    bordered={false}\r\n                >\r\n                    <div className={`${productList.length != 0 || nextLoading ? \"showing_pro_by_cat\" : \"\"}`}>\r\n                        {nextLoading ?\r\n                            skeletonArray.map((_, index) => (\r\n                                <Card size=\"small\" className=\"mx-2 mb-2\" key={index}>\r\n                                    <Skeleton.Image active />\r\n                                    <Skeleton active paragraph={{ row: 6 }} />\r\n                                </Card>\r\n\r\n                            ))\r\n                            : (\r\n                                productList.length === 0 ? (\r\n                                    <div className='text-center'>\r\n                                        <img src=\"https://www.aamtrading.com/assets/img/nproduct.png\" width=\"50%\" />\r\n                                    </div>\r\n                                ) : (\r\n                                    productList.map((item) => (\r\n                                        <div className=\"product_card individual_card \" key={item.productCode}>\r\n                                            <Card hoverable disabled={item.stockQty === 0}>\r\n                                                <div className=\"card_img\">\r\n                                                    {item.imageUrl[0] ? (\r\n                                                        <img\r\n                                                            src={item.imageUrl[0] || DefaultImg}\r\n                                                            onError={(e) => e.currentTarget.src = DefaultImg}\r\n                                                            onClick={() => goToProductDetails(item)}\r\n                                                        />\r\n                                                    ) : (\r\n                                                        <img src={DefaultImg} onClick={() => goToProductDetails(item)} />\r\n                                                    )}\r\n                                                </div>\r\n                                                <div className=\"pro_name\" onClick={() => goToProductDetails(item)}>\r\n                                                    <Tooltip title={titleCase(item.productName)}>\r\n                                                        <p>{item.productName.length > 36 ? titleCase(item.productName.slice(0, 36)) + \"...\" : titleCase(item.productName)}</p>\r\n                                                    </Tooltip>\r\n                                                </div>\r\n                                                <div className=\"show_variant_item\" onClick={() => goToProductDetails(item)}>\r\n                                                    {item.packSize && item.packSize !== \"(NIL)\" ? <Tag color=\"green\">{item.packSize}</Tag> : <p className=\"hidden_data\">N/A</p>}\r\n                                                    {item.stockQty <= out_of_stock ? <Tag color='red' className=\"stock_tag\">out of stock</Tag> : <p className='hidden_data'>N/A</p>}\r\n                                                </div>\r\n                                                <div className=\"show_price_mrp\">\r\n                                                    <p>BKD Price | MRP</p>\r\n                                                </div>\r\n                                                <div className=\"add_cart\">\r\n                                                    <p>{`₹ ${Math.round(item.bkdAmount)} `} <span>{item.bkdAmount != item.price && <del>₹ {item.price}</del>}</span> </p>\r\n\r\n                                                    {cartItems.find((cartItem) => cartItem.productCode === item.productCode) ? (\r\n                                                        cartItems.map((cartItem) => {\r\n                                                            if (cartItem.productCode === item.productCode) {\r\n                                                                return (\r\n                                                                    <Button.Group className=\"add_to_carts\" size={screenWidth < 800 ? \"\" : 'small'} key={cartItem.productCode}>\r\n                                                                        <Button className=\"add_to_carts add_to_cart_button\" onClick={() => handleDelItem(item)}>-</Button>\r\n                                                                        <Button className=\"add_to_carts add_to_cart_button\">{cartItem.unit}</Button>\r\n                                                                        <Button className=\"add_to_carts add_to_cart_button\" onClick={() => handleAddItem(item)}>+</Button>\r\n                                                                    </Button.Group>\r\n                                                                );\r\n                                                            }\r\n                                                            return null;\r\n                                                        })\r\n                                                    ) : (\r\n                                                        <Button disabled={item.stockQty <= out_of_stock} type=\"default\" onClick={() => handleAddItem(item)}>ADD</Button>\r\n                                                    )}\r\n                                                </div>\r\n                                            </Card>\r\n                                            {/* {loading && <div className=\"showing_pro_by_cat\">\r\n                                                {skeletonArray.map((_, index) => (\r\n                                                    <Card size=\"small\" className=\"mx-2 mb-2\" key={index}>\r\n                                                        <Skeleton.Image active />\r\n                                                        <Skeleton active paragraph={{ row: 6 }} />\r\n                                                    </Card>\r\n                                                ))}\r\n                                            </div>} */}\r\n                                            {item.billingQty === \"PROMOTIONS\" || item.billingQty === \"DISCOUNT\" || item.offerQty === \"PROMOTIONS\" || item.offerQty === \"DISCOUNT\" ?\r\n                                                <div className=\"discount_tags\">Super Saver Price</div> : item.billingQty != \"\" && item.offerQty != \"\" ?\r\n                                                    <div className=\"offer_Available\">\r\n                                                        {(item.billingQty === \"FOC\" || item.offerQty === \"FOC\") ?\r\n                                                            <>\r\n                                                                <img src={offerAvailable} />\r\n                                                                <div className=\"offer_types\">\r\n                                                                    <p>1 Item</p>\r\n                                                                    <p>Free </p>\r\n                                                                    <p>On MRP</p>\r\n                                                                </div>\r\n                                                            </>\r\n                                                            :\r\n                                                            <img src={getOfferImage(item?.offerQty)} />\r\n                                                        }\r\n\r\n                                                    </div> : Math.round(item.bkdAmount) !== item.price && (\r\n                                                        <div className=\"cat_tags\">\r\n                                                            {Math.round((item.price - item.bkdAmount) * 100 / item.price)}% off\r\n                                                        </div>\r\n                                                    )}\r\n                                            <div className=\"wish_list\">\r\n                                                {token ?\r\n                                                    <div className='wish_list'>\r\n                                                        {\r\n                                                            wishlist[item.productCode] || item.isWhislist ? (\r\n                                                                <FaHeart\r\n                                                                    className=\"no_wish_icon\"\r\n                                                                    size={22}\r\n                                                                    color='red'\r\n                                                                    onClick={() => RemoveToWishList(item)}\r\n                                                                />\r\n                                                            ) : (\r\n                                                                <FaRegHeart\r\n                                                                    className=\"no_wish_icon\"\r\n                                                                    size={22}\r\n                                                                    onClick={() => addToWishList(item)}\r\n                                                                />\r\n                                                            )\r\n                                                        }\r\n                                                    </div>\r\n\r\n                                                    :\r\n                                                    <div className='wish_list'>\r\n                                                        <FaRegHeart\r\n                                                            className=\"no_wish_icon\"\r\n                                                            size={22}\r\n                                                            onClick={HnadleNotLogin}\r\n                                                        />\r\n                                                    </div>\r\n                                                }\r\n                                            </div>\r\n                                        </div>\r\n                                    ))\r\n                                )\r\n                            )}\r\n                    </div>\r\n                    <div ref={observerRef} >\r\n                        {loading && <div className='text-center'><span className=\"loaderScroll\"></span></div>}\r\n\r\n                    </div>\r\n                </Card>\r\n            </div>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default BrandBaseProduct;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\home\\Home.jsx",["840","841","842","843","844","845","846","847","848","849","850"],[],"import React, { useEffect, useState } from \"react\";\r\n\r\nimport \"../../style/header.css\";\r\nimport HeroBanner from \"./HeroBanner\";\r\nimport OffersSlider from \"./OffersSlider\";\r\nimport CategorySlider from \"./CategorySlider\";\r\nimport BrandScroll from \"./BrandScroll\";\r\nimport { useCurrentLocation, useScreen } from \"../auth/AuthScreen\";\r\nimport PoolOrder from \"../poolOrder/PoolOrder\";\r\nimport Footers from \"../footer/Footers\";\r\nimport { bannerViewType, GetUserProfile, HeroBannerList } from \"../apiService/api\";\r\nimport { useAuth } from \"../auth/context/authContext\";\r\nimport CustomSegment from \"../segment/ProductSegment\";\r\nimport AllSegment from \"../segment/AllSegment\";\r\nimport { Skeleton } from \"antd\";\r\nimport TrendingBrand from \"./TrendingBrand\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { setDiscountAmount, setDiscountDetails } from \"../../redux/OrderSlice\";\r\nimport { setBannerData, setBannerLoading } from \"../../redux/BannerSlice\";\r\n\r\nfunction Home() {\r\n  const { fcmtoken } = useAuth()\r\n  // const [bannerData, setBannerData] = useState([])\r\n  const [bannerList, setBannerList] = useState([])\r\n  const [offerList, setOfferList] = useState([])\r\n  const { screenWidth } = useScreen();\r\n  const { userLocation, setUserLocation } = useCurrentLocation();\r\n  // const [isLoading, setIsLoading] = useState(false)\r\n  const dispatch = useDispatch()\r\n\r\n  const bannerState = useSelector((state) => state.banner || {});\r\n  const { bannerData = [], isLoading = false, hasFetched = false } = bannerState;\r\n\r\n  const fetchBanner = async () => {\r\n    try {\r\n      if (!hasFetched) {\r\n        dispatch(setBannerLoading(true));\r\n      }\r\n\r\n      const res = await HeroBannerList(bannerViewType.webView);\r\n\r\n      if (res.status === 200) {\r\n        dispatch(setBannerData(res.data.data));\r\n      }\r\n    } catch (err) {\r\n      console.log(err);\r\n      dispatch(setBannerLoading(false));\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    fetchBanner();\r\n  }, [userLocation]);\r\n\r\n  // const ShowBannerImage = async () => {\r\n  //   setIsLoading(true)\r\n  //   try {\r\n  //     await HeroBannerList(bannerViewType.webView)\r\n  //       .then((res) => {\r\n  //         // console.log(\"banner  lsit=============\", res);\r\n  //         if (res.status == 200) {\r\n  //           setBannerData(res.data.data);\r\n  //           setTimeout(() => {\r\n  //             setIsLoading(false)\r\n  //           }, 2000)\r\n  //         }\r\n  //       })\r\n  //       .catch((err) => {\r\n  //         console.log(err);\r\n  //       });\r\n  //   } catch (error) {\r\n  //     console.log(error);\r\n  //     setIsLoading(false)\r\n\r\n  //   }\r\n  // };\r\n  // useEffect(() => {\r\n  //   ShowBannerImage()\r\n  // }, [userLocation])\r\n\r\n  // useEffect(() => {\r\n  //   if (bannerData) {\r\n  //     const offer = bannerData.find(item => item._id === \"OFFER\");\r\n  //     const banner = bannerData.find(item => item._id === \"BANNER\");\r\n  //     if (offer) {\r\n  //       setOfferList(offer.banners);\r\n  //     }\r\n  //     if (banner) {\r\n  //       setBannerList(banner.banners);\r\n  //     }\r\n  //   }\r\n  // }, [bannerData]);\r\n\r\n  useEffect(() => {\r\n    dispatch(setDiscountDetails(null))\r\n    dispatch(setDiscountAmount(0))\r\n  }, [])\r\n\r\n\r\n  return (\r\n    <section>\r\n      <div className=\"home_section\">\r\n        <div className=\"banner\">\r\n          <div className=\"landing_page\">\r\n            {isLoading && !hasFetched ? (\r\n              <Skeleton.Node\r\n                active\r\n                className={`${screenWidth > 800 ? \"banner_loader\" : \"mobile_banner_Loader\"} mt-2`}\r\n              />\r\n            ) : (\r\n              <HeroBanner bannerList={bannerData} />\r\n            )}\r\n            {screenWidth > 800 ? <CategorySlider screenWidth={screenWidth} /> : null}\r\n            <TrendingBrand screenWidth={screenWidth} />\r\n            <AllSegment />\r\n            <PoolOrder screenWidth={screenWidth} />\r\n            <BrandScroll screenWidth={screenWidth} title={\"Explore by Brand\"} />\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <Footers />\r\n    </section>\r\n  );\r\n}\r\n\r\nexport default Home;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\home\\SearchProduct.jsx",["851","852","853","854","855","856","857","858","859","860","861","862","863","864","865"],[],"import React, { useEffect, useState, useRef, useCallback } from 'react';\r\nimport { Button, Card, notification, Skeleton, Spin, Tag, Tooltip } from 'antd';\r\nimport { fetchSearchProduct, getSearchKey, out_of_stock } from '../apiService/api';\r\nimport { useAuth } from '../auth/context/authContext';\r\nimport { useNavigate } from 'react-router-dom';\r\nimport \"../../style/home.css\";\r\nimport BKDLogo from \"../../assest/bkdlogo.png\";\r\nimport { encryptCategoryID } from '../../config/encriptConfig';\r\nimport { addItem, removeItem, selectCartItems } from '../../redux/CartSlice';\r\nimport { useDispatch, useSelector } from 'react-redux';\r\nimport { getOfferImage } from \"../../utils/offerUtils\";\r\nimport { useScreen } from '../auth/AuthScreen';\r\nimport offerAvailable from \"../../assest/png/offer_apply.png\"\r\nimport { MdOutlineCancel } from \"react-icons/md\";\r\n\r\nconst SearchProduct = ({ searchInput, initLoading, setInitLoading, handleClear, setSearchInput }) => {\r\n  const { nearStore, currentUser, token } = useAuth();\r\n  const navigate = useNavigate();\r\n  const [isDelay, setIsDelay] = useState(false)\r\n  // const [initLoading, setInitLoading] = useState(true);\r\n  const [loading, setLoading] = useState(false);\r\n\r\n  const [list, setList] = useState([]); // List used for rendering\r\n  const [suggestions, setSuggestions] = useState([]);\r\n  const [current, setCurrent] = useState(1);\r\n  const [hasMore, setHasMore] = useState(true); // Track if there are more items to load\r\n  const [debouncedSearchInput, setDebouncedSearchInput] = useState(\"\"); // Debounced input for API calls\r\n  const observerRef = useRef();\r\n  const [recentSearches, setRecentSearches] = useState([]);\r\n  const { screenWidth } = useScreen()\r\n  const dispatch = useDispatch();\r\n  const cartItems = useSelector(selectCartItems);\r\n\r\n  // Load recent searches from localStorage on mount\r\n  useEffect(() => {\r\n    const stored = localStorage.getItem('recentSearches');\r\n    if (stored) {\r\n      try {\r\n        setRecentSearches(JSON.parse(stored));\r\n      } catch (error) {\r\n        console.error('Error loading recent searches:', error);\r\n      }\r\n    }\r\n  }, []);\r\n\r\n  const addToRecentSearches = (searchTerm) => {\r\n    setRecentSearches((prev) => {\r\n      // Remove duplicates and keep only the new one at the top\r\n      const updated = [searchTerm, ...prev.filter((item) => item !== searchTerm)];\r\n      // Limit to 10 recent searches\r\n      const limited = updated.slice(0, 10);\r\n      localStorage.setItem('recentSearches', JSON.stringify(limited));\r\n      return limited;\r\n    });\r\n  };\r\n\r\n  const removeFromRecentSearches = (index) => {\r\n    setRecentSearches((prev) => {\r\n      const updated = prev.filter((_, i) => i !== index);\r\n      localStorage.setItem('recentSearches', JSON.stringify(updated));\r\n      return updated;\r\n    });\r\n  };\r\n\r\n  const clearAllRecentSearches = () => {\r\n    setRecentSearches([]);\r\n    localStorage.removeItem('recentSearches');\r\n  };\r\n\r\n  useEffect(() => {\r\n    setCurrent(1);\r\n    setHasMore(true);\r\n    setIsDelay(false);\r\n\r\n    if (!searchInput?.trim()) {\r\n      setList([]);\r\n      setSuggestions([]);\r\n      setInitLoading(false);\r\n      return;\r\n    }\r\n\r\n    // Apply 2-second debounce delay\r\n    const handler = setTimeout(() => {\r\n      setDebouncedSearchInput(searchInput);\r\n      setIsDelay(true);\r\n\r\n    }, 500);\r\n\r\n    // Clear previous timeout\r\n\r\n    return () => clearTimeout(handler);\r\n  }, [searchInput]);\r\n\r\n  // useEffect(() => {\r\n  //   if (isDelay) {\r\n  //     setCurrent(1); \r\n  //     fetchProductList(false);\r\n  //   }\r\n  // }, [debouncedSearchInput]);\r\n\r\n  useEffect(() => {\r\n    if (isDelay && debouncedSearchInput?.trim()) {\r\n      setCurrent(1);\r\n      setList([]);\r\n      setSuggestions([]);\r\n      fetchProductList(false, 1);\r\n    }\r\n  }, [debouncedSearchInput, isDelay]);\r\n\r\n  useEffect(() => {\r\n    if (current > 1 && isDelay) {\r\n      fetchProductList(true, current);\r\n    }\r\n  }, [current]);\r\n\r\n  // Infinite scroll observer\r\n  const lastProductElementRef = useCallback((node) => {\r\n    if (loading || !hasMore) return;\r\n\r\n    if (observerRef.current) observerRef.current.disconnect();\r\n\r\n    observerRef.current = new IntersectionObserver((entries) => {\r\n      if (entries[0].isIntersecting) {\r\n        setLoading(true);\r\n        setCurrent((prev) => prev + 1); // Load next page\r\n      }\r\n    });\r\n\r\n    if (node) observerRef.current.observe(node);\r\n  }, [loading, hasMore]);\r\n\r\n\r\n\r\n  // Fetch products based on the debounced search input\r\n  const fetchProductList = async (isLoadMore = false, page = current) => {\r\n    if (!debouncedSearchInput || !hasMore) return;// Do not fetch if input is empty or no more data\r\n\r\n    if (!isLoadMore) {\r\n      setInitLoading(true);\r\n    }\r\n    try {\r\n      const res = await fetchSearchProduct(debouncedSearchInput, nearStore?.branchCode, page);\r\n      if (res.status === 200) {\r\n        const products = res.data.data || [];\r\n        setInitLoading(false);\r\n\r\n        if (products.length === 0) {\r\n          setHasMore(false); // If no more products, stop further API calls\r\n        } else {\r\n          if (isLoadMore) {\r\n            // Append new products to existing ones\r\n            // setData((prevData) => [...prevData, ...products]);\r\n            setList((prevList) => [...prevList, ...products]);\r\n          } else {\r\n            // Replace data and list if it's not a load more action\r\n            // setData(products);\r\n            setList(products);\r\n            setSuggestions(res?.data?.suggestions || []);\r\n          }\r\n        }\r\n      } else if (res.status === 202) {\r\n        notification.success({ placement: 'topRight', message: res.data.message });\r\n      }\r\n    } catch (error) {\r\n      console.error(error);\r\n    } finally {\r\n      setLoading(false);\r\n    }\r\n  };\r\n\r\n  // useEffect(() => {\r\n\r\n  //   if (!loading && !hasMore && current === 1) {\r\n  //     setList([]);\r\n  //   }\r\n  //   if (isDelay) {\r\n  //     fetchProductList(current > 1); \r\n  //   }\r\n  // }, [debouncedSearchInput, current]); \r\n\r\n  const manageURl = (name) =>\r\n    name\r\n      .replace(/[,&\\/]/g, '')\r\n      .replace(/\\s+/g, '-')\r\n      .toLowerCase();\r\n\r\n  const getSearchDataKey = async (keys, id) => {\r\n    const body = {\r\n      token: searchInput,\r\n      esBkdCode: id,\r\n      esBKdCodeType: keys,\r\n      userId: currentUser?._id || \"\"\r\n    };\r\n    try {\r\n      await getSearchKey(body);\r\n    } catch (error) {\r\n      console.error(error);\r\n    }\r\n  };\r\n\r\n  const GoToSimilarProduct = (item) => {\r\n    addToRecentSearches(item.productName);\r\n    getSearchDataKey(item.key, item.productCode)\r\n    navigate(`/product/${manageURl(item.productName)}?uid=${encodeURIComponent(encryptCategoryID(item.productCode))}`);\r\n    // handleClear();\r\n  }\r\n\r\n  const goToProductDetails = (item) => {\r\n    addToRecentSearches(item.productName);\r\n    getSearchDataKey(item.key, item.productCode)\r\n    navigate(`/product/${manageURl(item.productName)}?uid=${encodeURIComponent(encryptCategoryID(item.productCode))}`);\r\n    // handleClear();\r\n  }\r\n\r\n  const handleAddItem = (item) => {\r\n    dispatch(addItem(item))\r\n  };\r\n\r\n  const handleDelItem = (item) => {\r\n    dispatch(removeItem(item));\r\n    const cart = JSON.parse(localStorage.getItem(\"cart\")) || []; // Retrieve cart from localStorage\r\n    const updatedCart = cart.filter(cartItem => cartItem.productCode !== item.productCode); // Filter \r\n    localStorage.setItem(\"cart\", JSON.stringify(updatedCart))\r\n  };\r\n\r\n  const titleCase = str => str.toLowerCase().split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');\r\n  console.log(\"search product list\", list);\r\n\r\n  const handleRemoveTag = (index) => {\r\n    removeFromRecentSearches(index);\r\n  };\r\n\r\n  const handleClearAll = () => {\r\n    clearAllRecentSearches();\r\n  };\r\n\r\n  return (\r\n    <div className=\"search_page_cards\">\r\n      {list?.length === 0 && recentSearches?.length > 0 && (\r\n        <div className=\"recent_search_container\">\r\n          <div className=\"recent_search_header\">\r\n            <h4>Recent searches</h4>\r\n            <span className=\"clear_text\" onClick={handleClearAll}>clear</span>\r\n          </div>\r\n\r\n          <div className=\"recent_search_tags\">\r\n            {recentSearches.map((item, index) => (\r\n              <div key={index} className=\"recent_tag\">\r\n                <span\r\n                  className=\"tag_text\"\r\n                  onClick={() => setSearchInput(item)}\r\n                >\r\n                  {item}\r\n                </span>\r\n                <span\r\n                  className=\"tag_cancel\"\r\n                  onClick={() => handleRemoveTag(index)}\r\n                >\r\n                  <MdOutlineCancel />\r\n                </span>\r\n              </div>\r\n            ))}\r\n          </div>\r\n        </div>\r\n      )}\r\n      {initLoading ? (\r\n        <div className=\"search_skeleton\">\r\n          <Skeleton active />\r\n        </div>\r\n      ) : list.length === 0 ? (\r\n        <div className=\"no_results\">\r\n          {/* No products found */}\r\n        </div>\r\n      ) : (\r\n        <div>\r\n          <div className=\"search_suggestions\">\r\n            {suggestions.slice(0, 6).map((item, index) => (\r\n              <div\r\n                className=\"suggestion_item\"\r\n                key={index}\r\n                onClick={() => {\r\n                  setSearchInput(item)\r\n                  addToRecentSearches(item);\r\n                }}\r\n              >\r\n                <img src={BKDLogo} />\r\n                <span>{item}</span>\r\n              </div>\r\n            ))}\r\n          </div>\r\n\r\n          <div>{`Showing results for \"${debouncedSearchInput}\"`}</div>\r\n\r\n          <div className=\"showing_pro_by_cat\">\r\n            {list.map((item) => (\r\n              <div className=\"product_card\">\r\n                <Card\r\n                  hoverable\r\n                  disabled={item.stockQty == 0 && true}\r\n                >\r\n                  <div className=\"card_img\">\r\n                    {item.imageUrl !== null ?\r\n                      <img\r\n                        className={item.stockQty <= out_of_stock ? \"out_of_stock_img\" : \"\"}\r\n                        src={item.imageUrl || BKDLogo}\r\n                        onError={(e) => e.currentTarget.src = BKDLogo}\r\n                        onClick={() => GoToSimilarProduct(item)}\r\n                      />\r\n                      :\r\n                      <img\r\n                        className={item.stockQty <= out_of_stock ? \"out_of_stock_img\" : \"\"}\r\n                        src={BKDLogo}\r\n                        onClick={() => goToProductDetails(item)}\r\n                      />\r\n                    }\r\n\r\n                  </div>\r\n\r\n                  <div className=\"pro_name\" onClick={() => goToProductDetails(item)}>\r\n                    <Tooltip title={titleCase(item.productName)}>\r\n                      <p>{item.productName.length > 36 ? titleCase(item.productName.slice(0, 36)) + \"...\" : titleCase(item.productName)}</p>\r\n                    </Tooltip>\r\n                  </div>\r\n                  <div className=\"show_variant_item\" onClick={() => goToProductDetails(item)}>\r\n                    {item.packSize && item.packSize !== \"(NIL)\" ? <Tag color=\"green\">{item.packSize.substr(0, 10)}</Tag> : <p className=\"hidden_data\">N/A</p>}\r\n                    {item.stockQty <= out_of_stock ? <Tag color='red' className=\"stock_tag\">out of stock</Tag> : <p className='hidden_data'>N/A</p>}\r\n                  </div>\r\n                  <div className=\"show_price_mrp\">\r\n                    <p>BKD Price | MRP</p>\r\n                  </div>\r\n                  <div className=\"add_cart\">\r\n                    <p>{`₹ ${Math.round(item.bkdAmount)} `} <span>{item.bkdAmount != item.price && <del>₹ {item.price}</del>}</span> </p>\r\n\r\n                    {cartItems.find((cartItem) => cartItem.productCode === item.productCode) ? (\r\n                      cartItems.map((cartItem) => {\r\n                        if (cartItem.productCode === item.productCode) {\r\n                          return (\r\n                            <Button.Group className=\"add_to_carts\" size={screenWidth < 800 ? \"\" : 'small'} key={cartItem.productCode}>\r\n                              <Button className=\"add_to_carts add_to_cart_button\" onClick={() => handleDelItem(item)}>-</Button>\r\n                              <Button className=\"add_to_carts add_to_cart_button\">{cartItem.unit}</Button> {/* Access quantity from cart item */}\r\n                              <Button className=\"add_to_carts add_to_cart_button\" onClick={() => handleAddItem(item)}>+</Button>\r\n                            </Button.Group>\r\n                          );\r\n                        }\r\n                        return null;\r\n                      })\r\n                    ) : (\r\n                      <Button disabled={item.stockQty <= out_of_stock} type=\"default\" onClick={() => handleAddItem(item)}>ADD</Button>\r\n                    )}\r\n                  </div>\r\n                </Card>\r\n                {item.billingQty === \"PROMOTIONS\" || item.billingQty === \"DISCOUNT\" || item.offerQty === \"PROMOTIONS\" || item.offerQty === \"DISCOUNT\" ? <div className=\"discount_tags\">Super Saver Price</div> : item.billingQty != \"\" && item.offerQty != \"\" ?\r\n                  <div className=\"offer_Available\">\r\n                    {(item.billingQty === \"FOC\" || item.offerQty === \"FOC\") ?\r\n                      <>\r\n                        <img src={offerAvailable} />\r\n                        <div className=\"offer_types\">\r\n                          <p>1 Item</p>\r\n                          <p>Free </p>\r\n                          <p>On MRP</p>\r\n                        </div>\r\n                      </>\r\n                      :\r\n                      <img src={getOfferImage(item?.offerQty)} />\r\n                    }\r\n\r\n                  </div> : Math.round(item.bkdAmount) != item.price ? <div className=\"cat_tags\">{Math.round((item.price - item.bkdAmount) * 100 / item.price)}% off</div> : null}\r\n              </div>\r\n            ))}\r\n\r\n            {loading && (\r\n              <div className=\"scroll_load\">\r\n                <Spin />\r\n              </div>\r\n            )}\r\n            <div ref={lastProductElementRef} />\r\n          </div>\r\n        </div>\r\n      )}\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default SearchProduct;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\header\\SearchHeader.jsx",["866","867","868","869","870"],[],"import React, { useEffect, useRef, useState } from \"react\";\r\nimport { Col, Row } from \"react-bootstrap\";\r\nimport \"../../style/header.css\";\r\nimport Logo from \"../../assest/logo.png\";\r\nimport { Button, Card, Dropdown, Input } from \"antd\";\r\nimport CartMenu from \"../cart/CartMenu\";\r\nimport Login from \"../auth/Login\";\r\nimport UserMenu from \"./UserMenu\";\r\nimport { useNavigate } from \"react-router-dom\";\r\nimport axios from \"axios\";\r\nimport { SearchOutlined } from \"@ant-design/icons\";\r\nimport { useScreen } from \"../auth/AuthScreen\";\r\nimport { MdOutlineKeyboardBackspace } from \"react-icons/md\";\r\nimport SearchProduct from \"../home/SearchProduct\";\r\nimport { useAuth } from \"../auth/context/authContext\";\r\nfunction SearchHearder() {\r\n  const { screenWidth } = useScreen()\r\n  const { token } = useAuth()\r\n  const focusInput = useRef(null);\r\n  const navigate = useNavigate();\r\n  const [initLoading, setInitLoading] = useState(true);\r\n  const [scrolling, setScrolling] = useState(false);\r\n  const [searchInput, setSearchInput] = useState(\"\")\r\n  console.log(\"searchInput\", searchInput)\r\n\r\n  const handleScroll = () => {\r\n    if (window.scrollY > 50) {\r\n      setScrolling(true);\r\n    } else {\r\n      setScrolling(false);\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    window.addEventListener(\"scroll\", handleScroll);\r\n    return () => {\r\n      window.removeEventListener(\"scroll\", handleScroll);\r\n    };\r\n  }, []);\r\n  const navbarClass = scrolling\r\n    ? \"header_search header_scroll\"\r\n    : \"header_search\";\r\n  useEffect(() => {\r\n    if (focusInput.current) {\r\n      focusInput.current.focus();\r\n    }\r\n  }, [focusInput]);\r\n\r\n\r\n  const handleSearch = (e) => {\r\n    setSearchInput(e.target.value)\r\n    setInitLoading(true)\r\n  }\r\n\r\n  const handleClear = () => {\r\n    setSearchInput(\"\"); // Clear the input field\r\n  };\r\n\r\n\r\n  return (\r\n    <div className=\"searxh_section\">\r\n      <div className={`${screenWidth > 800 ? \"head\":\"nav_bar_search\"}`}>\r\n\r\n        <div className={navbarClass}>\r\n          <Row>\r\n            <Col md={2}>\r\n              {screenWidth > 800 ? <img src={Logo} onClick={() => navigate(\"/\")} className=\"search_logo\" /> : null}\r\n\r\n            </Col>\r\n            <Col md={8} sm={12}>\r\n              <div className=\"menu\">\r\n                <div className=\"searchsPro\">\r\n                  <Input\r\n                    allowClear\r\n                    value={searchInput}\r\n                    onChange={handleSearch}\r\n                    placeholder=\"Search for Product & Category\"\r\n                    prefix={screenWidth > 800 ? <SearchOutlined className=\"search_icon\" /> : <MdOutlineKeyboardBackspace className=\"search_icon\" onClick={() => navigate(-1)} />}\r\n                    onClear={handleClear} // Handle clear event\r\n                    ref={focusInput}\r\n                    variant=\"filled\"\r\n                  />\r\n                </div>\r\n              </div>\r\n            </Col>\r\n            <Col md={2}>\r\n              {screenWidth > 800 ? <div className=\"carts_sect\">\r\n\r\n                {!token ? (\r\n                  <div className=\"logins\">\r\n                    <Login />\r\n                  </div>\r\n                ) : (\r\n                  <div className=\"loggedUser\">\r\n                    <UserMenu />\r\n                  </div>\r\n                )}\r\n                <CartMenu />\r\n\r\n              </div> : null}\r\n\r\n            </Col>\r\n          </Row>\r\n        </div>\r\n      </div>\r\n\r\n      {/* Full page search content below header */}\r\n        <div className=\"search_page_content\">\r\n          <SearchProduct handleClear={handleClear} initLoading={initLoading} setInitLoading={setInitLoading} searchInput={searchInput} setSearchInput={setSearchInput} />\r\n        </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default SearchHearder;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\account\\wallet\\WallletCheckout.jsx",["871","872","873","874","875","876","877","878","879","880","881"],[],"import {\r\n  Alert,\r\n  Avatar,\r\n  Button,\r\n  Card,\r\n  Divider,\r\n  Form,\r\n  Input,\r\n  Radio,\r\n  Select,\r\n} from \"antd\";\r\nimport React, { useState } from \"react\";\r\nimport { Col, Collapse, Row } from \"react-bootstrap\";\r\nimport \"../../../style/account.css\";\r\nimport { useLocation, useNavigate } from \"react-router-dom\";\r\nimport LocationIcon from \"../../../assest/delivery.gif\";\r\nimport { AiOutlineEdit } from \"react-icons/ai\";\r\nimport OrderPlace from \"../../checkout/OrderPlace\";\r\nimport CardBg from \"../../../assest/cardBg.png\";\r\nfunction WallletCheckout({ sugar }) {\r\n  const [delOtp, setDelOtp] = useState(\"Home Delivery\");\r\n  const [delLocation, setDelLocation] = useState(null);\r\n  const [unit, setUnit] = useState(1);\r\n  const navigate = useNavigate();\r\n\r\n  const del_location = JSON.parse(sessionStorage?.getItem(\"location\"));\r\n\r\n  // const { display_name } = del_location;\r\n\r\n  const handleDelivery = (value) => {\r\n    setDelOtp(value);\r\n    console.log(value);\r\n  };\r\n  return (\r\n    <div className=\"container\">\r\n      <div className=\"sugar_check\">\r\n        <Row>\r\n          <Col md={12}>\r\n            <div className=\"wallet_card_bg\">\r\n              <img src={CardBg} />\r\n            <div className=\"sugar_wallet_data\">\r\n              <div className=\"sugar_ckeck_title\">\r\n                <p>BKD SUGAR WALLET</p>\r\n                <p>Total Sugar: {sugar} kg</p>\r\n              </div>\r\n              <div className=\"wollet_card_img\">\r\n                <img src=\"https://www.freepnglogos.com/uploads/sugar-png/sugar-png-transparent-images-pictures-photos-png-arts-26.png\" />\r\n              </div>\r\n            </div>\r\n            </div>\r\n          </Col>\r\n          <Col md={12}>\r\n            <div className=\"sug_chekc_option\">\r\n              <Form layout=\"vertical\">\r\n                <Row>\r\n                  <Col md={6}>\r\n                    <Form.Item\r\n                      label=\"Select Delivery \"\r\n                      name=\"delivery\"\r\n                      rules={[\r\n                        {\r\n                          required: true,\r\n                          message: \"Please input your username!\",\r\n                        },\r\n                      ]}\r\n                    >\r\n                      <Select\r\n                        placeholder=\"Select Delivery \"\r\n                        variant=\"filled\"\r\n                        onChange={handleDelivery}\r\n                        defaultValue={delOtp}\r\n                      >\r\n                        <Select.Option value=\"Store Pickup\">\r\n                          Store Pickup\r\n                        </Select.Option>\r\n                        <Select.Option value=\"Home Delivery\">\r\n                          Home Delivery\r\n                        </Select.Option>\r\n                      </Select>\r\n                    </Form.Item>\r\n                  </Col>\r\n                  <Col md={6}>\r\n                    <Form.Item\r\n                      label=\"Redeem Sugar Kg\"\r\n                      name=\"reddem\"\r\n                      rules={[\r\n                        {\r\n                          required: true,\r\n                          message: \"Please input your username!\",\r\n                        },\r\n                      ]}\r\n                    >\r\n                      <div className=\"sugar_unit_btn\">\r\n                        <Radio.Group>\r\n                          <Radio.Button\r\n                            value=\"large\"\r\n                            onClick={() => setUnit((pre) => pre - 1)}\r\n                            disabled={unit == 1}\r\n                          >\r\n                            -\r\n                          </Radio.Button>\r\n                          <Radio.Button value=\"default\">{unit}</Radio.Button>\r\n                          <Radio.Button\r\n                            value=\"small\"\r\n                            onClick={() => setUnit((pre) => pre + 1)}\r\n                            disabled={Math.floor(sugar) == unit}\r\n                          >\r\n                            +\r\n                          </Radio.Button>\r\n                          \r\n                        </Radio.Group>\r\n                      </div>\r\n                    </Form.Item>\r\n                  </Col>\r\n                </Row>\r\n              </Form>\r\n            </div>\r\n            {delOtp === \"Store Pickup\" ? (\r\n              <Form layout=\"vertical\">\r\n                <Row>\r\n                  <Col md={6}>\r\n                    <Form.Item\r\n                      label=\"Select Near Store\"\r\n                      value={delLocation}\r\n                      rules={[\r\n                        {\r\n                          required: true,\r\n                          message: \"Please Select the option delivery\",\r\n                        },\r\n                      ]}\r\n                    >\r\n                      {/* <Select\r\n                        style={{ width: \"100%\" }}\r\n                        placeholder=\"Select an option\"\r\n                        optionLabelProp=\"label\"\r\n                        //onChange={storeHandler}\r\n                      >\r\n                        {ShopData().map((option) => (\r\n                          <Select.Option\r\n                            key={option.id}\r\n                            value={option?.location}\r\n                            label={\r\n                              <div>\r\n                                <psna>{option?.title}</psna>\r\n                                {option?.location}\r\n                              </div>\r\n                            }\r\n                          >\r\n                            <div className=\"opt_img\">\r\n                              <span style={{ marginRight: \"8px\" }}>\r\n                                {option.location}\r\n                              </span>\r\n                              <span style={{ marginRight: \"8px\" }}>\r\n                                {option?.location}\r\n                              </span>\r\n                              <span style={{ marginRight: \"8px\" }}>\r\n                                {option?.dis}\r\n                              </span>\r\n                            </div>\r\n                          </Select.Option>\r\n                        ))}\r\n                      </Select> */}\r\n                    </Form.Item>\r\n                  </Col>\r\n                </Row>\r\n              </Form>\r\n            ) : (\r\n              <div className=\"delivery_adds\">\r\n                <Card\r\n                  bordered={false}\r\n                  title=\"Delivery Location\"\r\n                  extra={\r\n                    <AiOutlineEdit\r\n                      className=\"del_add_icon\"\r\n                      onClick={() => navigate(\"/account/address\")}\r\n                    />\r\n                  }\r\n                >\r\n                  <div className=\"del_adds\">\r\n                    <div className=\"del_add_img\">\r\n                      <Avatar\r\n                        src={LocationIcon}\r\n                        size=\"large\"\r\n                        className=\"del_address_image\"\r\n                      />\r\n                    </div>\r\n                    <div className=\"del_add_loc\">\r\n                      <p>Ami Raza</p>\r\n                      {/* <p>{display_name != {} && display_name}</p> */}\r\n                    </div>\r\n                  </div>\r\n                </Card>\r\n                <Alert\r\n                  message={\r\n                    <div className=\"del_chrg\">\r\n                      <p>Delivery Charge</p>\r\n                      <p>₹ 40</p>\r\n                    </div>\r\n                  }\r\n                  type=\"success\"\r\n                />\r\n              </div>\r\n            )}\r\n            <div className=\"sugar_place\">\r\n              <OrderPlace />\r\n            </div>\r\n          </Col>\r\n        </Row>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default WallletCheckout;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\account\\profile\\MyProfile.jsx",["882"],[],"\r\nimport React, { useEffect, useState } from \"react\";\r\nimport { Button, Card, Col, DatePicker, Form, Input, Row, Select, Skeleton, Upload, notification } from \"antd\";\r\nimport \"../../../style/account.css\";\r\nimport { GetUserProfile, UpdateUserProfile, genders } from \"../../apiService/api\";\r\nimport { useAuth } from \"../../auth/context/authContext\";\r\nimport dayjs from 'dayjs'; // Import Day.js\r\nimport customParseFormat from 'dayjs/plugin/customParseFormat'; // To handle custom date formats\r\n\r\ndayjs.extend(customParseFormat); // Extend dayjs with custom parse format\r\n\r\nfunction MyProfile() {\r\n  const [profileInfo, setProfileInfo] = useState(null);\r\n  const [isLoading, setIsLoading] = useState(false);\r\n  const [uploder, setUploader] = useState(null);\r\n  const [newImg, setNewImg] = useState(null);\r\n  const { token, CurrentUserInfo, logout } = useAuth();\r\n  const [form] = Form.useForm();\r\n  const [formData, setFormData] = useState(new FormData());\r\n  const [updated, setUpdated] = useState(false);\r\n  const [dob, setDob] = useState(null);\r\n  const [isSubmit, setIsSubmit] = useState(false)\r\n\r\n  const ShowProfileInfo = async () => {\r\n    try {\r\n      const res = await GetUserProfile(token);\r\n      // console.log(\"user profile\", res);\r\n      if (res.status === 200) {\r\n        setProfileInfo(res.data.data);\r\n        setIsLoading(true);\r\n        CurrentUserInfo(res.data.data);\r\n        localStorage.setItem(\"userData\", JSON.stringify(res.data.data));\r\n\r\n        // Format DOB with dayjs\r\n        const formattedDob = res.data.data.dob ? dayjs(res.data.data.dob, \"DD/MM/YYYY\") : null;\r\n        setDob(formattedDob); // Save DOB as a dayjs object\r\n\r\n        form.setFieldsValue({\r\n          fullName: res.data.data.fullName,\r\n          mobileNo: res.data.data.mobileNo,\r\n          email: res.data.data.email || \"\",\r\n          dob: formattedDob || \"\", // Set DOB in the form\r\n          gender: res.data.data.gender || \"\",\r\n        });\r\n      } else if (res.status === 283) {\r\n        notification.error({\r\n          placement: \"topRight\",\r\n          message: res.data.message,\r\n        });\r\n        logout()\r\n      }\r\n    } catch (error) {\r\n      console.log(error);\r\n      setIsLoading(true);\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    ShowProfileInfo();\r\n  }, [updated]);\r\n\r\n  const onReset = () => {\r\n    form.resetFields();\r\n  };\r\n\r\n  const handlerImage = (file) => {\r\n    console.log(file);\r\n    setNewImg(file.file);\r\n    setUploader(file.fileList);\r\n  };\r\n  console.log(\"newImg\", newImg)\r\n\r\n  const onFinish = async (value) => {\r\n    setIsSubmit(true)\r\n    try {\r\n      if (newImg) formData.append(\"profilePic\", newImg);\r\n      formData.append(\"fullName\", value.fullName);\r\n      formData.append(\"email\", value.email || \"\");\r\n      formData.append(\"dob\", dob ? dob.format(\"DD/MM/YYYY\") : \"\"); // Format DOB for API using Day.js\r\n      formData.append(\"gender\", value.gender || \"\");\r\n      const res = await UpdateUserProfile(token, formData);\r\n      // console.log(\"user profile\", res);\r\n      if (res.status === 201) {\r\n        notification.success({\r\n          placement: \"topRight\",\r\n          message: res.data.message,\r\n        });\r\n        setFormData(new FormData());\r\n        onReset();\r\n        setIsLoading(true);\r\n        ShowProfileInfo();\r\n        setUpdated(true);\r\n        setUploader(null);\r\n        setNewImg(null);\r\n        setIsSubmit(false)\r\n\r\n      } if (res.status === 200) {\r\n        notification.warning({\r\n          placement: \"topRight\",\r\n          message: res.data.message,\r\n        });\r\n      }\r\n    } catch (error) {\r\n      console.log(error);\r\n      setIsLoading(true);\r\n      setFormData(new FormData());\r\n      setIsSubmit(false)\r\n\r\n    }\r\n  };\r\n\r\n  const onFinishFailed = (errorInfo) => {\r\n    console.log(\"Failed:\", errorInfo);\r\n  };\r\n\r\n  const handelDateChange = (date) => {\r\n    setDob(date); // Keep dob as dayjs object\r\n  };\r\n\r\n  return (\r\n    <div className=\"pro_form\">\r\n      <Card title=\"My Profile\">\r\n        {!isLoading ? (\r\n          <Skeleton active avatar={{ shape: 'circle' }} title={false} paragraph={{ rows: 6 }} />\r\n        ) : (\r\n          <Form\r\n            form={form}\r\n            name=\"basic\"\r\n            layout=\"vertical\"\r\n            initialValues={{\r\n              dob: dob, // Ensure initialValues uses dayjs\r\n            }}\r\n            onFinish={onFinish}\r\n            onFinishFailed={onFinishFailed}\r\n            autoComplete=\"off\"\r\n          >\r\n            <div className=\"profile_image\">\r\n              <Form.Item name=\"profilePic\">\r\n                <Upload\r\n                  multiple={false}\r\n                  listType=\"picture-circle\"\r\n                  beforeUpload={() => false} // Prevent automatic upload\r\n                  accept=\"image/*\"\r\n                  onChange={handlerImage}\r\n                >\r\n                  {uploder?.length !== 1 ? profileInfo?.profilePic ?\r\n                    <img src={profileInfo.profilePic} style={{ objectFit: \"cover\" }} alt=\"Profile\" />\r\n                    :\r\n                    <img src=\"https://www.generationsforpeace.org/wp-content/uploads/2018/03/empty.jpg\" alt=\"Default\" />\r\n                    : null}\r\n                </Upload>\r\n              </Form.Item>\r\n            </div>\r\n\r\n            <Row gutter={16}>\r\n              <Col span={12}>\r\n                <Form.Item\r\n                  label=\"Name\"\r\n                  name=\"fullName\"\r\n                  rules={[{ required: true, message: \"Please enter your fullName!\" }]}\r\n                >\r\n                  <Input placeholder=\"Enter your fullName\" />\r\n                </Form.Item>\r\n              </Col>\r\n              <Col span={12}>\r\n                <Form.Item\r\n                  label=\"Email\"\r\n                  name=\"email\"\r\n                  rules={[\r\n                    {\r\n                      type: 'email',\r\n                      message: 'Please Enter Valid Email!',\r\n                    },\r\n\r\n                  ]}\r\n                // rules={[{ required: true, message: \"Please Enter Your Email\" }]}\r\n                >\r\n                  <Input placeholder=\"Enter Email\" />\r\n                </Form.Item>\r\n              </Col>\r\n            </Row>\r\n\r\n            <Row gutter={16}>\r\n              <Col span={12}>\r\n                <Form.Item\r\n                  label=\"Mobile No.\"\r\n                  name=\"mobileNo\"\r\n                  rules={[{ required: true, message: \"Please Enter your Mobile Number!\" }]}\r\n                >\r\n                  <Input placeholder=\"Enter Mobile No\" disabled />\r\n                </Form.Item>\r\n              </Col>\r\n              <Col span={12}>\r\n                <Form.Item\r\n                  name=\"gender\"\r\n                  label=\"Select Gender\"\r\n                // rules={[{ required: true, message: \"Please choose Gender!\" }]}\r\n                >\r\n                  <Select placeholder=\"Select Gender\">\r\n                    {genders.map((item) => (\r\n                      <Select.Option value={item.values} key={item.key}>\r\n                        {item.values}\r\n                      </Select.Option>\r\n                    ))}\r\n                  </Select>\r\n                </Form.Item>\r\n              </Col>\r\n            </Row>\r\n\r\n            <Row gutter={16}>\r\n              <Col span={12}>\r\n                <Form.Item\r\n                  name=\"dob\"\r\n                  label=\"Select DOB\"\r\n\r\n                // rules={[{ required: true, message: \"Please choose DOB!\" }]}\r\n                >\r\n                  <DatePicker\r\n                    onChange={handelDateChange}\r\n                    format=\"DD/MM/YYYY\"\r\n                    placeholder=\"Select DOB\"\r\n                    style={{ width: \"100%\" }}\r\n                    value={dob} // Ensure the DatePicker shows the correct value\r\n                  />\r\n                </Form.Item>\r\n              </Col>\r\n            </Row>\r\n\r\n            <Form.Item>\r\n              <div className=\"profile_tbn\">\r\n                <Button loading={isSubmit} type=\"primary\" htmlType=\"submit\">\r\n                  Submit\r\n                </Button>\r\n              </div>\r\n            </Form.Item>\r\n          </Form>\r\n        )}\r\n      </Card>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default MyProfile;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\checkout\\CheckOutProduct.jsx",["883","884","885","886","887","888","889","890","891","892","893","894","895","896","897","898","899","900","901","902","903","904","905","906","907","908","909","910","911"],[],"import React, { useEffect, useState } from \"react\"\r\nimport \"../../style/checkout.css\";\r\nimport { Alert, Avatar, Button, Card, Col, Form, Input, List, message, Modal, notification, Popover, Radio, Result, Row, Select, Skeleton, Space, Steps, Tag, Typography } from \"antd\";\r\nimport { MdKeyboardBackspace, MdOutlineHome, MdOutlineHomeWork, MdOutlineLocationOn } from \"react-icons/md\";\r\nimport { useNavigate } from \"react-router-dom\";\r\nimport { CloseOutlined } from \"@ant-design/icons\";\r\nimport { addProduct, selectDeliveryCharge, selectDeliveryLocation, selectDeliveryStore, selectDiscount, selectDiscountAmount, selectPayableAmount, selectPaymentMode, selectSelectedCoupon, selectSlot, selectTotalSaveAmount, setActualAmount, setDeliveryCahrge, setDeliveryLocation, setDeliveryType, setDiscountAmount, setDiscountDetails, setPayableAmount, setPaymentMode, setSelectedCoupon, setSelectedStore, setSlotDetails, setSubTotalAmount } from \"../../redux/OrderSlice\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { AddAddress, fetchAutoOfferApplyCart, fetchDeliveryCharge, fetchHomeDeliverySlot, fetchStorePickupSlot, fetchUpdateCarts, GetNearBranch, GetSaveLocation, PlaceOurOrder, validateCoupon } from \"../apiService/api\";\r\nimport { useAuth } from \"../auth/context/authContext\";\r\nimport { addAutoApplyOffer, addItem, clearCart, removeItem, selectCartItems, selectedBillingQty, selectMrpTotalAmount, selectTotalAmount, setCartItem, setSelctedOffer, updateCartRemoveItem } from \"../../redux/CartSlice\";\r\nimport BKDLogo from \"../../assest/bkdlogo.png\"\r\nimport DefaultImage from \"../../assest/png/default_img.jpg\"\r\nimport NotImage from \"../../assest/png/notdeliverd.png\"\r\nimport { calculateOfferDistribution } from \"../cart/CartMenu\";\r\nimport { IoInformationCircleOutline } from \"react-icons/io5\";\r\nimport { RiCoupon3Line, RiDeleteBinLine } from \"react-icons/ri\";\r\nimport { Discount } from \"../../config/common\";\r\nimport CouponModal from \"../../kit/CouponModal/CouponModal\";\r\nimport ShopCards from \"../cart/ShopCards\";\r\nimport ShowMoreText from 'react-show-more-text';\r\nimport ShowMap from \"../cart/ShowMap\";\r\nimport axios from \"axios\";\r\nimport dayjs from \"dayjs\";\r\nimport { useCurrentLocation, useScreen } from \"../auth/AuthScreen\";\r\nimport OrderPlace from \"./OrderPlace\";\r\nimport { encryptCategoryID } from \"../../config/encriptConfig\";\r\nimport ClearAllModal from \"../../kit/ClearAllModal/ClearAllModal\";\r\nimport { buildCouponProductInfo, getCouponAppliedDiscount, useAutoRemoveInvalidCoupon } from \"../../utils/couponUtils\";\r\n\r\nconst { Text, Title } = Typography;\r\n\r\nconst addressType = [\r\n  {\r\n    id: 1,\r\n    title: \"HOME\",\r\n    icon: <MdOutlineHome />\r\n  },\r\n  {\r\n    id: 2,\r\n    title: \"OFFICE\",\r\n    icon: <MdOutlineHomeWork />\r\n\r\n  },\r\n  {\r\n    id: 2,\r\n    title: \"OTHERS\",\r\n    icon: <MdOutlineLocationOn />\r\n\r\n  },\r\n]\r\n\r\nfunction NewCheckOutProduct() {\r\n  const { logout, token, nearStore } = useAuth()\r\n  const navigate = useNavigate()\r\n  const dispatch = useDispatch()\r\n  const [form] = Form.useForm();\r\n  const { screenWidth } = useScreen()\r\n  const isMobile = screenWidth < 800\r\n\r\n  const [isCheckCart, setIsCheckCart] = useState(false)\r\n  const [deliveryTypes, setDeliveryTypes] = useState(\"\");\r\n  const [currentStep, setCurrentStep] = useState(-1);\r\n  const [deliveryOpt, setDeliveryOtp] = useState(\"DELIVERY\");\r\n  const [saveAddress, setSaveAddress] = useState([])\r\n  const [isAddressLoading, setIsAddressLoading] = useState(false)\r\n  const [isCouponModalOpen, setIsCouponModalOpen] = useState(false);\r\n  const [isRemoveOpen, setIsRemoveOpen] = useState(false);\r\n  const [isClearAllOpen, setIsClearAllOpen] = useState(false);\r\n  const [couponInput, setCouponInput] = useState(\"\");\r\n  const [wolletvalue, setsetWolletValue] = useState(null);\r\n  const [value, setValue] = useState(null);\r\n  const [isModalOpen, setIsModalOpen] = useState(false);\r\n  const [cartItemStockOut, setCartItemStockOut] = useState([])\r\n  const [saveAmount, setSaveAmount] = useState(0)\r\n  const [showUpdateBtn, setShowUpdateBtn] = useState(false)\r\n  const [updateCartData, setUpdateCartData] = useState([])\r\n  const [selectedSlotData, setSelectSlotData] = useState(null);\r\n  const [selectedSlot, setSelectedSlot] = useState(null);\r\n  const [isLoading, setIsLoading] = useState(false)\r\n  const [disabledButtons, setDisabledButtons] = useState({});\r\n  const [addTypes, setAddsType] = useState(\"\")\r\n  const [lat, setLat] = useState(\"\")\r\n  const [lng, setLng] = useState(\"\")\r\n  const [alerts, setAlerts] = useState(false)\r\n  const [formAddressLoader, setFormAddressLoader] = useState(false)\r\n  const [pinLocation, setPinLocation] = useState([])\r\n  const [noService, setNoService] = useState(null)\r\n  const [currentSlots, setCurrentSlots] = useState([]);\r\n  const [sloteData, setSlotData] = useState([])\r\n  const [isSlotLoader, setIsSlotLoader] = useState(false)\r\n  const [orderPlaceData, setOrderPlaceData] = useState(null)\r\n  const [orderPlaced, setOrderPlaced] = useState(false)\r\n  const [selectedShop, setSelectedShop] = useState(false)\r\n  const [selectedId, setSelectedId] = useState()\r\n  const [isAddressSkipped, setIsAddressSkipped] = useState(false);\r\n  const [isValidating, setIsValidating] = useState(false);\r\n\r\n  const cartItems = useSelector(selectCartItems);\r\n  const selectedBilQty = useSelector(selectedBillingQty);\r\n  const MrpTotalAmount = useSelector(selectMrpTotalAmount);\r\n  const totalAmount = useSelector(selectTotalAmount);\r\n  const deliveryCharge = useSelector(selectDeliveryCharge)\r\n  const selectCoupon = useSelector(selectSelectedCoupon);\r\n  const payableAmount = useSelector(selectPayableAmount);\r\n  const payMode = useSelector(selectPaymentMode)\r\n  const selectedDeliveryStore = useSelector(selectDeliveryStore)\r\n  const selectedDiscount = useSelector(selectDiscount);\r\n  const discountAmount = useSelector(selectDiscountAmount);\r\n  const totalSaveAmount = useSelector(selectTotalSaveAmount)\r\n  const deliveryLocation = useSelector(selectDeliveryLocation)\r\n  const newSelectedSlot = useSelector(selectSlot)\r\n  const { userLocation } = useCurrentLocation()\r\n\r\n  useAutoRemoveInvalidCoupon({\r\n    token,\r\n    selectedCoupon: selectCoupon,\r\n    cartAmount: totalAmount,\r\n    cartItems,\r\n    notifyOnRemove: false,\r\n  });\r\n\r\n  const capitalize = (str) => str.slice(0).toLowerCase();\r\n  const titleCase = str => str.toLowerCase().split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');\r\n  const toggleModalDrawer = () => setIsCouponModalOpen(!isCouponModalOpen)\r\n  const toggleClearAllModal = () => setIsClearAllOpen(!isClearAllOpen)\r\n  const toggleRemoveModal = () => setIsRemoveOpen(!isRemoveOpen)\r\n\r\n  const getSloteList = deliveryOpt === \"DELIVERY\" ? fetchHomeDeliverySlot : fetchStorePickupSlot\r\n\r\n  const onSelectCoupon = (coupon) => {\r\n    dispatch(setSelectedCoupon(coupon));\r\n    setIsCouponModalOpen(false);\r\n  };\r\n\r\n  const handleRemove = (productCode) => {\r\n    setSelectedId(productCode)\r\n    toggleRemoveModal();\r\n  };\r\n\r\n  const handleClearAll = () => {\r\n    toggleClearAllModal();\r\n  };\r\n\r\n  const handleOk = () => {\r\n    dispatch(clearCart())\r\n    toggleClearAllModal()\r\n  };\r\n\r\n  const handleRemoveItem = () => {\r\n    dispatch(updateCartRemoveItem({ productCode: selectedId }))\r\n    toggleRemoveModal()\r\n  };\r\n\r\n  const handleSelectDelivyType = (value) => {\r\n    localStorage.setItem(\"orderType\", value)\r\n    dispatch(setSlotDetails(null))\r\n    localStorage.removeItem(\"selected_slot\")\r\n    dispatch(setDeliveryType(value));\r\n    setDeliveryOtp(value)\r\n\r\n    if (value === \"PICKUP\") {\r\n      dispatch(setDeliveryCahrge(0))\r\n      localStorage.setItem(\"updatedeliveryCharge\", 0);\r\n    }\r\n  };\r\n\r\n  const showBranchDetails = async (lat, lng) => {\r\n    const body = {\r\n      longitude: lng,\r\n      latitude: lat\r\n    }\r\n    setIsAddressLoading(true)\r\n\r\n    try {\r\n      await GetNearBranch(body)\r\n        .then((res) => {\r\n          if (res.status == 200) {\r\n            localStorage.setItem(\"selected_Store\", JSON.stringify(res.data.data));\r\n            dispatch(setSelectedStore(res.data.data));\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          message.error(err);\r\n        });\r\n    } catch (error) {\r\n      message.error(error);\r\n    } finally {\r\n      setIsAddressLoading(false)\r\n    }\r\n  };\r\n\r\n  const ShowSaveAddress = async () => {\r\n    setIsAddressLoading(true)\r\n    try {\r\n      const res = await GetSaveLocation(token);\r\n\r\n      if (res.status == 200) {\r\n        setSaveAddress(res.data.data);\r\n        return res.data.data;\r\n      } else if (res.status === 283) {\r\n        logout();\r\n        notification.success({\r\n          placement: \"topRight\",\r\n          message: \"Token Expire\",\r\n        });\r\n      }\r\n    } catch (error) {\r\n      message.error(error);\r\n    } finally {\r\n      setIsAddressLoading(false);\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    // Initialize values from localStorage/Redux store\r\n    const savedOrderType = localStorage.getItem(\"orderType\") || \"DELIVERY\";\r\n    const savedPaymentMode = localStorage.getItem(\"payment_mode\");\r\n    const savedDeliveryLocation = JSON.parse(localStorage.getItem(\"delivery_location\"));\r\n\r\n    setDeliveryOtp(savedOrderType);\r\n    dispatch(setDeliveryType(savedOrderType));\r\n\r\n    if (savedPaymentMode) {\r\n      setsetWolletValue(savedPaymentMode);\r\n      dispatch(setPaymentMode(savedPaymentMode));\r\n    }\r\n\r\n    if (savedDeliveryLocation) {\r\n      setValue(savedDeliveryLocation._id);\r\n      dispatch(setDeliveryLocation(savedDeliveryLocation));\r\n    }\r\n\r\n    ShowSaveAddress()\r\n    dispatch(setSubTotalAmount(totalAmount))\r\n    dispatch(addProduct(cartItems))\r\n  }, [])\r\n\r\n\r\n  useEffect(() => {\r\n    if (cartItems.length === 0) {\r\n      navigate('/');\r\n    }\r\n    localStorage.setItem(\"cart\", JSON.stringify(cartItems));\r\n  }, [cartItems]);\r\n\r\n  const handleReduceItem = (item) => {\r\n    dispatch(removeItem(item));\r\n    if (selectedBilQty >= item?.unit) {\r\n      dispatch(setSelctedOffer(null))\r\n    }\r\n\r\n    const cart = JSON.parse(localStorage.getItem(\"cart\")) || []; // Retrieve cart from localStorage\r\n    const updatedCart = cart.filter(cartItem => cartItem.productCode !== item.productCode); // Filter out the item to be removed\r\n    localStorage.setItem(\"cart\", JSON.stringify(updatedCart))\r\n  };\r\n\r\n  const handleAddItem = (item) => {\r\n    dispatch(addItem(item));\r\n    localStorage.setItem(\"cart\", JSON.stringify(item))\r\n  };\r\n\r\n  const handleRemoveCoupon = () => {\r\n    dispatch(setSelectedCoupon(null));\r\n  }\r\n\r\n  const loadDeliveryCharge = async () => {\r\n    if (deliveryOpt === \"PICKUP\") {\r\n      dispatch(setDeliveryCahrge(0));\r\n      localStorage.setItem(\"updatedeliveryCharge\", 0);\r\n      return;\r\n    }\r\n\r\n    try {\r\n      const res = await fetchDeliveryCharge(deliveryOpt);\r\n      if (res.status === 200) {\r\n        const charge = res.data.data.deliveryCharge;\r\n        const minCart = res.data.data.freeDeliveryMaxCart;\r\n\r\n        let finalCharge = totalAmount < minCart ? charge : 0;\r\n\r\n        dispatch(setDeliveryCahrge(finalCharge));\r\n        localStorage.setItem(\"updatedeliveryCharge\", finalCharge);\r\n      }\r\n    } catch (err) {\r\n      message.error(err);\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    loadDeliveryCharge();\r\n  }, [deliveryOpt, totalAmount]);\r\n\r\n  useEffect(() => {\r\n    if (selectCoupon?.minCartAmount < totalAmount && selectCoupon?.discountType === Discount.FREE_DELIVERY) {\r\n      dispatch(setDeliveryCahrge(0))\r\n    }\r\n  }, [selectCoupon])\r\n\r\n  useEffect(() => {\r\n    if (payableAmount <= selectedDiscount?.details?.minCartAmount) {\r\n      dispatch(setDiscountDetails(null))\r\n      dispatch(setDiscountAmount(0))\r\n    }\r\n  }, [(payableAmount + discountAmount) <= selectedDiscount?.details?.minCartAmount])\r\n\r\n  useEffect(() => {\r\n    let save = (+MrpTotalAmount - +totalAmount) + +discountAmount\r\n    setSaveAmount(save)\r\n  }, [discountAmount, totalSaveAmount])\r\n\r\n  useEffect(() => {\r\n    if (selectedDiscount?.details != null) {\r\n      return;\r\n    }\r\n\r\n    const couponDiscount = selectCoupon ? getCouponAppliedDiscount(selectCoupon, totalAmount) : 0;\r\n    const finalDeliveryCharge = deliveryOpt === \"PICKUP\" ? 0 : Number(deliveryCharge || 0);\r\n\r\n    dispatch(setDiscountAmount(+couponDiscount.toFixed(2)))\r\n    dispatch(setPayableAmount(+((totalAmount - couponDiscount + finalDeliveryCharge).toFixed(2))))\r\n  }, [dispatch, selectCoupon, totalAmount, deliveryCharge, deliveryOpt, selectedDiscount?.details])\r\n\r\n  const handleApplyCouponMain = async () => {\r\n    if (!couponInput.trim()) {\r\n      message.error(\"Please enter a coupon code\");\r\n      return;\r\n    }\r\n\r\n    setIsValidating(true);\r\n    try {\r\n      const res = await validateCoupon(token, {\r\n        couponCode: couponInput.trim(),\r\n        cartAmount: totalAmount,\r\n        productInfo: buildCouponProductInfo(cartItems)\r\n      });\r\n      if (res.status === 200) {\r\n        dispatch(setSelectedCoupon(res.data.data));\r\n        message.success(\"Coupon Applied Successfully!\");\r\n        setCouponInput(\"\")\r\n      }\r\n    } catch (err) {\r\n      message.error(err?.response?.data?.message || \"Invalid coupon code\");\r\n    } finally {\r\n      setIsValidating(false);\r\n    }\r\n  };\r\n\r\n  const onChangeWollet = (e) => {\r\n    setsetWolletValue(e.target.value);\r\n    dispatch(setPaymentMode(e.target.value))\r\n    localStorage.setItem(\"payment_mode\", e.target.value)\r\n  };\r\n\r\n  const onChange = (e) => {\r\n    const addressId = e.target.value;\r\n    setValue(addressId);\r\n    const selectedAddress = saveAddress.find((item) => item._id === addressId);\r\n    dispatch(setDeliveryLocation(selectedAddress))\r\n    localStorage.setItem(\"delivery_location\", JSON.stringify(selectedAddress))\r\n    const [lng, lat] = selectedAddress.location.coordinates\r\n    showBranchDetails(lat, lng)\r\n\r\n    dispatch(setSlotDetails(null))\r\n    localStorage.removeItem(\"selected_slot\")\r\n  };\r\n\r\n  function executeOnClick(isExpanded) {\r\n    console.log(isExpanded);\r\n  }\r\n\r\n  //check updated cart or not \r\n  const updateCartbody = cartItems?.map(product => {\r\n    return {\r\n      productCode: product.productCode,\r\n      quantity: product.unit,\r\n      isDeliveryChargeAllowed: product.isDeliveryChargeAllowed,\r\n      imageUrl: product.imageUrl,\r\n      productPrice: product.bkdAmount,\r\n      categoryName: product.categoryName,\r\n      categoryID: product.categoryID,\r\n      brandName: product.brandName,\r\n      brandID: product.brandID,\r\n      mrpPrice: product.price,\r\n      requiredOfferedBillingQty: product?.selected_offer ? product?.selected_offer?.billingQty : 0,\r\n      requiredOfferedBillingPrice: product.selected_offer ? product.selected_offer?.comboPrice : 0,\r\n      isRefridgerator: product?.isRefridgerator,\r\n      isPoolProduct: product?.isPoolProduct,\r\n      nonReturnable: product?.nonReturnable,\r\n      nonReplaceable: product?.nonReplaceable,\r\n      offerProduct: product?.selected_offer != null ? {\r\n        productCode: product?.selected_offer?.productCode,\r\n        mrpPrice: product?.selected_offer?.price,\r\n        quantity: product?.selected_offer?.OfferQty,\r\n        offerName: product?.selected_offer?.offerName,\r\n        offerId: product?.selected_offer?.offerId,\r\n        isRefridgerator: product?.selected_offer?.isRefridgerator,\r\n      } : null\r\n    };\r\n  }, [])\r\n\r\n  const getUserIP = async () => {\r\n    try {\r\n      const res = await fetch(\"https://api64.ipify.org?format=json\");\r\n      const data = await res.json();\r\n      return data.ip;\r\n    } catch {\r\n      return \"\";\r\n    }\r\n  };\r\n\r\n  const handlePlaceOrder = async () => {\r\n    const values = form.getFieldsValue(true);\r\n    const userIp = await getUserIP();\r\n\r\n    if (payMode == null) {\r\n      notification.error({\r\n        placement: \"topRight\",\r\n        message: \"Please Select Payment Mode\",\r\n      });\r\n      return;\r\n    }\r\n\r\n    const bodyProduct = cartItems.flatMap((product) => {\r\n      const isOffer = product?.selected_offer;\r\n\r\n      // ✅ No offer → normal flow\r\n      if (!isOffer) {\r\n        return [{\r\n          productCode: product.productCode,\r\n          quantity: product.unit,\r\n          isDeliveryChargeAllowed: product.isDeliveryChargeAllowed,\r\n          productPrice: product.bkdAmount,\r\n          categoryName: product.categoryName,\r\n          categoryID: product.categoryID,\r\n          brandName: product.brandName,\r\n          brandID: product.brandID,\r\n          mrpPrice: product.price,\r\n          requiredOfferedBillingQty: product.unit,\r\n          requiredOfferedBillingPrice: product.bkdAmount,\r\n          isRefridgerator: product?.isRefridgerator,\r\n          isPoolProduct: product?.isPoolProduct,\r\n          nonReturnable: product?.nonReturnable,\r\n          nonReplaceable: product?.nonReplaceable,\r\n          offerProduct: null\r\n        }];\r\n      }\r\n\r\n      // const [buy, free] = isOffer?.promoType?.split('+').map(Number);\r\n\r\n      // const billingQty = buy;\r\n      // const offerQty = free;\r\n\r\n      const billingQty = isOffer.billingQty; // e.g. 1,2,3\r\n      const offerQty = parseInt(isOffer?.promoType?.split('+')[1] || '0'); // e.g. 1,2,3\r\n\r\n      const cycleSize = billingQty + offerQty;\r\n      const totalQty = product.unit;\r\n\r\n      const completeCycles = Math.floor(totalQty / cycleSize);\r\n      const remainder = totalQty % cycleSize;\r\n\r\n      const result = [];\r\n\r\n      // ✅ OFFER PART (cycles)\r\n      if (completeCycles > 0) {\r\n        result.push({\r\n          productCode: product.productCode,\r\n          quantity: completeCycles * cycleSize,\r\n          isDeliveryChargeAllowed: product.isDeliveryChargeAllowed,\r\n          productPrice: product.bkdAmount,\r\n          categoryName: product.categoryName,\r\n          categoryID: product.categoryID,\r\n          brandName: product.brandName,\r\n          brandID: product.brandID,\r\n          mrpPrice: product.price,\r\n          requiredOfferedBillingQty: completeCycles * billingQty,\r\n          requiredOfferedBillingPrice: product.price,\r\n          isRefridgerator: product?.isRefridgerator,\r\n          isPoolProduct: product?.isPoolProduct,\r\n          nonReturnable: product?.nonReturnable,\r\n          nonReplaceable: product?.nonReplaceable,\r\n          offerProduct: {\r\n            productCode: isOffer?.productCode,\r\n            mrpPrice: isOffer?.price,\r\n            quantity: completeCycles * offerQty,\r\n            offerName: isOffer?.offerName,\r\n            offerId: isOffer?.offerId,\r\n            isRefridgerator: isOffer?.isRefridgerator,\r\n          }\r\n        });\r\n      }\r\n\r\n      // ✅ REMAINING (non-offer part)\r\n      if (remainder > 0) {\r\n        result.push({\r\n          productCode: product.productCode,\r\n          quantity: remainder,\r\n          isDeliveryChargeAllowed: product.isDeliveryChargeAllowed,\r\n          productPrice: product.bkdAmount,\r\n          categoryName: product.categoryName,\r\n          categoryID: product.categoryID,\r\n          brandName: product.brandName,\r\n          brandID: product.brandID,\r\n          mrpPrice: product.price,\r\n          requiredOfferedBillingQty: remainder,\r\n          requiredOfferedBillingPrice: product.bkdAmount,\r\n          isRefridgerator: product?.isRefridgerator,\r\n          isPoolProduct: product?.isPoolProduct,\r\n          nonReturnable: product?.nonReturnable,\r\n          nonReplaceable: product?.nonReplaceable,\r\n          offerProduct: null\r\n        });\r\n      }\r\n\r\n      return result;\r\n    });\r\n\r\n    setIsLoading(true)\r\n    const body = {\r\n      branchCode: nearStore.branchCode,\r\n      branchId: nearStore._id,\r\n      userLocationId: deliveryOpt !== \"DELIVERY\" ? \"\" : deliveryLocation._id,\r\n      paymentMode: payMode,\r\n      deliveryOption: deliveryOpt,\r\n      alternativeCustomerName: values.fullName,\r\n      alternativeMobileNo: values.alertnativeMobileNo,\r\n      deliveryDate: newSelectedSlot?.details ? newSelectedSlot?.details?.selected_date?.availableSlotDate : selectedSlotData?.availableSlotDate,\r\n      discountId: selectedDiscount?.details?._id || \"\",\r\n      branchSlotId: newSelectedSlot?.details ? newSelectedSlot?.details?.selected_slot?._id : selectedSlot?._id,\r\n\r\n      totalSaving: saveAmount !== 0 ? +(saveAmount).toFixed(2) : 0,\r\n      mrpTotalProductAmount: MrpTotalAmount,\r\n      totalProductAmount: +totalAmount?.toFixed(2),\r\n      discountAmount: +discountAmount || 0,\r\n      totalActualAmount: payableAmount,\r\n      deliveryCharge: deliveryOpt === \"PICKUP\" ? 0 : deliveryCharge,\r\n      totalPayableAmount: Math.round(payableAmount),\r\n      productInfo: bodyProduct,\r\n      selectedCoupon: {\r\n        _id: selectCoupon?._id,\r\n        couponCode: selectCoupon?.couponCode,\r\n        discountType: selectCoupon?.discountType,\r\n        discountValueType: selectCoupon?.discountValueType,\r\n        discountValue: selectCoupon?.discountValue,\r\n        minCartAmount: selectCoupon?.minCartAmount,\r\n      },\r\n      orderinfoDetails: {\r\n        userLocation: {\r\n          latitude: userLocation?.geometry?.location?.lat,\r\n          longitude: userLocation?.geometry?.location?.lng,\r\n        },\r\n        userIp,\r\n        timeOfUserDevice: new Date().toISOString(),\r\n        browserDetails: {\r\n          userAgent: navigator.userAgent,\r\n          platform: navigator.platform,\r\n          language: navigator.language,\r\n        },\r\n      }\r\n    }\r\n    // setIsLoading(false)\r\n    // console.log(\"====orderDetails\", body);\r\n    // console.log(\"====orderDetailsBody\", JSON.stringify(body));\r\n\r\n    try {\r\n      await PlaceOurOrder(token, body)\r\n        .then((res) => {\r\n          if (res.status == 201) {\r\n            const payUrl = res.data.data.payment_links?.web\r\n            if (payUrl) {\r\n              // window.close();\r\n              // window.open(payUrl);\r\n              window.location.href = payUrl;\r\n\r\n            } else {\r\n              setOrderPlaceData(res.data)\r\n              setOrderPlaced(true)\r\n              setIsLoading(false)\r\n            }\r\n            onReset()\r\n            handleRemoveCoupon()\r\n            setIsLoading(false)\r\n          } else if (res.status == 200) {\r\n            setIsLoading(false)\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          message.error(err);\r\n        }).finally(() => {\r\n          setIsLoading(false)\r\n\r\n        });\r\n    } catch (error) {\r\n      message.error(error);\r\n      setIsLoading(false)\r\n    }\r\n  };\r\n\r\n  const handleUpdateCart = async () => {\r\n    localStorage.setItem(\"paybleAmount\", updateCartData.data.totalPayableAmount);\r\n    localStorage.setItem(\"cart\", JSON.stringify(updateCartData.data.productInfo));\r\n    localStorage.setItem(\"saveAmount\", updateCartData.data.totalSaving);\r\n    localStorage.setItem(\"actualAmount\", updateCartData.data.totalActualAmount);\r\n    localStorage.setItem(\"updatedeliveryCharge\", deliveryOpt === \"PICKUP\" ? 0 : Number(updateCartData.data.deliveryCharge));\r\n    localStorage.setItem(\"discountAmount\", updateCartData.data.discountAmount);\r\n    // window.location.reload()\r\n    try {\r\n\r\n      // Sequential dispatch calls (not in Promise.all)\r\n      dispatch(setPayableAmount([...updateCartData.data.totalPayableAmount]));\r\n      dispatch(setActualAmount(updateCartData.data.totalActualAmount));\r\n      dispatch(setDiscountAmount(updateCartData.data.discountAmount));\r\n      dispatch(setDeliveryCahrge(deliveryOpt === \"PICKUP\" ? 0 : Number(updateCartData.data.deliveryCharge)));\r\n      dispatch(setCartItem(updateCartData.data.productInfo));\r\n      dispatch(setSaveAmount(updateCartData.data.totalSaving));\r\n\r\n      // Synchronous localStorage updates\r\n    } catch (error) {\r\n      console.error(\"Error during dispatch\", error);\r\n    }\r\n    setIsModalOpen(false);\r\n  };\r\n\r\n  const handleCancel = () => {\r\n    setIsModalOpen(false);\r\n  };\r\n\r\n  const onReset = () => {\r\n    form.resetFields()\r\n  }\r\n\r\n  const handleAddress = (add) => {\r\n    setAddsType(add)\r\n  }\r\n\r\n  useEffect(() => {\r\n    async function getPinLocation() {\r\n      const apiKey = process.env.REACT_APP_GOOGLE_MAPS_API_KEY;\r\n\r\n      const response = await axios.get(\r\n        `https://maps.googleapis.com/maps/api/geocode/json?latlng=${lat},${lng}&key=${apiKey}`\r\n      );\r\n      setFormAddressLoader(true)\r\n      if (response.data.status === \"OK\") {\r\n        const userLocation = response.data.results[0];\r\n        setPinLocation(userLocation);  // Set the state with the user’s location data\r\n        setFormAddressLoader(false)\r\n      } else {\r\n        setFormAddressLoader(false)\r\n      }\r\n    }\r\n    if (lat != \"\" && lng != \"\") {\r\n      getPinLocation()\r\n    }\r\n  }, [lat, lng]);\r\n\r\n  useEffect(() => {\r\n    if (pinLocation.length != 0) {\r\n      form.setFieldsValue({\r\n        area: pinLocation?.formatted_address\r\n      })\r\n    }\r\n  }, [pinLocation])\r\n\r\n  const showDeliverySlot = async (branchId) => {\r\n    if (!branchId) {\r\n      message.warning(\"Branch ID not available for slot loading\");\r\n      return;\r\n    }\r\n\r\n    setIsSlotLoader(true);\r\n\r\n    try {\r\n      const res = await getSloteList(token, branchId);\r\n\r\n      if (res.status == 200) {\r\n        const slots = res.data.data;\r\n        setSlotData(slots);\r\n        setSelectedSlot(slots[0]?.availableSlot[0]);\r\n        setSelectSlotData(slots[0]);\r\n      } else {\r\n        setSlotData([]);\r\n        setSelectedSlot(null);\r\n        setSelectSlotData(null);\r\n      }\r\n    } catch (error) {\r\n      setSlotData([]);\r\n      setSelectedSlot(null);\r\n      setSelectSlotData(null);\r\n\r\n      notification.error({\r\n        placement: \"topRight\",\r\n        message: \"Slot Loading Error\",\r\n        description: \"Something went wrong while loading delivery slots.\",\r\n      });\r\n    } finally {\r\n      setIsSlotLoader(false);\r\n    }\r\n  };\r\n\r\n  const branchId = deliveryOpt !== \"DELIVERY\" ? selectedDeliveryStore?._id : deliveryLocation?.branchId;\r\n\r\n  useEffect(() => {\r\n    if (branchId) {\r\n      showDeliverySlot(branchId);\r\n    }\r\n  }, [branchId, deliveryOpt]);\r\n\r\n  useEffect(() => {\r\n    const now = dayjs();\r\n    const currentDate = now.format('DD/MM/YYYY');\r\n    const updatedSlots = sloteData.map((slot) => {\r\n      const slotFrom = dayjs(`${currentDate} ${slot.timeSlotFrom}`, 'DD/MM/YYYY hh:mm A');\r\n      const slotTo = dayjs(`${currentDate} ${slot.timeSlotTo}`, 'DD/MM/YYYY hh:mm A');\r\n      let slotDate;\r\n      if (slotFrom.isBefore(now) && slotTo.isBefore(now)) {\r\n        slotDate = now.add(1, 'day').format('DD/MM/YYYY');\r\n      } else {\r\n        slotDate = currentDate;\r\n      }\r\n      // Return a new object with the date property\r\n      return { ...slot, date: slotDate };\r\n    });\r\n\r\n    setCurrentSlots(updatedSlots);\r\n  }, [sloteData]);\r\n\r\n  // useEffect(() => {\r\n  //   if (sloteData?.length) {\r\n  //     checkUpdateCarts();\r\n  //   }\r\n  // }, [sloteData]);\r\n\r\n  const checkUpdateCarts = async (values) => {\r\n    setIsCheckCart(true)\r\n    const body = {\r\n      branchCode: selectedDeliveryStore.branchCode,\r\n      branchId: selectedDeliveryStore._id,\r\n      userLocationId: deliveryOpt != \"DELIVERY\" ? \"\" : deliveryLocation._id,\r\n      paymentMode: payMode,\r\n      deliveryOption: deliveryOpt,\r\n      alternativeCustomerName: \"\",\r\n      alternativeMobileNo: \"\",\r\n      deliveryDate: newSelectedSlot?.details ? newSelectedSlot?.details?.selected_date?.availableSlotDate : selectedSlotData?.availableSlotDate,\r\n      discountId: \"\",\r\n      branchSlotId: newSelectedSlot?.details ? newSelectedSlot?.details?.selected_slot?._id : selectedSlot?._id,\r\n      totalSaving: saveAmount != 0 ? +(saveAmount).toFixed(2) : 0,\r\n      mrpTotalProductAmount: MrpTotalAmount,\r\n      totalProductAmount: +totalAmount?.toFixed(2),\r\n      discountAmount: +discountAmount || 0,\r\n      totalActualAmount: +payableAmount?.toFixed(2),\r\n      deliveryCharge: deliveryOpt === \"PICKUP\" ? 0 : deliveryCharge,\r\n      totalPayableAmount: Math.round(payableAmount),\r\n      productInfo: updateCartbody,\r\n    }\r\n    try {\r\n      await fetchUpdateCarts(token, body)\r\n        .then((res) => {\r\n          if (res.status === 201) {\r\n            setIsCheckCart(false)\r\n          } else if (res.status === 200) {\r\n            setCartItemStockOut([])\r\n            setShowUpdateBtn(true)\r\n            setIsModalOpen(true)\r\n            setUpdateCartData(res.data)\r\n            fetchShareCartData()\r\n            setIsCheckCart(false)\r\n          } else if (res.status === 202) {\r\n            setShowUpdateBtn(false)\r\n            setCartItemStockOut(res.data.data)\r\n            setIsModalOpen(true)\r\n            setUpdateCartData(res.data)\r\n            setIsCheckCart(false)\r\n          } else if (res.status == 283) {\r\n            logout()\r\n            message.error(res.data.message)\r\n          }\r\n\r\n        })\r\n        .catch((err) => {\r\n          message.error(err);\r\n          setIsCheckCart(false)\r\n\r\n        });\r\n    } catch (error) {\r\n      message.error(error);\r\n      setIsCheckCart(false)\r\n    }\r\n  };\r\n\r\n  const handleDelItem = (item,) => {\r\n    dispatch(updateCartRemoveItem(item));\r\n    setDisabledButtons((prev) => ({ ...prev, [item.productCode]: true }));\r\n    const cart = JSON.parse(localStorage.getItem(\"cart\")) || []; // Retrieve cart from localStorage\r\n    const updatedCart = cart.filter(cartItem => cartItem.productCode !== item.productCode); // Filter out the item to be removed\r\n    localStorage.setItem(\"cart\", JSON.stringify(updatedCart))\r\n    if (!isModalOpen) {\r\n      checkUpdateCarts()\r\n    }\r\n  };\r\n\r\n  const validateMaxLength = (_, value) => {\r\n    if (value && value.length > 10) {\r\n      return Promise.reject(new Error('Please Enter Valid Number !'));\r\n    }\r\n    return Promise.resolve();\r\n  };\r\n\r\n  const fetchShareCartData = async () => {\r\n    const cart = cartItems.map((item) => ({ productCode: item.productCode, qty: item.unit, offer: false }))\r\n\r\n    try {\r\n      await fetchAutoOfferApplyCart({ cartItem: cart, branchCode: nearStore?.branchCode }).then((res) => {\r\n        const fetchData = res.data.data\r\n        if (res.status === 200) {\r\n          localStorage.setItem(\"cart\", JSON.stringify(fetchData));\r\n          dispatch(addAutoApplyOffer(fetchData))\r\n\r\n        }\r\n      }).catch((err) => {\r\n        message.error(err)\r\n      })\r\n\r\n    } catch (error) {\r\n      message.error(error)\r\n    }\r\n  }\r\n\r\n  const handleGoToPayment = async () => {\r\n    try {\r\n      const values = await form.validateFields();\r\n\r\n      if (!lat || !lng) {\r\n        notification.error({\r\n          message: \"Please select location on map\",\r\n        });\r\n        return;\r\n      }\r\n\r\n      if (addTypes === \"\") {\r\n        notification.warning({\r\n          message: \"Please Select Address Type!\",\r\n        });\r\n        return;\r\n      }\r\n\r\n      setFormAddressLoader(true);\r\n\r\n      const body = {\r\n        latitude: lat,\r\n        longitude: lng,\r\n        area: values.area,\r\n        flatNumber: values.flatNumber,\r\n        floorNumber: values.floorNumber,\r\n        apartmentName: values.apartmentName,\r\n        howToReach: values.howToReach,\r\n        mobileNo: values.mobileNo,\r\n        profileName: value.profileName,\r\n        addressName: value.addressName,\r\n        addressType: addTypes\r\n      };\r\n\r\n      const res = await AddAddress(token, body);\r\n\r\n      if (res.status === 201) {\r\n        notification.success({\r\n          message: \"Address added Successfully!\",\r\n        });\r\n\r\n        const addresses = await ShowSaveAddress();\r\n        const latestAddress = addresses[addresses.length - 1];\r\n\r\n        dispatch(setDeliveryLocation(latestAddress));\r\n        localStorage.setItem(\"delivery_location\", JSON.stringify(latestAddress));\r\n        setValue(latestAddress._id);\r\n\r\n        const [lng, lat] = latestAddress.location.coordinates;\r\n        showBranchDetails(lat, lng);\r\n        setCurrentStep(2);\r\n      } else if (res.status === 202) {\r\n        setNoService(res.data.message);\r\n      } else if (res.status === 200) {\r\n        message.warning(res.data.message);\r\n      }\r\n\r\n      setFormAddressLoader(false);\r\n      form.resetFields();\r\n      setPinLocation([])\r\n      setAddsType(\"\")\r\n      setAlerts(false)\r\n    } catch (error) {\r\n      message.error(error);\r\n      setFormAddressLoader(false);\r\n    }\r\n  };\r\n\r\n  const manageURl = (productName) => {\r\n    const sanitizedCategory = productName\r\n      .replace(/[,/&]/g, '') // Remove commas, slashes, ampersands\r\n      .replace(/\\s+/g, '-')  // Replace spaces with hyphens\r\n      .toLowerCase();\r\n    return sanitizedCategory\r\n  }\r\n\r\n  const goToProductDetails = (item) => {\r\n    navigate(`/product/${manageURl(item.productName)}?uid=${encodeURIComponent(encryptCategoryID(item.productCode))}`);\r\n  }\r\n\r\n  const popoverContent = (\r\n    <div>\r\n      {cartItems.map((item, index) => (\r\n        <div key={index} style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>\r\n          <div>{item.productName}</div>\r\n          <p style={{ marginLeft: '10px' }}>₹ {item.sub_total.toFixed(2)}</p>\r\n        </div>\r\n      ))}\r\n    </div>\r\n  );\r\n\r\n  return (\r\n    <>\r\n      {(isCheckCart || isLoading) ? (\r\n        <div className=\"checkout-loader-overlay\">\r\n          <span className=\"loaderCheckout\"></span>\r\n        </div>\r\n      ) : (\r\n        <div className=\"checkout_section\">\r\n          <div className=\"custom-container\">\r\n            <div className=\"checkout-header\">\r\n              <Button\r\n                className=\"back-button\"\r\n                type=\"link\"\r\n                icon={<MdKeyboardBackspace className={isMobile ? \"h6\" : \"h5\"} />}\r\n                onClick={() => navigate(-1)}\r\n              >\r\n                Back\r\n              </Button>\r\n              {currentStep === 0 &&\r\n                (deliveryTypes === \"DELIVERY\" ? (\r\n                  <Button\r\n                    type=\"primary\"\r\n                    block\r\n                    className=\"checkout-btn payment-btn\"\r\n                    onClick={() => {\r\n                      if (deliveryLocation === null) {\r\n                        notification.error({\r\n                          placement: \"topRight\",\r\n                          message: \"Please Select Delivery Location\",\r\n                        });\r\n                        return;\r\n                      }\r\n                      setIsAddressSkipped(true);\r\n                      setCurrentStep(2)\r\n                    }}\r\n                  >\r\n                    {`Go to Payment (₹${Number(totalAmount)?.toFixed(2)})`}\r\n                  </Button>\r\n                ) : (\r\n                  <Button\r\n                    type=\"primary\"\r\n                    block\r\n                    className=\"checkout-btn payment-btn\"\r\n                    onClick={() => {\r\n                      if (selectedSlot === null) {\r\n                        notification.warning({\r\n                          message: \"Please Select Slot!\",\r\n                        });\r\n                        return;\r\n                      }\r\n                      setCurrentStep(2)\r\n                    }}\r\n                  >\r\n                    {`Go to Payment (₹${Number(totalAmount)?.toFixed(2)})`}\r\n                  </Button>\r\n                ))}\r\n              {currentStep === 1 && (\r\n                <Button\r\n                  type=\"primary\"\r\n                  block\r\n                  className=\"checkout-btn payment-btn\"\r\n                  loading={formAddressLoader}\r\n                  onClick={handleGoToPayment}\r\n                >\r\n                  {`Go to Payment (₹${Number(totalAmount)?.toFixed(2)})`}\r\n                </Button>\r\n              )}\r\n            </div>\r\n            <div className=\"if_update_cart\">\r\n              <Modal\r\n                destroyOnClose={false}\r\n                closable={false} // Disable close button\r\n                maskClosable={false}\r\n                footer={false}\r\n                width={400}\r\n                closeIcon={false}\r\n                title={false}\r\n                open={isModalOpen}\r\n                onCancel={handleCancel}\r\n              >\r\n                <Result\r\n                  title={updateCartData.message}\r\n                  extra={\r\n                    <div>\r\n                      {!showUpdateBtn ?\r\n                        <>\r\n                          <List\r\n                            itemLayout=\"horizontal\"\r\n                            dataSource={cartItemStockOut}\r\n                            renderItem={(item, index) => (\r\n                              <List.Item\r\n                                extra={[\r\n                                  <Button\r\n                                    danger\r\n                                    type=\"primary\"\r\n                                    key={item.productCode}\r\n                                    disabled={disabledButtons[item.productCode]}\r\n                                    onClick={() => handleDelItem(item)}>\r\n                                    Remove\r\n                                  </Button>\r\n                                ]}\r\n                              >\r\n                                <List.Item.Meta\r\n                                  avatar={<Avatar size={46} src={item.imageUrl?.length != 0 ? item.imageUrl[0] : BKDLogo} />}\r\n                                  title={\r\n                                    <div>\r\n                                      <p>\r\n                                        {titleCase(item.productName.substr(0, 26))}\r\n                                      </p>\r\n                                      <Tag color=\"red\" className=\"stock_tag\">out of stock</Tag>\r\n                                    </div>\r\n                                  }\r\n                                  description={\r\n                                    <div>\r\n                                      <p>{item.packSize}</p>\r\n                                      <p><strong>₹ {item.bkdAmount}</strong> | <del>₹ {item.price}</del></p>\r\n                                    </div>\r\n                                  }\r\n                                />\r\n                              </List.Item>\r\n                            )}\r\n                          />\r\n                          <div className=\"text-center\">\r\n                            <Button\r\n                              type=\"primary\"\r\n                              style={{ padding: \"0 2rem\" }}\r\n                              disabled={Object.keys(disabledButtons).length === 0}\r\n                              onClick={() => setIsModalOpen(false)}\r\n                            >\r\n                              OK\r\n                            </Button>\r\n                          </div>\r\n                        </>\r\n                        :\r\n                        null\r\n                      }\r\n\r\n                      <div className=\"text-center\">\r\n                        {showUpdateBtn ?\r\n                          <Button\r\n                            type=\"primary\"\r\n                            style={{ padding: \"0 2rem\" }}\r\n                            onClick={handleUpdateCart}\r\n                          >\r\n                            OK\r\n                          </Button>\r\n                          :\r\n                          null\r\n                        }\r\n                      </div>\r\n                    </div>\r\n                  }\r\n                />\r\n              </Modal>\r\n            </div>\r\n\r\n            <Row gutter={[96, 16]}>\r\n              <Col xs={24} lg={14} xl={14}>\r\n                <Space style={{ width: \"100%\", justifyContent: \"space-between\" }} >\r\n                  <Title level={isMobile ? 5 : 4} style={{ margin: '0' }}>Shopping Cart</Title>\r\n                  <Text className=\"continue-shopping\" onClick={() => navigate('/')}>\r\n                    Continue shopping &gt;\r\n                  </Text>\r\n                </Space>\r\n\r\n                <Row className=\"product-list\">\r\n                  <Col xs={14} sm={14} className=\"product-list-text\">Product</Col>\r\n                  <Col xs={5} sm={4} className=\"product-list-text\">Quantity</Col>\r\n                  <Col xs={5} sm={4} className=\"product-list-text\">Total Price</Col>\r\n                  {!isMobile &&\r\n                    <Col xs={3} sm={2} className=\"product-list-text product-list-text-clear\" onClick={() => handleClearAll()}>{`Clear ${isMobile ? '' : 'all'}`}</Col>\r\n                  }\r\n                </Row>\r\n\r\n                <div className=\"product-list-data\">\r\n                  <div className=\"product-scroll\">\r\n                    {cartItems?.length !== 0 &&\r\n                      cartItems.map((item) => (\r\n                        <Row\r\n                          key={item.id}\r\n                          align=\"middle\"\r\n                          className=\"product-list-row\"\r\n                        >\r\n                          <Col xs={14} sm={14} align=\"start\">\r\n                            <Space>\r\n                              <img\r\n                                style={{ width: isMobile ? 34 : 40 }}\r\n                                src={item?.imageUrl?.[0] ? item.imageUrl[0] : BKDLogo}\r\n                                alt=\"\"\r\n                                onError={(e) => e.currentTarget.src = BKDLogo}\r\n                              />\r\n                              <div className=\"product-name-group\" onClick={() => goToProductDetails(item)}>\r\n                                <Text strong className=\"chekout-product-name\">\r\n                                  {item.productName}\r\n                                </Text>\r\n                                <br />\r\n                                {item.selected_offer ?\r\n                                  <div>\r\n                                    {(() => {\r\n                                      const offerDist = calculateOfferDistribution(item.unit, item.selected_offer);\r\n                                      const offerQty = offerDist.offerQty; // Only use calculated value\r\n                                      const regularQty = offerDist.regularQty;\r\n                                      const offerCycles = offerDist.offerCycles;\r\n\r\n                                      const offerUnits = offerCycles * item.selected_offer.billingQty;\r\n                                      const remainingUnits = regularQty - offerUnits;\r\n                                      const calculatedPrice = offerUnits * item.price + remainingUnits * item.bkdAmount;\r\n\r\n                                      const offerUnit = offerQty; // free/offer items (use price)\r\n                                      const normalUnit = regularQty - offerUnits; // paid items\r\n\r\n                                      const offerPrice = item.price;\r\n                                      const normalPrice = item.bkdAmount;\r\n\r\n                                      return (\r\n                                        <>\r\n                                          <Space>\r\n                                            <p className=\"checkout-price\">₹<del>{offerQty > 0 ? item.bkdAmount : item.price}</del></p>\r\n                                            <p className=\"checkout-price\"><strong>{`₹ ${offerQty > 0 ? item.price : item.bkdAmount}`}</strong></p>\r\n                                            {item?.packSize && <Tag color='green'>{item.packSize}</Tag>}\r\n                                          </Space>\r\n\r\n                                          <p className=\"checkout-regular-text\">{`Regular items: ${regularQty} qty - ₹${item.sub_total || calculatedPrice}`}</p>\r\n                                          <div>\r\n                                            {normalUnit > 0 && (\r\n                                              <p className=\"checkout-regular-text\">\r\n                                                {`${normalUnit} x ${normalPrice} = ₹${(normalUnit * normalPrice).toFixed(2)}`}\r\n                                              </p>\r\n                                            )}\r\n\r\n                                            {offerUnits > 0 && (\r\n                                              <p className=\"checkout-regular-text\">\r\n                                                {`${offerUnit} x ${offerPrice} = ₹${(offerUnit * offerPrice).toFixed(2)}`}\r\n                                              </p>\r\n                                            )}\r\n                                          </div>\r\n                                          {offerQty > 0 && (\r\n                                            <>\r\n                                              <p className=\"checkout-regular-text\" style={{ color: '#52c41a' }}>\r\n                                                {`Free items: ${offerQty} qty (${item.selected_offer.promoType} offer)`}\r\n                                              </p>\r\n                                              <p className=\"checkout-regular-text\" style={{ color: '#52c41a' }}>\r\n                                                {`Savings: ₹${offerQty * item.price}`}\r\n                                              </p>\r\n                                            </>\r\n                                          )}\r\n                                        </>\r\n                                      )\r\n                                    })()}\r\n                                  </div>\r\n                                  :\r\n                                  <Space>\r\n                                    <p>₹<del>{item.price}</del>  </p>\r\n                                    <p><strong>{`₹ ${item.bkdAmount} `}</strong></p>\r\n                                    {item?.packSize && <Tag color='green'>{item.packSize}</Tag>}\r\n                                  </Space>\r\n                                }\r\n                              </div>\r\n                            </Space>\r\n                          </Col>\r\n\r\n                          <Col xs={5} sm={4} style={{ textAlign: '-webkit-center' }}>\r\n                            <div className=\"qty-container\">\r\n                              <button\r\n                                className=\"qty-btn\"\r\n                                onClick={() => handleReduceItem(item)}\r\n                                disabled={item.unit <= 1}\r\n                              >\r\n                                -\r\n                              </button>\r\n\r\n                              <span className=\"qty-value\">\r\n                                {item.selected_offer ? (\r\n                                  <span>\r\n                                    {(() => {\r\n                                      const offerDist = calculateOfferDistribution(item.unit, item.selected_offer);\r\n                                      return (\r\n                                        <>\r\n                                          <span>{offerDist.regularQty}</span>\r\n                                          {offerDist.offerQty > 0 && (\r\n                                            <span style={{ color: '#52c41a', fontSize: '10px' }}>\r\n                                              +{offerDist.offerQty}\r\n                                            </span>\r\n                                          )}\r\n                                        </>\r\n                                      );\r\n                                    })()}\r\n                                  </span>\r\n                                ) : item.unit}\r\n                              </span>\r\n\r\n                              <button\r\n                                className=\"qty-btn\"\r\n                                onClick={() => handleAddItem(item)}\r\n                              >\r\n                                +\r\n                              </button>\r\n                            </div>\r\n                          </Col>\r\n\r\n                          <Col xs={5} sm={4} className=\"product-price\">\r\n                            ₹ {+(item.sub_total + item.combo_total).toFixed(2)}\r\n                          </Col>\r\n\r\n                          {!isMobile &&\r\n                            <Col xs={3} sm={2}>\r\n                              <CloseOutlined\r\n                                style={{ cursor: \"pointer\", color: 'gray' }}\r\n                                onClick={() => handleRemove(item.productCode)}\r\n                              />\r\n                            </Col>\r\n                          }\r\n                        </Row>\r\n                      ))\r\n                    }\r\n                  </div>\r\n\r\n                  <div className=\"checkout-summary-card\">\r\n                    <div className=\"checkout-summary-body\">\r\n                      <div className=\"checkout-summary-text\">\r\n                        <Text strong>Total MRP</Text>\r\n                        <Text strong>₹ {Number(MrpTotalAmount)?.toFixed(2)}</Text>\r\n                      </div>\r\n\r\n                      <div className=\"checkout-summary-text\">\r\n                        <Text strong>Total Amount</Text>\r\n                        <Text strong>₹ {Number(totalAmount)?.toFixed(2)}</Text>\r\n                      </div>\r\n\r\n                      {deliveryCharge !== 0 ?\r\n                        <div className=\"checkout-summary-text\">\r\n                          <Text strong>Delivery Charges</Text>\r\n                          <Text strong>₹ {Number(deliveryCharge)?.toFixed(2)}</Text>\r\n                        </div>\r\n                        :\r\n                        <div className=\"checkout-summary-text\">\r\n                          <Text strong>Delivery Charges</Text>\r\n                          <Text strong>{deliveryOpt !== \"DELIVERY\" ? \"NIL\" : \"Free\"}</Text>\r\n                        </div>\r\n                      }\r\n\r\n                      {selectCoupon && (\r\n                        <div className=\"checkout-summary-text\">\r\n                          <div style={{ display: \"flex\", alignItems: \"center\", gap: 6 }}>\r\n                            <RiCoupon3Line size={isMobile ? 14 : 16} />\r\n                            <p>Coupon</p>\r\n                            <span>({selectCoupon?.couponCode})</span>\r\n                          </div>\r\n                          <div className=\"free\" style={{ display: \"flex\", alignItems: \"center\", gap: 6 }}>\r\n                            <div\r\n                              style={{ cursor: 'pointer', color: 'red' }}\r\n                              onClick={handleRemoveCoupon}\r\n                            >\r\n                              <RiDeleteBinLine size={isMobile ? 14 : 16} />\r\n                            </div>\r\n                            <div>\r\n                              {selectCoupon.discountType === Discount.DISCOUNT ? (\r\n                                selectCoupon.discountValueType === \"flat\"\r\n                                  ? `₹${selectCoupon.discountValue} OFF`\r\n                                  : `${selectCoupon.discountValue}% OFF`\r\n                              ) : selectCoupon.discountType === Discount.CASHBACK ? (\r\n                                `₹${selectCoupon.discountValue} OFF`\r\n                              ) : (\r\n                                `Free delivery`\r\n                              )}\r\n                            </div>\r\n                          </div>\r\n                        </div>\r\n                      )}\r\n                      {selectCoupon && totalAmount < selectCoupon.minCartAmount && (\r\n                        <Alert\r\n                          type=\"error\"\r\n                          banner\r\n                          message={`This coupon can apply on orders above ₹${selectCoupon?.minCartAmount}`}\r\n                          style={{ padding: '5px 10px', margin: '5px 0' }}\r\n                        />\r\n                      )}\r\n                      <div className=\"checkout-summary-text\">\r\n                        <Text strong>Total Payable</Text>\r\n                        <Text strong>₹ {Math.round(payableAmount)}</Text>\r\n                      </div>\r\n                    </div>\r\n\r\n                    <div className=\"checkout-saving\">\r\n                      <div className=\"wave\">\r\n                        <svg viewBox=\"0 0 500 40\" preserveAspectRatio=\"none\">\r\n                          <path\r\n                            d=\"\r\n      M0,20 \r\n      Q15,8 30,20 \r\n      T60,20 \r\n      T90,20 \r\n      T120,20 \r\n      T150,20 \r\n      T180,20 \r\n      T210,20 \r\n      T240,20 \r\n      T270,20 \r\n      T300,20 \r\n      T330,20 \r\n      T360,20 \r\n      T390,20 \r\n      T420,20 \r\n      T450,20 \r\n      T480,20 \r\n      T500,20\r\n      L500,0 L0,0 Z\r\n    \"\r\n                            fill=\"#fff\"\r\n                          />\r\n                        </svg>\r\n                      </div>\r\n\r\n                      <div className=\"saving-content\">\r\n                        <b>Your Total Saving</b>\r\n                        <strong>₹{saveAmount?.toFixed(2)}</strong>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </Col>\r\n              <Col xs={24} lg={10} xl={10}>\r\n                <div className=\"custom-steps-wrapper\">\r\n                  <Steps\r\n                    current={currentStep < 0 ? 0 : currentStep}\r\n                    size=\"small\"\r\n                    direction=\"horizontal\"\r\n                    responsive={false}\r\n                    labelPlacement=\"vertical\"\r\n                    className={`custom-steps ${currentStep < 0 ? \"no-active-step\" : \"\"}`}\r\n                    items={[\r\n                      { title: \"Delivery\" },\r\n                      { title: \"Address\" },\r\n                      { title: \"Payment\" },\r\n                    ]}\r\n                  />\r\n                </div>\r\n                {currentStep > -1 && (\r\n                  <div\r\n                    style={{ padding: 0, marginBottom: 10, cursor: 'pointer', color: '#52c41a' }}\r\n                    onClick={() => {\r\n                      if (deliveryTypes === \"PICKUP\") {\r\n                        if (currentStep === 0) {\r\n                          setCurrentStep(-1);\r\n                        } else {\r\n                          setCurrentStep(0);\r\n                        }\r\n                      } else {\r\n                        if (currentStep === 2 && isAddressSkipped) {\r\n                          setCurrentStep(0);\r\n                        } else {\r\n                          setCurrentStep(currentStep - 1);\r\n                        }\r\n                      }\r\n                    }}\r\n                  >\r\n                    <MdKeyboardBackspace style={{ margin: '0' }} className={isMobile ? \"h6\" : \"h5\"} /> Back\r\n                  </div>\r\n                )}\r\n                {currentStep !== 2 &&\r\n                  <>\r\n                    <Title level={isMobile ? 5 : 4}>Delivery Option</Title>\r\n\r\n                    <Radio.Group\r\n                      value={deliveryTypes}\r\n                      onChange={(e) => {\r\n                        setDeliveryTypes(e.target.value);\r\n                        setCurrentStep(0)\r\n                        handleSelectDelivyType(e.target.value)\r\n                        setIsAddressSkipped(false);\r\n                      }}\r\n                      style={{ marginBottom: '28px' }}\r\n                    >\r\n                      <Space direction=\"vertical\">\r\n                        {currentStep === -1 && (\r\n                          <>\r\n                            <Radio value=\"DELIVERY\">Home Delivery</Radio>\r\n                            <Radio value=\"PICKUP\">Store Pickup</Radio>\r\n                          </>\r\n                        )}\r\n\r\n                        {deliveryTypes === \"DELIVERY\" && currentStep !== -1 && (\r\n                          <Radio value=\"DELIVERY\">Home Delivery</Radio>\r\n                        )}\r\n\r\n                        {deliveryTypes === \"PICKUP\" && currentStep !== -1 && (\r\n                          <Radio value=\"PICKUP\">Store Pickup</Radio>\r\n                        )}\r\n                      </Space>\r\n                    </Radio.Group>\r\n                  </>\r\n                }\r\n\r\n                {currentStep === 0 &&\r\n                  (deliveryTypes === \"DELIVERY\" ?\r\n                    (\r\n                      <>\r\n                        <div className=\"checkout-section-block\">\r\n                          <Text className=\"section-title\">Select Slot:</Text>\r\n                          {isSlotLoader ? (\r\n                            <Skeleton active />\r\n                          ) : currentSlots?.length === 0 ? (\r\n                            <Card className=\"text-center\">\r\n                              <h4>Slot is not available</h4>\r\n                              <p>Please contact with BKD customer care.</p>\r\n                            </Card>\r\n                          ) : (\r\n                            <Radio.Group\r\n                              value={\r\n                                selectedSlot\r\n                                  ? `${selectedSlot._id}_${selectedSlotData?.availableSlotDate}`\r\n                                  : null\r\n                              }\r\n                              onChange={(e) => {\r\n                                const value = e.target.value;\r\n                                const [slotId, slotDate] = value.split(\"_\");\r\n\r\n                                let selectedSlotObj = null;\r\n                                let selectedDateObj = null;\r\n\r\n                                currentSlots.forEach((item) => {\r\n                                  if (item.availableSlotDate === slotDate) {\r\n                                    const foundSlot = item.availableSlot.find(\r\n                                      (slot) => slot._id === slotId\r\n                                    );\r\n                                    if (foundSlot) {\r\n                                      selectedSlotObj = foundSlot;\r\n                                      selectedDateObj = item;\r\n                                    }\r\n                                  }\r\n                                });\r\n\r\n                                setSelectedSlot(selectedSlotObj);\r\n                                setSelectSlotData(selectedDateObj);\r\n                                dispatch(setSlotDetails({ selected_slot: selectedSlotObj, selected_date: selectedDateObj, }));\r\n                                localStorage.setItem(\"selected_slot\", JSON.stringify({ selected_slot: selectedSlotObj, selected_date: selectedDateObj, }));\r\n                              }}\r\n                            >\r\n                              <div className=\"slot-scroll-x\">\r\n                                {currentSlots.map((item, index) => (\r\n                                  <div key={index} className=\"slot-column\">\r\n                                    <Text strong className=\"slot-label\">{item.availableSlotFor} </Text>\r\n\r\n                                    <div className=\"slot-items\">\r\n                                      {item.availableSlot.map((slot, slotindex) => (\r\n                                        <Radio\r\n                                          key={slotindex}\r\n                                          value={`${slot._id}_${item.availableSlotDate}`}\r\n                                          className=\"checkout-slot\"\r\n                                        >\r\n                                          {slot.timeSlotFrom} - {slot.timeSlotTo}\r\n                                        </Radio>\r\n                                      ))}\r\n                                    </div>\r\n                                  </div>\r\n                                ))}\r\n                              </div>\r\n                            </Radio.Group>\r\n                          )}\r\n                        </div>\r\n\r\n                        <div className=\"checkout-section-block\">\r\n                          <div className=\"address-block\">\r\n                            <Text className=\"section-title\" style={{ marginBottom: '0px' }}>Select Saved Address:</Text>\r\n                            <Button\r\n                              type=\"primary\"\r\n                              size=\"small\"\r\n                              className=\"checkout-address-btn\"\r\n                              style={{ fontSize: '13px' }}\r\n                              onClick={() => {\r\n                                setIsAddressSkipped(false);\r\n                                setCurrentStep(1)\r\n                              }}\r\n                            >\r\n                              Add Address\r\n                            </Button>\r\n                          </div>\r\n                          {isAddressLoading ? (\r\n                            <Skeleton\r\n                              active\r\n                              avatar={{ shape: 'circle' }}\r\n                              title={false}\r\n                              paragraph={{ rows: 3 }}\r\n                            />\r\n                          ) : saveAddress?.length === 0 ? (\r\n                            <div className=\"no-address\">\r\n                              <p>No saved addresses found.</p>\r\n                              <span>Please add a new address to continue.</span>\r\n                            </div>\r\n                          ) : (\r\n                            <Radio.Group\r\n                              value={value}\r\n                              onChange={onChange}\r\n                            >\r\n                              <Space direction=\"vertical\">\r\n                                {saveAddress?.map((item) => (\r\n                                  <Radio key={item._id} value={item._id} className=\"address-text\">\r\n                                    <b>{item?.addressType || \"Home\"}</b>, {item?.fullAddress}\r\n                                  </Radio>\r\n                                ))}\r\n                              </Space>\r\n                            </Radio.Group>\r\n                          )}\r\n                        </div>\r\n\r\n                        <Button\r\n                          type=\"primary\"\r\n                          block\r\n                          className=\"checkout-btn checkout-payment-btn\"\r\n                          onClick={() => {\r\n                            if (deliveryLocation === null) {\r\n                              notification.error({\r\n                                placement: \"topRight\",\r\n                                message: \"Please Select Delivery Location\",\r\n                              });\r\n                              return;\r\n                            }\r\n                            setIsAddressSkipped(true);\r\n                            setCurrentStep(2)\r\n                          }}\r\n                        >\r\n                          {`Go to Payment (₹${Number(totalAmount)?.toFixed(2)})`}\r\n                        </Button>\r\n                      </>\r\n                    ) : (\r\n                      <>\r\n                        <Card title=\"Choose Store\" className=\"mb-3\">\r\n                          <div className=\"choose_store\">\r\n                            <ShopCards setSelectedShop={setSelectedShop} />\r\n                            {selectedDeliveryStore && (\r\n                              <Card hoverable\r\n                                className=\"mt-3\"\r\n                                actions={[\r\n                                  <span>{selectedDeliveryStore.distance?.toFixed(1)} KM</span>,\r\n                                  <a id=\"view_on_map\" href={`https://www.google.com/maps?q=${selectedDeliveryStore.location.coordinates[1]},${selectedDeliveryStore.location.coordinates[0]}`} target=\"_blank\">Open Map</a>\r\n                                ]}\r\n                              >\r\n                                <Card.Meta\r\n                                  avatar={<Avatar size={50} src={selectedDeliveryStore.branchImage ? selectedDeliveryStore.branchImage : DefaultImage} />}\r\n                                  title={<div>\r\n                                    <p>{selectedDeliveryStore.branchCode}</p>\r\n                                    <p>{capitalize(selectedDeliveryStore.branchName)}</p>\r\n                                  </div>}\r\n                                  description={<div>\r\n                                    <ShowMoreText\r\n                                      lines={1}\r\n                                      more={<span className=\"View_more\">View more</span>}\r\n                                      less={<span className=\"View_more\">View less</span>}\r\n                                      anchorClass=\"show-more-less-clickable\"\r\n                                      onClick={executeOnClick}\r\n                                      expanded={false}\r\n                                      truncatedEndingComponent={\"... \"}\r\n                                    >\r\n                                      <p>{selectedDeliveryStore.fullAddress}</p>\r\n                                    </ShowMoreText>\r\n                                  </div>}\r\n                                />\r\n                              </Card>\r\n                            )}\r\n                          </div>\r\n                        </Card>\r\n                        <div className=\"checkout-section-block\">\r\n                          <Text className=\"section-title\">Select Slot:</Text>\r\n                          {isSlotLoader ? (\r\n                            <Skeleton active />\r\n                          ) : currentSlots?.length === 0 ? (\r\n                            <Card className=\"text-center\">\r\n                              <h4>Slot is not available</h4>\r\n                              <p>Please contact with BKD customer care.</p>\r\n                            </Card>\r\n                          ) : (\r\n                            <Radio.Group\r\n                              value={\r\n                                selectedSlot\r\n                                  ? `${selectedSlot._id}_${selectedSlotData?.availableSlotDate}`\r\n                                  : null\r\n                              }\r\n                              onChange={(e) => {\r\n                                const value = e.target.value;\r\n                                const [slotId, slotDate] = value.split(\"_\");\r\n\r\n                                let selectedSlotObj = null;\r\n                                let selectedDateObj = null;\r\n\r\n                                currentSlots.forEach((item) => {\r\n                                  if (item.availableSlotDate === slotDate) {\r\n                                    const foundSlot = item.availableSlot.find(\r\n                                      (slot) => slot._id === slotId\r\n                                    );\r\n                                    if (foundSlot) {\r\n                                      selectedSlotObj = foundSlot;\r\n                                      selectedDateObj = item;\r\n                                    }\r\n                                  }\r\n                                });\r\n\r\n                                setSelectedSlot(selectedSlotObj);\r\n                                setSelectSlotData(selectedDateObj);\r\n                                dispatch(setSlotDetails({ selected_slot: selectedSlotObj, selected_date: selectedDateObj, }));\r\n                                localStorage.setItem(\"selected_slot\", JSON.stringify({ selected_slot: selectedSlotObj, selected_date: selectedDateObj, }));\r\n                              }}\r\n                            >\r\n                              <Space direction=\"vertical\">\r\n                                {currentSlots.map((item, index) => (\r\n                                  <div key={index} className=\"slot-group\">\r\n                                    <Text strong className=\"slot-label\">{item.availableSlotFor}</Text>\r\n\r\n                                    {item.availableSlot.map((slot, slotindex) => (\r\n                                      <Radio\r\n                                        key={slotindex}\r\n                                        value={`${slot._id}_${item.availableSlotDate}`}\r\n                                        className=\"checkout-slot\"\r\n                                      >\r\n                                        {slot.timeSlotFrom} - {slot.timeSlotTo}\r\n                                      </Radio>\r\n                                    ))}\r\n                                  </div>\r\n                                ))}\r\n                              </Space>\r\n                            </Radio.Group>\r\n                          )}\r\n                        </div>\r\n                        <Button\r\n                          type=\"primary\"\r\n                          block\r\n                          className=\"checkout-btn checkout-payment-btn\"\r\n                          onClick={() => {\r\n                            if (selectedSlot === null) {\r\n                              notification.warning({\r\n                                message: \"Please Select Slot!\",\r\n                              });\r\n                              return;\r\n                            }\r\n                            setCurrentStep(2)\r\n                          }}\r\n                        >\r\n                          {`Go to Payment (₹${Number(totalAmount)?.toFixed(2)})`}\r\n                        </Button>\r\n                      </>\r\n                    ))}\r\n\r\n                <Form form={form} layout=\"vertical\">\r\n                  {currentStep === 1 && (\r\n                    <>\r\n                      {/* SAVED ADDRESS STILL VISIBLE */}\r\n                      <div className=\"checkout-section-block\">\r\n                        <Text className=\"section-title\">Select Saved Address:</Text>\r\n                        {isAddressLoading ? (\r\n                          <Skeleton\r\n                            active\r\n                            avatar={{ shape: 'circle' }}\r\n                            title={false}\r\n                            paragraph={{ rows: 3 }}\r\n                          />\r\n                        ) : saveAddress?.length === 0 ? (\r\n                          <div className=\"no-address\">\r\n                            <p>No saved addresses found.</p>\r\n                            <span>Please add a new address to continue.</span>\r\n                          </div>\r\n                        ) : (\r\n                          <Radio.Group\r\n                            value={value}\r\n                            onChange={onChange}\r\n                          >\r\n                            <Space direction=\"vertical\">\r\n                              {saveAddress?.map((item) => (\r\n                                <Radio key={item._id} value={item._id} className=\"address-text\">\r\n                                  <b>{item?.addressType || \"Home\"}</b>, {item?.fullAddress}\r\n                                </Radio>\r\n                              ))}\r\n                            </Space>\r\n                          </Radio.Group>\r\n                        )}\r\n                      </div>\r\n\r\n                      {/* FORM */}\r\n                      <div className=\"checkout-section-block\">\r\n                        <Text className=\"section-title\">Enter New Address:</Text>\r\n\r\n                        {alerts ? <Alert message=\"Note : Please Drag Map Your exact Location\" type=\"info\" showIcon closable /> : null}\r\n                        <Card>\r\n                          <ShowMap setLat={setLat} setLng={setLng} lat={lat} lng={lng} setAlerts={setAlerts} />\r\n                        </Card>\r\n                        {noService ?\r\n                          <div className=\"no_service\">\r\n                            <img src={NotImage} style={{ width: '20%' }} />\r\n                            <p>{noService}</p>\r\n                          </div>\r\n                          : null\r\n                        }\r\n                        <div className=\"form-group\">\r\n                          <Form.Item\r\n                            className=\"label\"\r\n                            label=\"Area/Locality\"\r\n                            name=\"area\"\r\n                            rules={[\r\n                              {\r\n                                required: true,\r\n                                message: \"Please Search you area on on Map\",\r\n                              },\r\n                            ]}\r\n                          >\r\n                            <Input placeholder=\"Enter Area\" disabled className=\"checkout-input\" />\r\n                          </Form.Item>\r\n                        </div>\r\n\r\n                        <Row gutter={10} className=\"form-group\">\r\n                          <Col span={12}>\r\n                            <Form.Item\r\n                              className=\"label\"\r\n                              label=\"House/Flat Number\"\r\n                              name=\"flatNumber\"\r\n                              rules={[\r\n                                {\r\n                                  required: true,\r\n                                  message: \"Please Enter your flatNumber!\",\r\n                                },\r\n                              ]}\r\n                            >\r\n                              <Input placeholder=\"Enter Flat Number\" className=\"checkout-input\" />\r\n                            </Form.Item>\r\n                          </Col>\r\n                          <Col span={12}>\r\n                            <Form.Item\r\n                              className=\"label\"\r\n                              label=\"Floor Number\"\r\n                              name=\"floorNumber\"\r\n                              style={{ width: '100%' }}\r\n                            >\r\n                              <Input placeholder=\"Enter Floor Number \" className=\"checkout-input\" />\r\n                            </Form.Item>\r\n                          </Col>\r\n                        </Row>\r\n\r\n                        <Row gutter={10} className=\"form-group\">\r\n                          <Col span={12}>\r\n                            <Form.Item\r\n                              className=\"label\"\r\n                              label=\"Apartment/Building Name\"\r\n                              name=\"apartmentName\"\r\n                            >\r\n                              <Input placeholder=\"Enter Apartment\" className=\"checkout-input\" />\r\n                            </Form.Item>\r\n                          </Col>\r\n                          <Col span={12}>\r\n                            <Form.Item\r\n                              className=\"label\"\r\n                              label=\"Mobile Number\"\r\n                              name=\"mobileNo\"\r\n                              rules={[\r\n\r\n                                {\r\n                                  pattern: /^[0-9]*$/,\r\n                                  message: 'Please Enter only Numbers!',\r\n                                },\r\n                                { validator: validateMaxLength }\r\n                              ]}\r\n                            >\r\n                              <Input placeholder=\"Enter Mobile Number\" className=\"checkout-input\" />\r\n                            </Form.Item>\r\n                          </Col>\r\n                        </Row>\r\n\r\n                        <Row gutter={10} className=\"form-group\">\r\n                          <Col span={12}>\r\n                            <Form.Item\r\n                              className=\"label\"\r\n                              label=\"Profile Name\"\r\n                              name=\"profileName\"\r\n                            >\r\n                              <Input placeholder=\"Enter Profile Name (e.g. My Home)\" className=\"checkout-input\" />\r\n                            </Form.Item>\r\n                          </Col>\r\n                          <Col span={12}>\r\n                            <Form.Item\r\n                              className=\"label\"\r\n                              label=\"Address Name\"\r\n                              name=\"addressName\"\r\n                            >\r\n                              <Input placeholder=\"Enter Address Name (e.g. Dad's place)\" className=\"checkout-input\" />\r\n                            </Form.Item>\r\n                          </Col>\r\n                        </Row>\r\n\r\n                        <div className=\"form-group\">\r\n                          <Form.Item\r\n                            className=\"label\"\r\n                            label=\"How to reach\"\r\n                            name=\"howToReach\"\r\n                            rules={[\r\n                              {\r\n                                required: true,\r\n                                message: \"Please Enter How To Reach\",\r\n                              },\r\n                            ]}\r\n                          >\r\n                            <Input placeholder=\"Enter Landmark \" className=\"checkout-input\" />\r\n                          </Form.Item>\r\n                        </div>\r\n\r\n                        <div className=\"form-group\">\r\n                          <Form.Item\r\n                            label=\"Save address as a\"\r\n                            name=\"addressType\"\r\n                          >\r\n                            <div className=\"show_loc_type\" >\r\n                              {addressType.map((add) => (\r\n                                <div className={` ${addTypes == add.title && \"homeSelected\"}`}>\r\n                                  <Card key={add.id} hoverable onClick={() => handleAddress(add.title)}>\r\n                                    <Space>\r\n                                      <span >{add.icon}</span>\r\n                                      <p>{add.title}</p>\r\n                                    </Space>\r\n                                  </Card>\r\n                                </div>\r\n                              ))}\r\n                            </div>\r\n                          </Form.Item>\r\n                        </div>\r\n\r\n                        <Text className=\"section-title\" style={{ fontSize: '16px' }}>Ordering for someone else?</Text>\r\n\r\n                        <div className=\"form-group\">\r\n                          <Text className=\"label\">Alternate Contact Details</Text>\r\n                          <Form.Item\r\n                            name=\"fullName\"\r\n                            rules={[\r\n                              {\r\n                                validator: (_, value) =>\r\n                                  /^[a-zA-Z\\s]*$/.test(value)\r\n                                    ? Promise.resolve()\r\n                                    : Promise.reject(new Error('Name should only contain letters!')),\r\n                              },\r\n                            ]}\r\n                            style={{ marginBottom: 8 }}\r\n                          >\r\n                            <Input\r\n                              placeholder=\"Enter Name \"\r\n                              className=\"checkout-input\"\r\n                              onChange={(e) => {\r\n                                const value = e.target.value;\r\n                                if (/^[a-zA-Z\\s]*$/.test(value)) {\r\n                                  e.target.value = value;\r\n                                } else {\r\n                                  e.preventDefault();\r\n                                }\r\n                              }}\r\n                            />\r\n                          </Form.Item>\r\n                          <Form.Item\r\n                            name=\"alertnativeMobileNo\"\r\n                            rules={[\r\n                              {\r\n                                pattern: /^[0-9]*$/,\r\n                                message: 'Please Enter only Numbers!',\r\n                              },\r\n                              { validator: validateMaxLength }\r\n                            ]}\r\n                          >\r\n                            <Input placeholder=\"Enter Contact Number\" maxLength={10} className=\"checkout-input\" />\r\n                          </Form.Item>\r\n                        </div>\r\n                      </div>\r\n\r\n                      <Button\r\n                        type=\"primary\"\r\n                        block\r\n                        className=\"checkout-btn checkout-payment-btn\"\r\n                        loading={formAddressLoader}\r\n                        onClick={handleGoToPayment}\r\n                      >\r\n                        {`Go to Payment (₹${Number(totalAmount)?.toFixed(2)})`}\r\n                      </Button>\r\n                    </>\r\n                  )}\r\n                </Form>\r\n\r\n                {currentStep === 2 && (\r\n                  <>\r\n                    <Title level={4}>Payment Options</Title>\r\n\r\n                    <Radio.Group className=\"checkout-section-block\" onChange={onChangeWollet} value={wolletvalue || payMode}>\r\n                      <Space direction=\"vertical\">\r\n                        <Radio value=\"COD\">Cash on Delivery</Radio>\r\n                        <Radio value=\"ONLINE\">Online</Radio>\r\n                      </Space>\r\n                    </Radio.Group>\r\n\r\n                    <div className=\"checkout-section-block\">\r\n                      <Space style={{ justifyContent: \"space-between\", width: \"100%\" }}>\r\n                        <Text className=\"section-title\">Apply Coupon:</Text>\r\n                        <Text\r\n                          className=\"checkout-view-coupons\"\r\n                          onClick={toggleModalDrawer}\r\n                        >\r\n                          View Coupons\r\n                        </Text>\r\n                      </Space>\r\n\r\n                      {selectCoupon &&\r\n                        <Alert\r\n                          type=\"success\"\r\n                          showIcon\r\n                          style={{ padding: '5px 10px', margin: '5px 0' }}\r\n                          message={\r\n                            <p>\r\n                              Your Applied coupon is{\" \"}\r\n                              <b>\r\n                                {selectCoupon?.couponCode} (\r\n                                {selectCoupon?.discountType === Discount.DISCOUNT\r\n                                  ? selectCoupon.discountValueType === \"flat\"\r\n                                    ? `₹${selectCoupon.discountValue} OFF`\r\n                                    : `${selectCoupon.discountValue}% OFF`\r\n                                  : selectCoupon?.discountType === Discount.CASHBACK\r\n                                    ? `₹${selectCoupon.discountValue} OFF`\r\n                                    : `Free delivery`}\r\n                                )\r\n                              </b>\r\n                            </p>\r\n                          }\r\n                        />\r\n                      }\r\n\r\n                      <Text className=\"label\">Enter Coupon Code</Text>\r\n\r\n                      <div className=\"coupon-code-input\">\r\n                        <Input\r\n                          className=\"checkout-input\"\r\n                          placeholder=\"Enter Code\"\r\n                          value={couponInput}\r\n                          onChange={(e) => setCouponInput(e.target.value)}\r\n                        />\r\n                        <Button\r\n                          type=\"primary\"\r\n                          className=\"apply-btn\"\r\n                          shape=\"round\"\r\n                          onClick={handleApplyCouponMain}\r\n                          loading={isValidating}\r\n                        >\r\n                          Apply\r\n                        </Button>\r\n                      </div>\r\n                    </div>\r\n\r\n                    <Button\r\n                      type=\"primary\"\r\n                      block\r\n                      className=\"checkout-btn\"\r\n                      onClick={handlePlaceOrder}\r\n                      loading={isLoading}\r\n                    >\r\n                      Pay<span style={{ fontWeight: 'bold', marginLeft: '5px' }}>₹{Math.round(payableAmount)}</span>\r\n                    </Button>\r\n                  </>\r\n                )}\r\n              </Col>\r\n            </Row>\r\n          </div>\r\n        </div >\r\n      )}\r\n\r\n      {isCouponModalOpen &&\r\n        <CouponModal\r\n          title=\"Select Coupon\"\r\n          isOpen={isCouponModalOpen}\r\n          onClose={toggleModalDrawer}\r\n          onSelectCoupon={onSelectCoupon}\r\n          cartAmount={totalAmount}\r\n        />\r\n      }\r\n\r\n      {isClearAllOpen &&\r\n        <ClearAllModal\r\n          title=\"Clear All Items\"\r\n          subTitle={'Are you sure you want to clear all items from your cart?'}\r\n          isOpen={isClearAllOpen}\r\n          onClose={toggleClearAllModal}\r\n          isOk={handleOk}\r\n        />\r\n      }\r\n\r\n      {isRemoveOpen &&\r\n        <ClearAllModal\r\n          title=\"Remove Items\"\r\n          subTitle={'Are you sure you want to remove items from your cart?'}\r\n          isOpen={isRemoveOpen}\r\n          onClose={toggleRemoveModal}\r\n          isOk={handleRemoveItem}\r\n        />\r\n      }\r\n\r\n      <OrderPlace orderPlaced={orderPlaced} orderPlaceData={orderPlaceData} />\r\n    </>\r\n  )\r\n}\r\n\r\nexport default NewCheckOutProduct\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\poolOrder\\PoolOrderProduct.jsx",["912","913","914","915","916","917","918","919","920","921","922","923","924","925","926","927","928","929","930","931","932","933","934","935","936","937","938","939","940","941","942","943","944","945","946","947"],[],"import React, { useCallback, useEffect, useRef, useState } from \"react\";\r\nimport { Button, Card, Divider, notification, Radio, Select, Skeleton, Space, Tabs, Tag, Tooltip } from \"antd\";\r\nimport { Col, Row } from \"react-bootstrap\";\r\nimport \"../../style/Category.css\";\r\nimport { useNavigate } from \"react-router-dom\";\r\nimport { AddProductWishlist, fetchPoolCategory, fetchPoolOrderData, out_of_stock, ProdductLimits } from \"../apiService/api\";\r\nimport DefaultImg from \"../../assest/bkdlogo.png\"\r\n// import { selectBranch } from \"../../redux/OrderSlice\";\r\nimport { useAuth } from \"../auth/context/authContext\";\r\nimport { addItem, removeItem, selectCartItems } from \"../../redux/CartSlice\";\r\nimport { FaHeart, FaRegHeart } from \"react-icons/fa\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport BKDLogo from \"../../assest/bkdlogo.png\"\r\nimport { useScreen } from \"../auth/AuthScreen\";\r\nimport ProductFilter from \"../Category/ProductFilter\";\r\nimport offerAvailable from \"../../assest/png/offer_apply.png\"\r\nimport { encryptCategoryID } from \"../../config/encriptConfig\";\r\nimport { getOfferImage } from \"../../utils/offerUtils\";\r\n\r\nconst { TabPane } = Tabs;\r\n\r\nfunction PoolOrderProduct() {\r\n  const { screenWidth } = useScreen()\r\n  const { nearStore, token } = useAuth()\r\n  const dispatch = useDispatch()\r\n  const navigate = useNavigate()\r\n  const cartItems = useSelector(selectCartItems);\r\n  const [itemType, setItemType] = useState(\"\")\r\n  const [filterBy, setFilterBy] = useState(\"\")\r\n  const [catList, setCatList] = useState([]);\r\n  const [poolData, setPoolData] = useState([]);\r\n  const [current, setCurrent] = useState(1)\r\n  const [categoryId, setCategoryId] = useState(\"\")\r\n  const [loading, setLoading] = useState(false);\r\n  const [isLoading, setIsLoading] = useState(false)\r\n  const [nextLoading, setNextLoading] = useState(false)\r\n  const [hasMore, setHasMore] = useState(true);\r\n  const [isInitialRender, setIsInitialRender] = useState(true);\r\n  const [wishlist, setWishlist] = useState({});\r\n  const skeletonArray = new Array(poolData?.length || screenWidth < 1400 ? 12 : 14).fill(0);\r\n  const observerRef = useRef(null);\r\n  const titleCase = str => str.toLowerCase().split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');\r\n\r\n\r\n\r\n  const handleTabChange = (key) => {\r\n    // Accessing the title of the clicked tab\r\n    console.log(\"Tab changed - Key:\", key);\r\n    setCategoryId(key)\r\n  };\r\n  const handleClick = (item) => {\r\n    console.log(item);\r\n  };\r\n\r\n  const showAllCategoryList = async () => {\r\n    setLoading(true)\r\n\r\n    try {\r\n      await fetchPoolCategory()\r\n        .then((res) => {\r\n          // console.log(\"pool category lsit\", res);\r\n          if (res.status == 200) {\r\n            // setCategoryId(res.data.data[0].categoryID)\r\n            setCatList(res.data.data);\r\n            setLoading(false)\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          console.log(err);\r\n        });\r\n    } catch (error) {\r\n      console.log(error);\r\n      setLoading(false)\r\n    }\r\n  };\r\n  useEffect(() => {\r\n    showAllCategoryList()\r\n  }, [])\r\n\r\n\r\n  const showPoolProductList = async (isInitial = false) => {\r\n    setLoading(true);\r\n    setNextLoading(isInitial);\r\n\r\n    // Calculate the correct page value to pass\r\n    const page = isInitial ? 1 : current + 1;\r\n\r\n    try {\r\n      const res = await fetchPoolOrderData(categoryId, nearStore?.branchCode, page, itemType, filterBy)\r\n      if (res.status === 200) {\r\n        const fetchData = res.data.data;\r\n        if (fetchData.length === 0) {\r\n          setHasMore(false);\r\n        } else {\r\n          setPoolData((prevData) =>\r\n            isInitial ? fetchData : [...prevData, ...fetchData]\r\n          );\r\n          setCurrent(page); // Update `current` state\r\n        }\r\n      }\r\n    } catch (error) {\r\n      console.log(error);\r\n    } finally {\r\n      setLoading(false);\r\n      setNextLoading(false);\r\n      if (isInitialRender) setIsInitialRender(false); // Set initial render flag to false\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    showPoolProductList(true); // Initial load\r\n  }, [categoryId, itemType, filterBy,]);\r\n\r\n  useEffect(() => {\r\n\r\n    if (isInitialRender) return; // Skip observer logic during the initial render\r\n    if (poolData?.length == ProdductLimits * current) {\r\n      const observer = new IntersectionObserver(\r\n        (entries) => {\r\n          if (entries[0].isIntersecting && !loading && hasMore) {\r\n            showPoolProductList(false);\r\n          }\r\n        },\r\n        { threshold: 1.0 }\r\n      );\r\n\r\n      if (observerRef.current) observer.observe(observerRef.current);\r\n\r\n      return () => {\r\n        if (observerRef.current) observer.unobserve(observerRef.current);\r\n      };\r\n    }\r\n  }, [hasMore, loading, isInitialRender]);\r\n\r\n  useEffect(() => {\r\n    setCurrent(1);         // Reset current page to 1\r\n    setPoolData([]);      // Clear the brand list\r\n    setHasMore(true);      // Reset hasMore flag\r\n\r\n  }, [filterBy]);\r\n\r\n\r\n  // const showPoolProductList = async (isInitial = false) => {\r\n  //   // Prevent duplicate calls\r\n  //   setIsLoading(true)\r\n  //   setNextLoading(isInitial)\r\n\r\n  //   const page = isInitial ? 1 : current + 1\r\n  //   try {\r\n  //     const res = await fetchPoolOrderData(categoryId, nearStore?.branchCode, page, itemType, filterBy);\r\n  //     if (res.status === 200) {\r\n  //       const fetchedData = res.data.data;\r\n\r\n  //       setPoolData(fetchedData); // Append data\r\n  //       if (fetchedData.length === 0) {\r\n\r\n  //         setHasMore(false); // No more data\r\n  //       } else {\r\n  //         setPoolData((prevData) => isInitial ? fetchedData : [...prevData, ...fetchedData])\r\n  //         setCurrent(page)\r\n  //       }\r\n  //     }\r\n  //   } catch (err) {\r\n  //     console.error(err);\r\n  //   } finally {\r\n  //     setIsLoading(false);\r\n  //     setNextLoading(false)// Reset request flag\r\n  //   }\r\n  // }\r\n\r\n\r\n\r\n\r\n  // useEffect(() => {\r\n  //   showPoolProductList(true);\r\n  // }, [categoryId, itemType, filterBy]);\r\n\r\n  // // Infinite Scroll Observer\r\n  // useEffect(() => {\r\n  //   const observer = new IntersectionObserver(\r\n  //     (entries) => {\r\n  //       const [entry] = entries;\r\n  //       if (entry.isIntersecting && hasMore && !isLoading) {\r\n  //         showPoolProductList(false)\r\n  //       }\r\n  //     },\r\n  //     { threshold: 1.0 }\r\n  //   );\r\n\r\n  //   if (observerRef.current) observer.observe(observerRef.current);\r\n\r\n  //   return () => {\r\n  //     if (observerRef.current) observer.unobserve(observerRef.current);\r\n  //   };\r\n  // }, [hasMore, isLoading]);\r\n\r\n\r\n\r\n  const handleAddItem = (item) => {\r\n    dispatch(addItem(item))\r\n\r\n  };\r\n\r\n  useEffect(() => {\r\n    localStorage.setItem(\"cart\", JSON.stringify(cartItems));\r\n  }, [cartItems]);\r\n\r\n\r\n\r\n\r\n  const handleDelItem = (item) => {\r\n    dispatch(removeItem(item));\r\n    const cart = JSON.parse(localStorage.getItem(\"cart\")) || []; // Retrieve cart from localStorage\r\n    const updatedCart = cart.filter(cartItem => cartItem.productCode !== item.productCode); // Filter out the item to be removed\r\n    localStorage.setItem(\"cart\", JSON.stringify(updatedCart))\r\n\r\n  };\r\n\r\n\r\n  const HnadleNotLogin = () => {\r\n    notification.error({\r\n      placement: \"topRight\",\r\n      message: \"Please login before add wishlist\",\r\n    });\r\n  }\r\n\r\n\r\n  const addToWishList = async (proCode) => {\r\n    setWishlist((prev) => ({ ...prev, [proCode.productCode]: true }));\r\n    const body = {\r\n      productCode: proCode.productCode,\r\n      productName: proCode.productName,\r\n      status: \"ACTIVE\"\r\n    }\r\n    try {\r\n      await AddProductWishlist(token, body)\r\n        .then((res) => {\r\n          console.log(\"add to  wish\", res);\r\n          if (res.status == 201) {\r\n            if (res.data.data.whislistKey != true) {\r\n\r\n              showPoolProductList()\r\n            } else {\r\n\r\n              showPoolProductList()\r\n            }\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          console.log(err.message);\r\n          setWishlist((prev) => ({ ...prev, [proCode]: false }));\r\n        });\r\n    } catch (error) {\r\n      setWishlist((prev) => ({ ...prev, [proCode]: false }));\r\n      console.log(error);\r\n\r\n    }\r\n  };\r\n\r\n\r\n  const RemoveToWishList = async (proCode) => {\r\n    setWishlist((prev) => ({ ...prev, [proCode.productCode]: false })); // Immediately update the icon\r\n    const body = { productCode: proCode.productCode, productName: proCode.productName, status: \"INACTIVE\" };\r\n    try {\r\n      await AddProductWishlist(token, body)\r\n        .then((res) => {\r\n          if (res.status === 201) {\r\n            showPoolProductList();\r\n\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          console.log(err.message);\r\n          setWishlist((prev) => ({ ...prev, [proCode]: true })); // Revert the icon if the API call fails\r\n\r\n        });\r\n    } catch (error) {\r\n      console.log(error);\r\n      setWishlist((prev) => ({ ...prev, [proCode]: true })); // Revert the icon if the API call fails\r\n    }\r\n  };\r\n\r\n\r\n  const manageURl = (productName) => {\r\n    const sanitizedCategory = productName\r\n      .replace(/[,/&]/g, '') // Remove commas, slashes, ampersands\r\n      .replace(/\\s+/g, '-')  // Replace spaces with hyphens\r\n      .toLowerCase();\r\n    return sanitizedCategory\r\n  }\r\n\r\n  const goToProductDetails = (item) => {\r\n    navigate(`/product/${manageURl(item.productName)}?uid=${encodeURIComponent(encryptCategoryID(item.productCode))}`);\r\n  }\r\n\r\n  return (\r\n\r\n    <div className=\"pool_product\">\r\n\r\n      <div className=\"pool_category\">\r\n        <Tabs defaultActiveKey=\"1\" onChange={handleTabChange} tabBarExtraContent={<ProductFilter setFilterBy={setFilterBy} setItemType={setItemType} />}>\r\n          <TabPane\r\n            tab={\r\n              <div className=\"pool_cate_img\">\r\n                <img\r\n                  src=\"https://cdn.icon-icons.com/icons2/3150/PNG/512/shopping_basket_food_grocieries_full_icon_192685.png\" // Replace with your hardcoded tab image\r\n                  alt=\"All Pool\"\r\n                />\r\n                <p>All Pool</p>\r\n              </div>\r\n            }\r\n            key=\"\"\r\n          >\r\n            <div className=\"cantent_tab\">\r\n              <Card\r\n                bordered={false}\r\n                // title=\"Buy Pool Product\"\r\n                id=\"cat_pro_card\"\r\n\r\n              >\r\n                <div className='all_product_list'>\r\n\r\n                  <div className={`${poolData?.length != 0 && \"showing_pro_by_cat\"}`}>\r\n\r\n                    {nextLoading ?\r\n                      <div className=\"showing_pro_by_cat\">\r\n                        {skeletonArray.map((_, index) => (\r\n                          <Card size=\"small\" className=\"mx-2 mb-2\" key={index}>\r\n                            <Skeleton.Image active />\r\n                            <Skeleton active paragraph={{ row: 6 }} />\r\n                          </Card>\r\n                        ))}\r\n                      </div>\r\n\r\n                      : poolData.length == 0 ? <div className='text-center'>\r\n                        <img src=\"https://www.aamtrading.com/assets/img/nproduct.png\" width=\"50%\" />\r\n                      </div> : poolData.map((item) => (\r\n                        <div className=\"product_card individual_card\">\r\n                          <Card\r\n                            hoverable\r\n                            disabled={item.stockQty == 0 && true}\r\n                          >\r\n                            <div className=\"card_img\">\r\n                              {item.imageUrl[0] != null ?\r\n                                <img\r\n                                  src={item.imageUrl[0] || BKDLogo}\r\n                                  onError={(e) => e.currentTarget.src = BKDLogo}\r\n                                  onClick={() => goToProductDetails(item)}\r\n                                />\r\n                                :\r\n                                <img\r\n                                  src={BKDLogo}\r\n                                  onClick={() => goToProductDetails(item)}\r\n                                />\r\n                              }\r\n                            </div>\r\n\r\n                            <div className=\"pro_name\" onClick={() => goToProductDetails(item)} >\r\n                              <Tooltip title={titleCase(item.productName)}>\r\n                                <p>{item.productName.length > 36 ? titleCase(item.productName.slice(0, 36)) + \"...\" : titleCase(item.productName)}</p>\r\n                              </Tooltip>\r\n                            </div>\r\n                            <div className=\"show_variant_item\" onClick={() => goToProductDetails(item)} >\r\n                              {item.packSize && item.packSize !== \"(NIL)\" ? <Tag color=\"green\">{item.packSize.substr(0, 10)}</Tag> : <p className=\"hidden_data\">N/A</p>}\r\n                              {item.stockQty <= out_of_stock ? <Tag color='red' className=\"stock_tag\">out of stock</Tag> : <p className='hidden_data'>N/A</p>}\r\n                            </div>\r\n                            <div className=\"show_price_mrp\">\r\n                              <p>BKD Price | MRP</p>\r\n                            </div>\r\n                            <div className=\"add_cart\">\r\n                              <p>{`₹ ${Math.round(item.bkdAmount)} `} <span>{item.bkdAmount != item.price && <del>₹ {item.price}</del>}</span> </p>\r\n\r\n                              {cartItems.find((cartItem) => cartItem.productCode === item.productCode) ? (\r\n                                cartItems.map((cartItem) => {\r\n                                  if (cartItem.productCode === item.productCode) {\r\n                                    return (\r\n                                      <>\r\n\r\n\r\n                                        <Button.Group size={screenWidth < 800 ? \"\" : 'small'} key={cartItem.productCode}>\r\n                                          <Button className=\"add_to_carts add_to_cart_button\" onClick={() => handleDelItem(item)}>-</Button>\r\n                                          <Button className=\"add_to_carts add_to_cart_button\">{cartItem.unit}</Button> {/* Access quantity from cart item */}\r\n                                          <Button className=\"add_to_carts add_to_cart_button\" onClick={() => handleAddItem(item)}>+</Button>\r\n                                        </Button.Group>\r\n                                      </>\r\n                                    );\r\n                                  }\r\n                                  return null;\r\n                                })\r\n                              ) : (\r\n                                <Button className=\"add_to_carts\" disabled={item.stockQty <= out_of_stock} type=\"default\" onClick={() => handleAddItem(item)}>ADD</Button>\r\n                              )}\r\n                            </div>\r\n\r\n                          </Card>\r\n                          {item.billingQty === \"PROMOTIONS\" || item.billingQty === \"DISCOUNT\" || item.offerQty === \"PROMOTIONS\" || item.offerQty === \"DISCOUNT\" ?\r\n                            <div className=\"discount_tags\">Super Saver Price</div> : item.billingQty != \"\" && item.offerQty != \"\" ?\r\n                              <div className=\"offer_Available\">\r\n                                {(item.billingQty === \"FOC\" || item.offerQty === \"FOC\") ?\r\n                                  <>\r\n                                    <img src={offerAvailable} />\r\n                                    <div className=\"offer_types\">\r\n                                      <p>1 Item</p>\r\n                                      <p>Free </p>\r\n                                      <p>On MRP</p>\r\n                                    </div>\r\n                                  </>\r\n                                  :\r\n                                  <img src={getOfferImage(item?.offerQty)} />\r\n                                }\r\n\r\n                              </div> : Math.round(item.bkdAmount) != item.price ? <div className=\"cat_tags\">{Math.round((item.price - item.bkdAmount) * 100 / item.price)}% off</div> : null}\r\n\r\n                          <div className=\"wish_list\">\r\n\r\n                            {token ?\r\n                              <div className='wish_list'>\r\n                                {\r\n                                  wishlist[item.productCode] ? (\r\n                                    <FaHeart\r\n                                      className=\"no_wish_icon\"\r\n                                      size={22}\r\n                                      color='red'\r\n                                      onClick={() => RemoveToWishList(item)}\r\n                                    />\r\n                                  ) : (\r\n                                    <FaRegHeart\r\n                                      className=\"no_wish_icon\"\r\n                                      size={22}\r\n                                      onClick={() => addToWishList(item)}\r\n                                    />\r\n                                  )\r\n                                }\r\n                              </div>\r\n\r\n                              :\r\n                              <div className='wish_list'>\r\n                                <FaRegHeart\r\n                                  className=\"no_wish_icon\"\r\n                                  size={22}\r\n                                  onClick={HnadleNotLogin}\r\n                                />\r\n                              </div>\r\n                            }\r\n                          </div>\r\n                        </div>\r\n                      ))\r\n                    }\r\n                  </div>\r\n\r\n                  <div ref={observerRef}>\r\n                    {isLoading && (\r\n                      <div className='text-center'><span className=\"loaderScroll\"></span></div>\r\n\r\n                      // <div className=\"showing_pro_by_cat\">\r\n                      //   {skeletonArray.map((_, index) => (\r\n                      //     <Card size=\"small\" className=\"mx-2 mb-2\" key={index}>\r\n                      //       <Skeleton.Image active />\r\n                      //       <Skeleton active paragraph={{ row: 6 }} />\r\n                      //     </Card>\r\n                      //   ))}\r\n                      // </div>\r\n                    )}\r\n                  </div>\r\n                </div>\r\n              </Card>\r\n            </div>\r\n          </TabPane>\r\n          {catList.map((item,) => (\r\n            <TabPane\r\n\r\n              onClick={() => handleClick(item)}\r\n              tab={\r\n                <>\r\n                  <div className=\"pool_cate_img\">\r\n                    <img\r\n                      src={item.imageUrl != null ? item.imageUrl : DefaultImg}\r\n                      onError={(e) => e.currentTarget.src = DefaultImg}\r\n                    />\r\n                    <p>{titleCase(item.categoryName?.substr(0, 10))}..</p>\r\n                  </div>\r\n                </>\r\n              }\r\n              key={item.categoryID}\r\n\r\n            >\r\n              <div className=\"cantent_tab\">\r\n                <Card\r\n                  bordered={false}\r\n                  // title=\"Buy Pool Product\"\r\n                  id=\"cat_pro_card\"\r\n\r\n                >\r\n                  <div className='all_product_list'>\r\n                    <div className={`${poolData?.length != 0 && \"showing_pro_by_cat\"}`}>\r\n                      {nextLoading ?\r\n                        skeletonArray.map((_, index) => (\r\n                          <Card size=\"small\" className=\"mx-2 mb-2\" key={index}>\r\n                            <Skeleton.Image active />\r\n                            <Skeleton active paragraph={{ row: 6 }} />\r\n                          </Card>\r\n                        ))\r\n                        : poolData.length == 0 ? <div className='text-center'>\r\n                          <img src=\"https://www.aamtrading.com/assets/img/nproduct.png\" width=\"50%\" />\r\n                        </div> : poolData.map((item) => (\r\n                          <div className=\"product_card individual_card\">\r\n                            <Card\r\n                              hoverable\r\n                              disabled={item.stockQty == 0 && true}\r\n                            >\r\n                              <div className=\"card_img\">\r\n                                {item.imageUrl[0] != null ?\r\n                                  <img\r\n                                    src={item.imageUrl[0] || BKDLogo}\r\n                                    onError={(e) => e.currentTarget.src = BKDLogo}\r\n                                    onClick={() => goToProductDetails(item)}\r\n                                  />\r\n                                  :\r\n                                  <img\r\n                                    src={BKDLogo}\r\n                                    onClick={() => goToProductDetails(item)}\r\n                                  />\r\n                                }\r\n\r\n                              </div>\r\n\r\n                              <div className=\"pro_name\" onClick={() => goToProductDetails(item)}>\r\n                                <Tooltip title={titleCase(item.productName)}>\r\n                                  <p>{item.productName.length > 36 ? titleCase(item.productName.slice(0, 36)) + \"...\" : titleCase(item.productName)}</p>\r\n                                </Tooltip>\r\n                              </div>\r\n                              <Space onClick={() => goToProductDetails(item)}>\r\n                                {item.packSize && item.packSize !== \"(NIL)\" ? <p>{item.packSize}</p> : null}\r\n                                {item.stockQty <= out_of_stock && <Tag color='red' className=\"stock_tag\">out of stock</Tag>}\r\n                              </Space>\r\n                              <div className=\"add_cart\">\r\n                                <Space>\r\n                                  <p>{`₹ ${Math.round(item.bkdAmount)} `}</p>\r\n                                  {item.bkdAmount != item.price && <p><del>₹ {item.price}</del></p>}\r\n                                </Space>\r\n                                {cartItems.find((cartItem) => cartItem.productCode === item.productCode) ? (\r\n                                  cartItems.map((cartItem) => {\r\n                                    if (cartItem.productCode === item.productCode) {\r\n                                      return (\r\n                                        <>\r\n\r\n\r\n                                          <Button.Group className=\"add_to_carts\" size={screenWidth < 800 ? \"\" : 'small'} key={cartItem.productCode}>\r\n                                            <Button className=\"add_to_carts add_to_cart_button\" onClick={() => handleDelItem(item)}>-</Button>\r\n                                            <Button className=\"add_to_carts add_to_cart_button\">{cartItem.unit}</Button> {/* Access quantity from cart item */}\r\n                                            <Button className=\"add_to_carts add_to_cart_button\" onClick={() => handleAddItem(item)}>+</Button>\r\n                                          </Button.Group>\r\n                                        </>\r\n                                      );\r\n                                    }\r\n                                    return null;\r\n                                  })\r\n                                ) : (\r\n                                  <Button disabled={item.stockQty <= out_of_stock} type=\"default\" onClick={() => handleAddItem(item)}>ADD</Button>\r\n                                )}\r\n                              </div>\r\n                            </Card>\r\n                            {isLoading && (\r\n                              <div className={`${poolData?.length != 0 && \"showing_pro_by_cat\"}`}>\r\n                                {skeletonArray.map((_, index) => (\r\n                                  <Card size=\"small\" className=\"mx-2 mb-2\" key={index}>\r\n                                    <Skeleton.Image active />\r\n                                    <Skeleton active paragraph={{ row: 6 }} />\r\n                                  </Card>\r\n                                ))}\r\n                              </div>\r\n                            )}\r\n                            {Math.round(item.bkdAmount) != item.price ? <div className=\"cat_tags\">{Math.round((item.price - item.bkdAmount) * 100 / item.price)}% off</div> : null}\r\n\r\n                            <div className=\"wish_list\">\r\n\r\n                              {token ?\r\n                                <div className='wish_list'>\r\n                                  {\r\n                                    wishlist[item.productCode] || item.isWhislist ? (\r\n                                      <FaHeart\r\n                                        className=\"no_wish_icon\"\r\n                                        size={22}\r\n                                        color='red'\r\n                                        onClick={() => RemoveToWishList(item)}\r\n                                      />\r\n                                    ) : (\r\n                                      <FaRegHeart\r\n                                        className=\"no_wish_icon\"\r\n                                        size={22}\r\n                                        onClick={() => addToWishList(item)}\r\n                                      />\r\n                                    )\r\n                                  }\r\n                                </div>\r\n\r\n                                :\r\n                                <div className='wish_list'>\r\n                                  <FaRegHeart\r\n                                    className=\"no_wish_icon\"\r\n                                    size={22}\r\n                                    onClick={HnadleNotLogin}\r\n                                  />\r\n                                </div>\r\n                              }\r\n                            </div>\r\n                          </div>\r\n                        ))\r\n                      }\r\n                    </div>\r\n                    <div ref={observerRef}>\r\n\r\n                    </div>\r\n                  </div>\r\n                </Card>\r\n              </div>\r\n            </TabPane>\r\n          ))}\r\n        </Tabs>\r\n      </div>\r\n      <div ref={observerRef}>\r\n        {isLoading && (\r\n          <div className=\"showing_pro_by_cat\">\r\n            {skeletonArray.map((_, index) => (\r\n              <Card size=\"small\" className=\"mx-2 mb-2\" key={index}>\r\n                <Skeleton.Image active />\r\n                <Skeleton active paragraph={{ row: 6 }} />\r\n              </Card>\r\n            ))}\r\n          </div>\r\n        )}\r\n      </div>\r\n    </div>\r\n\r\n  );\r\n}\r\n\r\nexport default PoolOrderProduct;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\Product\\ProductDetails.jsx",["948","949","950","951","952","953","954"],[],"import React, { useEffect, useState } from \"react\";\r\nimport { Col, Row } from \"react-bootstrap\";\r\nimport ZoomProduct from \"./ZoomProduct\";\r\nimport \"../../style/product.css\"\r\nimport ProductData from \"./ProductData\";\r\nimport BrandScroll from \"../home/BrandScroll\";\r\nimport RacipiSlider from \"../Racipe/RacipiSlider\";\r\nimport ProductDetailTabs from \"./ProductDetailTabs\";\r\nimport { Divider, Skeleton, notification } from \"antd\";\r\nimport { useScreen } from \"../auth/AuthScreen\";\r\nimport { useLocation, useParams } from \"react-router-dom\";\r\nimport { AddProductWishlist, particularProductDetails } from \"../apiService/api\";\r\nimport SimilarProduct from \"./SimilarProduct\";\r\nimport { useAuth, useCategotyLayout } from \"../auth/context/authContext\";\r\nimport Footers from \"../footer/Footers\";\r\nimport { decryptCategoryID } from \"../../config/encriptConfig\";\r\n\r\nfunction ProductDetails() {\r\n  const { token, nearStore } = useAuth()\r\n  const { screenWidth } = useScreen()\r\n  const [productInfo, setProductInfo] = useState([])\r\n  console.log(\"productInfo\", productInfo)\r\n  const [isLoading, setIsLoading] = useState(false)\r\n  // const { state } = useLocation()\r\n\r\n  // // const location = useLocation();\r\n\r\n  const searchParams = new URLSearchParams(useLocation().search);\r\n  const encryptedCode = searchParams.get(\"uid\");\r\n  const state = encryptedCode ? decryptCategoryID(decodeURIComponent(encryptedCode)) : null;\r\n  console.log(\"statestatestatestatestate\", state)\r\n\r\n  useEffect(() => {\r\n    const handlePopState = (event) => {\r\n      // Prevent unnecessary API calls when going back\r\n      if (event.state && event.state.isNavigatedBack) {\r\n        console.log(\"Navigated back using browser back button\");\r\n        // Do nothing, or update the UI accordingly without triggering an API call\r\n      }\r\n    };\r\n\r\n    // Listen for popstate events\r\n    window.addEventListener(\"popstate\", handlePopState);\r\n\r\n    return () => {\r\n      window.removeEventListener(\"popstate\", handlePopState);\r\n    };\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    // Check if the user manually navigated to this page and not via back button\r\n    if (!state?.isNavigatedBack) {\r\n      // Call the API or fetch the data only when user directly navigates to the page\r\n      console.log(\"User navigated normally, fetch data here\");\r\n    }\r\n  }, [state]);\r\n\r\n\r\n  const ShowProductDetails = async () => {\r\n    setIsLoading(true)\r\n    try {\r\n      await particularProductDetails(state, token, nearStore?.branchCode)\r\n        .then((res) => {\r\n          console.log(\"product Information\", res);\r\n          if (res.status == 200) {\r\n            setProductInfo(res.data.data);\r\n            setIsLoading(false)\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          console.log(err.message);\r\n        });\r\n    } catch (error) {\r\n      console.log(error);\r\n      setIsLoading(false)\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    ShowProductDetails();\r\n  }, [state, nearStore]);\r\n\r\n\r\n  return (\r\n    <section>\r\n\r\n      <div className=\"product_indevisual\">\r\n        {isLoading ? <Skeleton className=\"mt-2\" active title={true} paragraph={{ rows: 6 }} /> :\r\n          <div className=\"pro_details\">\r\n            <Row>\r\n              <Col md={6}>\r\n                <ZoomProduct productInfo={productInfo} />\r\n                {/* <ProductMegnify  productInfo={productInfo}/> */}\r\n              </Col>\r\n              <Col md={6}>\r\n                <ProductData productId={state} productInfo={productInfo} ShowProductDetails={ShowProductDetails} />\r\n              </Col>\r\n            </Row>\r\n            <div className=\"similar_product\">\r\n              {/* <ProductDetailTabs productInfo={productInfo} ShowProductDetails={ShowProductDetails} /> */}\r\n              <Divider dashed />\r\n              <SimilarProduct productInfo={productInfo} ShowProductDetails={ShowProductDetails} />\r\n              <BrandScroll title={\"Similar Brand\"} screenWidth={screenWidth} productInfo={productInfo} />\r\n              <RacipiSlider screenWidth={screenWidth} productCode={state} />\r\n\r\n            </div>\r\n          </div>\r\n        }\r\n      </div>\r\n      <Footers />\r\n    </section>\r\n  );\r\n}\r\n\r\nexport default ProductDetails;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\cms\\Aboutus.jsx",["955","956"],[],"import React, { useEffect, useState } from 'react'\r\nimport { Container } from 'react-bootstrap'\r\nimport \"../../style/cms.css\"\r\nimport { fetchAbouts, fetchTermCondition } from '../apiService/api';\r\nimport { Skeleton } from 'antd';\r\nimport parse from 'html-react-parser';\r\n\r\nfunction Aboutus() {\r\n    const [aboutData, setAboutsData] = useState([])\r\n    const [isLoading, setIsLoading] = useState(false)\r\n\r\n\r\n    const ShowBKDAboutus = async () => {\r\n        try {\r\n            await fetchAbouts()\r\n                .then((res) => {\r\n                    console.log(\"about  \", res);\r\n                    if (res.status == 200) {\r\n                        setAboutsData(res.data.data);\r\n                        setIsLoading(true)\r\n\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err);\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n            setIsLoading(true)\r\n        }\r\n    };\r\n    useEffect(() => {\r\n        ShowBKDAboutus()\r\n    }, [])\r\n    return (\r\n        <Container>\r\n            <div className=\"terms\">\r\n                <div className=\"term_title\">\r\n\r\n                    <h4>About Us</h4>\r\n                    <p>Last Update : {aboutData.modifiedDate}</p>\r\n                </div>\r\n                {!isLoading ? <Skeleton active title={false} paragraph={{ rows: 6 }} /> :\r\n                    <p>{parse(aboutData?.description)}</p>}\r\n            </div>\r\n        </Container>\r\n    )\r\n}\r\n\r\n\r\n\r\n\r\nexport default Aboutus","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\cms\\TermCondition.jsx",["957"],[],"import React, { useEffect, useState } from 'react'\r\nimport { Container } from 'react-bootstrap'\r\nimport \"../../style/cms.css\"\r\nimport { fetchTermCondition } from '../apiService/api';\r\nimport { Skeleton } from 'antd';\r\nimport parse from 'html-react-parser';\r\n\r\n\r\nfunction TermCondition() {\r\n    const [termData, setTermData] = useState([])\r\n    const [isLoading, setIsLoading] = useState(false)\r\n\r\n\r\n    const ShowTermCondition = async () => {\r\n        try {\r\n            await fetchTermCondition()\r\n                .then((res) => {\r\n                    console.log(\"term  condition\", res);\r\n                    if (res.status == 200) {\r\n                        setTermData(res.data.data);\r\n                        setIsLoading(true)\r\n\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err);\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n            setIsLoading(true)\r\n        }\r\n    };\r\n    useEffect(() => {\r\n        ShowTermCondition()\r\n    }, [])\r\n    return (\r\n        <Container>\r\n\r\n            <div className=\"terms\">\r\n                <div className=\"term_title\">\r\n                    <h4>Terms & Conditions</h4>\r\n                    <p>Last Update : {termData.modifiedDate}</p>\r\n                </div>\r\n                {!isLoading ? <Skeleton active title={false} paragraph={{ rows: 6 }} /> :\r\n                    <p>{parse(termData?.description)}</p>}\r\n            </div>\r\n        </Container>\r\n    )\r\n}\r\n\r\nexport default TermCondition\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\cms\\PrivecyPolicy.jsx",["958","959"],[],"import React, { useEffect, useState } from 'react'\r\nimport { Container } from 'react-bootstrap'\r\nimport \"../../style/cms.css\"\r\nimport { fetchPrivacyPolicy, fetchTermCondition } from '../apiService/api';\r\nimport { Skeleton } from 'antd';\r\nimport parse from 'html-react-parser';\r\n\r\nfunction PrivecyPolicy() {\r\n    const [policyData, setPolicyData] = useState([])\r\n    const [isLoading, setIsLoading] = useState(false)\r\n\r\n\r\n    const ShowPrivacyPolicy = async () => {\r\n        try {\r\n            await fetchPrivacyPolicy()\r\n                .then((res) => {\r\n                    console.log(\"term  condition\", res);\r\n                    if (res.status == 200) {\r\n                        setPolicyData(res.data.data);\r\n                        setIsLoading(true)\r\n\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err);\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n            setIsLoading(true)\r\n        }\r\n    };\r\n    useEffect(() => {\r\n        ShowPrivacyPolicy()\r\n    }, [])\r\n    return (\r\n        <Container>\r\n            <div className=\"terms\">\r\n                <div className=\"term_title\">\r\n                    <h4>Privacy Policy</h4>\r\n                    <p>Last Update : {policyData.modifiedDate}</p>\r\n                </div>\r\n                {!isLoading ? <Skeleton active title={false} paragraph={{ rows: 6 }} /> :\r\n                    <p>{parse(policyData?.description)}</p>}\r\n            </div>\r\n        </Container>\r\n    )\r\n}\r\n\r\n\r\n\r\nexport default PrivecyPolicy","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\Category\\ExploreCategory.jsx",["960","961","962","963","964","965","966","967","968"],[],"import React, { useEffect, useState } from \"react\";\r\nimport SideBar from \"./SideBar\";\r\nimport \"../../style/Category.css\"\r\nimport HeaderTabs from \"./HeaderTabs\";\r\nimport Footers from \"../footer/Footers\";\r\nimport { Card, Skeleton, Tabs } from \"antd\";\r\nimport { useCategotyLayout } from \"../auth/context/authContext\";\r\nimport { FetchCategoryItem } from \"../apiService/api\";\r\nimport { useParams } from \"react-router-dom\";\r\nimport Logo from \"../../assest/bkdlogo.png\";\r\n\r\nconst { TabPane } = Tabs;\r\n\r\nfunction ExploreCateory() {\r\n  const { id } = useParams()\r\n  console.log(\"cat id\", id)\r\n\r\n  return (\r\n    <>\r\n      <div className=\"show_all_category\">\r\n        <div className=\"category_section\">\r\n          <SideBar />\r\n        </div>\r\n        <Footers />\r\n      </div>\r\n\r\n    </>\r\n  );\r\n}\r\n\r\nexport default ExploreCateory;\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\page\\NoConnection.jsx",["969"],[],"import React from 'react'\r\nimport NotInternet from '../assest/png/isOnline.png'\r\nimport '../App.css'\r\n\r\nfunction NoConnection() {\r\n    return (\r\n        <div className='offline'>\r\n            <img src={NotInternet} />\r\n            <p>Network Connection Failed</p>\r\n        </div>\r\n    )\r\n}\r\n\r\nexport default NoConnection","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\account\\wallet\\Wollets.jsx",["970","971","972","973","974","975","976","977"],[],"import React, { useState } from \"react\";\r\nimport \"../../../style/account.css\";\r\nimport { Button, Card, Divider, List } from \"antd\";\r\nimport { useNavigate } from \"react-router-dom\";\r\nimport WalletRedeem from \"./WalletRedeem\";\r\n\r\nfunction Wollets() {\r\n  const [sugar,setSugar]=useState(5.5)\r\n  const navigate=useNavigate()\r\n  return (\r\n    <div className=\"wallet\">\r\n      {/* <Card title=\"My Sugar Wallet\">\r\n        <div className=\"wallet_title\">\r\n          <div className=\"wallet_amt\">\r\n            <p>Total Sugar Reward</p>\r\n            <h3>{sugar} KG</h3>\r\n           <WalletRedeem sugar={sugar}/>\r\n          </div>\r\n          <img src=\"https://www.freepnglogos.com/uploads/sugar-png/sugar-png-transparent-images-pictures-photos-png-arts-26.png\" />\r\n        </div>\r\n        <Divider dashed/>\r\n        <div className=\"show_transsion\">\r\n          <div className=\"show_transaction_title\">\r\n            <p>Recent Activity</p>\r\n          </div>\r\n          <Divider ></Divider>\r\n          <div className=\"trans_list\">\r\n            {TransationData().map((item)=><List bordered>\r\n              <List.Item extra={item.trans===\"credit\" ? <p className=\"Sugar_credit\">+{item.total}</p> : <p className=\"Sugar_debit\">-{item.total}</p>}  >\r\n                <List.Item.Meta avatar={<img src={item.url} className=\"sugarImg\"/>} title={item.title} description={<p>{item.trans} {item.date}</p>}/>\r\n              </List.Item>\r\n           \r\n            </List>)}\r\n          </div>\r\n        </div>\r\n      </Card> */}\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Wollets;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\account\\accountMenu\\MyAccounts.jsx",["978","979","980","981","982","983"],[],"import React, { useState } from 'react';\r\nimport { Button, Layout, Menu, notification, theme } from 'antd';\r\nimport routes from './SideBarRoute';\r\nimport { NavLink, Outlet, useLocation, useNavigate } from 'react-router-dom';\r\nimport \"../../../style/account.css\"\r\nimport { HiOutlineArrowNarrowLeft } from \"react-icons/hi\";\r\n// import { useAuth } from '../../auth/context/authContext';\r\nimport { BiLogOutCircle } from \"react-icons/bi\";\r\n\r\nconst { Header, Content, Sider } = Layout;\r\n\r\nconst MyAccounts = () => {\r\n    const navigate = useNavigate()\r\n    const [collapsed, setCollapsed] = useState(false);\r\n    // const { logout } = useAuth()\r\n    const location = useLocation()\r\n\r\n    const {\r\n        token: { colorBgContainer, borderRadiusLG },\r\n    } = theme.useToken();\r\n\r\n    // const handleLogout = () => {\r\n    //     logout()\r\n    //     notification.error({\r\n    //         placement: \"topRight\",\r\n    //         message: \"you are succesfully logout\",\r\n\r\n    //     });\r\n    // }\r\n    return (\r\n        <div className=\"my_accnt\">\r\n            <Layout>\r\n                <div className='account_head'>\r\n                    <Header>\r\n                        <div className=\"header_title\">\r\n                            {/* <Button shape='circle' type='link' onClick={() => navigate(-1)} icon={<HiOutlineArrowNarrowLeft className='back_icon' />}> </Button> */}\r\n                            <p>My Account</p>\r\n                        </div>\r\n                        {/* <div className=\"profile_greed\">\r\n                            <Button type='link' danger size='large' icon={<BiLogOutCircle />} onClick={handleLogout} >Logout</Button>\r\n                        </div> */}\r\n                    </Header>\r\n                </div>\r\n                <div className=\"account_layout\">\r\n                    <Layout>\r\n                        <Sider trigger={null} collapsible collapsed={collapsed} width={240}>\r\n                            <Menu theme=\"light\" mode=\"inline\" defaultSelectedKeys={[`${location?.state?.key}`]}>\r\n                                {routes.map((route, index) => {\r\n                                    return (\r\n                                        <Menu.Item key={route.key} icon={route.icons}>\r\n                                            <NavLink to={route.path}> {route.label}</NavLink>\r\n                                        </Menu.Item>\r\n                                    );\r\n                                })}\r\n                            </Menu>\r\n                        </Sider>\r\n                        <Layout\r\n                        >\r\n                            <Content\r\n                                style={{\r\n                                    padding: 24,\r\n                                    margin: 0,\r\n                                    minHeight: 260,\r\n                                    background: colorBgContainer,\r\n                                    borderRadius: borderRadiusLG,\r\n                                }}\r\n                            >\r\n                                <Outlet />\r\n                            </Content>\r\n                        </Layout>\r\n                    </Layout>\r\n                </div>\r\n            </Layout>\r\n        </div>\r\n    );\r\n};\r\nexport default MyAccounts;","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\checkout\\UserPayment.jsx",["984","985","986","987","988","989","990","991","992","993","994","995","996"],[],"import React, { useEffect, useState } from 'react'\r\nimport { useLocation, useNavigate } from 'react-router-dom'\r\nimport { FetchAllOrderList, getPaymentStatus } from '../apiService/api'\r\nimport { useAuth } from '../auth/context/authContext'\r\nimport OrderPlace from './OrderPlace'\r\nimport { Button, Descriptions, message, Modal, Space } from 'antd'\r\nimport '../../style/order.css'\r\nimport PaymentSuccessImg from '../../assest/pay-success.gif'\r\nimport { clearCart, setSelctedOffer } from '../../redux/CartSlice'\r\nimport { addProduct, setDeliveryCahrge, setDeliveryLocation, setDeliveryType, setDiscountAmount, setDiscountDetails, setPayableAmount, setPaymentMode, setSubTotalAmount } from '../../redux/OrderSlice'\r\nimport { useDispatch } from 'react-redux'\r\nimport FaildedImg from \"../../assest/cancel-payment.gif\"\r\nimport PendingImage from \"../../assest/initiat-gif.gif\"\r\n\r\nfunction UserPayment() {\r\n    const { token, logout } = useAuth()\r\n    const [isModalOpen, setIsModalOpen] = useState(false);\r\n    const [isLoading, setIsloading] = useState(false);\r\n    const [getStatus, setGetStatus] = useState(null)\r\n    const navigate = useNavigate();\r\n    const location = useLocation()\r\n    const [showPendingMsg, setShowPendingMsg] = useState(false)\r\n    const dispatch = useDispatch()\r\n    const query = new URLSearchParams(useLocation().search);\r\n    const paymentOrderId = query.get('paymentOrderId');\r\n    const orderId = query.get('userOrderId');\r\n    const capitalize = (str) => str?.charAt(0).toUpperCase() + str?.slice(1).toLowerCase();\r\n\r\n\r\n\r\n\r\n    const fetchPayementStatus = async () => {\r\n        setIsloading(true)\r\n        try {\r\n            await getPaymentStatus(token, orderId, paymentOrderId)\r\n                .then((res) => {\r\n                    console.log(\"payment status\", res);\r\n                    if (res.status == 200) {\r\n                        setGetStatus(res.data.data)\r\n                        setIsloading(false)\r\n                    } else if (res.status == 283) {\r\n                        message.error(res.data.message)\r\n                        logout()\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n            setIsloading(false)\r\n        }\r\n    };\r\n\r\n    useEffect(() => {\r\n        fetchPayementStatus();\r\n    }, []);\r\n\r\n    //new initial status handle\r\n\r\n    useEffect(() => {\r\n        let intervalId;\r\n        let timeoutId;\r\n\r\n        const startPolling = () => {\r\n            // call immediately\r\n            fetchPayementStatus();\r\n\r\n            // start polling every 10 seconds\r\n            intervalId = setInterval(fetchPayementStatus, 10000);\r\n\r\n            // stop polling after 1 minute\r\n            console.log(\"call timing\", intervalId)\r\n            timeoutId = setTimeout(() => {\r\n                clearInterval(intervalId);\r\n                setShowPendingMsg(true);\r\n            }, 60000);\r\n        };\r\n\r\n        startPolling(); // initial call\r\n        return () => {\r\n            clearInterval(intervalId);\r\n            clearTimeout(timeoutId);\r\n        };\r\n    }, []);\r\n\r\n    setTimeout(() => {\r\n        showModal()\r\n    }, 300)\r\n\r\n    const showModal = () => {\r\n        setIsModalOpen(true);\r\n    };\r\n    const handleOk = () => {\r\n        setIsModalOpen(false);\r\n    };\r\n    const handleCancel = () => {\r\n        setIsModalOpen(false);\r\n        handlegotoHome()\r\n    };\r\n\r\n\r\n\r\n    const handlegotoHome = () => {\r\n        const orderId = new URLSearchParams(window.location.search).get(\"paymentOrderId\");\r\n        console.warn(\"orderId123\", orderId)\r\n        if (orderId) {\r\n            // Set payment status in localStorage, so the original tab can read it\r\n            localStorage.setItem(\"paymentStatus\", \"success\"); // or \"failure\" if the payment failed\r\n            if (getStatus?.paymentStatus === \"CANCELLED\" || getStatus?.paymentStatus === \"FAILED\") {\r\n                navigate(\"/checkout/DELIVERY\")\r\n            } else {\r\n                localStorage.removeItem(\"delivery_location\")\r\n                localStorage.removeItem(\"updatedeliveryCharge\")\r\n                localStorage.removeItem(\"orderType\")\r\n                localStorage.removeItem(\"payment_mode\")\r\n                localStorage.removeItem(\"cart\")\r\n                dispatch(clearCart())\r\n                dispatch(setDiscountDetails(null))\r\n                dispatch(setDeliveryLocation(null))\r\n\r\n                dispatch(setDeliveryCahrge(0))\r\n\r\n                dispatch(setDiscountAmount(0))\r\n                dispatch(addProduct(null))\r\n                dispatch(setSubTotalAmount(0))\r\n                dispatch(setDeliveryType(null))\r\n                dispatch(setPaymentMode(null))\r\n                dispatch(setPayableAmount(0))\r\n                dispatch(setSelctedOffer(null))\r\n                navigate('/')\r\n            }\r\n\r\n        }\r\n    }\r\n    const handlegotoOrder = () => {\r\n        const orderId = new URLSearchParams(window.location.search).get(\"paymentOrderId\");\r\n        console.warn(\"orderId123\", orderId)\r\n        localStorage.removeItem(\"delivery_location\")\r\n        localStorage.removeItem(\"orderType\")\r\n        localStorage.removeItem(\"payment_mode\")\r\n        localStorage.removeItem(\"cart\")\r\n        localStorage.removeItem(\"selected_Store\")\r\n        localStorage.removeItem(\"saveAmount\")\r\n        localStorage.removeItem(\"payment_mode\")\r\n        localStorage.removeItem(\"paybleAmount\")\r\n        localStorage.removeItem(\"updatedeliveryCharge\")\r\n        localStorage.removeItem(\"discountAmount\")\r\n        localStorage.removeItem(\"actualAmount\")\r\n\r\n        // dispatch(setDeliveryCahrge(0))\r\n\r\n        dispatch(clearCart())\r\n        dispatch(setDiscountDetails(null))\r\n        dispatch(setDeliveryLocation(null))\r\n\r\n        dispatch(setDeliveryCahrge(0))\r\n\r\n        dispatch(setDiscountAmount(0))\r\n        dispatch(addProduct(null))\r\n        dispatch(setSubTotalAmount(0))\r\n        dispatch(setDeliveryType(null))\r\n        dispatch(setPaymentMode(null))\r\n        dispatch(setPayableAmount(0))\r\n        dispatch(setSelctedOffer(null))\r\n        navigate(`/account/order`)\r\n    }\r\n\r\n    // const getPaymentStatus = () => {\r\n    //     if (getStatus?.paymentStatus === \"SUCCESS\") {\r\n\r\n    //         <div className=\"order_payment_status\">\r\n    //             <div className=\"ordered_place\">\r\n    //                 <img src={PaymentSuccessImg} />\r\n    //             </div>\r\n    //             <h5 className='order_paid'>Your payment has been successfully !</h5>\r\n    //             <h4>Order {getStatus?.paymentStatus} !!</h4>\r\n    //             <h2>₹{getStatus?.amountPaid}</h2>\r\n    //             <p>\r\n    //                 Transaction id : {getStatus?.txnId}\r\n    //             </p>\r\n    //             <p>\r\n    //                 Order id : {getStatus?.orderCode}\r\n    //             </p>\r\n    //             <p>\r\n    //                 Date time: {getStatus?.paidDateTime}\r\n    //             </p>\r\n    //             <div className=\"goto_home\">\r\n    //                 <Space>\r\n    //                     <Button size=\"large\"\r\n    //                         onClick={handlegotoOrder}\r\n    //                     > My Order</Button>\r\n    //                     <Button size=\"large\"\r\n    //                         onClick={handlegotoHome}\r\n    //                     > Home</Button>\r\n    //                 </Space>\r\n    //             </div>\r\n    //         </div>\r\n\r\n    //     } else if (getStatus?.paymentStatus === \"INITIATED\") {\r\n\r\n    //         <div>\r\n    //             <div className=\"ordered_faild\">\r\n    //                 <img src={PendingImage} />\r\n    //             </div>\r\n    //             <h5 className='pendiong_pay'>Your payment has been Pending !</h5>\r\n    //             {showPendingMsg && <p>! Your order is still pending. Please generate a query against the Payment Order ID : {paymentOrderId} </p>}\r\n\r\n    //         </div>\r\n\r\n\r\n    //     } else if (getStatus?.paymentStatus === \"CANCELLED\") {\r\n    //         <div>\r\n    //             <div className=\"ordered_faild\" >\r\n    //                 <img src={FaildedImg} />\r\n    //             </div>\r\n    //             <h5 className='faild_pay'>Your payment has been cancelled !</h5>\r\n    //             <div className=\"goto_home\">\r\n    //                 <Button size=\"large\"\r\n    //                     onClick={handlegotoHome}\r\n    //                 > Back</Button>\r\n\r\n    //             </div>\r\n    //         </div>\r\n\r\n    //     } else if (getStatus?.paymentStatus === \"FAILED\") {\r\n\r\n    //         <div>\r\n    //             <div className=\"ordered_faild\" >\r\n    //                 <img src={FaildedImg} />\r\n    //             </div>\r\n    //             <h5 className='faild_pay'>Your payment has been failed !</h5>\r\n    //             <div className=\"goto_home\">\r\n    //                 <Button size=\"large\"\r\n    //                     onClick={handlegotoHome}\r\n    //                 > Back</Button>\r\n    //             </div>\r\n    //         </div>\r\n\r\n    //     }\r\n    // }\r\n\r\n\r\n    const ShowPaymentStatus = () => {\r\n        if (getStatus?.paymentStatus === \"SUCCESS\") {\r\n            return (\r\n\r\n                <div className=\"order_payment_status\">\r\n                    <div className=\"order_place ordered_place\">\r\n                        <img src={PaymentSuccessImg} />\r\n                    </div>\r\n                    <h5 className='order_paid'>Your payment has been successfully!</h5>\r\n                    <h4>Order Placed!!</h4>\r\n                    <h2>₹{getStatus?.amountPaid}</h2>\r\n                    <p>Transaction id : {getStatus?.txnId}</p>\r\n                    <p>Order id : {getStatus?.orderCode}</p>\r\n                    <p>Date time: {getStatus?.paidDateTime}</p>\r\n                    <div className=\"goto_home\">\r\n                        <Space>\r\n                            <Button size=\"large\" onClick={handlegotoOrder}>My Order</Button>\r\n                            <Button size=\"large\" onClick={handlegotoHome}>Home</Button>\r\n                        </Space>\r\n                    </div>\r\n                </div>\r\n            );\r\n        } else if (getStatus?.paymentStatus === \"INITIATED\") {\r\n            return (\r\n                <div>\r\n                    <div className=\"ordered_faild\">\r\n                        <img src={PendingImage} />\r\n                    </div>\r\n                    <h5 className='pendiong_pay'>Please wait, Your payment is pending!</h5>\r\n                    {showPendingMsg && (\r\n                        <p className='pendiong_pay'> Your order is still pending. Please generate a query against the Payment Order ID : <strong>{paymentOrderId}</strong></p>\r\n                    )}\r\n                </div>\r\n            );\r\n        } else if (getStatus?.paymentStatus === \"CANCELLED\") {\r\n            return (\r\n                <div>\r\n                    <div className=\"ordered_faild\">\r\n                        <img src={FaildedImg} />\r\n                    </div>\r\n                    <h5 className='faild_pay'>Your payment has been cancelled!</h5>\r\n                    <div className=\"goto_home\">\r\n                        <Button size=\"large\" onClick={handlegotoHome}>Back</Button>\r\n                    </div>\r\n                </div>\r\n            );\r\n        } else if (getStatus?.paymentStatus === \"FAILED\") {\r\n            return (\r\n                <div>\r\n                    <div className=\"ordered_faild\">\r\n                        <img src={FaildedImg} />\r\n                    </div>\r\n                    <h5 className='faild_pay'>Your payment has been failed!</h5>\r\n                    <div className=\"goto_home\">\r\n                        <Button size=\"large\" onClick={handlegotoHome}>Back</Button>\r\n                    </div>\r\n                </div>\r\n            );\r\n        }\r\n\r\n        return null; // fallback if none of the conditions match\r\n    };\r\n\r\n    return (\r\n        <div>\r\n            <Modal\r\n                loading={isLoading}\r\n                footer={false}\r\n                closable={false}\r\n                open={isModalOpen}\r\n                closeIcon={false}\r\n                onOk={handleOk}\r\n                onCancel={handleCancel}\r\n                maskClosable={false}\r\n                width={400}\r\n            >\r\n                <div className=\"order_place_data\">\r\n                    {ShowPaymentStatus()}\r\n\r\n                </div>\r\n            </Modal >\r\n        </div >\r\n    )\r\n}\r\n\r\nexport default UserPayment\r\n\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\address\\AddressManage.jsx",["997","998","999","1000","1001","1002","1003","1004"],[],"import { Avatar, Button, Card, List, Popconfirm, Skeleton, notification } from \"antd\";\r\nimport React, { useEffect, useState } from \"react\";\r\nimport { MdDeleteOutline, MdOutlineHome, MdOutlineHomeWork, MdOutlineLocationOn, MdOutlineModeEdit } from \"react-icons/md\";\r\nimport AddressDrawer from \"./AddressDrawer\";\r\n\r\nimport { GetSaveLocation, deleteAddress } from \"../apiService/api\";\r\nimport { useAuth } from \"../auth/context/authContext\";\r\nimport '../../style/account.css'\r\nimport UpdateAddress from \"./UpdateAddress\";\r\nfunction AddressManage() {\r\n  const [saveAddress, setSaveAddress] = useState([])\r\n  const [isLoading, setIsLoading] = useState(false)\r\n  const { token,logout } = useAuth()\r\n\r\n  const ShowSaveAddress = async () => {\r\n    try {\r\n      await GetSaveLocation(token)\r\n        .then((res) => {\r\n          console.log(\"save list address\", res);\r\n          if (res.status == 200) {\r\n            setSaveAddress(res.data.data);\r\n            setIsLoading(true)\r\n          }else if (res.status === 283) {\r\n            notification.error({\r\n              placement: \"topRight\",\r\n              message: res.data.message,\r\n            });\r\n            logout()\r\n          }\r\n\r\n        })\r\n        .catch((err) => {\r\n          console.log(err.message);\r\n        });\r\n    } catch (error) {\r\n      console.log(error);\r\n      setIsLoading(true)\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    ShowSaveAddress();\r\n  }, []);\r\n\r\n\r\n  const cancel = (e) => {\r\n    console.log(e);\r\n\r\n  };\r\n  //delete addresss\r\n  const DeleteHandler = async (id) => {\r\n    const body = {\r\n      locationId: id\r\n    }\r\n    try {\r\n      await deleteAddress(token, body)\r\n        .then((res) => {\r\n          console.log(\"del address\", res);\r\n          if (res.status == 201) {\r\n            notification.success({\r\n              placement: \"topRight\",\r\n              message: res.data.message,\r\n            });\r\n            ShowSaveAddress()\r\n\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          console.log(err);\r\n        });\r\n    } catch (error) {\r\n      console.log(error);\r\n\r\n    }\r\n  };\r\n\r\n\r\n\r\n  return (\r\n    <div className=\"manage_address\">\r\n      <Card title=\"All Saved Addresses\" extra={<AddressDrawer ShowSaveAddress={ShowSaveAddress} />}>\r\n\r\n        <List\r\n          className=\"demo-loadmore-list\"\r\n          itemLayout=\"horizontal\"\r\n          dataSource={saveAddress}\r\n          renderItem={(item) => (\r\n            <List.Item\r\n              actions={[\r\n                <UpdateAddress editData={item} ShowSaveAddress={ShowSaveAddress} />,\r\n                <Popconfirm\r\n                  placement=\"topRight\"\r\n                  title=\"Delete the Address\"\r\n                  description=\"Are you sure to delete this Address?\"\r\n                  onConfirm={() => DeleteHandler(item._id)}\r\n                  onCancel={cancel}\r\n                  okText=\"Yes\"\r\n                  cancelText=\"No\"\r\n                >\r\n                  <Button danger type=\"default\">Remove</Button>\r\n                </Popconfirm>\r\n\r\n\r\n              ]}\r\n            >\r\n              {!isLoading ? <Skeleton active avatar={{ shape: 'circle' }} title={false} paragraph={{ rows: 3 }} /> :\r\n                <List.Item.Meta\r\n                  avatar={item.addressType == \"HOME\" ? <MdOutlineHome className=\"addres_icon\" /> : item.addressType == \"OFFICE\" ? <MdOutlineHomeWork className=\"addres_icon\" /> : <MdOutlineLocationOn className=\"addres_icon\" />}\r\n                  title={<div>\r\n                    <p>{item.addressType}</p>\r\n                    <p>{item.mobileNo}</p>\r\n                  </div>}\r\n                  description={<div>\r\n                    <p>Full Address : {item.fullAddress}</p>\r\n                    <p>How to reach : {item.howToReach}</p>\r\n                  </div>}\r\n                />\r\n              }\r\n\r\n            </List.Item>\r\n          )}\r\n        />\r\n\r\n      </Card>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default AddressManage;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\account\\order\\MyOrder.jsx",["1005","1006","1007","1008","1009","1010","1011","1012","1013","1014"],[],"import React, { useCallback, useEffect, useRef, useState } from \"react\";\r\nimport Slider from \"react-slick\";\r\nimport DefaultImg from \"../../../assest/bkdlogo.png\"\r\n\r\n\r\nimport {\r\n  Avatar,\r\n  Button,\r\n  Card,\r\n  Divider,\r\n  Image,\r\n  List,\r\n  Skeleton,\r\n  Tag,\r\n  Timeline,\r\n  Tooltip,\r\n  Col, Row,\r\n  Empty,\r\n  Space,\r\n  notification,\r\n  Spin\r\n} from \"antd\";\r\n// import { Col, Row } from \"react-bootstrap\";\r\nimport \"../../../style/order.css\";\r\nimport { FcApproval } from \"react-icons/fc\";\r\nimport { useNavigate } from \"react-router-dom\";\r\nimport { FetchAllOrderList, MyAllOrderList } from \"../../apiService/api\";\r\nimport { useAuth } from \"../../auth/context/authContext\";\r\nimport Logo from '../../../assest/fixicon.png'\r\nimport ShowMoreText from 'react-show-more-text';\r\nimport { useScreen } from \"../../auth/AuthScreen\";\r\n\r\nfunction MyOrder() {\r\n  const [orderList, setOrderList] = useState([]);\r\n  const [isLoading, setIsLoading] = useState(false)\r\n  const [nextLoading, setNextLoading] = useState(false)\r\n  const [current, setCurrent] = useState(1)\r\n  const { token, logout } = useAuth()\r\n  const navigate = useNavigate();\r\n  const { screenWidth } = useScreen();\r\n  const [hasMore, setHasMore] = useState(true);\r\n  const observer = useRef();\r\n\r\n\r\n\r\n  function executeOnClick(isExpanded) {\r\n    console.log(isExpanded);\r\n  }\r\n  const ShowMyOrderList = async () => {\r\n    setIsLoading(true); // Start the loading state\r\n    setNextLoading(true)\r\n    try {\r\n      const res = await FetchAllOrderList(token, current);\r\n      if (res.status === 200) {\r\n        const fetchData = res.data.data;\r\n        // Append new data instead of replacing\r\n        setOrderList((prevOrderList) => [...prevOrderList, ...fetchData]);\r\n        setHasMore(fetchData.length > 0);\r\n        setIsLoading(true); // Start the loading state\r\n        setNextLoading(true)\r\n      } else if (res.status === 283) {\r\n        notification.error({\r\n          placement: \"topRight\",\r\n          message: res.data.message,\r\n        });\r\n        logout()\r\n      }\r\n    } catch (error) {\r\n      console.error(\"Error fetching order list:\", error.message);\r\n    } finally {\r\n      setIsLoading(false); // Ensure loading state is turned off\r\n      setNextLoading(false);\r\n    }\r\n  };\r\n\r\n  // Trigger data loading on component mount or when `current` changes\r\n  useEffect(() => {\r\n    ShowMyOrderList();\r\n  }, [current,]);\r\n\r\n  const getStatusColor = (status) => {\r\n    switch (status) {\r\n      case 'ACCEPTED':\r\n        return '#90D26D';\r\n      case 'ORDERPACKED':\r\n        return \"#219C90\";\r\n      case 'RETURN':\r\n        return \"#fc9d03\";\r\n      case \"REPLACE\":\r\n        return \"#7C00FE\";\r\n      case 'DISPATCHED':\r\n        return '#008DDA';\r\n      case 'RETURNED':\r\n        return '#008DDA';\r\n      case 'REPLACED':\r\n        return '#008DDA';\r\n      case 'REACHED':\r\n        return '#7E60BF';\r\n      case 'DELIVERED':\r\n        return '#87A922';\r\n      case 'RETURNACCEPTED':\r\n        return '#87A922';\r\n      case 'REPLACEACCEPTED':\r\n        return '#87A922';\r\n      case 'CANCELLED':\r\n        return '#FF204E';\r\n      case 'CLOSED':\r\n        return '#FF204E';\r\n      case 'RETURNREJECTED':\r\n        return '#FF204E';\r\n      case 'REPLACEREJECTED':\r\n        return '#FF204E';\r\n      default:\r\n        return '#B3A398';\r\n    }\r\n  };\r\n\r\n  const settings = {\r\n    dots: false,\r\n    adaptiveHeight: true,\r\n    infinite: true,\r\n    speed: 800,\r\n    arrows: true,\r\n    slidesToShow: 3,\r\n\r\n    slidesToScroll: 1,\r\n    autoplay: true,\r\n    loop: true,\r\n    autoplaySpeed: 3000,\r\n    draggable: false,\r\n    swipeToSlide: true,\r\n    swipe: true,\r\n  };\r\n\r\n\r\n  // Intersection Observer for infinite scrolling\r\n  const lastOrderElementRef = useCallback(\r\n    (node) => {\r\n      if (isLoading) return;\r\n      if (observer.current) observer.current.disconnect();\r\n\r\n      observer.current = new IntersectionObserver((entries) => {\r\n        if (entries[0].isIntersecting && hasMore) {\r\n          setCurrent((prevPage) => prevPage + 1);\r\n        }\r\n      });\r\n\r\n      if (node) observer.current.observe(node);\r\n    },\r\n    [nextLoading, hasMore]\r\n  );\r\n\r\n  return (\r\n    <div className={screenWidth > 800 ? \"container\" : \"\"}>\r\n      <div className=\"order_manage\">\r\n        <div className=\"my_order_title\">\r\n          <p>My Order ({orderList?.length})</p>\r\n        </div>\r\n        { orderList?.length == 0 ? <Empty image={Empty.PRESENTED_IMAGE_SIMPLE} /> :\r\n          <List\r\n            loading={isLoading }\r\n            className=\"order_item\"\r\n            itemLayout=\"horizontal\"\r\n            dataSource={orderList}\r\n            renderItem={(item) => (\r\n\r\n              <Card\r\n                actions={[<div className=\"act_btn\">\r\n                  {item.orderType !== \"RETREP\" ? <div className=\"show_del_pay_type\">\r\n                    <Button type=\"link\"><FcApproval className=\"deli_icon\" /> {item.deliveryOption}</Button>\r\n                    <Button type=\"link\"><Tag color={item.paymentMode === \"COD\" ? \"#FF6500\" : \"#90D26D\"} bordered={false}>{item.paymentMode}</Tag></Button>\r\n                  </div> : null}\r\n                </div>]}>\r\n                <List.Item actions={[<div className=\"total_status\" onClick={() => item.orderType === \"ORDER\" ? navigate(`/account/order-detail/${item._id}`) : navigate(`/account/return-order-detail/${item._id}`)} >\r\n                  <Tag key={item.orderCode} color={getStatusColor(item.status)}>{item.status}</Tag>\r\n                  {item.orderType === \"ORDER\" ?\r\n                    <p>Payable Amount : ₹ {item.totalPayableAmount?.toFixed(2)}</p> : item.status !== \"REPLACE\" ?\r\n                      <p>Refund Amount : ₹ {item.returnAmount?.toFixed(2)}</p> : null}\r\n                </div>]}>\r\n                  <List.Item.Meta\r\n                    onClick={() => item.orderType === \"ORDER\" ? navigate(`/account/order-detail/${item._id}`) : navigate(`/account/return-order-detail/${item._id}`)}\r\n                    avatar={<Avatar src={Logo} size={60} className=\"wish_imgs\" />}\r\n                    title={\r\n                      <div className=\"wish_title\">\r\n                        <p>{item.orderCode}</p>\r\n                      </div>\r\n                    }\r\n\r\n                    description={\r\n                      <div className=\"order_datas\">\r\n                        <p>Placed on : {item.addedDate},{item.addedTime}</p>\r\n                        {item.orderType === \"ORDER\" ?\r\n                          <p>Delivery on :  {item.status != \"DELIVERED\" ? <Tag color={item.addedDate === item.deliveryDate ? \"green\" : \"orange\"} bordered={false}>{item.deliveryDate} {item.timeSlotFrom}-{item.timeSlotTo}</Tag> : <span>{item.deliveredDate} {item.timeSlotFrom}-{item.timeSlotTo}</span>}</p> :\r\n                          <p>Delivery on :  {item.status === \"RETURN\" ? <Tag color={item.addedDate === item.timeSlotDate ? \"green\" : \"orange\"} bordered={false}>{item.timeSlotDate} {item.timeSlotFrom}-{item.timeSlotTo}</Tag> : <span>{item.deliveredDate} {item.timeSlotFrom}-{item.timeSlotTo}</span>}</p>}\r\n                      </div>\r\n                    }\r\n                  />\r\n                  <div className=\"product_order_item\">\r\n\r\n                    {item?.userOrderInfo?.length <= 3 ? item.userOrderInfo.map((url) => (\r\n                      <div className=\"total_pro_img\">\r\n\r\n                        {url.productImage != null ? <Image src={url.productImage} width={60} /> : <Image width={60} src=\"error\" fallback={DefaultImg} />\r\n                        }\r\n\r\n                      </div>\r\n                    )) : <div className=\"prodcut_slider_container\">\r\n\r\n                      <Slider {...settings}>\r\n                        {item.userOrderInfo.map((url) => (\r\n                          <div className=\"total_pro_img\">\r\n                            {url.productImage != null ? <Image src={url.productImage} width={60} /> : <Image width={60} src=\"error\" fallback={DefaultImg} />\r\n                            }\r\n                          </div>\r\n                        ))}\r\n                      </Slider>\r\n                    </div>}\r\n                  </div>\r\n                </List.Item>\r\n                <div className=\"mt-2\">\r\n                  <Row>\r\n                    <Col span={10}>\r\n                      <List.Item >\r\n                        <List.Item.Meta\r\n                          title=\"BKD Store\"\r\n                          description={\r\n                            <ShowMoreText\r\n                              lines={1} // Display only 2 lines before truncating\r\n                              more={<span className=\"View_more\">View more</span>}\r\n                              less={<span className=\"View_more\">View less</span>}\r\n\r\n                              anchorClass=\"show-more-less-clickable\"\r\n                              onClick={executeOnClick}\r\n                              expanded={false}\r\n                              //  width={200}\r\n                              truncatedEndingComponent={\"... \"}\r\n                            >\r\n                              <p>{item.branchInfo.fullAddress ? item.branchInfo.fullAddress : \"N/A\"}</p>\r\n                            </ShowMoreText>\r\n                          }\r\n                        />\r\n                      </List.Item>\r\n                    </Col>\r\n                    <Col span={2}>\r\n                      <Divider type=\"vertical\" style={{ height: '100%' }} />\r\n                    </Col>\r\n                    {item.deliveryOption != \"PICKUP\" ? <Col span={10}>\r\n                      <List.Item >\r\n                        <List.Item.Meta\r\n                          title={item.userLocationId?.addressType}\r\n                          description={\r\n                            <ShowMoreText\r\n                              lines={1} // Display only 2 lines before truncating\r\n                              more={<span className=\"View_more\">View more</span>}\r\n                              less={<span className=\"View_more\">View less</span>}\r\n\r\n                              anchorClass=\"show-more-less-clickable\"\r\n                              onClick={executeOnClick}\r\n                              expanded={false}\r\n                              //  width={200}\r\n                              truncatedEndingComponent={\"... \"}\r\n                            >\r\n                              <p>{item.userLocationId.fullAddress ? item.userLocationId.fullAddress : \"N/A\"}</p>\r\n                            </ShowMoreText>\r\n                          }\r\n                        />\r\n                      </List.Item>\r\n                    </Col> : null}\r\n                  </Row>\r\n                </div>\r\n              </Card>\r\n            )}\r\n          />}\r\n        <div ref={lastOrderElementRef} className=\"scroll_load mt-5\">\r\n          {nextLoading && <Spin    />}\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default MyOrder;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\cms\\FaqData.jsx",["1015","1016","1017","1018","1019","1020","1021","1022"],[],"import React, { useEffect, useState } from 'react'\r\nimport { Col, Container, Row } from 'react-bootstrap'\r\nimport \"../../style/cms.css\"\r\nimport { fetchAbouts, fetchFaqContact, fetchTermCondition } from '../apiService/api';\r\nimport { Button, Card, Collapse, Descriptions, Skeleton, Space } from 'antd';\r\nimport FaqImage from \"../../assest/png/faq.jpg\"\r\nimport { FcFeedback } from \"react-icons/fc\";\r\nimport { FcCallback } from \"react-icons/fc\";\r\n\r\n\r\nfunction FaqData() {\r\n    const [aboutData, setAboutsData] = useState([])\r\n    const [isLoading, setIsLoading] = useState(false)\r\n\r\n\r\n    const ShowBKDAboutus = async () => {\r\n        try {\r\n            await fetchFaqContact()\r\n                .then((res) => {\r\n                    console.log(\"faq  \", res);\r\n                    if (res.status == 200) {\r\n                        setAboutsData(res.data.data);\r\n                        setIsLoading(true)\r\n\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err);\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n            setIsLoading(true)\r\n        }\r\n    };\r\n    useEffect(() => {\r\n        ShowBKDAboutus()\r\n    }, [])\r\n    return (\r\n        <Container>\r\n            <div className=\"terms\">\r\n                <div className=\"term_title\">\r\n                    <h4>FAQ'S </h4>\r\n                    <div className='help_support'>\r\n                        <h5><a href={`tel:${aboutData.helpSupport?.mobileNo}`}><FcCallback /> {aboutData.helpSupport?.mobileNo}</a> </h5> |\r\n                        <h5><FcFeedback /> {aboutData.helpSupport?.email}</h5>\r\n                    </div>\r\n                </div>\r\n                {!isLoading ? <Skeleton active title={false} paragraph={{ rows: 6 }} /> :\r\n                    <Row className='faq_item'>\r\n                        <Col md={7}>\r\n\r\n                            <Collapse defaultActiveKey={['1']} >\r\n                                {aboutData?.faqList?.map((item) => (\r\n                                    <Collapse.Panel header={<strong>{item.question} ?</strong>} key={item._id}>\r\n                                        <p>{item?.answer}</p>\r\n                                    </Collapse.Panel>\r\n                                ))}\r\n                            </Collapse>\r\n                        </Col>\r\n                        <Col md={5}>\r\n                            <div className='faq_img'>\r\n                                <img src={FaqImage} />\r\n                            </div>\r\n                        </Col>\r\n                    </Row>\r\n                }\r\n            </div>\r\n        </Container>\r\n    )\r\n}\r\n\r\n\r\n\r\n\r\nexport default FaqData","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\account\\order\\OrderDetails.jsx",["1023","1024","1025","1026","1027","1028","1029","1030","1031","1032","1033","1034","1035","1036","1037","1038","1039","1040","1041","1042","1043","1044","1045","1046","1047","1048","1049","1050","1051","1052","1053","1054","1055","1056","1057","1058","1059","1060","1061","1062","1063","1064","1065","1066","1067"],[],"import React, { Component, useEffect, useState } from \"react\";\r\nimport Slider from \"react-slick\";\r\nimport { MdFindReplace } from \"react-icons/md\";\r\nimport { RiArrowGoBackFill } from \"react-icons/ri\";\r\nimport { BsArrowRepeat } from \"react-icons/bs\";\r\nimport {\r\n  Alert,\r\n  Avatar,\r\n  Button,\r\n  Card,\r\n  Collapse,\r\n  Descriptions,\r\n  Divider,\r\n  Empty,\r\n  Image,\r\n  List,\r\n  message,\r\n  Modal,\r\n  Rate,\r\n  Skeleton,\r\n  Space,\r\n  Tag,\r\n  Timeline,\r\n  Tooltip,\r\n} from \"antd\";\r\nimport { Col, Row } from \"react-bootstrap\";\r\nimport { IoIosCheckmarkCircle } from \"react-icons/io\";\r\nimport \"../../../style/order.css\";\r\nimport { RetweetOutlined, RollbackOutlined } from \"@ant-design/icons\";\r\nimport { MdHome } from \"react-icons/md\";\r\nimport { MdStorefront } from \"react-icons/md\";\r\nimport { useLocation, useNavigate, useParams } from \"react-router-dom\";\r\nimport Icon, { EyeOutlined } from \"@ant-design/icons\";\r\nimport { FcApproval, FcClock, FcCancel, FcOk, FcInfo } from \"react-icons/fc\";\r\nimport { ActionPayNow, CancelOrderProduct, fetchRemoveOrderItem, MyOrderDetails, RemoveOrderProduct } from \"../../apiService/api\";\r\nimport { useAuth } from \"../../auth/context/authContext\";\r\nimport { ExclamationCircleFilled } from '@ant-design/icons';\r\nimport { FaBox } from \"react-icons/fa\";\r\nimport DefaultImg from \"../../../assest/bkdlogo.png\"\r\nimport OrderReturn from \"./OrderReturn\";\r\nimport { GrMapLocation } from \"react-icons/gr\";\r\nimport { useScreen } from \"../../auth/AuthScreen\";\r\n\r\n\r\nimport PartnerRating from \"../../checkout/PartnerRating\";\r\nimport CancelOrderType from \"../../checkout/CancelOrderType\";\r\nfunction OrderDetails() {\n  const { id } = useParams();\n  const { token, logout } = useAuth()\n  const navigate = useNavigate();\n  const [orderData, setOrderData] = useState([])\r\n  const [isLoading, setIsloading] = useState(false)\r\n  const [isRemove, setIsRemove] = useState(null)\r\n  const [isPayLoading, setPayLoading] = useState(false)\r\n  const [removeData, setRemoveData] = useState([])\n  const { screenWidth } = useScreen();\n  const titleCase = str => str.toLowerCase().split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');\n\n  const formatCurrency = (value) => {\n    const amount = Number(value);\n    return `₹ ${Number.isFinite(amount) ? amount.toFixed(2) : \"0.00\"}`;\n  };\n\n  const getOrderItemAmount = (item) => {\n    const quantity = Number(item?.quantity ?? item?.unit ?? 0);\n    const lineAmount = Number(item?.bkdAmount);\n    const billingQty = Number(item?.requiredOfferedBillingQty);\n    const comboPrice = Number(item?.requiredOfferedBillingPrice);\n    const unitPrice = Number(item?.productPrice ?? item?.bkdAmount);\n    const offerQtyPerCombo = Number(item?.offerProduct?.offerQuantity ?? 1);\n    const comboTotalSize = item?.offerProduct && Number.isFinite(billingQty) && billingQty > 0\n      ? billingQty + (Number.isFinite(offerQtyPerCombo) ? offerQtyPerCombo : 0)\n      : 0;\n\n    if (comboTotalSize > 0 && Number.isFinite(comboPrice)) {\n      const totalComboBillingQty = Math.floor(quantity / comboTotalSize);\n      const totalNormalBillingQty = quantity - (totalComboBillingQty * comboTotalSize);\n      const remainderAmount = Number.isFinite(unitPrice) ? totalNormalBillingQty * unitPrice : 0;\n      return totalComboBillingQty * comboPrice + remainderAmount;\n    }\n\n    if (Number.isFinite(quantity) && quantity > 0 && Number.isFinite(unitPrice)) {\n      return quantity * unitPrice;\n    }\n\n    return Number.isFinite(lineAmount) ? lineAmount : 0;\n  };\n\r\n\r\n\r\n\r\n\r\n  const ShowMyOrderDetails = async () => {\r\n    try {\r\n      await MyOrderDetails(token, id)\r\n        .then((res) => {\r\n          console.log(\"order info\", res);\r\n          if (res.status == 200) {\r\n            setOrderData(res.data.data);\r\n            setIsloading(true)\r\n          } else if (res.data.code == 283) {\r\n            message.error(res.data.message)\r\n            logout()\r\n\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          console.log(err.message);\r\n        });\r\n    } catch (error) {\r\n      console.log(error);\r\n      setIsloading(true)\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    ShowMyOrderDetails();\r\n  }, []);\r\n\r\n\r\n  let orderStatus;\r\n  let actionBtn;\r\n  let cancelBtn;\r\n\r\n  if (orderData?.status == \"DISPATCHED\") {\r\n    orderStatus = <span><FcInfo className=\"deli_icon\" />Your  Order Dispatch</span>\r\n\r\n    cancelBtn = <Button type=\"primary\" danger disabled >Cancel</Button>\r\n\r\n  } else if (orderData?.status == \"ORDERPACKED\") {\r\n    orderStatus = <span><FaBox className=\"deli_icon\" />Your  Order Packed</span>\r\n\r\n    cancelBtn = <CancelOrderType orderId={id} ShowMyOrderDetails={ShowMyOrderDetails} />\r\n\r\n  } else if (orderData?.status == \"REACHED\") {\r\n    orderStatus = <span><GrMapLocation className=\"deli_icon\" />Delivery Partner reached your  location </span>\r\n\r\n    cancelBtn = <Button type=\"primary\" disabled danger >Cancel</Button>\r\n\r\n  } else if (orderData?.status == \"CANCELLED\") {\r\n    orderStatus = <span><FcCancel className=\"deli_icon\" />OOh! Your Order Cancelled</span>\r\n    cancelBtn = <Button type=\"primary\" danger disabled>Cancel</Button>\r\n\r\n  } else if (orderData?.status == \"DELIVERED\") {\r\n    orderStatus = <span><FcApproval className=\"deli_icon\" />Your  Order Delivered Successfully </span>\r\n    cancelBtn = <Button type=\"primary\" danger disabled>Cancel</Button>\r\n\r\n  } else if (orderData?.status == \"PLACED\") {\r\n    orderStatus = <span><FcClock className=\"deli_icon\" />Your  Order Placed </span>\r\n\r\n    cancelBtn = <CancelOrderType orderId={id} ShowMyOrderDetails={ShowMyOrderDetails} />\r\n  }\r\n\r\n  const getOrderItemRemoveAction = async () => {\r\n    try {\r\n      await fetchRemoveOrderItem(token)\r\n        .then((res) => {\r\n          console.log(\"remove action\", res);\r\n          if (res.status == 200) {\r\n            setIsRemove(res.data.data);\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          console.log(err.message);\r\n        });\r\n    } catch (error) {\r\n      console.log(error);\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    getOrderItemRemoveAction();\r\n  }, []);\r\n\r\n\r\n\r\n\r\n\r\n\r\n  //remov a particular order \r\n\r\n\r\n\r\n\r\n  const handelPayNow = async () => {\r\n    setPayLoading(true)\r\n\r\n    try {\r\n      await ActionPayNow(token, { userOrderId: id })\r\n        .then((res) => {\r\n          console.log(\"order place\", res);\r\n          if (res.status == 201) {\r\n            console.log(\"res\", res)\r\n            const payUrl = res.data.data.payment_links?.web\r\n            console.log(\"payUrl\", payUrl)\r\n            if (payUrl) {\r\n              window.location.href = payUrl;\r\n            }\r\n            setPayLoading(false)\r\n          }\r\n\r\n        })\r\n        .catch((err) => {\r\n          console.log(err);\r\n          setPayLoading(false)\r\n\r\n        });\r\n    } catch (error) {\r\n      console.log(error);\r\n      setPayLoading(false)\r\n    }\r\n  };\r\n\r\n\r\n  return (\r\n    <div className={screenWidth > 800 ? \"container\" : \"\"}>\r\n\r\n      <div className=\"order_manages\">\r\n        {!isLoading ? <Skeleton active avatar={{ shape: 'circle' }} title={false} paragraph={{ rows: 6 }} /> :\r\n          <>\r\n            {orderData?.cancelReason != \"\" ? <Alert className=\"mb-2\" message={` Order Cancel Reason  : ${orderData?.cancelReason}`} type=\"error\" />\r\n              : null}\r\n            <Card title={<div className=\"ord_info_titles\">\r\n              <p>{orderStatus}  {orderData?.statusDate ? <span>({orderData?.statusDate})</span> : null}</p>\r\n              <p>Placed on : {orderData.addedDate},{orderData.addedTime}</p>\r\n\r\n              {/* <p>{orderData?.deliveryOption === \"PICKUP\" ? \"Store Pickup on\" : \"Delivery on\"}:  {orderData.status != \"DELIVERED\" ? <Tag color={orderData.addedDate === orderData.deliveryDate ? \"green\" : \"orange\"} bordered={false}>{orderData.deliveryDate} {orderData.timeSlotFrom}-{orderData.timeSlotTo}</Tag> : <span>{orderData.deliveryDate} {orderData.timeSlotFrom}-{orderData.timeSlotTo}</span>}</p> */}\r\n            </div>} extra={\r\n              <Space >\r\n                {cancelBtn}\r\n                {orderData?.isOrderClose ? <Space>\r\n                  {/* <Button className=\"order_invoice\">Reorder</Button> */}\r\n                  <Button disabled={orderData?.status === \"CANCELLED\"} className=\"order_invoice\" icon={<EyeOutlined />}>View Invoice</Button>\r\n                </Space> : <Button className=\"order_invoice\" onClick={() => navigate(`/account/track_order/${orderData?._id}`, { state: { orderData } })}>Track Order</Button>}\r\n              </Space>\r\n\r\n            }>\r\n\r\n              {orderData?.totalSaving != 0 ?\r\n                <Alert\r\n                  message={\r\n                    <div className=\"save_order\">\r\n                      <p>₹ {orderData?.totalSaving?.toFixed(2)}</p>\r\n                      <span> Save of this Order</span>\r\n                    </div>\r\n                  }\r\n                  type=\"success\"\r\n                  style={{ textAlign: \"center\" }}\r\n                /> : null}\r\n              <Row className=\"mt-2\">\r\n                <Col md={6}>\r\n                  <Card bordered={false} title=\"Store  Location\" >\r\n                    <Descriptions >\r\n                      <Descriptions.Item span={3} label=\"Branch Code\">\r\n                        {orderData?.branchId?.branchCode}\r\n                      </Descriptions.Item>\r\n                      <Descriptions.Item span={3} label=\"Branch Name\">\r\n                        <p className=\"locations\">\r\n                          {titleCase(orderData?.branchId?.branchName)}\r\n                        </p>\r\n                      </Descriptions.Item>\r\n                      <Descriptions.Item span={3} label=\"Full Address\">\r\n                        <p className=\"locations\">\r\n                          {titleCase(orderData?.branchId?.fullAddress)}\r\n                        </p>\r\n                      </Descriptions.Item>\r\n                    </Descriptions>\r\n                  </Card>\r\n                </Col>\r\n                {orderData?.deliveryOption != \"PICKUP\" ? <Col md={6}>\r\n                  <Card bordered={false} title=\"Delivery  Location\">\r\n                    <Descriptions >\r\n                      <Descriptions.Item span={3} label=\"Address Type\">\r\n                        {orderData?.userLocationId?.addressType}\r\n                      </Descriptions.Item>\r\n                      <Descriptions.Item span={3} label=\"Full Address\">\r\n                        <div className=\"locations\"><p>{orderData?.userLocationId?.fullAddress}</p></div>\r\n                      </Descriptions.Item>\r\n                    </Descriptions>\r\n                  </Card>\r\n                </Col> : null}\r\n              </Row>\r\n              <div className=\"pay_opts\">\r\n                <Card title={<div className=\"remove_request\">\r\n                  <p>{`No of Item (${orderData?.productInfo?.length})`}</p>\r\n                  {/* <Space><span> Remove Selected Item :</span>\r\n                  <RemoveItemDetails ShowMyOrderDetails={ShowMyOrderDetails} removeData={removeData} UserOrderId={id} setRemoveData={setRemoveData} />\r\n                </Space> */}\r\n                </div>}>\r\n                  <List\r\n                    className=\"demo-loadmore-list\"\r\n                    itemLayout=\"horizontal\"\r\n                    dataSource={orderData?.productInfo}\r\n                    renderItem={(item, index) => (\r\n                      <>\r\n                        <List.Item\r\n                          actions={\n                            [\n\n                              <p className=\"order_Data_price\">{formatCurrency(getOrderItemAmount(item))} </p>\n\n                            ]}\n                        >\n                          <List.Item.Meta\r\n                            avatar={item.imageUrl != null ? <Image src={item.imageUrl} width={50} height={50} className=\"item_img\" /> : <Image width={50} height={50} src=\"error\" fallback={DefaultImg} className=\"item_img\" />\r\n                            }\r\n                            title={\r\n                              <div className=\"item_title\">\r\n                                <p>{titleCase(item.productName)}</p>\r\n                              </div>\r\n                            }\r\n                            description={\r\n                              <div className=\"order_data\">\r\n                                <Space>\r\n                                  <p>{item.packSize} .</p>\n                                  <p>Qty. {item.quantity} .</p>\n\n                                  <p>{formatCurrency(Number(item?.productPrice ?? item?.bkdAmount))}</p>\n                                </Space>\n                                <p>\n                                  <Tag bordered={false}>{item.returnReplaceComment}</Tag>\n                                </p>\r\n\r\n                                {/* <p className=\"order_Data_price\">₹ {item.productPrice} </p> */}\r\n                                {item.offerProduct ?\r\n                                  <List\r\n                                    className=\"demo-loadmore-list\"\r\n                                    itemLayout=\"horizontal\"\r\n                                    size=\"small\"\r\n                                  // style={{background:\"#eee\"}}\r\n\r\n                                  >\r\n                                    <List.Item\r\n\r\n                                    >\r\n                                      <List.Item.Meta\r\n                                        avatar={item.offerProduct.imageUrl != null ? <Image src={item.offerProduct.imageUrl} width={40} /> : <Image width={40} src=\"error\" fallback={DefaultImg} />\r\n                                        }\r\n\r\n                                        title={\r\n                                          <div className=\"item_title\">\r\n                                            <p>{titleCase(item.offerProduct.productName)}<span className=\"mx-2\"><Tag color=\"green\" bordered={false}>Offer </Tag></span></p>\r\n                                          </div>\r\n                                        }\r\n                                        description={\r\n                                          <div className=\"order_datas\">\r\n                                            <p >{item.offerProduct.packSize} . <span>Qty. {item.offerProduct.quantity}</span>  .  <strong className=\"order_Data_price\">Free </strong></p>\r\n\r\n                                          </div>\r\n                                        }\r\n                                      />\r\n\r\n                                    </List.Item>\r\n\r\n\r\n                                  </List>\r\n                                  : null}\r\n                              </div>\r\n                            }\r\n                          />\r\n\r\n                        </List.Item>\r\n                        {screenWidth < 800 ? <Divider /> : null}\r\n                      </>\r\n\r\n                    )}\r\n                  />\r\n                </Card>\r\n              </div>\r\n              <Card title=\"Bill Details\">\r\n\r\n                <div className=\"total_pay_amts\">\n                  <div className=\"total_items\">\n                    <p> MRP Total </p>\n                    <p>{formatCurrency(orderData?.mrpTotalProductAmount)}</p>\n                  </div>\n                  <div className=\"total_items\">\n                    <p> Sub Total </p>\n                    <p>{formatCurrency(orderData?.totalProductAmount)}</p>\n                  </div>\n                  {Number(orderData?.discountAmount) > 0 ? <div className=\"bill_items\">\n                    <p>\n                      {orderData?.referralCode ? `Referral (${orderData.referralCode})` : \"Discount / Referral\"}\n                      {orderData?.discountType ? (\n                        orderData?.discountType === \"FLAT\"\n                          ? <span> ({formatCurrency(orderData?.discountValue)})</span>\n                          : <span> ({orderData?.discountValue}% )</span>\n                      ) : null}\n                    </p>\n                    <p>{formatCurrency(orderData?.discountAmount)}</p>\n                  </div> : null}\n                  {(orderData?.couponCode || Number(orderData?.couponDiscountAmount) > 0) ? <div className=\"bill_items\">\n                    <p>\n                      {orderData?.couponCode ? `Coupon (${orderData.couponCode})` : \"Coupon Applied\"}\n                      {orderData?.couponDiscountValueType ? (\n                        orderData?.couponDiscountValueType === \"percentage\"\n                          ? <span> ({orderData?.couponDiscountValue}% off)</span>\n                          : <span> ({formatCurrency(orderData?.couponDiscountValue)} off)</span>\n                      ) : null}\n                    </p>\n                    <p>{formatCurrency(orderData?.couponDiscountAmount)}</p>\n                  </div> : null}\n                  <div className=\"bill_items\">\n                    <p>Delivery Charge</p>\n                    <p>{formatCurrency(orderData?.deliveryCharge)}</p>\n                  </div>\n                  <Divider dashed />\n                  <div className=\"total_items\">\n                    <p> Payable Amount</p>\n                    <p>{formatCurrency(orderData?.totalPayableAmount)}</p>\n                  </div>\n                </div>\n              </Card>\n              <div className=\"bill_sumraries\">\r\n                <Card title=\"Order Summary\">\r\n                  <Descriptions >\r\n                    <Descriptions.Item span={3} label=\"Order Id\">\r\n                      {orderData?.orderCode}\r\n                    </Descriptions.Item>\r\n                    <Descriptions.Item span={3} label=\"Payment Mode\">\r\n                      <Tag color={orderData?.paymentMode != \"COD\" ? \"#7ABA78\" : \"#F57D1F\"}>\r\n                        {orderData?.paymentMode}\r\n                      </Tag>\r\n                    </Descriptions.Item>\r\n                    <Descriptions.Item span={3} label=\"Delivery Type\">\r\n                      <Tag color={orderData?.deliveryOption == \"DELIVERY\" ? \"#7ABA78\" : \"#387ADF\"}>\r\n                        {orderData?.deliveryOption}\r\n                      </Tag>\r\n                    </Descriptions.Item>\r\n                    {/* {orderData?.deliveryOption == \"DELIVERY\" ? <Descriptions.Item span={3} label=\"Delivery To\">\r\n                    {orderData?.userLocationId?.area\r\n                    }\r\n                  </Descriptions.Item> : null} */}\r\n                    <Descriptions.Item span={3} label=\"Delivery Date \">\r\n                      {orderData.deliveryDate != null ? orderData.deliveryDate : orderData.effectiveDeliveryDate} {orderData.timeSlotFrom}-{orderData.timeSlotTo}\r\n                    </Descriptions.Item>\r\n                  </Descriptions>\r\n                  {\r\n                    orderData?.refundInfo != \"\" ? <Descriptions title=\"Refund Details\">\r\n                      <Descriptions.Item span={3} label=\"Refund Amount\">\r\n                        ₹ {orderData?.refundInfo.totalReturnableAmount}\r\n                      </Descriptions.Item>\r\n                      <Descriptions.Item span={3} label=\"Payment Status\">\r\n                        <Tag>{orderData?.refundInfo.isPaymentDone != true ? \"Processing\" : \"Done\"}</Tag>\r\n                      </Descriptions.Item>\r\n                      <Descriptions.Item span={3} label=\"status\">\r\n                        <Tag> {orderData?.refundInfo.status}</Tag>\r\n                      </Descriptions.Item>\r\n                    </Descriptions> : null\r\n                  }\r\n                </Card>\r\n              </div>\r\n              {orderData?.status === \"DELIVERED\" || orderData?.status === \"CLOSED\" ? <div className=\"show_rating\">\r\n                <Card title=\"Rating & Review\" className=\"mt-2\">\r\n                  {orderData.ratingReviewInfo ? <div>\r\n                    <p>Rating : <Rate disabled allowHalf defaultValue={orderData.ratingReviewInfo?.rating} /></p>\r\n                    <p>{orderData.ratingReviewInfo?.review != \"\" ? `Review : ${orderData.ratingReviewInfo?.review}` : null}</p>\r\n                  </div> :\r\n                    <Empty image={Empty.PRESENTED_IMAGE_SIMPLE} description={\r\n                      <p>\r\n                        Not Available any rating , Please give rating.\r\n                      </p>\r\n                    } >\r\n                      <PartnerRating ShowMyOrderDetails={ShowMyOrderDetails} />\r\n                    </Empty>}\r\n                </Card>\r\n              </div> : null}\r\n              {orderData?.status === \"DELIVERED\" && !orderData?.isOrderClose && orderData?.isOrderReturnAndReplace ? <div className=\"return_replace\">\r\n                <Space>\r\n\r\n                  <OrderReturn orderId={id} title=\"RETURN\" />\r\n                  <OrderReturn orderId={id} title=\"REPLACEMENT\" />\r\n                </Space>\r\n              </div> : null}\r\n              {!orderData?.isPaymentDone && orderData?.status !== \"DELIVERED\" ? <div className=\"return_replace\">\r\n                <Button loading={isPayLoading} className='pay_now_btn' disabled={orderData?.status === \"CANCELLED\"} shape=\"round\" onClick={handelPayNow}><Space><span>Pay Now</span> |  <strong>₹{orderData?.balanceAmount}</strong>\r\n                </Space></Button>\r\n              </div> : !orderData?.isPaymentDone && orderData?.status === \"CANCELLED\" ? null : null}\r\n            </Card>\r\n          </>\r\n        }\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default OrderDetails;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\account\\order\\ReturnReplaceTrack.jsx",["1068","1069","1070","1071","1072","1073"],[],"import React, { useEffect, useState } from \"react\";\r\nimport { Button, Card, Divider, Image, Skeleton, Tag } from \"antd\";\r\nimport \"../../../style/checkout.css\";\r\nimport { FiPhoneCall } from \"react-icons/fi\";\r\n\r\nimport { useLocation, useParams } from \"react-router-dom\";\r\nimport TrackImg from \"../../../assest/png/track-img.gif\"\r\nimport { ReturnAndReplacementTrack } from \"../../apiService/api\";\r\nimport { useAuth } from \"../../auth/context/authContext\";\r\nimport TrackStep from \"../../checkout/TrackStep\";\r\n\r\n\r\nfunction ReturnReplaceTrack() {\r\n  const { id } = useParams()\r\n  const { token } = useAuth()\r\n  // const [current, setCurrent] = useState(0);\r\n  const { state } = useLocation()\r\n  const [trackData, setTrackData] = useState([])\r\n  const [isLoading, setIsLoading] = useState(false)\r\n\r\n  const dispatchedStatus = trackData?.orderTrack?.find(\r\n    (track) => track.orderStatus === \"DISPATCHED\"\r\n  );\r\n\r\n  const PackStatus = trackData?.orderTrack?.find(\r\n    (track) => track.orderStatus === \"PACKED\"\r\n  );\r\n\r\n  const ShowOrderTrack = async () => {\r\n    setIsLoading(true)\r\n    try {\r\n      await ReturnAndReplacementTrack(token, id)\r\n        .then((res) => {\r\n          console.log(\"return order track\", res);\r\n          if (res.status == 200) {\r\n            setTrackData(res.data.data);\r\n            setIsLoading(false)\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          console.log(err.message);\r\n        });\r\n    } catch (error) {\r\n      console.log(error);\r\n      setIsLoading(false)\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    ShowOrderTrack();\r\n  }, []);\r\n\r\n  \r\n\r\n\r\n\r\n  return (\r\n    <div className=\"order_tracks\">\r\n      <Card>\r\n        {/* <TrackMap />/ */}\r\n        <img src={TrackImg} />\r\n      </Card>\r\n      {isLoading ? <Skeleton active /> :\r\n        <>\r\n          <div className=\"oder_way\">\r\n            <div className=\"order_tack\">\r\n              <p> {trackData?.lastUpdateDateTimeMessage} </p>\r\n              <p>{trackData?.lastUpdateDate}-{trackData?.lastUpdateTime}</p>\r\n            </div>\r\n            {!trackData?.orderOtp ? null : <div className=\"order_place_otp\">\r\n              <p>OTP</p>\r\n              <Tag color=\"green\">{trackData?.orderOtp}</Tag>\r\n            </div>}\r\n          </div>\r\n          <div className=\"track_timeline\">\r\n            <TrackStep currentStatus={trackData} />\r\n          </div>\r\n          <Divider dashed />\r\n          {dispatchedStatus && trackData?.deliveryOption === \"DELIVERY\" ? \r\n            <div className=\"delivery_boy_detials\">\r\n\r\n              <div className=\"delivey_boy\">\r\n                <div className=\"del_boy_img\">\r\n                  <Image src={trackData?.vendorDetails?.profilePic} width={80} height={80} style={{ borderRadius: \"6px\" }} />\r\n                </div>\r\n                <div className=\"del_boy_name\">\r\n                  <h5>Delivery Partner</h5>\r\n                  <p className=\"delivety_boy_title\">{trackData?.vendorDetails?.vendorName}</p>\r\n                  <p> <FiPhoneCall className=\"\" /> {trackData?.vendorDetails?.mobileNo}</p>\r\n                </div>\r\n              </div>\r\n              <div className=\"call_msg\">\r\n                <FiPhoneCall className=\"del_boy_suooport\" />\r\n              </div>\r\n            </div>:null}\r\n          {/* <Divider dashed /> */}\r\n          {/* <div className=\"cancel_order_type\">\r\n            \r\n            {trackData?.orderTrack?.length > 0 && !DeliveredStatus ? (\r\n              <CancelOrderType />\r\n            ) : (\r\n              <PartnerRating />\r\n            )}\r\n          </div> */}\r\n        </>\r\n      }\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default ReturnReplaceTrack;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\account\\order\\ReturnOrderDetails.jsx",["1074","1075","1076","1077","1078","1079","1080","1081","1082","1083","1084","1085","1086","1087","1088","1089","1090","1091","1092","1093","1094","1095","1096","1097","1098","1099","1100","1101","1102","1103","1104","1105","1106","1107","1108","1109","1110","1111","1112","1113","1114","1115","1116","1117","1118","1119","1120","1121"],[],"import React, { Component, useEffect, useState } from \"react\";\r\nimport Slider from \"react-slick\";\r\n\r\nimport {\r\n    Alert,\r\n    Avatar,\r\n    Button,\r\n    Card,\r\n    Collapse,\r\n    Descriptions,\r\n    Divider,\r\n    Image,\r\n    List,\r\n    message,\r\n    Modal,\r\n    Skeleton,\r\n    Space,\r\n    Tag,\r\n    Timeline,\r\n    Tooltip,\r\n} from \"antd\";\r\nimport { Col, Row } from \"react-bootstrap\";\r\nimport { IoIosCheckmarkCircle } from \"react-icons/io\";\r\nimport \"../../../style/order.css\";\r\nimport { AntDesignOutlined, UserOutlined } from \"@ant-design/icons\";\r\nimport { MdHome } from \"react-icons/md\";\r\nimport { MdStorefront } from \"react-icons/md\";\r\nimport { useLocation, useNavigate, useParams } from \"react-router-dom\";\r\nimport Icon, { EyeOutlined } from \"@ant-design/icons\";\r\nimport { FcApproval, FcClock, FcCancel, FcOk, FcInfo } from \"react-icons/fc\";\r\nimport { CancelOrderProduct, fetchRemoveOrderItem, FetchReturnOrderDetails, MyOrderDetails, RemoveOrderProduct } from \"../../apiService/api\";\r\nimport { useAuth } from \"../../auth/context/authContext\";\r\nimport { ExclamationCircleFilled } from '@ant-design/icons';\r\nimport { FaBox } from \"react-icons/fa\";\r\nimport DefaultImg from \"../../../assest/bkdlogo.png\"\r\nimport RemoveItemDetails from \"./RemoveItemDetails\";\r\nimport OrderReturn from \"./OrderReturn\";\r\nimport { GrMapLocation } from \"react-icons/gr\";\r\nimport { useScreen } from \"../../auth/AuthScreen\";\r\nimport {\r\n    CheckCircleOutlined,\r\n    ClockCircleOutlined,\r\n    CloseCircleOutlined,\r\n    ExclamationCircleOutlined,\r\n    MinusCircleOutlined,\r\n    SyncOutlined,\r\n} from '@ant-design/icons';\r\n\r\n\r\nfunction ReturnOrderDetails() {\r\n    const { id } = useParams();\r\n    const { token, logout } = useAuth()\r\n    const navigate = useNavigate();\r\n    const [orderData, setOrderData] = useState([])\r\n    const [isLoading, setIsloading] = useState(false)\r\n    const [isRemove, setIsRemove] = useState(null)\r\n    const [removeData, setRemoveData] = useState([])\r\n    const { screenWidth } = useScreen();\r\n\r\n\r\n\r\n    const showOrderCacelConfirm = () => {\r\n        Modal.confirm({\r\n            title: 'Do you want to Cancel this  Order?',\r\n            icon: <ExclamationCircleFilled />,\r\n            content: 'if you are click on ok your order is cancel',\r\n            onOk() {\r\n                cancelOrderHandler()\r\n            },\r\n            onCancel() {\r\n                message.warning('Cancel');\r\n            },\r\n        });\r\n    };\r\n\r\n    let orderStatus;\r\n    let actionBtn;\r\n    let cancelBtn;\r\n\r\n\r\n    if (orderData?.status === \"RETURNVENDORACCEPTED\" || orderData?.status === \"REPLACEVENDORACCEPTED\" || orderData?.status === \"RETURNED\" || orderData?.status === \"REPLACED\") {\r\n        orderStatus = <span><GrMapLocation className=\"deli_icon\" />{`Your  Order ${orderData?.status == \"RETURNVENDORACCEPTED\" || orderData?.status == \"RETURNED\" ? \"Returned\" : \"Replaced\"}`}  </span>\r\n\r\n    } else if (orderData?.status === \"RETURNREJECTED\" || orderData?.status === \"RETURNREJECTED\") {\r\n        orderStatus = <span><FcCancel className=\"deli_icon\" />{`Your  Order ${orderData?.status == \"RETURNREJECTED\" ? \"Return Rejected\" : \"Replace Rejected\"}`} </span>\r\n\r\n    } else if (orderData?.status === \"RETURNACCEPTED\" || orderData?.status === \"REPLACEACCEPTED\") {\r\n        orderStatus = <span><FcApproval className=\"deli_icon\" />{`Your  Order ${orderData?.status == \"RETURNACCEPTED\" ? \"Return Accepted\" : \"Replace Accepted\"}`}  </span>\r\n\r\n    } else if (orderData?.status === \"RETURNASSIGNED\" || orderData?.status === \"REPLACEASSIGNED\") {\r\n        orderStatus = <span><FcApproval className=\"deli_icon\" />{`Your  Order ${orderData?.status == \"RETURNASSIGNED\" ? \"Return Accepted\" : \"Replace Accepted\"}`}  </span>\r\n\r\n    } else if (orderData?.status == \"RETURNPENDING\" || orderData?.status == \"REPLACEPENDING\") {\r\n        orderStatus = <span><FcClock className=\"deli_icon\" />{`Your  Order ${orderData?.status == \"RETURNPENDING\" ? \"Return Pending\" : \"Replace Pending\"}`} </span>\r\n\r\n    }\r\n\r\n\r\n\r\n    const ShowMyOrderDetails = async () => {\r\n        try {\r\n            await FetchReturnOrderDetails(token, id)\r\n                .then((res) => {\r\n                    console.log(\"return order info\", res);\r\n                    if (res.status == 200) {\r\n                        setOrderData(res.data.data);\r\n                        setIsloading(true)\r\n                    } else if (res.data.code == 283) {\r\n                        message.error(res.data.message)\r\n                        logout()\r\n\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n            setIsloading(true)\r\n        }\r\n    };\r\n\r\n    useEffect(() => {\r\n        ShowMyOrderDetails();\r\n    }, []);\r\n\r\n    const cancelOrderHandler = async () => {\r\n        const body = {\r\n            userOrderId: id,\r\n        }\r\n        try {\r\n            await CancelOrderProduct(token, body)\r\n                .then((res) => {\r\n                    console.log(\"order cancel\", res);\r\n                    if (res.status == 201) {\r\n                        message.success(res.data.message)\r\n                        ShowMyOrderDetails()\r\n\r\n                    }\r\n\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err);\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n        }\r\n    };\r\n\r\n    return (\r\n        <div className={screenWidth > 800 ? \"container\" : \"\"}>\r\n\r\n            <div className=\"order_manages\">\r\n                {!isLoading ? <Skeleton active avatar={{ shape: 'circle' }} title={false} paragraph={{ rows: 6 }} /> :\r\n                    <>\r\n                        {orderData?.rejectReason != \"\" ? <Alert className=\"mb-2\" message={` Order Reject or Replace  Reason  : ${orderData?.rejectReason || \"N/A\"}`} type=\"error\" />\r\n                            : null}\r\n                        <Card title={<div className=\"ord_info_titles\">\r\n                            <p>{orderStatus}</p>\r\n                            <p>Order Code : {orderData?.orderCode}</p>\r\n                            <p>Placed on : {orderData.addedDate}</p>\r\n                            <p>Return Slot:  {orderData.status != \"DELIVERED\" ? <Tag color={orderData.addedDate === orderData.deliveryDate ? \"green\" : \"orange\"} bordered={false}>{orderData.timeSlotDate} {orderData.timeSlotFrom}-{orderData.timeSlotTo}</Tag> : <span>{orderData.timeSlotDate} {orderData.timeSlotFrom}-{orderData.timeSlotTo}</span>}</p>\r\n                        </div>}\r\n                            extra={\r\n                                <Space >\r\n                                    {cancelBtn}\r\n                                    {orderData?.isOrderClose ? <Space>\r\n                                        <Button className=\"order_invoice\">Reorder</Button>\r\n                                        <Button className=\"order_invoice\" icon={<EyeOutlined />}>View Invoice</Button>\r\n                                    </Space> : <Button className=\"order_invoice\" onClick={() => navigate(`/account/return-track_order/${orderData?._id}`, { state: { orderData } })}>Track Order</Button>}\r\n                                </Space>\r\n                            }>\r\n\r\n                            {/* {orderData?.totalSaving != 0 ?\r\n                            <Alert\r\n                                message={\r\n                                    <div className=\"save_order\">\r\n                                        <p>₹ {orderData?.totalSaving}</p>\r\n                                        <span> Save of this Order</span>\r\n                                    </div>\r\n                                }\r\n                                type=\"success\"\r\n                                style={{ textAlign: \"center\" }}\r\n                            /> : null} */}\r\n                            <Row>\r\n                                {orderData?.userLocationId ? <Col md={6}>\r\n                                    <Card bordered={false} title=\"From  Location\">\r\n                                        <Descriptions >\r\n                                            <Descriptions.Item span={3} label=\"Address Type\">\r\n                                                {orderData?.userLocationId?.addressType}\r\n                                            </Descriptions.Item>\r\n                                            <Descriptions.Item span={3} label=\"Full Address\">\r\n                                                {orderData?.userLocationId?.fullAddress}\r\n                                            </Descriptions.Item>\r\n                                        </Descriptions>\r\n                                    </Card>\r\n                                </Col> : null}\r\n                                <Col md={6}>\r\n                                    <Card bordered={false} title=\"To Location\">\r\n                                        <Descriptions >\r\n                                            <Descriptions.Item span={3} label=\"Branch Code\">\r\n                                                {orderData?.branchId?.branchCode}\r\n                                            </Descriptions.Item>\r\n                                            <Descriptions.Item span={3} label=\"Branch Name\">\r\n                                                {orderData?.branchId?.branchName}\r\n                                            </Descriptions.Item>\r\n\r\n                                            <Descriptions.Item span={3} label=\"Full Address\">\r\n                                                {orderData?.branchId?.fullAddress}\r\n                                            </Descriptions.Item>\r\n\r\n                                        </Descriptions>\r\n                                    </Card>\r\n                                </Col>\r\n                            </Row>\r\n                            <div className=\"pay_opts\">\r\n                                <Card title={<div className=\"remove_request\">\r\n                                    <p>{`${orderData?.type !== \"REPLACEMENT\" ? \"Return Item\" : \"Replace Item\"} (${orderData?.productInfo?.length})`}</p>\r\n                                </div>}\r\n\r\n                                >\r\n                                    <List\r\n                                        className=\"demo-loadmore-list\"\r\n                                        itemLayout=\"horizontal\"\r\n                                        dataSource={orderData?.productInfo}\r\n                                        renderItem={(item, index) => (\r\n                                            <List.Item\r\n                                                actions={[<div className=\"return_img\">\r\n                                                    <span> Return Image :</span> <Image src={item.returnReplaceImage} width={50} height={50} />\r\n\r\n                                                </div>, <strong>₹ {item.offerProduct ? item?.requiredOfferedBillingPrice || 0 : item.productPrice} </strong>\r\n                                                ]}\r\n                                            >\r\n                                                <List.Item.Meta\r\n                                                    avatar={item.imageUrl != null ? <Image src={item.imageUrl} width={50} /> : <Image width={50} src=\"error\" fallback={DefaultImg} />\r\n                                                    }\r\n                                                    title={\r\n                                                        <div className=\"item_title\">\r\n                                                            <p>{item.productName}</p>\r\n                                                        </div>\r\n                                                    }\r\n                                                    description={\r\n                                                        <div className=\"order_data\">\r\n                                                            <p>{item.packSize}</p>\r\n                                                            <Space>\r\n                                                                <span>Qty. {item.quantity}</span>\r\n                                                                <span>x</span>\r\n                                                                <span>₹{item.offerProduct ? item.requiredOfferedBillingPrice : item.productPrice}</span>\r\n                                                            </Space>\r\n                                                            {item.offerProduct !== null ?\r\n                                                                <List\r\n                                                                    className=\"demo-loadmore-list\"\r\n                                                                    itemLayout=\"horizontal\"\r\n                                                                    size=\"small\"\r\n                                                                ><List.Item >\r\n                                                                        <List.Item.Meta\r\n                                                                            avatar={item.offerProduct.imageUrl != null ? <Image src={item.offerProduct.imageUrl} width={40} /> : <Image width={45} src=\"error\" fallback={DefaultImg} />\r\n                                                                            }\r\n                                                                            title={\r\n                                                                                <div className=\"item_title\">\r\n                                                                                    <p>{item.offerProduct.productName}<span className=\"mx-2\"><Tag color=\"green\" bordered={false}>Offer </Tag></span></p>\r\n                                                                                </div>\r\n                                                                            }\r\n                                                                            description={\r\n                                                                                <div className=\"order_datas\">\r\n                                                                                    <p >{item.offerProduct.packSize} . <span>Qty. {item.offerProduct.quantity}</span>  .  <strong className=\"order_Data_price\">Free </strong></p>\r\n\r\n                                                                                </div>\r\n                                                                            }\r\n                                                                        />\r\n                                                                    </List.Item></List>\r\n                                                                : null}\r\n                                                        </div>\r\n                                                    }\r\n                                                />\r\n                                            </List.Item>\r\n                                        )}\r\n                                    />\r\n                                </Card>\r\n                            </div>\r\n                            <Alert\r\n                                message={\r\n                                    `Reason :   ${orderData?.reason}`\r\n                                }\r\n                                type=\"info\"\r\n                            />\r\n                            {orderData?.type !== \"REPLACEMENT\" ?\r\n                                <div className=\"bill_sumraries\">\r\n                                    <Card title=\"Refund Details\">\r\n\r\n                                        <Descriptions >\r\n                                            <Descriptions.Item span={3} label=\"Refund on\">\r\n                                                {orderData?.refundInfo?.bank ? <div>\r\n                                                    <p>Bank</p>\r\n\r\n                                                </div> : orderData?.refundInfo?.upi ? <div>\r\n                                                    <p>UPI</p>\r\n                                                </div> : <div>\r\n                                                    <p>Online</p>\r\n                                                </div>}\r\n\r\n                                            </Descriptions.Item>\r\n                                            <Descriptions.Item span={3} label=\"Refund Amount\">\r\n                                                ₹ {orderData?.returnAmount}\r\n                                            </Descriptions.Item>\r\n\r\n                                            <Descriptions.Item span={3} label=\"Refund Status\">\r\n                                                <Tag> {orderData?.refundInfo?.status}</Tag>\r\n                                            </Descriptions.Item>\r\n                                        </Descriptions>\r\n\r\n                                    </Card>\r\n                                </div> : null}\r\n                        </Card>\r\n                    </>}\r\n            </div >\r\n        </div >\r\n    );\r\n}\r\n\r\n\r\nexport default ReturnOrderDetails","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\utils\\CalculateSubTotal.js",[],[],"C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\cart\\BeforeCheckoutAllView.jsx",["1122","1123","1124","1125","1126","1127","1128","1129","1130","1131","1132","1133","1134","1135"],[],"import { Badge, Button, Card, Col, Divider, Row, Skeleton, Space, Tag, notification } from \"antd\";\r\nimport React, { useEffect, useRef, useState } from \"react\";\r\nimport Slider from \"react-slick\";\r\nimport \"../../style/header.css\";\r\nimport { FaHeart, FaRegHeart } from \"react-icons/fa\";\r\nimport { useNavigate, useParams } from \"react-router-dom\";\r\nimport { MdArrowRightAlt, MdKeyboardBackspace } from \"react-icons/md\";\r\nimport { useScreen } from \"../auth/AuthScreen\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { addItem, removeItem, selectCartItems } from \"../../redux/CartSlice\";\r\nimport { useAuth } from \"../auth/context/authContext\";\r\nimport { AddProductWishlist, fetchBeforeCheckoutItem, FetchBrandProduct, out_of_stock } from \"../apiService/api\";\r\nimport DefaultImg from \"../../assest/bkdlogo.png\";\r\n\r\nfunction BeforeCheckoutAllView() {\r\n    const { id } = useParams();\r\n  const { screenWidth } = useScreen()\r\n\r\n    const { token, nearStore } = useAuth();\r\n    const [productList, setProductList] = useState([]);\r\n    const [loading, setLoading] = useState(false);\r\n    const [current, setCurrent] = useState(1);\r\n    const [noData, setNoData] = useState(false);\r\n    const navigate = useNavigate();\r\n    const dispatch = useDispatch();\r\n    const cartItems = useSelector(selectCartItems);\r\n    const observerRef = useRef(null);\r\n    const [wishlist, setWishlist] = useState({});\r\n    const skeletonArray = new Array(productList?.length || screenWidth < 1400 ? 12 : 14).fill(0);\r\n\r\n\r\n    const handleAddItem = (item) => {\r\n        dispatch(addItem(item));\r\n    };\r\n\r\n    useEffect(() => {\r\n        localStorage.setItem(\"cart\", JSON.stringify(cartItems));\r\n    }, [cartItems]);\r\n\r\n    const handleDelItem = (item) => {\r\n        dispatch(removeItem(item));\r\n        const cart = JSON.parse(localStorage.getItem(\"cart\")) || [];\r\n        const updatedCart = cart.filter(cartItem => cartItem.productCode !== item.productCode);\r\n        localStorage.setItem(\"cart\", JSON.stringify(updatedCart));\r\n    };\r\n\r\n    const HnadleNotLogin = () => {\r\n        notification.error({\r\n            placement: \"topRight\",\r\n            message: \"Please login before add wishlist\",\r\n        });\r\n    };\r\n\r\n    const addToWishList = async (proCode) => {\r\n        setWishlist((prev) => ({ ...prev, [proCode.productCode]: true })); // Immediately update the icon\r\n        const body = { productCode: proCode.productCode, productName: proCode.productName, status: \"ACTIVE\" };\r\n        try {\r\n            await AddProductWishlist(token, body)\r\n                .then((res) => {\r\n                    if (res.status === 201) {\r\n                        notification['success']({\r\n                            placement: \"topRight\",\r\n                            message: \"Added Product To Wishlist\",\r\n                        });\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n                    setWishlist((prev) => ({ ...prev, [proCode]: false })); // Revert the icon if the API call fails\r\n                    notification['error']({\r\n                        placement: \"topRight\",\r\n                        message: \"Failed to Add Product To Wishlist\",\r\n                    });\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n            setWishlist((prev) => ({ ...prev, [proCode]: false })); // Revert the icon if the API call fails\r\n        }\r\n    };\r\n\r\n    const RemoveToWishList = async (proCode) => {\r\n        setWishlist((prev) => ({ ...prev, [proCode.productCode]: false })); // Immediately update the icon\r\n        const body = { productCode: proCode.productCode, productName: proCode.productName, status: \"INACTIVE\" };\r\n        try {\r\n            await AddProductWishlist(token, body)\r\n                .then((res) => {\r\n                    if (res.status === 201) {\r\n                        notification['warning']({\r\n                            placement: \"topRight\",\r\n                            message: \"Removed Product From Wishlist\",\r\n                        });\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n                    setWishlist((prev) => ({ ...prev, [proCode]: true })); // Revert the icon if the API call fails\r\n                    notification['error']({\r\n                        placement: \"topRight\",\r\n                        message: \"Failed to Remove Product From Wishlist\",\r\n                    });\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n            setWishlist((prev) => ({ ...prev, [proCode]: true })); // Revert the icon if the API call fails\r\n        }\r\n    };\r\n\r\n\r\n    const ShowBeforeCheckoutItem = async () => {\r\n        setLoading(true);\r\n        try {\r\n            const res = await fetchBeforeCheckoutItem(nearStore?.branchCode);\r\n            console.log(\"view before checkout\", res);\r\n            if (res.status === 200) {\r\n                setProductList(prevData => [...prevData, ...res.data.data]);\r\n                setNoData(res.data.data.length === 0);\r\n            }\r\n        } catch (error) {\r\n            console.log(error);\r\n        } finally {\r\n            setLoading(false);\r\n        }\r\n    };\r\n\r\n    useEffect(() => {\r\n        ShowBeforeCheckoutItem();\r\n    }, [current]);\r\n\r\n    useEffect(() => {\r\n        const observer = new IntersectionObserver(\r\n            (entries) => {\r\n                if (entries[0].isIntersecting && !loading && !noData) {\r\n                    setCurrent(prevPage => prevPage + 1);\r\n                }\r\n            },\r\n            { threshold: 1.0 }\r\n        );\r\n\r\n        if (observerRef.current) {\r\n            observer.observe(observerRef.current);\r\n        }\r\n\r\n        return () => {\r\n            if (observerRef.current) {\r\n                observer.unobserve(observerRef.current);\r\n            }\r\n        };\r\n    }, [loading, noData]);\r\n    const handleNotLogin = () => {\r\n        notification.error({\r\n            placement: \"topRight\",\r\n            message: \"Please login before adding to wishlist\",\r\n        });\r\n    };\r\n\r\n    return (\r\n        <div className=\"show_pro\">\r\n            <div className=\"show_all_product\">\r\n                <Card\r\n                    title={\r\n                        <Space>\r\n                            <Button type=\"link\" onClick={() => navigate(-1)} icon={<MdKeyboardBackspace className=\"h4\" />} />\r\n                            <p>Explore Before Checkout </p>\r\n                        </Space>\r\n                    }\r\n                    bordered={false}\r\n                >\r\n                    <div className={`${productList?.length !== 0 && \"showing_pro_by_cat\"}`}>\r\n                        {!productList.length ? (\r\n                            <div>\r\n\r\n                                <div className=\"showing_pro_by_cat\">\r\n                                    {skeletonArray.map((_, index) => (\r\n                                        <Card size=\"small\" className=\"mx-2 mb-2\" key={index}>\r\n                                            <Skeleton.Image active />\r\n                                            <Skeleton active paragraph={{ row: 6 }} />\r\n                                        </Card>\r\n                                    ))}\r\n                                </div>\r\n\r\n                            </div>\r\n                        ) : (\r\n                            productList.length === 0 ? (\r\n                                <div className='text-center'>\r\n                                    <img src=\"https://www.aamtrading.com/assets/img/nproduct.png\" width=\"50%\" />\r\n                                </div>\r\n                            ) : (\r\n                                productList.map((item) => (\r\n                                    <div className=\"product_card individual_card\" key={item.productCode}>\r\n                                        <Card hoverable disabled={item.stockQty === 0}>\r\n                                            <div className=\"card_img\">\r\n                                                {item.imageUrl[0] ? (\r\n                                                    <img\r\n                                                        src={item.imageUrl[0] || DefaultImg}\r\n                                                        onError={(e) => e.currentTarget.src = DefaultImg}\r\n                                                        onClick={() => navigate(`/product/${item.productCode}`)}\r\n                                                    />\r\n                                                ) : (\r\n                                                    <img src={DefaultImg} onClick={() => navigate(`/product/${item.productCode}`)} />\r\n                                                )}\r\n                                            </div>\r\n                                            <div className=\"pro_name\">\r\n                                                <p>{item.productName}</p>\r\n                                            </div>\r\n                                            <div className=\"show_variant_item\">\r\n                                                {item.packSize && item.packSize !== \"(NIL)\" ? <Tag color=\"green\">{item.packSize}</Tag> : <span className=\"hidden_data\">N/A</span>}\r\n                                                {item.stockQty <= out_of_stock && <Tag color='red' className=\"stock_tag\">out of stock</Tag>}\r\n                                            </div>\r\n                                            <div className=\"add_cart\">\r\n                                                <Space>\r\n                                                    <p>{`₹ ${Math.round(item.bkdAmount)} `}</p>\r\n                                                    {item.bkdAmount !== item.price && <p><del>₹ {item.price}</del></p>}\r\n                                                </Space>\r\n                                                {cartItems.find((cartItem) => cartItem.productCode === item.productCode) ? (\r\n                                                    cartItems.map((cartItem) => {\r\n                                                        if (cartItem.productCode === item.productCode) {\r\n                                                            return (\r\n                                                                <Button.Group size='small' key={cartItem.productCode}>\r\n                                                                    <Button onClick={() => handleDelItem(item)}>-</Button>\r\n                                                                    <Button>{cartItem.unit}</Button>\r\n                                                                    <Button onClick={() => handleAddItem(item)}>+</Button>\r\n                                                                </Button.Group>\r\n                                                            );\r\n                                                        }\r\n                                                        return null;\r\n                                                    })\r\n                                                ) : (\r\n                                                    <Button disabled={item.stockQty <= out_of_stock} type=\"default\" onClick={() => handleAddItem(item)}>Add</Button>\r\n                                                )}\r\n                                            </div>\r\n                                        </Card>\r\n                                        {Math.round(item.bkdAmount) !== item.price && (\r\n                                            <div className=\"cat_tags\">\r\n                                                {Math.round((item.price - item.bkdAmount) * 100 / item.price)}% off\r\n                                            </div>\r\n                                        )}\r\n                                        <div className=\"wish_list\">\r\n                                            {token ?\r\n                                                <div className='wish_list'>\r\n                                                    {\r\n                                                        wishlist[item.productCode] || item.isWhislist ? (\r\n                                                            <FaHeart\r\n                                                                className=\"no_wish_icon\"\r\n                                                                size={22}\r\n                                                                color='red'\r\n                                                                onClick={() => RemoveToWishList(item)}\r\n                                                            />\r\n                                                        ) : (\r\n                                                            <FaRegHeart\r\n                                                                className=\"no_wish_icon\"\r\n                                                                size={22}\r\n                                                                onClick={() => addToWishList(item)}\r\n                                                            />\r\n                                                        )\r\n                                                    }\r\n                                                </div>\r\n\r\n                                                :\r\n                                                <div className='wish_list'>\r\n                                                    <FaRegHeart\r\n                                                        className=\"no_wish_icon\"\r\n                                                        size={22}\r\n                                                        onClick={handleNotLogin}\r\n                                                    />\r\n                                                </div>\r\n                                            }\r\n                                        </div>\r\n                                    </div>\r\n                                ))\r\n                            )\r\n                        )}\r\n                    </div>\r\n                    <div ref={observerRef}>\r\n                        {loading && (\r\n                            <div className=\"showing_pro_by_cat\">\r\n                                {skeletonArray.map((_, index) => (\r\n                                    <Card size=\"small\" className=\"mx-2 mb-2\" key={index}>\r\n                                        <Skeleton.Image active />\r\n                                        <Skeleton active paragraph={{ row: 6 }} />\r\n                                    </Card>\r\n                                ))}\r\n                            </div>\r\n                        )}\r\n                    </div>\r\n\r\n                </Card>\r\n            </div>\r\n        </div>\r\n    );\r\n}\r\n\r\n\r\n\r\nexport default BeforeCheckoutAllView","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\account\\support\\Support.jsx",["1136","1137","1138","1139","1140"],[],"import { Avatar, Card } from \"antd\";\r\nimport React from \"react\";\r\nimport \"../../../style/account.css\";\r\nimport { Col, Row } from \"react-bootstrap\";\r\nimport GmailIcons from \"../../../assest/png/gmail3d.png\"\r\nimport LocationIcons from \"../../../assest/png/3dlocation.png\"\r\nimport CallIcons from \"../../../assest/png/call.png\"\r\nimport SupportImg from \"../../../assest/png/support_img.jpg\"\r\n\r\nfunction Support() {\r\n  return (\r\n    <div className=\"supports\">\r\n      <div className=\"support_img\">\r\n        <img src={SupportImg} />\r\n      </div>\r\n      <div className=\"support_types\">\r\n        <Row>\r\n          <Col md={4} sm={4}>\r\n            <Card bordered={false} hoverable>\r\n              <div className=\"suppot_item\">\r\n                <img\r\n                  src={CallIcons}\r\n                />{\" \"}\r\n                <p>+91-985266465454</p>\r\n              </div>\r\n            </Card>\r\n          </Col>\r\n          <Col md={4} sm={4}>\r\n\r\n            <Card bordered={false} hoverable>\r\n              <div className=\"suppot_item\">\r\n                <img\r\n                  src={GmailIcons}\r\n                />{\" \"}\r\n                <p>Customersupport@bkd.com</p>\r\n              </div>\r\n            </Card>\r\n          </Col>\r\n          <Col md={4} sm={4}>\r\n\r\n            <Card bordered={false} hoverable>\r\n              <div className=\"suppot_item\">\r\n                <img\r\n                  src={LocationIcons}\r\n                />{\" \"}\r\n                <p>Rohini sector 7 delhi</p>\r\n              </div>\r\n            </Card>\r\n          </Col>\r\n        </Row>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default Support;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\account\\wish\\WishList.jsx",["1141","1142","1143","1144","1145","1146","1147"],[],"\r\nimport { Avatar, Button, Card, Input, List, Skeleton, Space, Tag, notification } from \"antd\";\r\nimport React, { useEffect, useState, useRef, useCallback } from \"react\";\r\n\r\nimport { useAuth } from \"../../auth/context/authContext\";\r\nimport { AddProductWishlist, fetchWishlist, out_of_stock, ProdductLimits } from \"../../apiService/api\";\r\nimport { Link, useNavigate } from \"react-router-dom\";\r\nimport { FaHeart, FaRegHeart } from \"react-icons/fa\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { addItem, removeItem, selectCartItems } from \"../../../redux/CartSlice\";\r\nimport { SearchOutlined } from '@ant-design/icons';\r\nimport BKDLogo from \"../../../assest/bkdlogo.png\";\r\nimport '../../../style/account.css'\r\n\r\nimport _ from 'lodash';  // For debounce\r\nimport { encryptCategoryID } from \"../../../config/encriptConfig\";\r\n\r\nfunction WishList() {\r\n  const { token, nearStore, logout } = useAuth();\r\n  const [searchInput, setSearchInput] = useState(\"\");\r\n  const [current, setCurrent] = useState(1);\r\n  const [wishData, setWishData] = useState([]);\r\n  const [isLoading, setIsLoading] = useState(false); // Initial & search loader\r\n  const [loadingMore, setLoadingMore] = useState(false); // Loader for infinite scroll\r\n  const [hasMore, setHasMore] = useState(true);  // For infinite scroll\r\n  const dispatch = useDispatch();\r\n  const cartItems = useSelector(selectCartItems);\r\n  const [wishlists, setWishlists] = useState({});\r\n  const titleCase = str => str.toLowerCase().split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');\r\n  const navigate = useNavigate()\r\n\r\n  const observer = useRef();\r\n\r\n  // Debounced search function using lodash's debounce\r\n  const debouncedSearch = useCallback(\r\n    _.debounce((value) => {\r\n      setWishData([]);       // Clear old data\r\n      setCurrent(1);         // Always reset to page 1 on new search\r\n      setSearchInput(value); // This triggers useEffect\r\n    }, 500),\r\n    []\r\n  );\r\n\r\n\r\n\r\n  const handleSearch = (e) => {\r\n    debouncedSearch(e.target.value);\r\n    setLoadingMore(false)\r\n    setCurrent(1)\r\n  };\r\n\r\n  // Fetch wishlist\r\n  const ShowAllWishList = async () => {\r\n    if (current === 1) {\r\n      setIsLoading(true); // First page or new search\r\n    } else {\r\n      setLoadingMore(true); // For infinite scroll\r\n    }\r\n\r\n    try {\r\n      const res = await fetchWishlist(token, nearStore?.branchCode, current, searchInput);\r\n\r\n      if (res.status === 200) {\r\n        setWishData(prev => current === 1 ? res.data.data : [...prev, ...res.data.data]); // Replace on page 1\r\n        setHasMore(res.data.data.length > 0); // More pages?\r\n      } else if (res.status === 283) {\r\n        notification.error({\r\n          placement: \"topRight\",\r\n          message: res.data.message,\r\n        });\r\n        logout();\r\n      }\r\n    } catch (error) {\r\n      console.error(error);\r\n    } finally {\r\n      setIsLoading(false);\r\n      setLoadingMore(false);\r\n    }\r\n  };\r\n\r\n\r\n  useEffect(() => {\r\n    ShowAllWishList();\r\n  }, [current, searchInput]);\r\n\r\n\r\n\r\n\r\n\r\n  const RemoveToWishList = async (proCode) => {\r\n    const body = { productCode: proCode.productCode, productName: proCode.productName, status: \"INACTIVE\" };\r\n    try {\r\n      await AddProductWishlist(token, body)\r\n        .then((res) => {\r\n          if (res.status === 201) {\r\n            setCurrent(1)\r\n            ShowAllWishList(); // Trigger fetch after removing from wishlist\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          console.log(err.message);\r\n\r\n        });\r\n    } catch (error) {\r\n      console.log(error);\r\n    }\r\n  };\r\n\r\n\r\n\r\n\r\n  const lastWishElementRef = useCallback((node) => {\r\n    if (loadingMore || isLoading) return;\r\n\r\n    if (observer.current) observer.current.disconnect();\r\n    observer.current = new IntersectionObserver((entries) => {\r\n      if (entries[0].isIntersecting && hasMore) {\r\n        setCurrent(prev => prev + 1); // Load next page\r\n      }\r\n    });\r\n\r\n    if (node) observer.current.observe(node);\r\n  }, [loadingMore, isLoading, hasMore]);\r\n\r\n\r\n  const handleAddItem = (item) => {\r\n    dispatch(addItem(item));\r\n  };\r\n\r\n  const handleDelItem = (item) => {\r\n    dispatch(removeItem(item));\r\n    const updatedCart = cartItems.filter(cartItem => cartItem.productCode !== item.productCode);\r\n    localStorage.setItem(\"cart\", JSON.stringify(updatedCart));\r\n  };\r\n\r\n\r\n\r\n  const manageURl = (productName) => {\r\n    const sanitizedCategory = productName\r\n      .replace(/[,/&]/g, '') // Remove commas, slashes, ampersands\r\n      .replace(/\\s+/g, '-')  // Replace spaces with hyphens\r\n      .toLowerCase();\r\n    return sanitizedCategory\r\n  }\r\n\r\n  const goToProductDetails = (item) => {\r\n    navigate(`/product/${manageURl(item.productName)}?uid=${encodeURIComponent(encryptCategoryID(item.productCode))}`);\r\n  }\r\n\r\n  return (\r\n    <div className=\"wish_lists\">\r\n      <Card title={\r\n        <div className=\"d-flex justify-content-between\">\r\n          <p>My Wishlist</p>\r\n          <Input\r\n            style={{ width: '200px' }}\r\n            allowClear\r\n            placeholder=\"Search Product\"\r\n            suffix={<SearchOutlined />}\r\n            onChange={handleSearch}\r\n          />\r\n        </div>\r\n      }>\r\n        {isLoading ? (\r\n          <Skeleton active title={false} paragraph={{ rows: 3 }} />\r\n        ) : (\r\n          <List\r\n            className=\"demo-loadmore-list\"\r\n            itemLayout=\"horizontal\"\r\n            dataSource={wishData}\r\n            renderItem={(item, index) => (\r\n              <List.Item\r\n                key={item.productCode}\r\n                actions={[\r\n                  <div className=\"wish_cart_amount\">\r\n                    {cartItems.find(cartItem => cartItem.productCode === item.productCode) ?\r\n                      cartItems.map(cartItem => cartItem.productCode === item.productCode && (\r\n                        <Button.Group key={cartItem.productCode} size=\"middle\">\r\n                          <Button onClick={() => handleDelItem(item)}>-</Button>\r\n                          <Button>{cartItem.unit}</Button>\r\n                          <Button onClick={() => handleAddItem(item)}>+</Button>\r\n                        </Button.Group>\r\n                      )) :\r\n                      <Button type=\"default\" disabled={item.stockQty <= out_of_stock} onClick={() => handleAddItem(item)}>\r\n                        Add\r\n                      </Button>\r\n                    }\r\n                  </div>\r\n                ]}\r\n              >\r\n                <List.Item.Meta\r\n                  avatar={item.imageUrl[0] ? <Avatar src={item.imageUrl[0]} className=\"wish_img\" onClick={() => goToProductDetails(item)} /> : <Avatar src={BKDLogo} className=\"wish_img\" onClick={() => goToProductDetails(item)} />}\r\n                  title={\r\n                    <div className=\"wish_title\">\r\n                      <div className=\"pro_wish_title\">\r\n                        <p onClick={() => goToProductDetails(item)}>{titleCase(item.productName)}</p>\r\n\r\n                        <FaHeart\r\n                          className=\"no_wish_icon\"\r\n                          size={22}\r\n                          color='red'\r\n                          onClick={() => RemoveToWishList(item)}\r\n                        />\r\n                      </div>\r\n                      <p>\r\n                        <del>₹ {item.price}</del> | ₹ {item.bkdAmount}\r\n                      </p>\r\n                    </div>\r\n                  }\r\n                  description={<Space>\r\n                    <p>{item.packSize}</p>\r\n                    {item.stockQty <= out_of_stock && <Tag color='red' bordered={false}>Out of stock</Tag>}\r\n                  </Space>}\r\n                />\r\n              </List.Item>\r\n            )}\r\n          // // Pass the ref to the last item for infinite scroll detection\r\n          // ref={wishData.length === index + 1 ? lastWishElementRef : null}\r\n          />\r\n        )}\r\n        <div ref={lastWishElementRef} className=\"scroll_load  mt-4\">\r\n          {loadingMore && <Skeleton active title={false} paragraph={{ rows: 3 }} />}\r\n        </div>\r\n      </Card>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default WishList;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\account\\bankDetails\\BankDetails.jsx",["1148","1149"],[],"import React, { useEffect, useState } from \"react\";\r\nimport { Card, Empty, notification, Segmented } from \"antd\";\r\n\r\nimport \"../../../style/account.css\";\r\nimport { fetchUserBankDetails } from \"../../apiService/api\";\r\nimport { useAuth } from \"../../auth/context/authContext\";\r\nimport BankData from \"./BankData\";\r\nimport UPIIDData from \"./UPIIDData\";\r\nimport AddBankDetails from \"./AddBankDetails\";\r\nimport AddUpi from \"./AddUpi\";\r\n\r\n\r\nfunction BankDetails() {\r\n    const [bankType, setBankType] = useState(\"Bank\")\r\n    const [isLoading, setIsLoading] = useState(false)\r\n    const [bankData, setBankData] = useState([])\r\n    const { token, logout } = useAuth()\r\n\r\n    const ShowUserBankData = async () => {\r\n        setIsLoading(true)\r\n        try {\r\n            await fetchUserBankDetails(token)\r\n                .then((res) => {\r\n                    if (res.status == 200) {\r\n                        setBankData(res.data.data)\r\n                        setIsLoading(false)\r\n                    } else if (res.status === 283) {\r\n                        notification.error({\r\n                            placement: \"topRight\",\r\n                            message: res.data.message,\r\n                        });\r\n                        logout()\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n            setIsLoading(false)\r\n        }\r\n    };\r\n\r\n    useEffect(() => {\r\n        ShowUserBankData();\r\n    }, [bankType]);\r\n\r\n    let userBankType;\r\n    if (bankType === \"Bank\") {\r\n        userBankType = bankData ? <BankData bankData={bankData} ShowUserBankData={ShowUserBankData} isLoading={isLoading} /> : <Empty image={Empty.PRESENTED_IMAGE_SIMPLE} description={<div>\r\n            <p>data not found , please add bank details</p>\r\n        </div>}><AddBankDetails ShowUserBankData={ShowUserBankData} /></Empty>\r\n    } else if (bankType === \"UPI ID\") {\r\n        userBankType = bankData?.upiId ? <UPIIDData bankData={bankData} ShowUserBankData={ShowUserBankData} isLoading={isLoading} /> : <Empty image={Empty.PRESENTED_IMAGE_SIMPLE} description={<div>\r\n            <p>data not found , please add bank details</p>\r\n        </div>}><AddUpi ShowUserBankData={ShowUserBankData} /></Empty>\r\n\r\n    }\r\n\r\n    return (\r\n        <div className=\"pro_form\">\r\n            <Card title={<div className=\"bank_details\">\r\n                <p>Bank Account Details</p>\r\n            </div>}>\r\n                <div className=\"bank_segment\">\r\n                    <Segmented options={[\"Bank\", \"UPI ID\"]} block onChange={(value) => setBankType(value)\r\n                    } />\r\n                </div>\r\n                {/* {!isLoading ? <Skeleton active avatar={{ shape: 'circle' }} title={false} paragraph={{ rows: 6 }} /> : */}\r\n                {userBankType}\r\n\r\n            </Card>\r\n        </div>\r\n    );\r\n}\r\n\r\n\r\n\r\n\r\nexport default BankDetails","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\cart\\CartMenu.jsx",["1150","1151","1152","1153","1154","1155","1156","1157","1158","1159","1160","1161","1162","1163","1164","1165","1166","1167","1168","1169","1170","1171","1172","1173","1174","1175","1176","1177","1178","1179","1180","1181","1182","1183","1184"],[],"import React, { useEffect, useMemo, useRef, useState } from \"react\";\r\nimport {\r\n  Alert,\r\n  Avatar,\r\n  Badge,\r\n  Button,\r\n  Card,\r\n  Divider,\r\n  Drawer,\r\n  Input,\r\n  List,\r\n  Modal,\r\n  notification,\r\n  Popover,\r\n  Radio,\r\n  Skeleton,\r\n  Space,\r\n  Tag,\r\n  Typography,\r\n} from \"antd\";\r\nimport { MdOutlineAddLocationAlt } from \"react-icons/md\";\r\nimport { RiCoupon3Line } from \"react-icons/ri\";\r\nimport { IoIosArrowForward } from \"react-icons/io\";\r\nimport PoolImg from \"../../assest/png/bag.png\"\r\nimport { AiOutlineShoppingCart } from \"react-icons/ai\";\r\nimport { IoInformationCircleOutline } from \"react-icons/io5\";\r\n// import EmptyCart from \"../../assest/cart.gif\";\r\nimport EmptyCart from \"../../assest/png/notcartImageremovebg.png\";\r\nimport \"../../style/header.css\";\r\nimport Login from \"../auth/Login\";\r\nimport ApplyCoupon from \"./ApplyCoupon\";\r\nimport BKDLogo from \"../../assest/bkdlogo.png\";\r\nimport BeforeCheckProductList from \"./BeforeCheckProductList\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { addAutoApplyOffer, addItem, addShareCart, removeItem, selectCartItems, selectedBillingQty, selectedOfferQty, selectMrpTotalAmount, selectNewUpdateOfferQty, selectTotalAmount, setSelctedOffer, updateCartRemoveItem } from \"../../redux/CartSlice\";\r\nimport { MdNavigateNext } from \"react-icons/md\";\r\n\r\nimport { useLocation, useNavigate } from \"react-router-dom\";\r\nimport { useScreen } from \"../auth/AuthScreen\";\r\nimport { useAuth } from \"../auth/context/authContext\";\r\nimport ShowApplyOffer from \"./ShowApplyOffer\";\r\nimport { fetchAllDiscountList, fetchAutoOfferApplyCart, fetchDeliveryCharge } from \"../apiService/api\";\r\nimport { selectDeliveryCharge, selectDeliveryStore, selectDeliveryType, selectDiscount, selectDiscountAmount, selectPayableAmount, selectSelectedCoupon, setDeliveryCahrge, setDeliveryType, setDiscountAmount, setDiscountDetails, setPayableAmount, setSaveAmount, setSelectedCoupon } from \"../../redux/OrderSlice\";\r\nimport { GiStarFormation } from \"react-icons/gi\";\r\nimport DescribeOffer from \"./DescribeOffer\";\r\nimport ShareCartModal from \"../shareLink/ShareCartModal\";\r\nimport ReferralCouponCard from \"./ReferralCouponCard\";\r\nimport CouponModal from \"../../kit/CouponModal/CouponModal\";\nimport { Discount } from \"../../config/common\";\nimport { RiDeleteBinLine } from \"react-icons/ri\";\nimport { HiOutlineTrash } from \"react-icons/hi2\";\nimport { getCouponAppliedDiscount, useAutoRemoveInvalidCoupon } from \"../../utils/couponUtils\";\nimport ClearAllModal from \"../../kit/ClearAllModal/ClearAllModal\";\n\r\nconst { Text } = Typography;\r\n\r\n// Step-by-step offer calculation following exact user pattern\r\nexport function calculateOfferDistribution(userQuantity, offerDetails) {\r\n  if (!offerDetails || userQuantity === 0) {\r\n    return {\r\n      regularQty: userQuantity || 0,\r\n      offerQty: 0,\r\n      totalQty: userQuantity || 0,\r\n      offerCycles: 0\r\n    };\r\n  }\r\n\r\n  const offerQty = parseInt(offerDetails?.promoType?.split('+')[1] || '0');\r\n  const { billingQty } = offerDetails;\r\n\r\n  // Based on your exact requirements:\r\n  // 1+1 offer: Buy 1, Get 1 Free (billingQty=1, offerQty=1)\r\n  // 2+1 offer: Buy 2, Get 1 Free (billingQty=2, offerQty=1)\r\n\r\n  if (billingQty === 1 && offerQty === 1) {\r\n    // Special case for 1+1 offers\r\n    if (userQuantity === 1) {\r\n      return {\r\n        regularQty: 1,  // User pays for 1\r\n        offerQty: 0,     // No free items yet\r\n        totalQty: 1,\r\n        offerCycles: 0\r\n      };\r\n    } else {\r\n      // For 2 or more items with 1+1\r\n      // User always pays for half (rounded up), gets half free\r\n      const pairs = Math.floor(userQuantity / 2);\r\n      const remainder = userQuantity % 2;\r\n      return {\r\n        regularQty: pairs + remainder,  // Items user pays for\r\n        offerQty: pairs,                // Free items (2nd item of each pair)\r\n        totalQty: userQuantity,         // Total is just what user requested\r\n        offerCycles: pairs\r\n      };\r\n    }\r\n  } else if (billingQty === 1 && offerQty === 2) {\r\n    if (userQuantity < 3) {\r\n      // Not enough to complete one full offer cycle\r\n      return {\r\n        regularQty: userQuantity,\r\n        offerQty: 0,\r\n        totalQty: userQuantity,\r\n        offerCycles: 0\r\n      };\r\n    } else {\r\n      const cycleSize = billingQty + offerQty; // 1 + 2 = 3\r\n      const completeCycles = Math.floor(userQuantity / cycleSize);\r\n      const remainder = userQuantity % cycleSize;\r\n\r\n      return {\r\n        regularQty: completeCycles * billingQty + remainder,\r\n        offerQty: completeCycles * offerQty,\r\n        totalQty: userQuantity,\r\n        offerCycles: completeCycles\r\n      };\r\n    }\r\n  } else if (billingQty === 1 && offerQty === 3) {\r\n    if (userQuantity < 4) {\r\n      // Not enough to complete one full offer cycle\r\n      return {\r\n        regularQty: userQuantity,\r\n        offerQty: 0,\r\n        totalQty: userQuantity,\r\n        offerCycles: 0\r\n      };\r\n    } else {\r\n      const cycleSize = billingQty + offerQty; // 1 + 3 = 4\r\n      const completeCycles = Math.floor(userQuantity / cycleSize);\r\n      const remainder = userQuantity % cycleSize;\r\n\r\n      return {\r\n        regularQty: completeCycles * billingQty + remainder,\r\n        offerQty: completeCycles * offerQty,\r\n        totalQty: userQuantity,\r\n        offerCycles: completeCycles\r\n      };\r\n    }\r\n  } else {\r\n    // Standard logic for other offers (2+1, 3+1, etc.)\r\n    const completeSets = Math.floor(userQuantity / billingQty);\r\n    const remainder = userQuantity % billingQty;\r\n\r\n    // For 2+1: user pays for 2, gets 1 free (total still 2+1=3)\r\n    // For 3+1: user pays for 3, gets 1 free (total still 3+1=4)\r\n    return {\r\n      regularQty: remainder + (completeSets * billingQty), // All items user requested\r\n      offerQty: completeSets * offerQty,                   // Free bonus items\r\n      totalQty: userQuantity + (completeSets * offerQty),  // User items + bonus\r\n      offerCycles: completeSets\r\n    };\r\n  }\r\n}\r\n\r\n// export function calculateOfferDistribution(userQuantity, offerDetails) {\r\n//   if (!offerDetails || userQuantity === 0) {\r\n//     return {\r\n//       regularQty: userQuantity || 0,\r\n//       offerQty: 0,\r\n//       totalQty: userQuantity || 0,\r\n//       offerCycles: 0\r\n//     };\r\n//   }\r\n\r\n//   // ✅ ALWAYS derive from promoType (NOT API billingQty)\r\n//   const [buy, free] = offerDetails?.promoType?.split('+').map(Number);\r\n\r\n//   const billingQty = buy;   // how many user pays\r\n//   const offerQty = free;    // how many free\r\n\r\n//   const cycleSize = billingQty + offerQty;\r\n\r\n//   const completeCycles = Math.floor(userQuantity / cycleSize);\r\n//   const remainder = userQuantity % cycleSize;\r\n\r\n//   return {\r\n//     regularQty: completeCycles * billingQty + Math.min(remainder, billingQty),\r\n//     offerQty: completeCycles * offerQty,\r\n//     totalQty: userQuantity,\r\n//     offerCycles: completeCycles\r\n//   };\r\n// }\r\n\r\nconst CartMenu = () => {\r\n  const [isModalOpen, setIsModalOpen] = useState(false);\r\n  const [isLoading, setIsLoading] = useState(false)\r\n  const [isRemoveOpen, setIsRemoveOpen] = useState(false);\r\n  const [selectedId, setSelectedId] = useState()\r\n  const [minCartAmount, setMinCartAmount] = useState(null);\r\n  const deliveryOpt = useSelector(selectDeliveryType)\r\n  const dispatch = useDispatch();\r\n  const { token, currentUser, nearStore } = useAuth()\r\n  const cartItems = useSelector(selectCartItems);\r\n  const selectedDeliveryStore = useSelector(selectDeliveryStore);\r\n  const totalAmount = useSelector(selectTotalAmount);\r\n  const payableAmount = useSelector(selectPayableAmount);\r\n  const mrpTotal = useSelector(selectMrpTotalAmount);\r\n  const selectedCoupon = useSelector(selectDiscount)\r\n  const selectedBilQty = useSelector(selectedBillingQty);\r\n  const saveDeliveryCharge = useSelector(selectDeliveryCharge);\r\n  const selectCoupon = useSelector(selectSelectedCoupon);\r\n  const navigate = useNavigate();\r\n  const [open, setOpen] = useState(false);\r\n  const [deliveryChargeAmount, setDeliveryChargeAmount] = useState(0)\r\n  const discountAmount = useSelector(selectDiscountAmount);\r\n  // const poolProduct = cartItems?.map((pool) => pool?.isPoolProduct)\r\n  const [AllSaveAmount, setAllSaveAmount] = useState(0)\r\n  const titleCase = str => str?.toLowerCase()?.split(' ')?.map(word => word?.charAt(0)?.toUpperCase() + word?.slice(1))?.join(' ');\r\n\r\n  const location = useLocation()\r\n\r\n  const maxVisibleAvatars = 3; // Maximum avatars to display\r\n  const visibleAvatars = cartItems?.slice(-maxVisibleAvatars); // First 3 items\r\n  const remainingCount = cartItems?.length - maxVisibleAvatars; // Remaining items count\r\n  const totalUnits = cartItems?.reduce((sum, product) => {\r\n    if (product.selected_offer) {\r\n      const offerDist = calculateOfferDistribution(product.unit, product.selected_offer);\r\n      return sum + offerDist.regularQty; // Use calculated regular quantity\r\n    }\r\n    return sum + (product.unit || 0);\r\n  }, 0);\r\n  const totalofferUnits = cartItems?.reduce((sum, product) => {\r\n    if (product.selected_offer) {\r\n      const offerDist = calculateOfferDistribution(product.unit, product.selected_offer);\r\n      return sum + offerDist.offerQty;\r\n    }\r\n    return sum;\r\n  }, 0);\r\n  const TotalQty = totalUnits + totalofferUnits\r\n  const prevPayableAmount = useRef(payableAmount);\r\n  const { screenWidth } = useScreen()\r\n\r\n\r\n  useAutoRemoveInvalidCoupon({\r\n    token,\r\n    selectedCoupon: selectCoupon,\r\n    cartAmount: totalAmount,\r\n    cartItems,\r\n    notifyOnRemove: true,\r\n  });\r\n\r\n  const toggleModalDrawer = () => setIsModalOpen(!isModalOpen)\r\n\r\n  function calculateOfferData() {\r\n    // Calculate total booked subtotal (total amount after discounts)\r\n    const totalBkdsubtotal = cartItems?.reduce((total, product) => total + (product.sub_total || 0) + (product.combo_total || 0), 0);\r\n\r\n    // Calculate total MRP subtotal for all items (including free ones from offers)\r\n    const totalmrpsubtotal = cartItems?.reduce((total, product) => {\r\n      if (product.selected_offer) {\r\n        // Calculate MRP for user quantity + offer quantity\r\n        const offerDist = calculateOfferDistribution(product.unit, product.selected_offer);\r\n        // For 1+1: totalQty is same as userQuantity, so use offerDist.totalQty\r\n        const totalItemsMRP = offerDist.totalQty * product.price;\r\n        return total + totalItemsMRP;\r\n      }\r\n      return total + (product.mrp_sub_total || 0);\r\n    }, 0);\r\n\r\n    // Calculate total amount paid (what customer actually pays)\r\n    const totalAmountPaid = cartItems?.reduce((total, product) => {\r\n      return total + (product.sub_total || 0) + (product.combo_total || 0);\r\n    }, 0);\r\n\r\n    // Total savings = MRP of all items (including free) - Amount actually paid\r\n    const totalSaveAmount = totalmrpsubtotal - totalAmountPaid;\r\n\r\n    // Dispatch only once with the final calculated value\r\n    dispatch(setSaveAmount(totalSaveAmount));\r\n\r\n    // Store in localStorage\r\n    localStorage.setItem('saveAmount', JSON.stringify(totalSaveAmount));\r\n\r\n    setAllSaveAmount(totalSaveAmount)\r\n  }\r\n\r\n  useEffect(() => {\r\n    calculateOfferData()\r\n  }, [cartItems])\r\n\r\n  // Force re-calculation when drawer opens\r\n  useEffect(() => {\r\n    if (open && cartItems.length > 0) {\r\n      // Small delay to ensure DOM is updated\r\n      setTimeout(() => {\r\n        calculateOfferData()\r\n      }, 100);\r\n    }\r\n  }, [open])\r\n\r\n\r\n  // apply offer automatic - now works with auto-calculated offers\r\n  const fetchShareCartData = async () => {\r\n    const cart = cartItems.map((item) => ({\r\n      productCode: item.productCode,\r\n      qty: item.unit,\r\n      offer: item.selected_offer ? true : false\r\n    }))\r\n\r\n    setIsLoading(true)\r\n    try {\r\n      await fetchAutoOfferApplyCart({ cartItem: cart, branchCode: nearStore?.branchCode }).then((res) => {\r\n        console.log(\"res update cart\", res)\r\n        const fetchData = res.data.data\r\n        if (res.status === 200) {\r\n          // Process fetched data to work with auto-calculation\r\n          const processedData = fetchData.map(item => {\r\n            if (item.selected_offer) {\r\n              const offerDist = calculateOfferDistribution(item.qty, item.selected_offer);\r\n              return {\r\n                ...item,\r\n                unit: item.qty,\r\n                calculated_offer_qty: offerDist.offerQty,\r\n                calculated_total_qty: offerDist.totalQty\r\n              };\r\n            }\r\n            return {\r\n              ...item,\r\n              unit: item.qty\r\n            };\r\n          });\r\n\r\n          localStorage.setItem(\"cart\", JSON.stringify(processedData));\r\n          dispatch(addAutoApplyOffer(processedData))\r\n          setIsLoading(false)\r\n        }\r\n      }).catch((err) => {\r\n        console.log(err)\r\n        setIsLoading(false)\r\n      })\r\n\r\n    } catch (error) {\r\n      console.log(error)\r\n      setIsLoading(false)\r\n    }\r\n  }\r\n\r\n\r\n\r\n  const showDrawer = () => {\r\n    setOpen(true);\r\n    // Don't fetch share cart data on first open to avoid overriding calculations\r\n    fetchShareCartData()\r\n    // ShowDeliveryChangeList();\r\n    // calculateDeliveryCharge()\r\n  };\r\n\r\n  useEffect(() => {\r\n    if (open) {\r\n      dispatch(setDeliveryType(\"DELIVERY\"));\r\n      localStorage.setItem(\"orderType\", \"DELIVERY\");\r\n    }\r\n  }, [open]);\r\n\r\n  useEffect(() => {\r\n    if (open && deliveryOpt) {\r\n      ShowDeliveryChangeList();\r\n    }\r\n  }, [open, deliveryOpt]);\r\n\r\n  useEffect(() => {\r\n    calculateDeliveryCharge();\r\n  }, [deliveryChargeAmount, minCartAmount]);\r\n\r\n  const cartClose = () => {\r\n    setOpen(false);\r\n  };\r\n\r\n  const totalAmounthandle = () => {\n\n    let couponDiscount = 0;\n    if (selectCoupon) {\n      const isCouponApplicable = Number(totalAmount) >= Number(selectCoupon.minCartAmount || 0);\n      if (isCouponApplicable) {\n        if (selectCoupon.discountType === Discount.DISCOUNT) {\n          couponDiscount = getCouponAppliedDiscount(selectCoupon, totalAmount);\n        } else if (selectCoupon.discountType === Discount.CASHBACK) {\n          couponDiscount = getCouponAppliedDiscount(selectCoupon, totalAmount);\n        }\n      } else {\n        couponDiscount = 0;\n      }\r\n    }\r\n\r\n    if (selectedCoupon?.details != null) {\r\n      if (selectedCoupon?.details?.discountType === \"FLAT\") {\r\n        dispatch(setPayableAmount(totalAmount + saveDeliveryCharge - selectedCoupon?.details?.discountValue))\r\n        dispatch(setDiscountAmount(selectedCoupon?.details?.discountValue.toFixed(2)))\r\n\r\n\r\n      } else {\r\n        const percetValue = ((totalAmount + saveDeliveryCharge) * (selectedCoupon?.details?.discountValue) / 100)\r\n        // const calDiscount = (totalAmount / 100) * selectedCoupon?.details?.discountValue?.toFixed(2)\r\n        dispatch(setPayableAmount(totalAmount + saveDeliveryCharge - percetValue))\r\n        dispatch(setDiscountAmount(percetValue.toFixed(2)))\r\n\r\n      }\r\n      } else {\n      dispatch(setDiscountAmount(+couponDiscount.toFixed(2)))\n      dispatch(setPayableAmount(+(((totalAmount - couponDiscount) + saveDeliveryCharge).toFixed(2))))\n      }\n    }\n\r\n  useEffect(() => {\r\n    totalAmounthandle()\r\n  }, [selectCoupon, totalAmount, cartItems, saveDeliveryCharge, selectedCoupon])\r\n\r\n\r\n  const handleAddItem = (item) => {\r\n    // Calculate automatic offers based on current quantity + 1\r\n    const currentItem = cartItems.find(cartItem => cartItem.productCode === item.productCode);\r\n    const newUserQuantity = currentItem ? currentItem.unit + 1 : 1;\r\n\r\n    // Calculate offer distribution\r\n    const offerCalculation = calculateOfferDistribution(newUserQuantity, item.selected_offer);\r\n\r\n    // Create updated item with calculated offers\r\n    const updatedItem = {\r\n      ...item,\r\n      unit: newUserQuantity,\r\n      calculated_offer_qty: offerCalculation.offerQty,\r\n      calculated_total_qty: offerCalculation.totalQty\r\n    };\r\n\r\n    dispatch(addItem(updatedItem));\r\n    localStorage.setItem(\"cart\", JSON.stringify(updatedItem))\r\n  };\r\n\r\n\r\n  const handleDelItem = (item,) => {\r\n    // Calculate automatic offers for reduced quantity\r\n    const newUserQuantity = item.unit > 1 ? item.unit - 1 : 0;\r\n\r\n    if (newUserQuantity === 0) {\r\n      // Remove item completely\r\n      dispatch(removeItem(item));\r\n      const cart = JSON.parse(localStorage.getItem(\"cart\")) || [];\r\n      const updatedCart = cart.filter(cartItem => cartItem.productCode !== item.productCode);\r\n      localStorage.setItem(\"cart\", JSON.stringify(updatedCart))\r\n    } else {\r\n      // Calculate offer distribution for reduced quantity\r\n      const offerCalculation = calculateOfferDistribution(newUserQuantity, item.selected_offer);\r\n\r\n      // Create updated item with recalculated offers\r\n      const updatedItem = {\r\n        ...item,\r\n        unit: newUserQuantity,\r\n        calculated_offer_qty: offerCalculation.offerQty,\r\n        calculated_total_qty: offerCalculation.totalQty\r\n      };\r\n\r\n      dispatch(removeItem(updatedItem));\r\n    }\r\n\r\n    if (selectedBilQty >= item?.unit) {\r\n      dispatch(setSelctedOffer(null))\r\n    }\r\n  };\r\n\r\n\r\n  const ShowDeliveryChangeList = async () => {\r\n    if (deliveryOpt === \"PICKUP\") {\r\n      setDeliveryChargeAmount(0);\r\n      setMinCartAmount(0);\r\n      return;\r\n    }\r\n    try {\r\n      await fetchDeliveryCharge(deliveryOpt)\r\n        .then((res) => {\r\n          console.log(\"delivery charge\", res);\r\n          if (res.status == 200) {\r\n            setDeliveryChargeAmount(res.data.data.deliveryCharge)\r\n            setMinCartAmount(res.data.data.freeDeliveryMaxCart)\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          console.log(err.message);\r\n        });\r\n    } catch (error) {\r\n      console.log(error);\r\n    }\r\n  };\r\n\r\n\r\n  const calculateDeliveryCharge = () => {\r\n    if (deliveryOpt === \"PICKUP\") {\r\n      dispatch(setDeliveryCahrge(0));\r\n      localStorage.setItem(\"updatedeliveryCharge\", 0);\r\n      return;\r\n    }\r\n    const hasPoolProduct = cartItems.some(product => product.isPoolProduct);\r\n\r\n    const isDeliveryTrueSum = cartItems\r\n      .filter(product => product.isDeliveryChargeAllowed)\r\n      .reduce((sum, product) => sum + (product.combo_total || product.sub_total), 0);\r\n    const checkDelveryRequire = totalAmount - isDeliveryTrueSum;\r\n    let defaultDelivery = 0;\r\n\r\n    if (selectCoupon?.discountType === Discount.FREE_DELIVERY && Number(totalAmount) >= Number(selectCoupon?.minCartAmount || 0)) {\r\n      dispatch(setDeliveryCahrge(defaultDelivery));\r\n      localStorage.setItem(\"updatedeliveryCharge\", defaultDelivery);\r\n      return;\r\n    }\r\n\r\n    if (hasPoolProduct) {\r\n      dispatch(setDeliveryCahrge(defaultDelivery));\r\n      localStorage.setItem(\"updatedeliveryCharge\", defaultDelivery);\r\n      return;\r\n    }\r\n\r\n    if (minCartAmount !== null && Number(checkDelveryRequire) >= Number(minCartAmount)) {\r\n      dispatch(setDeliveryCahrge(defaultDelivery));\r\n      localStorage.setItem(\"updatedeliveryCharge\", defaultDelivery);\r\n      return;\r\n    }\r\n\r\n    if (deliveryChargeAmount > 0) {\r\n      dispatch(setDeliveryCahrge(deliveryChargeAmount));\r\n      localStorage.setItem(\"updatedeliveryCharge\", deliveryChargeAmount);\r\n    } else {\r\n      // fallback: keep existing value (from Redux/localStorage) while async API is loading\r\n      const existing = Number(localStorage.getItem(\"updatedeliveryCharge\")) || 0;\r\n      dispatch(setDeliveryCahrge(existing));\r\n      localStorage.setItem(\"updatedeliveryCharge\", existing);\r\n    }\r\n  }\r\n\r\n  useEffect(() => {\r\n    // Only call ShowDeliveryChangeList if payableAmount has changed\r\n    if (payableAmount !== prevPayableAmount.current) {\r\n      calculateDeliveryCharge();\r\n      prevPayableAmount.current = payableAmount; // Update the ref to the current value\r\n    }\r\n  }, [payableAmount, deliveryChargeAmount]);\r\n\r\n  useEffect(() => {\r\n    calculateDeliveryCharge();\r\n  }, [selectCoupon]);\r\n\r\n  const popoverContent = (\r\n    <div>\r\n      {visibleAvatars.map((item, index) => (\r\n        <div key={index} style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>\r\n          <div>{item?.productName}</div>\r\n          <p style={{ marginLeft: '10px' }}>₹ {item?.sub_total?.toFixed(2)}</p>\r\n        </div>\r\n      ))}\r\n    </div>\r\n  );\r\n\r\n  const onSelectCoupon = (coupon) => {\r\n    dispatch(setSelectedCoupon(coupon));\r\n    setIsModalOpen(false);\r\n  };\r\n\r\n  const handleRemoveCoupon = () => {\r\n    dispatch(setSelectedCoupon(null));\r\n  }\r\n\r\n  const toggleRemoveModal = () => setIsRemoveOpen(!isRemoveOpen)\r\n\r\n  const handleRemove = (productCode) => {\r\n    setSelectedId(productCode)\r\n    toggleRemoveModal();\r\n  };\r\n\r\n  const handleRemoveItem = () => {\r\n    dispatch(updateCartRemoveItem({ productCode: selectedId }))\r\n    toggleRemoveModal()\r\n  };\r\n\r\n  return (\r\n    <>\r\n      <div className=\"add_to_cart\">\r\n        <div className=\"carts\" style={{ paddingRight: '10px' }}>\r\n          {screenWidth > 800 ? <Badge count={cartItems.length}>\r\n            <Button\r\n              size=\"large\"\r\n              shape=\"circle\"\r\n              type=\"primary\"\r\n              icon={<AiOutlineShoppingCart className=\"cart_icon\" />}\r\n              onClick={showDrawer}\r\n              disabled={discountAmount != 0 && location?.pathname === \"/checkout/DELIVERY\" || location?.pathname === \"/checkout/PICKUP\"}\r\n            ></Button>\r\n          </Badge> : cartItems.length > 0 ? <div className=\"mobile_cart\">\r\n            <div className=\"cart_mobile_view\" onClick={showDrawer}\r\n            // iconPosition=\"end\"\r\n            // icon={\r\n            //   // <Badge count={cartItems.length}>\r\n            //   // <AiOutlineShoppingCart className=\"cart_icon\" />\r\n            //   // </Badge>\r\n            // }\r\n            >\r\n\r\n              <Space>\r\n                {/* <Avatar.Group \r\n              max={{\r\n                count: 3,\r\n               \r\n              }}>\r\n                {cartItems.map((url) => (\r\n                  <Avatar src={url.imageUrl?.length != 0 && url.imageUrl[0] ? url.imageUrl[0] : \"https://img.freepik.com/premium-vector/bkd-logo-bkd-letter-bkd-letter-logo-design-initials-bkd-logo-linked-with-circle-uppercase-monogram-logo-bkd-typography-technology-business-real-estate-brand_229120-64688.jpg?w=360\"} />\r\n                ))}\r\n              </Avatar.Group> */}\r\n                <Avatar.Group>\r\n                  {visibleAvatars.map((item, index) => (\r\n                    <Avatar\r\n                      size=\"large\"\r\n                      className=\"avtar_color\"\r\n                      key={index}\r\n                      src={\r\n                        item.imageUrl && item.imageUrl.length !== 0 && item.imageUrl[0]\r\n                          ? item.imageUrl[0]\r\n                          : BKDLogo\r\n                      }\r\n                    />\r\n                  ))}\r\n                  {remainingCount > 0 && (\r\n                    <Avatar size=\"large\" className=\"avtar_color\">+{remainingCount}</Avatar> // Show remaining count as \"+X\"\r\n                  )}\r\n                </Avatar.Group>\r\n                <span>₹ {Math.round(payableAmount)}\r\n                </span>\r\n                <Button shape=\"circle\" className=\"next_cart_btn\" size=\"large\" icon={<MdNavigateNext className=\"next_icons\" />} ></Button>\r\n              </Space>\r\n            </div>\r\n          </div> : null\r\n          }\r\n\r\n        </div>\r\n        <Drawer title={<div className=\"cart_title\">\r\n          <h5> My Cart</h5>\r\n          <ShareCartModal cartClose={cartClose} cartItems={cartItems} />\r\n        </div>} className=\"my_cart\" width={480} onClose={cartClose} open={open} placement=\"right\" style={{ background: \"#eee\" }}>\r\n          <>\r\n            {cartItems.length == 0 ? (\r\n              <div className=\"empty_cart\">\r\n                <img src={EmptyCart} onClick={() => {\r\n                  navigate(\"/\");\r\n                  setOpen(false);\r\n                }} />\r\n\r\n              </div>\r\n            ) : (\r\n              <>\r\n                <div className=\"cart_section\">\r\n                  <div className=\"cart_list\">\r\n                    <Card >\r\n                      <List\r\n                        footer={<div>\r\n                          <p> Total Quantity  ({totalUnits} + {totalofferUnits}) = {TotalQty} </p>\r\n                        </div>}\r\n                        className=\"demo-loadmore-list\"\r\n                        itemLayout={screenWidth < 800 ? \"vertical\" : \"horizontal\"}\r\n                        loading={isLoading}\r\n                        dataSource={cartItems}\r\n                        renderItem={(item) => (\r\n                          <List.Item\r\n                            actions={[<div className=\"add_cart_btn\" style={{ gap: '6px', alignItems: 'end' }}>\r\n                              {/* {item.selected_offer!=null ? \"offer\" : null} */}\r\n                              {item.isPoolProduct ?\r\n                                <img src={PoolImg} className=\"pool_cart_img\" />\r\n                                : item.isDeliveryChargeAllowed ?\r\n                                  <MdOutlineAddLocationAlt className=\"delivery_require\" />\r\n                                  : null}\r\n                              <div style={{ display: 'flex', gap: '6px', alignItems: 'center' }}>\r\n                                <Button.Group size=\"small\">\r\n                                  <Button\r\n                                    onClick={() => handleDelItem(item)}\r\n                                    disabled={item.unit <= 1}\r\n                                  >\r\n                                    -\r\n                                  </Button>\r\n                                  <Button>\r\n                                    {item.selected_offer ? (\r\n                                      <span>\r\n                                        {(() => {\r\n                                          const offerDist = calculateOfferDistribution(item.unit, item.selected_offer);\r\n                                          return (\r\n                                            <>\r\n                                              <span>{offerDist.regularQty}</span>\r\n                                              {offerDist.offerQty > 0 && (\r\n                                                <span style={{ color: '#52c41a', fontSize: '10px' }}>\r\n                                                  +{offerDist.offerQty}\r\n                                                </span>\r\n                                              )}\r\n                                            </>\r\n                                          );\r\n                                        })()}\r\n                                      </span>\r\n                                    ) : item.unit}\r\n                                  </Button>\r\n                                  <Button onClick={() => handleAddItem(item)}>+</Button>\r\n                                </Button.Group>\r\n                                <HiOutlineTrash\r\n                                  onClick={() => handleRemove(item.productCode)}\r\n                                  color=\"red\"\r\n                                  style={{ cursor: 'pointer' }}\r\n                                />\r\n                              </div>\r\n                            </div>]}\r\n                          >\r\n\r\n                            <List.Item.Meta\r\n                              // avatar={item?.imageUrl[0] != null ? <img src={item?.imageUrl && item?.imageUrl?.length > 0 ? item?.imageUrl[0] : null} /> :\r\n                              //   <img src={BKDLogo} />}\r\n                              avatar={Array.isArray(item?.imageUrl) && item?.imageUrl[0] != null ? (\r\n                                <img\r\n                                  src={item?.imageUrl[0] || BKDLogo}\r\n                                  onError={(e) => e.currentTarget.src = BKDLogo}\r\n                                  alt=\"product\"\r\n                                />\r\n                              ) : (\r\n                                <img src={BKDLogo} alt=\"default logo\" />\r\n                              )}\r\n                              title={\r\n                                <div className=\"cart_pro_title\">\r\n                                  <p >{titleCase(item?.productName)} </p>\r\n                                </div>\r\n                              }\r\n                              description={\r\n                                <div className=\"weat\">\r\n                                  {item.selected_offer ?\r\n                                    <div>\r\n                                      {(() => {\r\n                                        const offerDist = calculateOfferDistribution(item.unit, item.selected_offer);\r\n                                        const offerQty = offerDist.offerQty; // Only use calculated value\r\n                                        const regularQty = offerDist.regularQty;\r\n                                        const offerCycles = offerDist.offerCycles;\r\n\r\n                                        const offerUnits = offerCycles * item.selected_offer.billingQty;\r\n                                        const remainingUnits = regularQty - offerUnits;\r\n                                        const calculatedPrice = offerUnits * item.price + remainingUnits * item.bkdAmount;\r\n\r\n                                        const offerUnit = offerQty; // free/offer items (use price)\r\n                                        const normalUnit = regularQty - offerUnits; // paid items\r\n\r\n                                        const offerPrice = item.price;\r\n                                        const normalPrice = item.bkdAmount;\r\n\r\n                                        return (\r\n                                          <>\r\n                                            <Space>\r\n                                              <p>{item.packSize} ∘</p>\r\n                                              {offerQty > 0 ? (\r\n                                                <>\r\n                                                  <p>₹<del>{item.bkdAmount}</del></p>\r\n                                                  <p><strong>{`₹ ${item.price}`}</strong></p>\r\n                                                </>\r\n                                              ) : (\r\n                                                <>\r\n                                                  <p>₹<del>{item.price}</del></p>\r\n                                                  <p><strong>{`₹ ${item.bkdAmount}`}</strong></p>\r\n                                                </>\r\n                                              )}\r\n                                            </Space>\r\n\r\n                                            <p>{`Regular items: ${regularQty} qty - ₹${item.sub_total || calculatedPrice}`}</p>\r\n                                            <div>\r\n                                              {normalUnit > 0 && (\r\n                                                <p className=\"checkout-regular-text\">\r\n                                                  {`${normalUnit} x ${normalPrice} = ₹${(normalUnit * normalPrice).toFixed(2)}`}\r\n                                                </p>\r\n                                              )}\r\n\r\n                                              {offerUnits > 0 && (\r\n                                                <p className=\"checkout-regular-text\">\r\n                                                  {`${offerUnit} x ${offerPrice} = ₹${(offerUnit * offerPrice).toFixed(2)}`}\r\n                                                </p>\r\n                                              )}\r\n                                            </div>\r\n                                            {offerQty > 0 && (\r\n                                              <>\r\n                                                <p style={{ color: '#52c41a' }}>\r\n                                                  {`Free items: ${offerQty} qty (${item.selected_offer.promoType} offer)`}\r\n                                                </p>\r\n                                                <p style={{ color: '#52c41a' }}>\r\n                                                  {`Savings: ₹${offerQty * item.price}`}\r\n                                                </p>\r\n                                              </>\r\n                                            )}\r\n                                            {item.selected_offer && (\r\n                                              <p style={{ fontSize: '12px', color: '#666' }}>\r\n                                                {(() => {\r\n                                                  const nextOfferThreshold = Math.ceil(item.unit / item.selected_offer.billingQty) * item.selected_offer.billingQty;\r\n                                                  const itemsNeeded = nextOfferThreshold - item.unit;\r\n                                                  return itemsNeeded > 0\r\n                                                    ? `Add ${itemsNeeded} more to get ${item.selected_offer.qty} free`\r\n                                                    : `Next offer after ${item.selected_offer.billingQty} more items`;\r\n                                                })()}\r\n                                              </p>\r\n                                            )}\r\n                                          </>\r\n                                        );\r\n                                      })()}\r\n                                    </div>\r\n                                    :\r\n                                    <Space>\r\n                                      <p>{item.packSize} ∘</p>\r\n                                      <p>₹<del>{item.price}</del>  </p>\r\n                                      <p><strong>{`₹ ${item.bkdAmount} `}</strong></p>\r\n                                    </Space>\r\n                                  }\r\n                                  {item.selected_offer ?\r\n                                    <Space>\r\n                                      <ShowApplyOffer offerItem={item} />\r\n                                      {/* <DescribeOffer productData={item} /> */}\r\n                                    </Space>\r\n                                    : null}\r\n                                </div>}\r\n                            />\r\n                          </List.Item>\r\n                        )}\r\n                      />\r\n                    </Card>\r\n                  </div>\r\n\r\n                  <div className=\"bill_details\">\r\n                    <Card>\r\n                      <div\r\n                        style={{\r\n                          display: \"flex\",\r\n                          justifyContent: \"space-between\",\r\n                          alignItems: \"center\",\r\n                          cursor: \"pointer\",\r\n                          userSelect: \"none\",\r\n                        }}\r\n                        onClick={toggleModalDrawer}\r\n                      >\r\n                        <div style={{ display: \"flex\", alignItems: \"center\", gap: \"8px\" }}>\r\n                          <RiCoupon3Line size={24} />\r\n                          <p style={{ margin: 0, fontSize: 16 }}>{selectCoupon ? 'Applied' : 'Apply'} coupon</p>\r\n                        </div>\r\n                        <IoIosArrowForward size={20} />\r\n                      </div>\r\n                    </Card>\r\n                  </div>\r\n\r\n                  <Card className=\"billing_card\">\r\n                    <div className=\"checkout-summary-body\">\r\n                      <div className=\"checkout-summary-text\">\r\n                        <Text strong>Total MRP</Text>\r\n                        <Text strong>₹ {Number(mrpTotal)?.toFixed(2)}</Text>\r\n                      </div>\r\n\r\n                      <div className=\"checkout-summary-text\">\r\n                        <Text strong>Total Amount</Text>\r\n                        <div style={{ display: \"flex\", alignItems: \"center\", gap: 6 }}>\r\n                          <Popover content={popoverContent} title=\"Total Amount\" trigger=\"hover\" placement=\"top\">\r\n                            <IoInformationCircleOutline style={{ color: \"#1890ff\", fontSize: '16px', cursor: 'pointer' }} />\r\n                          </Popover>\r\n                          <Text strong>₹ {Number(totalAmount)?.toFixed(2)}</Text>\r\n                        </div>\r\n                      </div>\r\n\r\n                      {saveDeliveryCharge !== 0 ?\r\n                        <div className=\"checkout-summary-text\">\r\n                          <Text strong>Delivery Charges</Text>\r\n                          <Text strong>₹ {Number(saveDeliveryCharge)?.toFixed(2)}</Text>\r\n                        </div>\r\n                        :\r\n                        <div className=\"checkout-summary-text\">\r\n                          <Text strong>Delivery Charges</Text>\r\n                          <Text strong>Free</Text>\r\n                        </div>\r\n                      }\r\n\r\n                      {selectCoupon && (\r\n                        <div className=\"checkout-summary-text\">\r\n                          <div style={{ display: \"flex\", alignItems: \"center\", gap: 6 }}>\r\n                            <RiCoupon3Line size={14} />\r\n                            <p>Coupon</p>\r\n                            <span>({selectCoupon?.couponCode})</span>\r\n                          </div>\r\n                          <div className=\"free\" style={{ display: \"flex\", alignItems: \"center\", gap: 6 }}>\r\n                            <div\r\n                              style={{ cursor: 'pointer', color: 'red' }}\r\n                              onClick={handleRemoveCoupon}\r\n                            >\r\n                              <RiDeleteBinLine size={14} />\r\n                            </div>\r\n                            <div>\r\n                              {selectCoupon?.discountType === Discount?.DISCOUNT ? (\r\n                                `${selectCoupon?.discountValue}% OFF`\r\n                              ) : selectCoupon?.discountType === Discount?.CASHBACK ? (\r\n                                `₹${selectCoupon?.discountValue} OFF`\r\n                              ) : (\r\n                                `Free delivery`\r\n                              )}\r\n                            </div>\r\n                          </div>\r\n                        </div>\r\n                      )}\r\n                      {selectCoupon && totalAmount < selectCoupon.minCartAmount && (\r\n                        <Alert\r\n                          type=\"error\"\r\n                          banner\r\n                          message={`This coupon can apply on orders above ₹${selectCoupon?.minCartAmount}`}\r\n                          style={{ padding: '5px 10px', margin: '5px 0' }}\r\n                        />\r\n                      )}\r\n                      <div className=\"checkout-summary-text\">\r\n                        <Text strong>Total Payable</Text>\r\n                        <Text strong>₹ {Math.round(payableAmount)}</Text>\r\n                      </div>\r\n                    </div>\r\n\r\n                    <div className=\"checkout-saving\">\r\n                      <div className=\"wave\">\r\n                        <svg viewBox=\"0 0 500 40\" preserveAspectRatio=\"none\">\r\n                          <path\r\n                            d=\"\r\n      M0,20 \r\n      Q15,8 30,20 \r\n      T60,20 \r\n      T90,20 \r\n      T120,20 \r\n      T150,20 \r\n      T180,20 \r\n      T210,20 \r\n      T240,20 \r\n      T270,20 \r\n      T300,20 \r\n      T330,20 \r\n      T360,20 \r\n      T390,20 \r\n      T420,20 \r\n      T450,20 \r\n      T480,20 \r\n      T500,20\r\n      L500,0 L0,0 Z\r\n    \"\r\n                            fill=\"#fff\"\r\n                          />\r\n                        </svg>\r\n                      </div>\r\n\r\n                      <div className=\"saving-content\">\r\n                        <b>Your Total Saving</b>\r\n                        <strong>₹{AllSaveAmount?.toFixed(2)}</strong>\r\n                      </div>\r\n                    </div>\r\n                  </Card>\r\n\r\n                  <Alert\r\n                    style={{ margin: '1rem 0', alignItems: 'flex-start' }}\r\n                    type=\"info\"\r\n                    showIcon\r\n                    message={\r\n                      <>\r\n                        <h6>Cancellation Policy</h6>\r\n                        <p>\r\n                          Orders cannot be cancelled once Dispatched for delivery.\r\n                          In case of unexpected delays, a refund will be\r\n                          provided, if applicable.\r\n                        </p>\r\n                      </>\r\n                    }\r\n                  />\r\n\r\n                  {/* {currentUser?.referralData &&\r\n                    <ReferralCouponCard\r\n                      userReferralData={currentUser?.referralData}\r\n                      onApply={() => { }}\r\n                    />\r\n                  } */}\r\n\r\n                  <BeforeCheckProductList setOpen={setOpen} open={open} />\r\n                </div>\r\n                <div className=\"total_amount\">\r\n                  <Card>\r\n                    <div className=\"total\">\r\n                      <p>₹ {Math.round(payableAmount)}</p>\r\n                      {!token ? (\r\n                        <Login />\r\n                      ) : (\r\n                        <div className=\"total\">\r\n                          <Button disabled={isLoading} type=\"secondry\" onClick={() => {\r\n                            setOpen(false);\r\n                            navigate(\"/checkout/DELIVERY\");\r\n                            // navigate(\"/newCheckout/DELIVERY\");\r\n                          }}>\r\n                            Proceed\r\n                          </Button>\r\n                        </div>\r\n                      )}\r\n                    </div>\r\n                  </Card>\r\n                </div>\r\n              </>\r\n            )}\r\n          </>\r\n        </Drawer >\r\n      </div >\r\n\r\n      {isModalOpen &&\r\n        <CouponModal\r\n          title=\"Select Coupon\"\r\n          isOpen={isModalOpen}\r\n          onClose={toggleModalDrawer}\r\n          onSelectCoupon={onSelectCoupon}\r\n          cartAmount={totalAmount}\r\n        />\r\n      }\r\n\r\n      {isRemoveOpen &&\r\n        <ClearAllModal\r\n          title=\"Remove Items\"\r\n          subTitle={'Are you sure you want to remove items from your cart?'}\r\n          isOpen={isRemoveOpen}\r\n          onClose={toggleRemoveModal}\r\n          isOk={handleRemoveItem}\r\n        />\r\n      }\r\n    </>\r\n  );\r\n};\r\n\r\nexport default CartMenu;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\referralOffer\\Offer.jsx",["1185"],[],"import { Card, Col, Divider, List, message, notification, Row, Skeleton, Tag, Tooltip, Typography } from \"antd\";\r\nimport { useEffect, useState } from \"react\";\r\nimport { GetOfferDetails } from \"../apiService/api\";\r\nimport { useAuth } from \"../auth/context/authContext\";\r\nimport dayjs from \"dayjs\";\r\nimport { AiOutlineCopy, AiOutlineGift } from \"react-icons/ai\";\r\nimport '../../style/offer.css'\r\n\r\nconst { Text, Title } = Typography;\r\n\r\nconst Offer = () => {\r\n    const { token, currentUser } = useAuth();\r\n    const referralCode = currentUser?.referralCode || 'DEFAULT_CODE';\r\n    const baseUrl = window.location.origin;\r\n    const referralLink = `${baseUrl}/home?referralCode=${referralCode}`;\r\n\r\n    const [offerInfo, setOfferInfo] = useState(null);\r\n    const [isLoading, setIsLoading] = useState(false);\r\n    const [copied, setCopied] = useState(false);\r\n\r\n    const handleCopy = async () => {\r\n        try {\r\n            await navigator.clipboard.writeText(referralLink);\r\n            setCopied(true);\r\n            message.success(\"Copied to clipboard!\");\r\n            setTimeout(() => setCopied(false), 2000);\r\n        } catch (err) {\r\n            message.error(\"Failed to copy.\");\r\n        }\r\n    };\r\n\r\n    const ShowOfferInfo = async () => {\r\n        setIsLoading(true);\r\n        try {\r\n            const res = await GetOfferDetails(token);\r\n            if (res.status === 200) {\r\n                setOfferInfo(res.data.data);\r\n                setIsLoading(false);\r\n            } else if (res.status === 283) {\r\n                notification.error({\r\n                    placement: \"topRight\",\r\n                    message: res.data.message,\r\n                });\r\n            }\r\n        } catch (error) {\r\n            setIsLoading(false);\r\n        }\r\n    };\r\n\r\n    useEffect(() => {\r\n        ShowOfferInfo();\r\n    }, []);\r\n\r\n    return (\r\n        <div className=\"landing_page\" style={{ margin: '20px 0px' }}>\r\n            <Card\r\n                cover={\r\n                    <img\r\n                        alt=\"Banner\"\r\n                        src=\"reward_banner.png\"\r\n                        className=\"referral-card-img\"\r\n                    />\r\n                }\r\n                className=\"referral-card\"\r\n                bodyStyle={{ padding: \"32px\" }}\r\n            >\r\n                {isLoading ? (\r\n                    <Skeleton active title={false} paragraph={{ rows: 3 }} />\r\n                ) : (\r\n                    <>\r\n                        <Row gutter={[24, 24]}>\r\n                            <Col xs={24} sm={18} md={14} lg={12} xl={8} className=\"referral-col\">\r\n                                <div style={{height:'100%'}}>\r\n                                    <Card className=\"referral-code-card\" bodyStyle={{ textAlign: \"center\",height:'100%' }}>\r\n                                        <Text type=\"secondary\" className=\"referral-text\">\r\n                                            Share this code with your friends and earn exciting rewards! (Max Order Limit): <strong>{offerInfo?.maxOrderLimit || 'N/A'}</strong>, with an expiry of <strong>{offerInfo?.expiryDays || 'N/A'} days</strong>, earning rewards like <strong>{offerInfo?.rewardName || 'N/A'}</strong>—and you will receive a reward count of <strong>{offerInfo?.referralUserRewardCount || 'N/A'}</strong>.\r\n                                        </Text>\r\n                                        <Title level={4}>Your Referral Code</Title>\r\n                                        <div\r\n                                            className=\"copy-container\"\r\n                                            onClick={handleCopy}\r\n                                            title={copied ? \"Copied!\" : \"Click to copy\"}\r\n                                        >\r\n                                            <Text className=\"copy-text\">{referralCode}</Text>\r\n                                            <AiOutlineCopy size={28} color={copied ? \"#52c41a\" : \"#888\"} />\r\n                                        </div>\r\n                                    </Card>\r\n                                </div>\r\n                            </Col>\r\n\r\n                            <Col xs={24} md={24} xl={12} style={{ padding: '0 16px' }}>\r\n                                <div>\r\n                                    <Row align=\"start\" gutter={[16, { xs: 16, sm: 16 }]}>\r\n                                        <Col xs={12} sm={8}>\r\n                                            <Text strong>Referral Users Count:</Text>\r\n                                        </Col>\r\n                                        <Col xs={12} sm={16}>\r\n                                            <Text>{currentUser?.referralData?.totalReferrals}</Text>\r\n                                        </Col>\r\n                                    </Row>\r\n                                    <Divider>Active Referral Offers</Divider>\r\n                                    <List\r\n                                        grid={{ gutter: 16, xs: 1, sm: 1, md: 2, lg: 2, xl: 2, xxl: 2 }}\r\n                                        dataSource={currentUser?.referralData?.referredUsers.filter((user) => user.isActive)}\r\n                                        renderItem={(user) => (\r\n                                            <List.Item>\r\n                                                <Card\r\n                                                    title={\r\n                                                        <Row align=\"middle\" gutter={8}>\r\n                                                            <Col>\r\n                                                                <AiOutlineGift size={24} style={{ color: \"#52c41a\" }} />\r\n                                                            </Col>\r\n                                                            <Col>\r\n                                                                <Text strong>{user?.rewardId?.rewardName || \"Reward\"}</Text>\r\n                                                            </Col>\r\n                                                            <Col flex=\"auto\">\r\n                                                                <Tag color=\"green\" style={{ float: \"right\" }}>\r\n                                                                    Max Order: {user.rewardId.maxOrderLimit}\r\n                                                                </Tag>\r\n                                                            </Col>\r\n                                                        </Row>\r\n                                                    }\r\n                                                    style={{ borderRadius: 8 }}\r\n                                                >\r\n                                                    <Text strong>Reward:</Text> {user?.rewardId?.rewardName || \"N/A\"}\r\n                                                    <br />\r\n                                                    <Text strong>Active Date:</Text>{\" \"}\r\n                                                    <Tooltip title={user?.activatedDate ? dayjs(user.activatedDate).format(\"DD MMM YYYY, hh:mm A\") : \"N/A\"}>\r\n                                                        <span>{user?.activatedDate ? dayjs(user.activatedDate).format(\"DD/MM/YYYY\") : \"N/A\"}</span>\r\n                                                    </Tooltip>\r\n                                                    <br />\r\n                                                    <Text strong>Expiry Date:</Text>{\" \"}\r\n                                                    <Tooltip title={user?.expiryDate ? dayjs(user.expiryDate).format(\"DD MMM YYYY, hh:mm A\") : \"N/A\"}>\r\n                                                        <span style={{ color: user?.expiryDate && dayjs(user.expiryDate).isBefore(dayjs()) ? \"red\" : \"inherit\" }}>\r\n                                                            {user?.expiryDate ? dayjs(user.expiryDate).format(\"DD/MM/YYYY\") : \"N/A\"}\r\n                                                        </span>\r\n                                                    </Tooltip>\r\n                                                </Card>\r\n                                            </List.Item>\r\n                                        )}\r\n                                    />\r\n                                </div>\r\n                            </Col>\r\n                        </Row>\r\n                    </>\r\n                )}\r\n            </Card>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default Offer;","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\shareLink\\GetShareLink.jsx",["1186","1187"],[],"import React, { useEffect, useState } from 'react';\r\nimport { Button, Divider, List, Modal, Skeleton, Space } from 'antd';\r\nimport '../../style/order.css'\r\nimport { useLocation, useNavigate, useParams } from 'react-router-dom';\r\nimport LZString from 'lz-string'\r\nimport { fetchShareCart } from '../apiService/api';\r\nimport { useScreen } from '../auth/AuthScreen';\r\nimport BKDLogo from \"../../assest/bkdlogo.png\";\r\nimport { addShareCart } from '../../redux/CartSlice';\r\nimport { useDispatch } from 'react-redux';\r\n\r\n\r\nconst GetShareLink = () => {\r\n    const [isModalOpen, setIsModalOpen] = useState(false);\r\n    const [isLoading, setIsLoading] = useState(false);\r\n    const [cartData, setCartData] = useState([])\r\n    const navigate = useNavigate()\r\n    const { screenWidth } = useScreen()\r\n    const dispatch = useDispatch()\r\n    const params = new URLSearchParams(window.location.search);\r\n    const paramsData = params.get(\"data\");\r\n\r\n    const titleCase = str => str?.toLowerCase()?.split(' ')?.map(word => word?.charAt(0)?.toUpperCase() + word?.slice(1))?.join(' ');\r\n\r\n    console.log(\"params\", params)\r\n\r\n    const showModal = () => {\r\n        setIsModalOpen(true);\r\n    };\r\n    const handleOk = () => {\r\n        setIsModalOpen(false);\r\n    };\r\n    const handleCancel = () => {\r\n        setIsModalOpen(false);\r\n        navigate('/')\r\n    };\r\n\r\n    useEffect(() => {\r\n        showModal()\r\n    }, [])\r\n\r\n    const fetchShareCartData = async (cart) => {\r\n        console.log(\"cart jatin\", cart)\r\n        setIsLoading(true)\r\n        try {\r\n            await fetchShareCart({ cartItem: cart }).then((res) => {\r\n                console.log(\"res\", res)\r\n                if (res.status === 200) {\r\n                    setCartData(res.data.data)\r\n                    setIsLoading(false)\r\n\r\n                }\r\n            }).catch((err) => {\r\n                console.log(err)\r\n                setIsLoading(false)\r\n\r\n            })\r\n\r\n        } catch (error) {\r\n            console.log(error)\r\n            setIsLoading(false)\r\n\r\n        }\r\n    }\r\n\r\n\r\n    useEffect(() => {\r\n        try {\r\n            const decodedData = LZString.decompressFromEncodedURIComponent(paramsData);\r\n            const cart = JSON.parse(decodedData); // parse JSON string\r\n            console.log(\"Imported cart:\", cart);\r\n            fetchShareCartData(cart)\r\n            setCartData?.(cart);\r\n        } catch (error) {\r\n            console.error(\"Failed to decode cart:\", error);\r\n            alert(\"Invalid cart link.\");\r\n\r\n        }\r\n    }, [paramsData]);\r\n\r\n    const handletoCart = () => {\r\n        localStorage.setItem(\"cart\", JSON.stringify(cartData));\r\n        dispatch(addShareCart(cartData))\r\n        handleCancel()\r\n        navigate(\"/\");\r\n    }\r\n\r\n\r\n    return (\r\n        <>\r\n\r\n            <Modal\r\n                style={{ top: 20 }}\r\n                footer={false}\r\n                title=\"Items share with you !\"\r\n                closable={{ 'aria-label': 'Custom Close Button' }}\r\n                open={isModalOpen}\r\n                onOk={handleOk}\r\n                onCancel={handleCancel}\r\n            >\r\n                {isLoading ? <Skeleton active /> : <div className='cart_list'>\r\n                    <List\r\n\r\n                        className=\"demo-loadmore-list\"\r\n\r\n                        itemLayout={screenWidth < 800 ? \"vertical\" : \"horizontal\"}\r\n\r\n                        dataSource={cartData}\r\n                        renderItem={(item) => (\r\n                            <List.Item\r\n                            >\r\n                                <List.Item.Meta\r\n                                    avatar={Array.isArray(item?.imageUrl) && item?.imageUrl[0] != null ? (\r\n                                        <img\r\n                                            src={item?.imageUrl[0] || BKDLogo}\r\n                                            onError={(e) => e.currentTarget.src = BKDLogo}\r\n                                            alt=\"product\"\r\n                                        />\r\n                                    ) : (\r\n                                        <img src={BKDLogo} alt=\"default logo\" />\r\n                                    )}\r\n                                    title={<div className=\"cart_pro_title\">\r\n                                        <p >{titleCase(item?.productName)} </p>\r\n                                    </div>}\r\n                                    description={\r\n                                        <div className=\"weat\">\r\n                                            <Space>\r\n                                                <p>{item.qty} x {item.packSize} </p>\r\n                                                {/* <p>₹<del>{item.price}</del>  </p>\r\n                                                <p><strong>{`₹ ${item.bkdAmount} `}</strong></p> */}\r\n                                            </Space>\r\n                                        </div>}\r\n                                />\r\n\r\n                            </List.Item>\r\n                        )}\r\n                    />\r\n                </div>}\r\n\r\n                <Divider />\r\n                <div className=\"add_share_item\">\r\n                    <Space>\r\n                        <Button type='primary' onClick={handletoCart}> Add To Cart </Button>\r\n                        <Button danger onClick={handleCancel}>Cancel Cart</Button>\r\n                    </Space>\r\n                </div>\r\n            </Modal>\r\n        </>\r\n    );\r\n};\r\n\r\nexport default GetShareLink","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\segment\\SegmentDetails.jsx",["1188","1189","1190","1191","1192","1193","1194","1195","1196","1197","1198","1199","1200","1201","1202","1203","1204","1205","1206","1207","1208","1209","1210","1211","1212","1213"],[],"import BannerSegment from './BannerSegment'\r\nimport SegmentProductItem from './SegmentProductItem'\r\nimport { useLocation, useParams } from 'react-router-dom';\r\nimport { fetchSegmentDetails, ProdductLimits } from '../apiService/api';\r\nimport ProductFilter from '../Category/ProductFilter';\r\nimport { Badge, Button, Card, Divider, Radio, Skeleton, Space, Tag, Tooltip, notification } from \"antd\";\r\nimport React, { useEffect, useState, useRef } from \"react\";\r\nimport \"../../style/header.css\";\r\nimport { FaHeart } from \"react-icons/fa\";\r\nimport { FaRegHeart } from \"react-icons/fa\";\r\nimport { useNavigate } from \"react-router-dom\";\r\nimport { MdArrowRightAlt } from \"react-icons/md\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { addItem, removeItem, selectCartItems } from \"../../redux/CartSlice\";\r\nimport { SmileOutlined } from '@ant-design/icons';\r\nimport { AddProductWishlist, out_of_stock } from \"../apiService/api\";\r\nimport { useScreen } from \"../auth/AuthScreen\";\r\nimport { useAuth } from \"../auth/context/authContext\";\r\nimport BKDLogo from \"../../assest/bkdlogo.png\"\r\nimport NotFoundProduct from \"../../assest/not-found.jpg\"\r\nimport offerAvailable from \"../../assest/png/offer_apply.png\"\r\nimport { encryptCategoryID } from '../../config/encriptConfig';\r\nimport { getOfferImage } from '../../utils/offerUtils';\r\n\r\nfunction SegmentDetails() {\r\n    const { screenWidth } = useScreen()\r\n\r\n    const { nearStore } = useAuth()\r\n    const { id } = useParams()\r\n    const [segmentData, setSegmentData] = useState([])\r\n    const [isLoading, setIsLoading] = useState(false)\r\n    const [current, setCurrent] = useState(1)\r\n    const [nextLoading, setNextLoading] = useState(false)\r\n    const [hasMore, setHasMore] = useState(true);\r\n    const observerRef = useRef(null);\r\n    const { state } = useLocation()\r\n    const [itemType, setItemType] = useState(\"\")\r\n    const [filterBy, setFilterBy] = useState(\"\")\r\n    const skeletonArray = new Array(segmentData?.length || screenWidth < 1400 ? 12 : 14).fill(0);\r\n\r\n    const { token } = useAuth()\r\n    const navigate = useNavigate();\r\n    const dispatch = useDispatch();\r\n    const cartItems = useSelector(selectCartItems);\r\n    const titleCase = str => str.toLowerCase().split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');\r\n\r\n\r\n    const [wishlist, setWishlist] = useState({});\r\n\r\n\r\n\r\n    const handleAddItem = (item) => {\r\n        dispatch(addItem(item))\r\n\r\n    };\r\n\r\n    useEffect(() => {\r\n        localStorage.setItem(\"cart\", JSON.stringify(cartItems));\r\n    }, [cartItems]);\r\n\r\n\r\n    const handleDelItem = (item) => {\r\n        dispatch(removeItem(item));\r\n        const cart = JSON.parse(localStorage.getItem(\"cart\")) || []; // Retrieve cart from localStorage\r\n        const updatedCart = cart.filter(cartItem => cartItem.productCode !== item.productCode); // Filter \r\n        localStorage.setItem(\"cart\", JSON.stringify(updatedCart))\r\n\r\n    };\r\n\r\n\r\n    const GoToSimilarProduct = (item) => {\r\n        // navigate(`/product/${manageURl(item.productName)}`, { state: item.productCode })\r\n        navigate(`/product/${manageURl(item.productName)}?uid=${encodeURIComponent(encryptCategoryID(item.productCode))}`);\r\n        showSegmentDetails()\r\n    }\r\n\r\n    const HnadleNotLogin = () => {\r\n        notification.error({\r\n            placement: \"topRight\",\r\n            message: \"Please login before add wishlist\",\r\n        });\r\n    }\r\n\r\n\r\n    const addToWishList = async (proCode) => {\r\n        setWishlist((prev) => ({ ...prev, [proCode.productCode]: true }));\r\n        const body = {\r\n            productCode: proCode.productCode,\r\n            productName: proCode.productName,\r\n            status: \"ACTIVE\"\r\n        }\r\n        try {\r\n            await AddProductWishlist(token, body)\r\n                .then((res) => {\r\n                    console.log(\"add to  wish\", res);\r\n                    if (res.status == 201) {\r\n                        if (res.data.data.whislistKey != true) {\r\n                            showSegmentDetails()\r\n                        } else {\r\n                            showSegmentDetails()\r\n\r\n                        }\r\n\r\n\r\n                    }\r\n\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n                    setWishlist((prev) => ({ ...prev, [proCode]: false }));\r\n                });\r\n        } catch (error) {\r\n            setWishlist((prev) => ({ ...prev, [proCode]: false }));\r\n            console.log(error);\r\n\r\n        }\r\n    };\r\n    const RemoveToWishList = async (proCode) => {\r\n        setWishlist((prev) => ({ ...prev, [proCode.productCode]: false })); // Immediately update the icon\r\n        const body = { productCode: proCode.productCode, productName: proCode.productName, status: \"INACTIVE\" };\r\n        try {\r\n            await AddProductWishlist(token, body)\r\n                .then((res) => {\r\n                    if (res.status === 201) {\r\n                        showSegmentDetails();\r\n\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n                    setWishlist((prev) => ({ ...prev, [proCode]: true })); // Revert the icon if the API call fails\r\n\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n            setWishlist((prev) => ({ ...prev, [proCode]: true })); // Revert the icon if the API call fails\r\n        }\r\n    };\r\n\r\n    // const showSegmentDetails = async (isInitial = false) => {\r\n\r\n    //     setIsLoading(true)\r\n    //     setNextLoading(isInitial)\r\n    //     const page = isInitial ? 1 : current + 1\r\n    //     try {\r\n    //         await fetchSegmentDetails(id, current, nearStore?.branchCode, itemType, filterBy)\r\n    //             .then((res) => {\r\n    //                 console.log(\"segment  details product\", res);\r\n    //                 if (res.status == 200) {\r\n    //                     const fetchData = res.data.data\r\n    //                     // setSegmentData((prev) => [...prev, ...fetchData]);\r\n\r\n    //                     if (fetchData.length === 0) {\r\n    //                         setHasMore(false)\r\n    //                     } else {\r\n    //                         setSegmentData((prevData) => isInitial ? fetchData : [...prevData, ...fetchData])\r\n    //                         setCurrent(page)\r\n    //                     }\r\n    //                 }\r\n    //             })\r\n    //             .catch((err) => {\r\n    //                 console.log(err);\r\n    //             });\r\n    //     } catch (error) {\r\n    //         console.log(error);\r\n    //     } finally {\r\n    //         setIsLoading(false)\r\n    //         setNextLoading(false)\r\n\r\n    //     }\r\n    // };\r\n    // useEffect(() => {\r\n    //     showSegmentDetails(true)\r\n    // }, [itemType, filterBy])\r\n\r\n    const showSegmentDetails = async (isInitial = false) => {\r\n        setIsLoading(true);\r\n        setNextLoading(isInitial);\r\n\r\n        // Fix: Calculate the correct page value to pass\r\n        const page = isInitial ? 1 : current + 1;\r\n\r\n        try {\r\n            // Use the updated `page` value instead of stale `current`\r\n            await fetchSegmentDetails(id, page, nearStore?.branchCode, itemType, filterBy)\r\n                .then((res) => {\r\n                    console.log(\"segment details product\", res);\r\n                    if (res.status === 200) {\r\n                        const fetchData = res.data.data;\r\n\r\n                        if (fetchData.length === 0) {\r\n                            setHasMore(false);\r\n                        } else {\r\n                            setSegmentData((prevData) =>\r\n                                isInitial ? fetchData : [...prevData, ...fetchData]\r\n                            );\r\n                            setCurrent(page); // Update `current` state here\r\n                        }\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err);\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n        } finally {\r\n            setIsLoading(false);\r\n            setNextLoading(false);\r\n        }\r\n    };\r\n\r\n    useEffect(() => {\r\n        showSegmentDetails(true)\r\n    }, [itemType, filterBy])\r\n\r\n    useEffect(() => {\r\n        if (segmentData?.length == ProdductLimits * current) {\r\n            const observer = new IntersectionObserver(\r\n                (entries) => {\r\n                    if (entries[0].isIntersecting && !isLoading && hasMore) {\r\n\r\n                        showSegmentDetails(false)\r\n                    }\r\n\r\n                },\r\n                { threshold: 1.0 }\r\n            );\r\n\r\n            if (observerRef.current) observer.observe(observerRef.current);\r\n\r\n            return () => {\r\n                if (observerRef.current) observer.unobserve(observerRef.current);\r\n            };\r\n        }\r\n    }, [hasMore, isLoading]);\r\n\r\n    const manageURl = (productName) => {\r\n        const sanitizedCategory = productName\r\n            .replace(/[,/&]/g, '') // Remove commas, slashes, ampersands\r\n            .replace(/\\s+/g, '-')  // Replace spaces with hyphens\r\n            .toLowerCase();\r\n        return sanitizedCategory\r\n    }\r\n\r\n    const goToProductDetails = (item) => {\r\n        navigate(`/product/${manageURl(item.productName)}?uid=${encodeURIComponent(encryptCategoryID(item.productCode))}`);\r\n    }\r\n\r\n    return (\r\n        <div className='recipes_datas'>\r\n            <div className=\"segment_banner\">\r\n                {state instanceof Array ? state.map((url) => (\r\n                    <div className=\"banenr_segment\">\r\n                        <img\r\n                            src={url.banner || BKDLogo}\r\n                            onError={(e) => e.currentTarget.src = BKDLogo}\r\n                        />\r\n                    </div>\r\n                )) :\r\n                    <div className=\"banenr_segment\">\r\n                        <img\r\n                            src={state.banner || BKDLogo}\r\n                            onError={(e) => e.currentTarget.src = BKDLogo}\r\n                        />\r\n                    </div>\r\n                }\r\n            </div>\r\n            <div className=\"segment_product\">\r\n\r\n                <div>\r\n                    {state instanceof Array ? state.map((url) => (\r\n                        <div className=\"banenr_segment_title\">\r\n                            <h4>{url.title}</h4>\r\n                            <ProductFilter setFilterBy={setFilterBy} setItemType={setItemType} setCurrent={setCurrent} />\r\n                        </div>\r\n                    )) :\r\n                        <div className=\"banenr_segment_title\">\r\n                            <h4>{state.title}</h4>\r\n                            <ProductFilter setFilterBy={setFilterBy} setItemType={setItemType} />\r\n\r\n                        </div>\r\n\r\n                    } {nextLoading ?\r\n                        <div className=\"showing_pro_by_cat\">\r\n                            {skeletonArray.map((_, index) => (\r\n                                <Card size=\"small\" className=\"loading mx-2 mb-2\" key={index}>\r\n                                    <Skeleton.Image active />\r\n                                    <Skeleton active paragraph={{ row: 6 }} />\r\n                                </Card>\r\n                            ))}\r\n                        </div> : <div className=\"prodcut_slider\">\r\n                            <div className={`${segmentData?.length !== 0 && \"showing_pro_by_cat\"}`}>\r\n                                {segmentData?.length === 0 ? <div className='text-center'>\r\n                                    <img src={NotFoundProduct} width=\"50%\" />\r\n                                </div> : segmentData.map((item) => (\r\n                                    <div className=\"product_card individual_card\" key={item.productCode}>\r\n                                        <Card\r\n                                            hoverable\r\n                                            disabled={item.stockQty == 0 && true}\r\n                                        >\r\n                                            <div className=\"card_img\">\r\n                                                {item.imageUrl[0] != null ?\r\n                                                    <img\r\n                                                        className={item.stockQty <= out_of_stock ? \"out_of_stock_img\" : \"\"}\r\n                                                        src={item.imageUrl[0] || BKDLogo}\r\n                                                        onError={(e) => e.currentTarget.src = BKDLogo}\r\n                                                        onClick={() => GoToSimilarProduct(item)}\r\n                                                    />\r\n                                                    :\r\n                                                    <img\r\n                                                        className={item.stockQty <= out_of_stock ? \"out_of_stock_img\" : \"\"}\r\n                                                        src={BKDLogo}\r\n                                                        onClick={() => goToProductDetails(item)}\r\n                                                    />\r\n                                                }\r\n                                            </div>\r\n\r\n                                            <div className=\"pro_name\" onClick={() => goToProductDetails(item)}>\r\n                                                <Tooltip title={titleCase(item.productName)}>\r\n                                                    <p>{item.productName.length > 36 ? titleCase(item.productName.slice(0, 36)) + \"...\" : titleCase(item.productName)}</p>\r\n                                                </Tooltip>\r\n                                            </div>\r\n                                            <div className=\"show_variant_item\" onClick={() => goToProductDetails(item)}>\r\n                                                {item.packSize && item.packSize !== \"(NIL)\" ? <Tag color=\"green\">{item.packSize.substr(0, 10)}</Tag> : <p className=\"hidden_data\">N/A</p>}\r\n                                                {item.stockQty <= out_of_stock ? <Tag color='red' className=\"stock_tag\">out of stock</Tag> : <p className='hidden_data'>N/A</p>}\r\n                                            </div>\r\n                                            <div className=\"show_price_mrp\">\r\n                                                <p>BKD Price | MRP</p>\r\n                                            </div>\r\n                                            <div className=\"add_cart\">\r\n                                                <p>{`₹ ${Math.round(item.bkdAmount)} `} <span>{item.bkdAmount != item.price && <del>₹ {item.price}</del>}</span> </p>\r\n\r\n                                                {cartItems.find((cartItem) => cartItem.productCode === item.productCode) ? (\r\n                                                    cartItems.map((cartItem) => {\r\n                                                        if (cartItem.productCode === item.productCode) {\r\n                                                            return (\r\n                                                                <Button.Group className=\"add_to_carts\" size={screenWidth < 800 ? \"\" : 'small'} key={cartItem.productCode}>\r\n                                                                    <Button className=\"add_to_carts add_to_cart_button\" onClick={() => handleDelItem(item)}>-</Button>\r\n                                                                    <Button className=\"add_to_carts add_to_cart_button\">{cartItem.unit}</Button> {/* Access quantity from cart item */}\r\n                                                                    <Button className=\"add_to_carts add_to_cart_button\" onClick={() => handleAddItem(item)}>+</Button>\r\n                                                                </Button.Group>\r\n                                                            );\r\n                                                        }\r\n                                                        return null;\r\n                                                    })\r\n                                                ) : (\r\n                                                    <Button disabled={item.stockQty <= out_of_stock} type=\"default\" onClick={() => handleAddItem(item)}>ADD</Button>\r\n                                                )}\r\n                                            </div>\r\n                                        </Card>\r\n                                        {/* {isLoading && (\r\n                                            <div className=\"showing_pro_by_cat\">\r\n                                                {skeletonArray.map((_, index) => (\r\n                                                    <Card size=\"small\" className=\"loading mx-2 mb-2\" key={index}>\r\n                                                        <Skeleton.Image active />\r\n                                                        <Skeleton active paragraph={{ row: 6 }} />\r\n                                                    </Card>\r\n                                                ))}\r\n                                            </div>\r\n                                        )} */}\r\n                                        {item.billingQty === \"PROMOTIONS\" || item.billingQty === \"DISCOUNT\" || item.offerQty === \"PROMOTIONS\" || item.offerQty === \"DISCOUNT\" ?\r\n                                            <div className=\"discount_tags\">Super Saver Price</div> : item.billingQty != \"\" && item.offerQty != \"\" ? <div className=\"offer_Available\">\r\n                                                {(item.billingQty === \"FOC\" || item.offerQty === \"FOC\") ?\r\n                                                    <>\r\n                                                        <img src={offerAvailable} />\r\n                                                        <div className=\"offer_types\">\r\n                                                            <p>1 Item</p>\r\n                                                            <p>Free </p>\r\n                                                            <p>On MRP</p>\r\n                                                        </div>\r\n                                                    </>\r\n                                                    :\r\n                                                    <img src={getOfferImage(item?.offerQty)} />\r\n                                                }\r\n\r\n                                            </div> : Math.round(item.bkdAmount) != item.price ? <div className={`${isLoading ? \"load_batch\" : \"cat_tags\"}`}>{Math.round((item.price - item.bkdAmount) * 100 / item.price)}% off</div> : null}\r\n\r\n                                        <div className=\"wish_list\">\r\n\r\n                                            {token ?\r\n                                                <div className='wish_list'>\r\n                                                    {\r\n                                                        wishlist[item.productCode] || item.isWhislist ? (\r\n                                                            <FaHeart\r\n                                                                className=\"no_wish_icon\"\r\n                                                                size={22}\r\n                                                                color='red'\r\n                                                                onClick={() => RemoveToWishList(item)}\r\n                                                            />\r\n                                                        ) : (\r\n                                                            <FaRegHeart\r\n                                                                className=\"no_wish_icon\"\r\n                                                                size={22}\r\n                                                                onClick={() => addToWishList(item)}\r\n                                                            />\r\n                                                        )\r\n                                                    }\r\n                                                </div>\r\n\r\n                                                :\r\n                                                <div className='wish_list'>\r\n                                                    <FaRegHeart\r\n                                                        className=\"no_wish_icon\"\r\n                                                        size={22}\r\n                                                        onClick={HnadleNotLogin}\r\n                                                    />\r\n                                                </div>\r\n                                            }\r\n                                        </div>\r\n                                    </div>\r\n                                ))}\r\n                            </div>\r\n                        </div>}\r\n                </div>\r\n                <div ref={observerRef}>\r\n                    {isLoading && <div className='text-center'><span className=\"loaderScroll\"></span></div>}\r\n\r\n                </div>\r\n\r\n            </div>\r\n        </div>\r\n    )\r\n}\r\n\r\nexport default SegmentDetails","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\header\\UserMenu.jsx",["1214","1215","1216","1217","1218"],[],"import React from \"react\";\r\nimport { UserOutlined, SmileOutlined } from \"@ant-design/icons\";\r\nimport { Avatar, Button, Divider, Dropdown, notification, QRCode, Space } from \"antd\";\r\nimport \"../../style/header.css\";\r\n\r\nimport { useNavigate } from \"react-router-dom\";\r\nimport { AiFillHeart } from \"react-icons/ai\";\r\nimport { BsHandbagFill } from \"react-icons/bs\";\r\nimport { FaHeart, FaUser, FaWallet, FaShare } from \"react-icons/fa\";\r\nimport { MdLocalOffer, MdLocationPin } from \"react-icons/md\";\r\nimport { BiSupport } from \"react-icons/bi\";\r\nimport { useAuth } from \"../auth/context/authContext\";\r\nimport { AiOutlineLogout } from \"react-icons/ai\";\r\n\r\n\r\nfunction UserMenu() {\r\n  const navigate = useNavigate();\r\n  const { logout, currentUser } = useAuth()\r\n  const [text, setText] = React.useState('https:/www.onbkd.in')\r\n\r\n\r\n  const handleLogout = () => {\r\n    logout(navigate)\r\n    // notification.error({\r\n    //   placement: \"topRight\",\r\n    //   message: \"You've Logged Out\",\r\n\r\n    // });\r\n  }\r\n\r\n  const handleReferralShare = async () => {\r\n    const referralCode = currentUser?.referralCode || 'DEFAULT_CODE';\r\n    const baseUrl = window.location.origin;\r\n    const referralLink = `${baseUrl}/home?referralCode=${referralCode}`;\r\n\r\n    try {\r\n      if (navigator.share) {\r\n        // Use native sharing if available\r\n        await navigator.share({\r\n          title: 'Join OnBkd',\r\n          text: 'Join me on OnBkd and get amazing deals!',\r\n          url: referralLink,\r\n        });\r\n      } else {\r\n        // Fallback to copying to clipboard\r\n        await navigator.clipboard.writeText(referralLink);\r\n        notification.success({\r\n          placement: \"topRight\",\r\n          message: \"Referral link copied to clipboard!\",\r\n        });\r\n      }\r\n    } catch (error) {\r\n      console.error('Error sharing referral link:', error);\r\n      // Fallback: copy to clipboard\r\n      try {\r\n        await navigator.clipboard.writeText(referralLink);\r\n        notification.success({\r\n          placement: \"topRight\",\r\n          message: \"Referral link copied to clipboard!\",\r\n        });\r\n      } catch (clipboardError) {\r\n        console.error('Clipboard error:', clipboardError);\r\n        notification.info({\r\n          placement: \"topRight\",\r\n          message: `Your referral link: ${referralLink}`,\r\n          duration: 10,\r\n        });\r\n      }\r\n    }\r\n  }\r\n\r\n  const items = [\r\n    {\r\n      label: (\r\n        <>\r\n          <h4>My Account</h4>\r\n          <p>+91-{currentUser?.mobileNo}</p>\r\n        </>\r\n\r\n      ),\r\n      disabled: true,\r\n    },\r\n    {\r\n      key: 1,\r\n      label: (\r\n        <p onClick={() => navigate(\"/account/profile\", { state: { key: 1 } })}>\r\n          <FaUser className=\"menu_icon\" /> View profile\r\n        </p>\r\n      ),\r\n    },\r\n    {\r\n      key: 2,\r\n      label: (\r\n        <p onClick={() => navigate(\"/account/order\", { state: { key: 2 } })}>\r\n          <BsHandbagFill className=\"menu_icon\" /> My Order\r\n        </p>\r\n      ),\r\n    },\r\n    {\r\n      key: 3,\r\n      label: (\r\n        <p onClick={() => navigate(\"/account/wishlist\", { state: { key: 3 } })}>\r\n          <FaHeart className=\"menu_icon\" /> Wishlist\r\n        </p>\r\n      ),\r\n    },\r\n    {\r\n      key: 4,\r\n      label: (\r\n        <p onClick={() => navigate(\"/account/address\", { state: { key: 4 } })}>\r\n          <MdLocationPin className=\"menu_icon\" /> Save Address\r\n        </p>\r\n      ),\r\n    },\r\n    {\r\n      key: 8,\r\n      label: (\r\n        <p onClick={() => navigate(\"/offer\", { state: { key: 8 } })}>\r\n          <MdLocalOffer className=\"menu_icon\" /> My Offers\r\n        </p>\r\n      ),\r\n    },\r\n    {\r\n      key: 5,\r\n      label: (\r\n        <p onClick={handleReferralShare}>\r\n          <FaShare className=\"menu_icon\" /> Share Referral Link\r\n        </p>\r\n      ),\r\n    },\r\n    // {\r\n    //   key: 5,\r\n    //   label: (\r\n    //     <p onClick={() => navigate(\"/account/Wallet\",{state:{key:5}})}>\r\n    //       <FaWallet className=\"menu_icon\" /> Sugar Wallet\r\n    //     </p>\r\n    //   ),\r\n    // },\r\n\r\n    {\r\n      key: 6,\r\n      label: (\r\n        <>\r\n          <p onClick={handleLogout} >\r\n            <AiOutlineLogout className=\"menu_icon\" />Logout\r\n          </p>\r\n          <Divider style={{ margin: \"0\" }} />\r\n        </>\r\n      ),\r\n    },\r\n    {\r\n      key: 7,\r\n      label: (\r\n        <Space>\r\n          <div className=\"qrs\">\r\n\r\n            <QRCode value={text || '-'} />\r\n          </div>\r\n          <div className=\"qr_title\">\r\n            <p>\r\n              Simple way to\r\n              get your groceries\r\n\r\n            </p>\r\n            <p>\r\n              Scan the QR code and\r\n\r\n            </p>\r\n            <p> Download the OnBKD app</p>\r\n          </div>\r\n        </Space>\r\n      ),\r\n    },\r\n  ];\r\n  return (\r\n    <div className=\"menu_user\">\r\n      <Dropdown\r\n        className=\"menu_drop_down\"\r\n        getPopupContainer={(triggerNode) => triggerNode.parentNode}\r\n        placement=\"bottomRight\"\r\n        trigger={[\"click\"]}\r\n        menu={{\r\n          items,\r\n        }}\r\n      >\r\n        {currentUser?.profilePic ? <Avatar src={currentUser?.profilePic} size={40} className=\"current_user_pic\" /> :\r\n          <Button type=\"primary\" shape=\"circle\" size=\"large\" className=\"user_menu\" icon={<UserOutlined />} />\r\n        }\r\n      </Dropdown>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default UserMenu;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\header\\LocationModal.jsx",["1219","1220","1221","1222","1223","1224","1225"],[],"\r\n\r\nimport React, { useEffect, useState } from \"react\";\r\nimport { Button, Modal, Spin } from \"antd\";\r\nimport { useCurrentLocation, useScreen } from \"../auth/AuthScreen\";\r\nimport GooglePlacesAutocomplete, {\r\n  geocodeByAddress,\r\n  getLatLng,\r\n} from \"react-google-places-autocomplete\";\r\nimport axios from \"axios\";\r\nimport '../../style/header.css'\r\nimport { useDispatch } from \"react-redux\";\r\nimport { setBranchDetails } from \"../../redux/OrderSlice\";\r\nimport { GetNearBranch } from \"../apiService/api\";\r\nimport { useAuth } from \"../auth/context/authContext\";\r\nimport noServiceImg from \"../../assest/png/notdeliverd.png\"\r\n\r\n\r\nconst LocationModal = ({ getLocationHandle, locationError, isLoad }) => {\r\n  const { screenHeight, screenWidth } = useScreen();\r\n  const [value, setValue] = useState(null);\r\n  const [latLng, setLatLng] = useState(null);\r\n  const [isModalOpen, setIsModalOpen] = useState(false);\r\n  const { setUserLocation, userLocation } = useCurrentLocation();\r\n  const { getNearStore } = useAuth()\r\n\r\n  const [noService, setNoService] = useState(null)\r\n  const dispatch = useDispatch()\r\n  const [isLoading, setIsLoading] = useState(false)\r\n\r\n  const mapKey = process.env.REACT_APP_GOOGLE_MAPS_API_KEY\r\n\r\n  const getDeliveryLocation = () => {\r\n    getLocationHandle();\r\n    // handleOk();\r\n  };\r\n\r\n  const showModal = () => {\r\n    setIsModalOpen(true);\r\n  };\r\n\r\n  const handleOk = () => {\r\n    setIsModalOpen(false);\r\n  };\r\n\r\n  useEffect(() => {\r\n    const getManualLocation = async (label) => {\r\n      try {\r\n        const results = await geocodeByAddress(label);\r\n        const { lat, lng } = await getLatLng(results[0]);\r\n        setLatLng({ lat, lng });\r\n\r\n        const response = await axios.get(\r\n          `https://maps.googleapis.com/maps/api/geocode/json?latlng=${lat},${lng}&key=${mapKey}`\r\n        );\r\n        if (response.data.status === \"OK\" && !noService) {\r\n          const userLocation = response.data.results[0];\r\n          setUserLocation(userLocation);  // Set the state with the user’s location data\r\n          localStorage.setItem(\"location\", JSON.stringify(userLocation));\r\n\r\n        }\r\n        setValue(null);\r\n      } catch (error) {\r\n        // Error handling\r\n      }\r\n    };\r\n\r\n    if (value && value.label) {\r\n      getManualLocation(value.label);\r\n    }\r\n  }, [value, noService]);\r\n\r\n  useEffect(() => {\r\n    if (userLocation == null) {\r\n      showModal();\r\n    }\r\n  }, []);\r\n\r\n\r\n\r\n  const handleChange = (selectedValue) => {\r\n    setValue(selectedValue); // Update the selected value\r\n    setNoService(\"\");\r\n  };\r\n\r\n\r\n  const showBranchDetails = async () => {\r\n    const body = {\r\n      longitude: userLocation?.geometry?.location?.lng,\r\n      latitude: userLocation?.geometry?.location?.lat\r\n    }\r\n    setIsLoading(true)\r\n\r\n    try {\r\n      await GetNearBranch(body)\r\n        .then((res) => {\r\n          if (res.status == 200) {\r\n            localStorage.setItem(\"near store\", JSON.stringify(res.data.data));\r\n            dispatch(setBranchDetails(res.data.data));\r\n            getNearStore(res.data.data)\r\n            setIsModalOpen(false)\r\n            setIsLoading(false)\r\n            setNoService(null)\r\n          } else if (res.status === 202) {\r\n            setIsModalOpen(true)\r\n            setNoService(res.data.message)\r\n            setIsLoading(false)\r\n          }\r\n\r\n        })\r\n        .catch((err) => {\r\n          // Error handling\r\n        });\r\n    } catch (error) {\r\n      setIsLoading(false)\r\n    }\r\n  };\r\n  useEffect(() => {\r\n    if (userLocation != null)\r\n      showBranchDetails()\r\n  }, [userLocation])\r\n\r\n  return (\r\n    <>\r\n      <Modal\r\n        title=\"Select Your Location\"\r\n        open={isModalOpen}\r\n        onOk={handleOk}\r\n        closable={false}\r\n        maskClosable={false}\r\n        onCancel={handleOk}\r\n        footer={false}\r\n        width={300}\r\n        style={{\r\n          right: screenWidth > 800 ? 300 : 0,\r\n        }}\r\n      >\r\n        {isLoad ? (\r\n          <div className=\"text-center\" style={{ margin: '30px 0' }}>\r\n            <Spin />\r\n            <p style={{ fontSize: \"12px\", marginTop: \"5px\" }}>\r\n              Detecting your location...\r\n            </p>\r\n          </div>\r\n        ) : (\r\n          <>\r\n            <div className=\"loc_add\">\r\n              <Button shape=\"round\" block onClick={getDeliveryLocation}>\r\n                Detect Current Location\r\n              </Button>\r\n              <GooglePlacesAutocomplete\r\n                apiKey={mapKey}\r\n                selectProps={{\r\n                  value,\r\n                  onChange: handleChange, // Custom onChange handler\r\n                  placeholder: \"Search Your Location...\",\r\n                }}\r\n                debounce={500}\r\n              />\r\n              {locationError && (\r\n                <div className=\"no_service locatio_warning_note\">\r\n                  <p style={{ color: \"red\", fontSize: \"13px\", padding: '5px' }}>\r\n                    {locationError}\r\n                  </p>\r\n                </div>\r\n              )}\r\n            </div>\r\n            {isLoading ? <div className=\"text-center\">\r\n              <span class=\"loaderLocation\"></span>\r\n            </div>\r\n              : noService ? <div className=\"no_service\">\r\n                <img src={noServiceImg} />\r\n                <p>{noService}</p>\r\n              </div> : null}\r\n          </>\r\n        )}\r\n      </Modal>\r\n    </>\r\n  );\r\n};\r\n\r\nexport default LocationModal;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\header\\DropdownMenu.jsx",["1226","1227","1228","1229","1230","1231","1232","1233"],[],"\r\n\r\n\r\nimport React, { useEffect, useState } from \"react\";\r\nimport { Button, message, Modal, notification, Spin } from \"antd\";\r\nimport GooglePlacesAutocomplete, { geocodeByAddress, getLatLng } from \"react-google-places-autocomplete\";\r\n// import { MdOutlineArrowDropDown } from \"react-icons/md\";\r\nimport axios from \"axios\";\r\nimport \"../../style/header.css\";\r\nimport { useCurrentLocation, useScreen } from \"../auth/AuthScreen\";\r\nimport { MdLocationPin } from \"react-icons/md\";\r\nimport { MdOutlineArrowDropDown } from \"react-icons/md\";\r\nimport { setBranchDetails } from \"../../redux/OrderSlice\";\r\nimport { GetNearBranch, GetSaveLocation } from \"../apiService/api\";\r\nimport { useAuth } from \"../auth/context/authContext\";\r\nimport { useDispatch } from \"react-redux\";\r\nimport noServiceImg from \"../../assest/png/notdeliverd.png\"\r\n\r\nconst DropdownMenu = ({ getLocationHandle, isLoad, locationError }) => {\r\n  const { getNearStore, token, logout } = useAuth()\r\n  const [open, setOpen] = useState(false);\r\n  const [value, setValue] = useState(null);\r\n  const [latLng, setLatLng] = useState(null);\r\n  const { screenWidth } = useScreen();\r\n  const { userLocation, setUserLocation } = useCurrentLocation();\r\n  const [noService, setNoService] = useState(null)\r\n  const dispatch = useDispatch()\r\n  const [isLoading, setIsLoading] = useState(false)\r\n  const [saveAddress, setSaveAddress] = useState([])\r\n  const [isAddressLoading, setIsAddressLoading] = useState(false)\r\n  const [selectedAddressId, setSelectedAddressId] = useState(null);\r\n\r\n  const mapKey = process.env.REACT_APP_GOOGLE_MAPS_API_KEY\r\n\r\n\r\n  const isModalOpen = () => {\r\n    setOpen(true);\r\n  };\r\n\r\n  const handleOk = () => {\r\n    setOpen(false);\r\n  };\r\n\r\n  const getDeliveryLocation = () => {\r\n    getLocationHandle();\r\n  };\r\n\r\n\r\n  useEffect(() => {\r\n    const getManualLocation = async (label) => {\r\n      try {\r\n        const results = await geocodeByAddress(label);\r\n        const { lat, lng } = await getLatLng(results[0]);\r\n        setLatLng({ lat, lng });\r\n\r\n        const response = await axios.get(\r\n          `https://maps.googleapis.com/maps/api/geocode/json?latlng=${lat},${lng}&key=${mapKey}`\r\n        );\r\n        if (response.data.status === \"OK\" && !noService) {\r\n          const userLocation = response.data.results[0];\r\n          setUserLocation(userLocation);  // Set the state with the user’s location data\r\n          localStorage.setItem(\"location\", JSON.stringify(userLocation));\r\n\r\n        }\r\n        setValue(null);\r\n\r\n\r\n      } catch (error) {\r\n        console.error(\"Error fetching location data: \", error);\r\n\r\n      }\r\n    };\r\n\r\n    if (value && value.label) {\r\n      getManualLocation(value.label);\r\n    }\r\n  }, [value]);\r\n\r\n\r\n\r\n  const handleChange = (selectedValue) => {\r\n    setValue(selectedValue); // Update the selected value\r\n    setNoService(\"\");\r\n  };\r\n\r\n  const showBranchDetails = async () => {\r\n    const body = {\r\n      longitude: userLocation?.geometry?.location?.lng,\r\n      latitude: userLocation?.geometry?.location?.lat\r\n    }\r\n    setIsLoading(true)\r\n\r\n    try {\r\n      await GetNearBranch(body)\r\n        .then((res) => {\r\n          // console.log(\"branch data near\", res);\r\n          if (res.status == 200) {\r\n            localStorage.setItem(\"near store\", JSON.stringify(res.data.data));\r\n            dispatch(setBranchDetails(res.data.data));\r\n            getNearStore(res.data.data)\r\n            setOpen(false)\r\n            setIsLoading(false)\r\n            setNoService(null)\r\n          } else if (res.status === 202) {\r\n            setOpen(true)\r\n            setNoService(res.data.message)\r\n            setIsLoading(false)\r\n          }\r\n\r\n        })\r\n        .catch((err) => {\r\n          console.log(err);\r\n        });\r\n    } catch (error) {\r\n      console.log(error);\r\n      setIsLoading(false)\r\n    }\r\n  };\r\n  useEffect(() => {\r\n    if (userLocation != null)\r\n      showBranchDetails()\r\n  }, [userLocation])\r\n\r\n  const ShowSaveAddress = async () => {\r\n    setIsAddressLoading(true)\r\n    try {\r\n      await GetSaveLocation(token).then((res) => {\r\n        if (res.status == 200) {\r\n          setSaveAddress(res.data.data);\r\n          setIsAddressLoading(false)\r\n        } else if (res.status === 283) {\r\n          notification.error({\r\n            placement: \"topRight\",\r\n            message: res.data.message,\r\n          });\r\n          logout()\r\n        }\r\n      })\r\n        .catch((err) => {\r\n          message.log(err.message);\r\n        });\r\n    } catch (error) {\r\n      setIsAddressLoading(false)\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    if (token) {\r\n      ShowSaveAddress();\r\n    } else {\r\n      setSaveAddress([]);\r\n    }\r\n  }, [token]);\r\n\r\n  const handleSavedAddress = (item) => {\r\n    const lat = item.location.coordinates[1];\r\n    const lng = item.location.coordinates[0];\r\n\r\n    const selectedLocation = {\r\n      formatted_address: item.fullAddress,\r\n      geometry: {\r\n        location: { lat, lng }\r\n      }\r\n    };\r\n\r\n    setSelectedAddressId(item._id);\r\n    setUserLocation(selectedLocation);\r\n    localStorage.setItem(\"location\", JSON.stringify(selectedLocation));\r\n    setOpen(false);\r\n  };\r\n\r\n  useEffect(() => {\r\n    if (!userLocation || !saveAddress?.length) return;\r\n\r\n    const match = saveAddress.find(\r\n      (addr) => addr.fullAddress === userLocation?.formatted_address\r\n    );\r\n\r\n    if (match) {\r\n      setSelectedAddressId(match._id);\r\n    }\r\n  }, [userLocation, saveAddress]);\r\n\r\n  return (\r\n    <>\r\n      <Button type=\"link\" className=\"loc\" onClick={isModalOpen}>\r\n        <div className=\"show_loc_drop\">\r\n          {userLocation == null ? (\r\n            <p className=\"header_location\">\r\n              <span>\r\n                <MdLocationPin className=\"del_loc_icon\" />\r\n              </span>{\" \"}\r\n              Delivery Location <MdOutlineArrowDropDown />\r\n            </p>\r\n          ) : (\r\n            // <p className=\"header_location\">\r\n            //   <span style={{ marginRight: \".5rem\" }}>\r\n            //     <MdLocationPin className=\"del_loc_icon\" />\r\n            //   </span>\r\n            //   {`${userLocation?.formatted_address?.substring(0, 30)}...` || `${userLocation?.display_name?.substring(0, 30)}...`}\r\n            //   <MdOutlineArrowDropDown className=\"h4\" />\r\n            // </p>\r\n\r\n\r\n            <p className=\"header_location\">\r\n              <MdLocationPin className=\"del_loc_icon\" />\r\n\r\n              <span>\r\n                {userLocation?.formatted_address\r\n                  ? `${userLocation.formatted_address.substring(0, 25)}...`\r\n                  : `${userLocation?.display_name?.substring(0, 25)}...`}\r\n              </span>\r\n\r\n              <MdOutlineArrowDropDown className=\"arrow_icon\"/>\r\n            </p>\r\n          )}\r\n        </div>\r\n      </Button>\r\n      <Modal\r\n        title=\"Change Your Location\"\r\n        open={open}\r\n        onOk={handleOk}\r\n        closable={false} // Disable close button\r\n        maskClosable={noService ? false : true} // Disable close on mask click\r\n        onCancel={handleOk}\r\n        footer={false}\r\n        width={300}\r\n        style={{\r\n          right: screenWidth > 800 ? 300 : 0,\r\n        }}\r\n      >\r\n        <div className=\"loc_add\">\r\n          <Button shape=\"round\" block onClick={getDeliveryLocation}>\r\n            Detect Current Location\r\n          </Button>\r\n          <GooglePlacesAutocomplete\r\n            apiKey={mapKey}\r\n            selectProps={{\r\n              value,\r\n              onChange: handleChange, // Custom onChange handler\r\n              placeholder: \"Search Your Location...\",\r\n            }}\r\n            debounce={500}\r\n          />\r\n          {locationError && (\r\n            <div className=\"no_service locatio_warning_note\">\r\n              <p style={{ color: \"red\", fontSize: \"13px\", padding: '5px' }}>\r\n                {locationError}\r\n              </p>\r\n            </div>\r\n          )}\r\n\r\n          {isAddressLoading ? (\r\n            <div className=\"saved_loader\">\r\n              <Spin />\r\n            </div>\r\n          ) : saveAddress?.length > 0 && (\r\n            <div className=\"saved_addresses\">\r\n              {saveAddress.map((item) => (\r\n                <div\r\n                  key={item._id}\r\n                  className={`saved_address_item ${selectedAddressId === item._id ? \"active_address\" : \"\"}`}\r\n                  onClick={() => handleSavedAddress(item)}\r\n                >\r\n                  <MdLocationPin className=\"saved_icon\" />\r\n                  <div>\r\n                    <p className=\"saved_title\">{item.addressType}</p>\r\n                    <p className=\"saved_text\">{item.fullAddress}</p>\r\n                  </div>\r\n                </div>\r\n              ))}\r\n            </div>\r\n          )}\r\n        </div>\r\n        {isLoad ? <div className=\"text-center\">\r\n          <span class=\"loaderLocation\"></span>\r\n        </div>\r\n          : noService ? <div className=\"no_service\">\r\n            <img src={noServiceImg} />\r\n            <p>{noService}</p>\r\n          </div> : null}\r\n      </Modal>\r\n    </>\r\n  );\r\n};\r\n\r\nexport default DropdownMenu;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\auth\\Login.jsx",["1234","1235","1236","1237","1238","1239","1240","1241","1242","1243"],[],"import React, { useState } from \"react\";\r\nimport { Button, Modal, Form, Input, Alert, Space, message } from \"antd\";\r\nimport OptVerifiy from \"./OptVerifiy\";\r\nimport \"../../style/login.css\";\r\nimport Logo from \"../../assest/logo.png\"\r\nimport Signup from \"./Signup\";\r\nimport { sendOTP } from \"../apiService/api\";\r\nimport { useAuth } from \"./context/authContext\";\r\n\r\nconst Login = ({ setIsLogged }) => {\r\n\r\n  const [isModalOpen, setIsModalOpen] = useState(false);\r\n  const [isOtpSent, setIsOtpSent] = useState(false);\r\n  const [disableSubmit, setDisableSubmit] = useState(true);\r\n  const [number, setNumber] = useState(\"\")\r\n  const [error, setError] = useState(null)\r\n  const { fcmtoken } = useAuth()\r\n  const [isNewUser, setIsNewUser] = useState(false)\r\n  const [iSSubmit, setISSubmit] = useState(false)\r\n\r\n\r\n  const handleInputChange = (e) => {\r\n    const inputValue = e.target.value;\r\n    setDisableSubmit(inputValue.trim() === '');\r\n    setNumber(inputValue)\r\n\r\n\r\n  };\r\n\r\n  const showModal = () => {\r\n    setIsModalOpen(true);\r\n    setIsOtpSent(false)\r\n  };\r\n  const handleOk = () => {\r\n    setIsModalOpen(false);\r\n  };\r\n  const handleCancel = () => {\r\n    setIsModalOpen(false);\r\n  };\r\n\r\n  const onFinish = async (value) => {\r\n    setISSubmit(true)\r\n    try {\r\n      await sendOTP(value)\r\n        .then((res) => {\r\n          // console.log(\"send otp\", res);\r\n          if (res.status == 201) {\r\n            setISSubmit(false)\r\n            setIsOtpSent(true)\r\n          }\r\n          else if (res.status === 200) {\r\n            message.error(res.data.message);\r\n            setIsNewUser(true)\r\n            setISSubmit(false)\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          message.error(err.response.data.message);\r\n          setISSubmit(false)\r\n        });\r\n    } catch (error) {\r\n      message.error(error);\r\n      setISSubmit(false)\r\n    }\r\n  };\r\n\r\n  const onFinishFailed = (errorInfo) => {\r\n    message.error(errorInfo)\r\n  };\r\n\r\n  const validateMaxLength = (_, value) => {\r\n    if (value && value.length != 10) {\r\n      return Promise.reject(new Error('Invalid Number !'));\r\n    }\r\n    return Promise.resolve();\r\n  };\r\n\r\n  return (\r\n    <div className=\"log_page\">\r\n      <p onClick={showModal}>\r\n        Login\r\n      </p>\r\n      <Modal\r\n        footer={false}\r\n        width={450}\r\n        open={isModalOpen}\r\n        onOk={handleOk}\r\n        onCancel={handleCancel}\r\n        style={{\r\n          top: 100,\r\n        }}\r\n      >\r\n\r\n        <div className=\"login_pag\">\r\n          <div className=\"log_head\">\r\n            <img src={Logo} />\r\n          </div>\r\n          <div className=\"login_title\">\r\n            <h4>Get start shopping with BKD</h4>\r\n            <h5>{isOtpSent == true ? \"Verify OTP\" : \"Login \"}</h5>\r\n            {isOtpSent == true ? <Space>\r\n              <p >Enter OTP Sent on <spna style={{ color: \"green\" }}>******{number != null && number.slice(-4)}</spna> or</p>\r\n              <span className=\"change_number\" onClick={() => setIsOtpSent(false)}>Change Number</span>\r\n            </Space> : null}\r\n          </div>\r\n          {isOtpSent == true ? (\r\n            <OptVerifiy isOtpSent={isOtpSent} setIsModalOpen={setIsModalOpen} number={number} />\r\n          ) : (\r\n            <div className=\"log_form\">\r\n              {/* {error != null ? <Alert message={error} type=\"error\" showIcon className=\"mb-2\" /> : null} */}\r\n              <Form\r\n                layout=\"vertical\"\r\n                name=\"basic\"\r\n                initialValues={{\r\n                  remember: true,\r\n                }}\r\n                onFinish={onFinish}\r\n                onFinishFailed={onFinishFailed}\r\n                autoComplete=\"off\"\r\n              >\r\n                <Form.Item\r\n                  name=\"mobileNo\"\r\n                  rules={[\r\n                    {\r\n                      required: true,\r\n                      message: \"Please Enter Your Number!\",\r\n                    },\r\n                    {\r\n                      pattern: /^[0-9]*$/,\r\n                      message: 'Please Enter Only Numbers!',\r\n                    },\r\n                    { validator: validateMaxLength }\r\n                  ]}\r\n                >\r\n                  <Input\r\n                    // type=\"number\"\r\n                    value={number}\r\n                    maxLength={10}\r\n                    inputMode=\"numeric\"\r\n                    pattern=\"[0-9]*\"\r\n                    size=\"large\" placeholder=\"Enter your mobile no.\" variant=\"filled\" prefix=\"+91\"\r\n                    onChange={handleInputChange} />\r\n                </Form.Item>\r\n                <Form.Item>\r\n                  <div className=\"log_continue\">\r\n                    <Button\r\n                      size=\"large\"\r\n                      type=\"primary\"\r\n                      htmlType=\"submit\"\r\n                      disabled={disableSubmit}\r\n                      loading={iSSubmit}\r\n                    >\r\n                      Continue..\r\n                    </Button>\r\n                  </div>\r\n                </Form.Item>\r\n              </Form>\r\n            </div>\r\n          )}\r\n        </div>\r\n        {!isOtpSent && <div className=\"signup_user\">\r\n\r\n          <p>Log in or </p>\r\n          <Signup\r\n            handleCancel={handleCancel}\r\n            isNewUser={isNewUser}\r\n            newNumber={number}\r\n            setIsNewUser={setIsNewUser}\r\n          />\r\n        </div>}\r\n\r\n      </Modal>\r\n    </div>\r\n  );\r\n};\r\nexport default Login;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\header\\MenuDrawer.jsx",["1244","1245","1246","1247","1248","1249","1250","1251","1252","1253","1254","1255"],[],"import React, { useEffect, useState } from 'react';\r\nimport { Avatar, Button, Divider, Drawer, Empty, List, Radio, Skeleton, Space } from 'antd';\r\nimport {\r\n    MenuFoldOutlined\r\n} from '@ant-design/icons';\r\n\r\nimport { NavLink, useNavigate } from \"react-router-dom\";\r\n\r\nimport { Sidebar, Menu, MenuItem, SubMenu } from \"react-pro-sidebar\";\r\nimport \"../../style/header.css\"\r\n\r\nimport { BsHandbagFill } from \"react-icons/bs\";\r\nimport { FaHeart, FaUser, FaWallet, FaShare } from \"react-icons/fa\";\r\nimport { MdLocationPin } from \"react-icons/md\";\r\nimport { BiSupport } from \"react-icons/bi\";\r\n\r\n\r\nimport Login from '../auth/Login';\r\nimport { HiOutlineArrowNarrowLeft } from 'react-icons/hi';\r\nimport { useAuth } from '../auth/context/authContext';\r\nimport { GetUserProfile } from '../apiService/api';\r\n\r\n\r\n\r\n\r\n\r\n\r\nconst MenuDrawer = () => {\r\n    // const { setUser } = useCurrentUser();\r\n\r\n    const navigate = useNavigate();\r\n    const [profileInfo, setProfileInfo] = useState(null)\r\n    const { token, logout, currentUser } = useAuth()\r\n    const [open, setOpen] = useState(false);\r\n    const [placement, setPlacement] = useState('left');\r\n    const [isLoading, setIsLoading] = useState(false)\r\n    const showDrawer = () => {\r\n        setOpen(true);\r\n        ShowProfileInfo()\r\n    };\r\n    const onClose = () => {\r\n        setOpen(false);\r\n    };\r\n    const onChange = (e) => {\r\n        setPlacement(e.target.value);\r\n    };\r\n\r\n\r\n    const handleBack = () => {\r\n        navigate(-1)\r\n        setOpen(false)\r\n    }\r\n\r\n    const handleReferralShare = async () => {\r\n        const referralCode = currentUser?.referralCode || profileInfo?.referralCode || 'DEFAULT_CODE';\r\n        const baseUrl = window.location.origin;\r\n        const referralLink = `${baseUrl}/home?referralCode=${referralCode}`;\r\n\r\n        try {\r\n            if (navigator.share) {\r\n                // Use native sharing if available\r\n                await navigator.share({\r\n                    title: 'Join OnBkd',\r\n                    text: 'Join me on OnBkd and get amazing deals!',\r\n                    url: referralLink,\r\n                });\r\n            } else {\r\n                // Fallback to copying to clipboard\r\n                await navigator.clipboard.writeText(referralLink);\r\n                // You might want to show a toast notification here\r\n                alert('Referral link copied to clipboard!');\r\n            }\r\n        } catch (error) {\r\n            console.error('Error sharing referral link:', error);\r\n            // Fallback: copy to clipboard\r\n            try {\r\n                await navigator.clipboard.writeText(referralLink);\r\n                alert('Referral link copied to clipboard!');\r\n            } catch (clipboardError) {\r\n                console.error('Clipboard error:', clipboardError);\r\n                alert(`Your referral link: ${referralLink}`);\r\n            }\r\n        }\r\n        setOpen(false);\r\n    }\r\n\r\n    const ShowProfileInfo = async () => {\r\n        try {\r\n            await GetUserProfile(token)\r\n                .then((res) => {\r\n                    // console.log(\"user profile\", res);\r\n                    if (res.status == 200) {\r\n                        setProfileInfo(res.data.data);\r\n                        setIsLoading(true)\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n            setIsLoading(true)\r\n        }\r\n    };\r\n\r\n\r\n\r\n    return (\r\n        <div className='mobile_menu_drawer'>\r\n            {currentUser?.profilePic != null ? <Avatar src={currentUser?.profilePic} size={45} className=\"current_user_pic\" onClick={showDrawer} /> :\r\n                <Button shape=\"circle\" size=\"large\" className=\"user_menu\" icon={<FaUser />} onClick={showDrawer} />\r\n            }\r\n            {/* <Button\r\n                size=\"large\"\r\n                shape=\"circle\"\r\n                type=\"primary\"\r\n                className=\"wish_icon\"\r\n                onClick={showDrawer}\r\n                icon={<FaUser className=\"cart_icon\" />}\r\n            ></Button> */}\r\n\r\n\r\n            <Drawer\r\n                title={\r\n                    <div>\r\n                        <Button type='link' icon={<HiOutlineArrowNarrowLeft className='back_icon' onClick={handleBack} />}></Button>\r\n                        {!token ?\r\n                            <List\r\n                                itemLayout=\"vertical\"\r\n                            >\r\n\r\n                                <List.Item actions={[<Login />]}>\r\n\r\n                                    <List.Item.Meta\r\n                                        avatar={<Avatar icon={<FaUser className='pro_ics_cons' />} className='pro_ics' />}\r\n                                        title={<h4>Welcome Guest</h4>}\r\n                                        description={<h4>Please Login </h4>}\r\n                                    >\r\n                                    </List.Item.Meta>\r\n                                </List.Item>\r\n\r\n                            </List> : <List\r\n                                itemLayout=\"vertical\"\r\n                            >\r\n                                <List.Item>\r\n                                    <List.Item.Meta\r\n                                        avatar={profileInfo?.profilePic != null\r\n                                            ? <Avatar size={64} src={profileInfo?.profilePic} className='pro_ics' /> :\r\n                                            <Avatar icon={<FaUser className='pro_ics_cons' />} size={64} />\r\n                                        }\r\n                                        title={<h4>Welcome <span className='loggedUser'>{profileInfo?.fullName}</span> !</h4>}\r\n                                        description={<div>\r\n                                            <h6>{profileInfo?.mobileNo} </h6>\r\n                                            <h6>{profileInfo?.email} </h6>\r\n                                            <span className=\"profile_logout\" onClick={() => logout()}>Logout</span>\r\n                                        </div>}\r\n                                    >\r\n                                    </List.Item.Meta>\r\n                                </List.Item>\r\n                            </List>}\r\n                    </div>\r\n                }\r\n\r\n                placement={placement}\r\n                closable={false}\r\n                onClose={onClose}\r\n                open={open}\r\n                // width={240}\r\n                id='menu_mobile_draw'\r\n            >\r\n                {!token ? null :\r\n                    <Sidebar>\r\n                        <Menu defaultOpenKeys={['components']}>\r\n                            <MenuItem\r\n                                component={<NavLink to=\"/account/order\" />}\r\n                                icon={<BsHandbagFill className=\"menu_icon\" />}\r\n                                onClick={() => setOpen(false)}\r\n                            >\r\n                                {\" \"}\r\n                                My Order\r\n                            </MenuItem>\r\n                            <MenuItem\r\n                                component={<NavLink to=\"/account/wishlist\" />}\r\n                                icon={<FaHeart className=\"menu_icon\" />}\r\n                                onClick={() => setOpen(false)}\r\n                            >\r\n                                {\" \"}\r\n                                My Wishlist\r\n                            </MenuItem>\r\n                            <MenuItem\r\n                                component={<NavLink to=\"/account/address\" />}\r\n                                icon={<MdLocationPin className=\"menu_icon\" />}\r\n                                onClick={() => setOpen(false)}\r\n                            >\r\n                                {\" \"}\r\n                                Address Manage\r\n                            </MenuItem>\r\n                            {/* <MenuItem\r\n                                component={<NavLink to=\"/account/Wallet\" />}\r\n                                icon={<FaWallet className=\"menu_icon\" />}\r\n                                onClick={() => setOpen(false)}\r\n                            >\r\n                                {\" \"}\r\n                                Wallet\r\n                            </MenuItem> */}\r\n                            <MenuItem\r\n                                component={<NavLink to=\"/account/profile\" />}\r\n                                icon={<FaUser className=\"menu_icon\" />}\r\n                                onClick={() => setOpen(false)}\r\n                            >\r\n                                {\" \"}\r\n                                Profile\r\n                            </MenuItem>\r\n                            <MenuItem\r\n                                component={<NavLink to=\"/account/support\" />}\r\n                                icon={<BiSupport className=\"menu_icon\" />}\r\n                                onClick={() => setOpen(false)}\r\n                            >\r\n                                {\" \"}\r\n                                Support\r\n                            </MenuItem>\r\n                            <MenuItem\r\n                                icon={<FaShare className=\"menu_icon\" />}\r\n                                onClick={handleReferralShare}\r\n                            >\r\n                                {\" \"}\r\n                                Share Referral Link\r\n                            </MenuItem>\r\n                        </Menu>\r\n                    </Sidebar>}\r\n            </Drawer>\r\n\r\n        </div >\r\n    );\r\n};\r\n\r\nexport default MenuDrawer","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\header\\CategoryDwader.jsx",["1256","1257","1258","1259"],[],"\r\n\r\nimport React, { useEffect, useState, useRef, useCallback } from 'react';\r\nimport { Button, Card, Drawer, Empty, Input } from 'antd';\r\nimport { BiCategory } from 'react-icons/bi';\r\nimport \"../../style/header.css\";\r\nimport { useNavigate } from 'react-router-dom';\r\nimport DefaultLogo from \"../../assest/logo.png\";\r\nimport { FetchCategoryList } from '../apiService/api';\r\nimport { SearchOutlined } from '@ant-design/icons';\r\nimport _ from 'lodash';  // For debounce\r\nimport { encryptCategoryID } from '../../config/encriptConfig';\r\n\r\nconst CategoryDrawer = () => {\r\n    const navigate = useNavigate();\r\n    const [open, setOpen] = useState(false);\r\n    const [searchInput, setSearchInput] = useState(\"\");\r\n    const [catList, setCatList] = useState([]);\r\n    const [loading, setLoading] = useState(false);\r\n    const titleCase = str => str.toLowerCase().split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');\r\n\r\n\r\n    // Debounced search function using lodash's debounce\r\n    const debouncedSearch = useCallback(_.debounce((value) => {\r\n        setSearchInput(value);\r\n        setCatList([]); // Clear the list when searching\r\n    }, 1000), []); // 500ms delay\r\n\r\n    const handleSearch = (e) => {\r\n        debouncedSearch(e.target.value);\r\n    };\r\n\r\n    const showAllCategoryList = async () => {\r\n        setLoading(true);\r\n        try {\r\n            const res = await FetchCategoryList(searchInput);\r\n            if (res.status === 200) {\r\n                setCatList(res.data.data); // Append new data\r\n                setLoading(false);\r\n            }\r\n        } catch (error) {\r\n            setLoading(false);\r\n        }\r\n    };\r\n\r\n    useEffect(() => {\r\n        showAllCategoryList();\r\n    }, [searchInput]);\r\n\r\n\r\n\r\n    const showDrawer = () => {\r\n        setOpen(true);\r\n    };\r\n\r\n    const onClose = () => {\r\n        setOpen(false);\r\n    };\r\n\r\n    const manageURl = (categoryName) => {\r\n        const sanitizedCategory = categoryName\r\n            .replace(/[,/&]/g, '') // Remove commas, slashes, ampersands\r\n            .replace(/\\s+/g, '-')  // Replace spaces with hyphens\r\n            .toLowerCase();\r\n        return sanitizedCategory\r\n    }\r\n\r\n    return (\r\n        <>\r\n            <Button\r\n                onClick={showDrawer}\r\n                size=\"large\"\r\n                shape=\"circle\"\r\n                type=\"primary\"\r\n                className=\"cat_draw_icon\"\r\n                icon={<BiCategory className=\"cart_icon\" />}\r\n            ></Button>\r\n\r\n            <Drawer\r\n                title={\r\n                    <div className='d-flex justify-content-between'>\r\n                        <p>Category List</p>\r\n                        <Input\r\n                            style={{ width: '200px' }}\r\n                            allowClear\r\n                            placeholder=\"Search Category\"\r\n                            suffix={<SearchOutlined />}\r\n                            onChange={handleSearch}\r\n                        />\r\n                    </div>\r\n                }\r\n                width={500}\r\n                onClose={onClose}\r\n                open={open}\r\n\r\n\r\n            >\r\n                <div className={`${catList?.length != 0 ? \"show_cat_drawer\" : \"text-center\"} `}>\r\n                    {loading ? <div className='text-center'><span className=\"loaderScroll\"></span></div> : catList?.length === 0 ? <Empty image={Empty.PRESENTED_IMAGE_SIMPLE} /> : catList.map((item, index) => (\r\n                        <div className='cat_listing' key={item.categoryID}>\r\n                            <Card bordered={false} onClick={() => {\r\n                                navigate(`/category/${manageURl(item.categoryName)}?uid=${encodeURIComponent(encryptCategoryID(item.categoryID))}`);\r\n                                ; onClose();\r\n                            }} hoverable>\r\n                                <div className=\"draw_cat_item\">\r\n                                    {item.imageUrl ?\r\n                                        <img\r\n                                            src={item.imageUrl || DefaultLogo}\r\n                                            onError={(e) => e.currentTarget.src = DefaultLogo}\r\n                                            alt=\"Category\"\r\n                                            loading=\"lazy\"\r\n                                        />\r\n                                        :\r\n                                        <img\r\n                                            src={DefaultLogo}\r\n                                            alt=\"Default\"\r\n                                        />\r\n                                    }\r\n                                    <p>{item.title}</p>\r\n                                </div>\r\n                            </Card>\r\n                            <div className=\"cat_names\">\r\n                                <p>{titleCase(item.categoryName)}</p>\r\n                            </div>\r\n                        </div>\r\n                    ))}\r\n                </div>\r\n\r\n            </Drawer>\r\n        </>\r\n    );\r\n};\r\n\r\nexport default CategoryDrawer;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\auth\\Signup.jsx",["1260","1261","1262","1263","1264","1265","1266","1267","1268","1269","1270","1271"],[],"import React, { useEffect, useState } from \"react\";\r\nimport { Button, Modal, Form, Input, Divider, Alert, Select, DatePicker, Checkbox, message } from \"antd\";\r\nimport OptVerifiy from \"./OptVerifiy\";\r\nimport \"../../style/login.css\";\r\nimport Logo from \"../../assest/logo.png\"\r\nimport { Link, useNavigate, useLocation } from \"react-router-dom\"\r\nimport { SignUpUser, genders } from \"../apiService/api\";\r\n\r\n\r\nconst Signup = ({ handleCancel, isNewUser, newNumber, setIsNewUser, hideSignupTrigger }) => {\r\n    const [form] = Form.useForm();\r\n    const location = useLocation();\r\n    const [isModalOpen, setIsModalOpen] = useState(false);\r\n    const [isOtpSent, setIsOtpSent] = useState(false);\r\n    const [number, setNumber] = useState(\"\")\r\n    const [error, setError] = useState(null)\r\n    const [isSign, setIsSign] = useState(false)\r\n    const [dob, setDob] = useState(null)\r\n    const [checked, setChecked] = useState(false);\r\n    const [referralCode, setReferralCode] = useState(\"\");\r\n\r\n    console.log(Number(newNumber), \"chnage in number\")\r\n    console.log(typeof (Number(newNumber)), \"type of number\")\r\n\r\n    useEffect(() => {\r\n        // Extract referralCode from URL query parameters\r\n        const searchParams = new URLSearchParams(location.search);\r\n        const urlReferralCode = searchParams.get('referralCode');\r\n\r\n        if (urlReferralCode) {\r\n            setReferralCode(urlReferralCode);\r\n        }\r\n\r\n        form.setFieldsValue({\r\n            mobileNo: String(newNumber) || number,\r\n            referralCode: urlReferralCode || \"\",\r\n        })\r\n        if (isNewUser) {\r\n            showModal()\r\n        }\r\n    }, [isNewUser, location.search])\r\n\r\n    const handleTerm = (e) => {\r\n        console.log('Checked:', e.target.checked);\r\n        setChecked(e.target.checked); // Will update the state based on checked value\r\n    };\r\n\r\n    const handleUserNumber = (e) => {\r\n        setNumber(e.target.value)\r\n    }\r\n    const showModal = () => {\r\n        setIsModalOpen(true);\r\n        handleCancel()\r\n        setIsNewUser(false)\r\n    };\r\n\r\n    const handleOk = () => {\r\n        setIsModalOpen(false);\r\n        setIsOtpSent(false)\r\n    };\r\n    const handleCancelSign = () => {\r\n        setIsModalOpen(false);\r\n        setIsOtpSent(false)\r\n\r\n    };\r\n    const handelDateChange = (date, dateString) => {\r\n        console.log(date, dateString);\r\n        setDob(dateString)\r\n    };\r\n\r\n\r\n    const onFinish = async (value) => {\r\n        setIsSign(true)\r\n        try {\r\n            await SignUpUser({ ...value, dob: dob, referralCode: value.referralCode || referralCode })\r\n                .then((res) => {\r\n                    console.log(\"user register\", res);\r\n                    if (res.status == 201) {\r\n                        onReset();\r\n                        setIsOtpSent(true)\r\n                        setIsSign(false)\r\n\r\n                    }\r\n                    else if (res.status == 200) {\r\n                        setError(res.data.message);\r\n                        setIsSign(false)\r\n\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.warn(err);\r\n                    message.error(err.response.data.message)\r\n                    setIsSign(false)\r\n\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n            setIsSign(false)\r\n\r\n        }\r\n    };\r\n\r\n    const onReset = () => {\r\n        form.resetFields();\r\n    };\r\n    const onFinishFailed = (errorInfo) => {\r\n        console.log(\"Failed:\", errorInfo);\r\n    };\r\n\r\n    const validateMaxLength = (_, value) => {\r\n        if (value && value.length != 10) {\r\n            return Promise.reject(new Error('Please Enter Valid Number OR  10 digit!'));\r\n        }\r\n        return Promise.resolve();\r\n    };\r\n\r\n\r\n    return (\r\n        <div className=\"log_page\">\r\n            {/* <SignUpConfirmation confirm={confirm} /> */}\r\n            {!hideSignupTrigger && (\r\n                <span onClick={showModal} className=\"sign_up_btn\">\r\n                    Signup\r\n                </span>\r\n            )}\r\n            <Modal\r\n\r\n                footer={false}\r\n                width={450}\r\n                open={isModalOpen}\r\n                onOk={handleOk}\r\n                onCancel={handleCancelSign}\r\n                style={{\r\n                    top: 20,\r\n                }}\r\n            >\r\n                <div className=\"login_pag\">\r\n                    <div className=\"log_head\">\r\n                        <img src={Logo} />\r\n                    </div>\r\n                    <div className=\"login_title\">\r\n\r\n                        <h6>Get start Shopping with BKD</h6>\r\n\r\n                        <h4>{isOtpSent ? \"Verify OTP\" : \"Signup \"}</h4>\r\n                        {isOtpSent && (\r\n                            <p>\r\n                                Enter OTP Sent on\r\n                                <span style={{ color: \"green\", marginLeft: \".5rem\" }}>\r\n                                    ******{(number || newNumber)?.toString().slice(-4)}\r\n                                </span>\r\n                            </p>\r\n                        )}\r\n\r\n                        {/* {isOtpSent == true ? <p >otp send on <spna style={{ color: \"green\" }}>******{number || newNumber && number?.slice(-4) || String(newNumber).slice(-4)}</spna> view sms</p> : null} */}\r\n                    </div>\r\n                    {\r\n                        isOtpSent ?\r\n                            <OptVerifiy isOtpSent={isOtpSent} setIsModalOpen={setIsModalOpen} number={number || newNumber} /> :\r\n                            <div className=\"signup_form\">\r\n                                {error != null ? <Alert message={error} type=\"error\" showIcon className=\"mb-2\" /> : null}\r\n\r\n                                <Form\r\n                                    form={form}\r\n                                    layout=\"vertical\"\r\n                                    name=\"basic\"\r\n                                    initialValues={{\r\n                                        mobileNo: String(newNumber) || number,\r\n                                    }}\r\n                                    onFinish={onFinish}\r\n                                    onFinishFailed={onFinishFailed}\r\n                                    autoComplete=\"off\"\r\n                                >\r\n                                    <Form.Item\r\n                                        name=\"fullName\"\r\n                                        label=\"Full Name\"\r\n                                        rules={[\r\n                                            {\r\n                                                required: true,\r\n                                                message: \"Please Enter Your Full Name!\",\r\n                                            },\r\n                                            {\r\n                                                pattern: /^(?!\\s*$)[a-zA-Z\\s]*$/,\r\n                                                message: 'Number not allow!',\r\n                                            },\r\n                                        ]}\r\n                                    >\r\n                                        <Input placeholder=\"Enter your name\" variant=\"filled\" />\r\n                                    </Form.Item>\r\n                                    <Form.Item\r\n\r\n                                        name=\"mobileNo\"\r\n                                        label=\"Mobile\"\r\n                                        type=\"number\"\r\n                                        inputMode=\"numeric\"\r\n                                        pattern=\"[0-9]*\"\r\n                                        rules={[\r\n                                            {\r\n                                                required: true,\r\n                                                message: \"Please Enter Your Mobile Number!\",\r\n                                            },\r\n                                            {\r\n                                                pattern: /^[0-9]*$/,\r\n                                                message: 'Please Enter only Numbers!',\r\n                                            },\r\n                                            { validator: validateMaxLength }\r\n                                        ]}\r\n                                    >\r\n                                        <Input\r\n                                            maxLength={10}\r\n                                            inputMode=\"numeric\"\r\n                                            pattern=\"[0-9]*\"\r\n                                            placeholder=\"Enter your number\"\r\n                                            variant=\"filled\"\r\n                                            onChange={handleUserNumber} />\r\n                                    </Form.Item>\r\n                                    <Form.Item\r\n\r\n                                        name=\"email\"\r\n                                        label=\"Email\"\r\n\r\n                                        rules={[\r\n                                            {\r\n                                                type: 'email',\r\n                                                message: 'Please Enter Valid Email!',\r\n                                            },\r\n\r\n                                        ]}\r\n                                    >\r\n                                        <Input placeholder=\"Enter your email\" variant=\"filled\" />\r\n                                    </Form.Item>\r\n\r\n                                    <Form.Item\r\n                                        name=\"referralCode\"\r\n                                        label=\"Referral Code (Optional)\"\r\n                                    >\r\n                                        <Input\r\n                                            placeholder=\"Enter referral code if you have one\"\r\n                                            variant=\"filled\"\r\n                                            value={referralCode}\r\n                                            onChange={(e) => setReferralCode(e.target.value)}\r\n                                        />\r\n                                    </Form.Item>\r\n\r\n\r\n                                    <Form.Item\r\n                                        name=\"isAcceptTermCondition\"\r\n                                        valuePropName=\"checked\"\r\n                                        rules={[\r\n                                            {\r\n                                                required: true,\r\n                                                message: 'Please accept terms & condition!',\r\n                                                validator: (_, value) =>\r\n                                                    value ? Promise.resolve() : Promise.reject('Please accept terms & condition!'),\r\n                                            },\r\n                                        ]}\r\n                                    >\r\n                                        <Checkbox checked={checked} onChange={handleTerm}>\r\n                                            <a href=\"/terms\" target=\"_blank\">Accept Terms & Conditions</a>\r\n                                        </Checkbox>\r\n                                    </Form.Item>\r\n                                    <Form.Item>\r\n                                        <div className=\"log_continue\">\r\n                                            <Button\r\n                                                loading={isSign}\r\n                                                htmlType=\"submit\"\r\n                                                size=\"large\"\r\n                                            >\r\n                                                Get OTP\r\n                                            </Button>\r\n                                        </div>\r\n                                    </Form.Item>\r\n                                </Form>\r\n                            </div>\r\n                    }\r\n\r\n\r\n                </div>\r\n\r\n                {/* <div className=\"log_term\">\r\n                    <p>By continueing , your agree to our </p>\r\n                    <a href=\"#\">Term & Condition</a>\r\n                    <Divider type=\"vertical\" />\r\n                    <a href=\"#\">Privacy & Policy</a>\r\n\r\n                </div> */}\r\n            </Modal>\r\n        </div>\r\n    );\r\n};\r\nexport default Signup;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\utils\\offerUtils.js",[],[],"C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\config\\encriptConfig.js",[],[],"C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\cart\\ShowMap.jsx",["1272"],[],"// import { React, useEffect, useMemo, useRef, useState } from \"react\";\r\n// import \"../../style/header.css\";\r\n// import {\r\n//   GoogleMap,\r\n//   Marker,\r\n//   useJsApiLoader,\r\n//   MarkerF,\r\n// } from \"@react-google-maps/api\";\r\n// import GooglePlacesAutocomplete, {\r\n//   geocodeByAddress,\r\n//   getLatLng,\r\n// } from \"react-google-places-autocomplete\";\r\n// import { Input, Skeleton, Spin } from \"antd\";\r\n// import axios from \"axios\"\r\n// import { useCurrentLocation } from \"../auth/AuthScreen\";\r\n// const containerStyle = {\r\n//   width: \"100%\",\r\n//   height: \"300px\",\r\n// };\r\n\r\n// const ShowMap = ({ setLat, setLng, setAlerts }) => {\r\n//   const [value, setValue] = useState(null);\r\n//   const [lable, setLabel] = useState(null);\r\n//   const [latLng, setLatLng] = useState(null);\r\n//   const { userLocation } = useCurrentLocation()\r\n\r\n\r\n\r\n//   const mapToken = process.env.REACT_APP_GOOGLE_MAPS_API_KEY\r\n\r\n\r\n\r\n//   if (value) {\r\n//     const { label } = value;\r\n//     setLabel(label);\r\n//   }\r\n\r\n//   const { isLoaded } = useJsApiLoader({\r\n//     googleMapsApiKey: mapToken,\r\n//     libraries: [\"places\"],\r\n//   });\r\n\r\n//   const center = useMemo(() => ({ lat: parseInt(userLocation?.geometry?.location?.lat), lng: parseInt(userLocation?.geometry?.location?.lng) }), []);\r\n\r\n//   console.log(\"userLocation?.lat\", userLocation?.lat)\r\n//   console.log(\"userLocation?.lat\", userLocation?.lon)\r\n\r\n//   const onLoadHandler = (marker) => {\r\n//     console.log(\"marker: \", marker);\r\n//   };\r\n\r\n//   if (!isLoaded) {\r\n//     return <Skeleton />;\r\n//   }\r\n//   const mapOptions = {\r\n//     disableDefaultUI: false, // Set to true to hide all default UI controls\r\n//     zoomControl: true, // Set to false to hide zoom control\r\n//     mapTypeControl: false, // Set to false to hide map type control\r\n//     scaleControl: true, // Set to false to hide scale control\r\n//     streetViewControl: true, // Set to false to hide street view control\r\n//     fullscreenControl: true, // Set to false to hide fullscreen control\r\n//   };\r\n\r\n\r\n\r\n//   const handleSelect = async (value) => {\r\n//     try {\r\n//       const results = await geocodeByAddress(value.label);\r\n//       const latLng = await getLatLng(results[0]);\r\n//       setLatLng(latLng)\r\n//       setAlerts(true)\r\n//       console.log('Selected Address:', value);\r\n//       console.log('Latitude:', latLng.lat);\r\n//       console.log('Longitude:', latLng.lng);\r\n//     } catch (error) {\r\n//       console.error('Error fetching location:', error);\r\n//     }\r\n//   };\r\n\r\n//   const handleMarkerDragEnd = (event) => {\r\n//     const newPosition = {\r\n//       lat: event.latLng.lat(),\r\n//       lng: event.latLng.lng(),\r\n//     };\r\n//     // setMarkerPosition(newPosition);\r\n//     setLat(newPosition.lat)\r\n//     setLng(newPosition.lng)\r\n//     console.log(newPosition)\r\n//   };\r\n\r\n//   return (\r\n//     <section>\r\n//       <div className=\"show_map\">\r\n//         <GoogleMap\r\n//           zoom={latLng ? 16 : 12}\r\n//           center={latLng != null ? latLng : center}\r\n//           options={mapOptions}\r\n//           mapContainerStyle={containerStyle}\r\n//           onClick={(ev) => {\r\n//             setLat(ev.latLng.lat());\r\n//             setLng(ev.latLng.lng());\r\n//           }}\r\n//         >\r\n//           <MarkerF\r\n//             onLoad={onLoadHandler}\r\n//             position={latLng != null ? latLng : center}\r\n//             draggable={true}\r\n//             onDragEnd={handleMarkerDragEnd}\r\n//           />\r\n//         </GoogleMap>\r\n//       </div>\r\n//       <div className=\"search_place\">\r\n//         <GooglePlacesAutocomplete\r\n\r\n//           apiKey={mapToken}\r\n//           selectProps={{\r\n//             value,\r\n//             onChange: (value) => handleSelect(value),\r\n//             placeholder: \"Search your  location...\"\r\n//           }}\r\n//         />\r\n//       </div>\r\n//     </section>\r\n//   );\r\n// };\r\n\r\n// export default ShowMap;\r\n\r\n\r\n\r\n// import React, { useMemo, useState } from \"react\";\r\n// import { GoogleMap, useJsApiLoader } from \"@react-google-maps/api\";\r\n// import GooglePlacesAutocomplete, {\r\n//   geocodeByAddress,\r\n//   getLatLng,\r\n// } from \"react-google-places-autocomplete\";\r\n// import { Skeleton } from \"antd\";\r\n// import { useCurrentLocation } from \"../auth/AuthScreen\";\r\n\r\n// const containerStyle = {\r\n//   width: \"100%\",\r\n//   height: \"300px\",\r\n// };\r\n\r\n// const ShowMap = ({ setLat, setLng, setAlerts }) => {\r\n//   const [value, setValue] = useState(null);\r\n//   const [mapCenter, setMapCenter] = useState(null); // Track map center\r\n//   const { userLocation } = useCurrentLocation();\r\n\r\n//   const mapToken = process.env.REACT_APP_GOOGLE_MAPS_API_KEY;\r\n\r\n//   const { isLoaded } = useJsApiLoader({\r\n//     googleMapsApiKey: mapToken,\r\n//     libraries: [\"places\"],\r\n//   });\r\n\r\n//   const defaultCenter = useMemo(\r\n//     () => ({\r\n//       lat: parseFloat(userLocation?.geometry?.location?.lat || 28.6139),\r\n//       lng: parseFloat(userLocation?.geometry?.location?.lng || 77.2090),\r\n//     }),\r\n//     [userLocation]\r\n//   );\r\n\r\n//   const mapOptions = {\r\n//     disableDefaultUI: false,\r\n//     zoomControl: true,\r\n//     mapTypeControl: false,\r\n//     streetViewControl: false,\r\n//     fullscreenControl: false,\r\n//   };\r\n\r\n//   const handleSelect = async (value) => {\r\n//     try {\r\n//       const results = await geocodeByAddress(value.label);\r\n//       const latLng = await getLatLng(results[0]);\r\n//       setMapCenter(latLng); // Update the map's center\r\n//       setLat(latLng.lat);\r\n//       setLng(latLng.lng);\r\n//       setAlerts(true);\r\n//     } catch (error) {\r\n//       console.error(\"Error fetching location:\", error);\r\n//     }\r\n//   };\r\n\r\n//   const handleMapDrag = (map) => {\r\n//     const newCenter = {\r\n//       lat: map.getCenter().lat(),\r\n//       lng: map.getCenter().lng(),\r\n//     };\r\n//     setMapCenter(newCenter);\r\n//     setLat(newCenter.lat);\r\n//     setLng(newCenter.lng);\r\n//   };\r\n\r\n//   if (!isLoaded) {\r\n//     return <Skeleton />;\r\n//   }\r\n\r\n//   return (\r\n//     <section>\r\n//       <div className=\"show_map\">\r\n//         <GoogleMap\r\n//           zoom={14}\r\n//           center={mapCenter || defaultCenter}\r\n//           options={mapOptions}\r\n//           mapContainerStyle={containerStyle}\r\n//           onDragEnd={(e) => handleMapDrag(e)} // Update center on drag end\r\n//         >\r\n//           {/* Fixed marker at the center */}\r\n//           <div\r\n//             style={{\r\n//               position: \"absolute\",\r\n//               top: \"50%\",\r\n//               left: \"50%\",\r\n//               transform: \"translate(-50%, -50%)\",\r\n//               zIndex: 1,\r\n//             }}\r\n//           >\r\n//             <img\r\n//               src=\"https://maps.gstatic.com/mapfiles/api-3/images/spotlight-poi2_hdpi.png\"\r\n//               alt=\"Marker\"\r\n//             />\r\n//           </div>\r\n//         </GoogleMap>\r\n//       </div>\r\n//       <div className=\"search_place\">\r\n//         <GooglePlacesAutocomplete\r\n//           apiKey={mapToken}\r\n//           selectProps={{\r\n//             value,\r\n//             onChange: (value) => handleSelect(value),\r\n//             placeholder: \"Search your location...\",\r\n//           }}\r\n//         />\r\n//       </div>\r\n//     </section>\r\n//   );\r\n// };\r\n\r\n// export default ShowMap;\r\n\r\n\r\nimport React, { useState, useMemo, useRef } from \"react\";\r\nimport \"../../style/account.css\"\r\nimport { GoogleMap, useJsApiLoader } from \"@react-google-maps/api\";\r\nimport GooglePlacesAutocomplete, {\r\n  geocodeByAddress,\r\n  getLatLng,\r\n} from \"react-google-places-autocomplete\";\r\nimport { Skeleton } from \"antd\";\r\nimport { useCurrentLocation } from \"../auth/AuthScreen\";\r\nimport LocationIcons from \"../../assest/png/location_icon.png\"\r\n\r\nconst containerStyle = {\r\n  width: \"100%\",\r\n  height: \"300px\",\r\n};\r\n\r\nconst ShowMap = ({ setLat, setLng, setAlerts }) => {\r\n  const [value, setValue] = useState(null);\r\n  const [mapCenter, setMapCenter] = useState(null); // Track map center\r\n  const mapRef = useRef(null); // Reference for the GoogleMap instance\r\n  const { userLocation } = useCurrentLocation();\r\n\r\n  const mapToken = process.env.REACT_APP_GOOGLE_MAPS_API_KEY;\r\n\r\n  const { isLoaded } = useJsApiLoader({\r\n    googleMapsApiKey: mapToken,\r\n    libraries: [\"places\"],\r\n  });\r\n\r\n  const defaultCenter = useMemo(\r\n    () => ({\r\n      lat: parseFloat(userLocation?.geometry?.location?.lat || 28.6139),\r\n      lng: parseFloat(userLocation?.geometry?.location?.lng || 77.2090),\r\n    }),\r\n    [userLocation]\r\n  );\r\n\r\n  const mapOptions = {\r\n    disableDefaultUI: false,\r\n    zoomControl: true,\r\n    mapTypeControl: false,\r\n    streetViewControl: false,\r\n    fullscreenControl: false,\r\n  };\r\n\r\n  const handleSelect = async (value) => {\r\n    try {\r\n      const results = await geocodeByAddress(value.label);\r\n      const latLng = await getLatLng(results[0]);\r\n      setMapCenter(latLng); // Update the map's center\r\n      setLat(latLng.lat);\r\n      setLng(latLng.lng);\r\n      setAlerts(true);\r\n    } catch (error) {\r\n      console.error(\"Error fetching location:\", error);\r\n    }\r\n  };\r\n\r\n  const handleMapLoad = (map) => {\r\n    mapRef.current = map; // Save the map instance\r\n    setMapCenter(map.getCenter().toJSON()); // Initialize center position\r\n  };\r\n\r\n  const handleMapDrag = () => {\r\n    if (mapRef.current) {\r\n      const newCenter = mapRef.current.getCenter().toJSON(); // Get the updated center\r\n      setMapCenter(newCenter);\r\n      setLat(newCenter.lat);\r\n      setLng(newCenter.lng);\r\n      console.log(\"newCenter\",newCenter)\r\n    }\r\n  };\r\n\r\n  if (!isLoaded) {\r\n    return <Skeleton />;\r\n  }\r\n\r\n  return (\r\n    <section>\r\n      <div className=\"show_map\">\r\n        <GoogleMap\r\n          zoom={14}\r\n          center={mapCenter || defaultCenter}\r\n          options={mapOptions}\r\n          mapContainerStyle={containerStyle}\r\n          onLoad={handleMapLoad} // Save the map instance on load\r\n          onDragEnd={handleMapDrag} // Update center on drag end\r\n        >\r\n          {/* Fixed marker at the center */}\r\n          <div\r\n            style={{\r\n              position: \"absolute\",\r\n              top: \"50%\",\r\n              left: \"50%\",\r\n              transform: \"translate(-50%, -50%)\",\r\n              zIndex: 1,\r\n            }}\r\n          >\r\n            <img\r\n              className=\"map_icons\"\r\n              src={LocationIcons}\r\n              alt=\"Marker\"\r\n            />\r\n          </div>\r\n        </GoogleMap>\r\n      </div>\r\n      <div className=\"search_place\">\r\n        <GooglePlacesAutocomplete\r\n          apiKey={mapToken}\r\n          selectProps={{\r\n            value,\r\n            onChange: (value) => handleSelect(value),\r\n            placeholder: \"Search your location...\",\r\n          }}\r\n        />\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nexport default ShowMap;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\checkout\\TrackMap.jsx",["1273","1274","1275","1276","1277","1278","1279","1280","1281","1282","1283"],[],"import { React, useEffect, useMemo, useRef, useState } from \"react\";\r\nimport \"../../style/header.css\";\r\nimport {\r\n  GoogleMap,\r\n  Marker,\r\n  useJsApiLoader,\r\n  MarkerF,\r\n} from \"@react-google-maps/api\";\r\nimport GooglePlacesAutocomplete, {\r\n  geocodeByAddress,\r\n  getLatLng,\r\n} from \"react-google-places-autocomplete\";\r\nimport { Input, Skeleton, Spin } from \"antd\";\r\n\r\nconst containerStyle = {\r\n  width: \"100%\",\r\n  height: \"300px\",\r\n};\r\n\r\nconst TrackMap = () => {\r\n  const [value, setValue] = useState(null);\r\n  const [lable, setLabel] = useState(null);\r\n  const [lat, setLat] = useState(\"\");\r\n  const [lng, setLng] = useState(\"\");\r\n  const [latLng, setLatLng] = useState(null);\r\n  if (value) {\r\n    const { label } = value;\r\n    setLabel(label);\r\n  }\r\n\r\n  const { isLoaded } = useJsApiLoader({\r\n    googleMapsApiKey: process.env.REACT_APP_GOOGLE_MAPS_API_KEY_TRACK,\r\n    libraries: [\"places\"],\r\n  });\r\n\r\n  const center = useMemo(() => ({ lat: 28.7041, lng: 77.1025 }), []);\r\n\r\n\r\n\r\n  const onLoadHandler = (marker) => {\r\n    console.log(\"marker: \", marker);\r\n  };\r\n\r\n  if (!isLoaded) {\r\n    return <Skeleton />;\r\n  }\r\n  const mapOptions = {\r\n    disableDefaultUI: false, // Set to true to hide all default UI controls\r\n    zoomControl: true, // Set to false to hide zoom control\r\n    mapTypeControl: false, // Set to false to hide map type control\r\n    scaleControl: true, // Set to false to hide scale control\r\n    streetViewControl: true, // Set to false to hide street view control\r\n    fullscreenControl: true, // Set to false to hide fullscreen control\r\n  };\r\n\r\n  const handleSelect = async (value) => {\r\n    try {\r\n      const results = await geocodeByAddress(value.label);\r\n      const latLng = await getLatLng(results[0]);\r\n      setLatLng(latLng)\r\n      console.log('Selected Address:', value);\r\n      console.log('Latitude:', latLng.lat);\r\n      console.log('Longitude:', latLng.lng);\r\n    } catch (error) {\r\n      console.error('Error fetching location:', error);\r\n    }\r\n  };\r\n\r\n  return (\r\n    <section>\r\n      <div className=\"show_map\">\r\n        <GoogleMap\r\n          zoom={latLng != null ? 20 : 15}\r\n          center={latLng != null ? latLng : center}\r\n          options={mapOptions}\r\n          mapContainerStyle={containerStyle}\r\n          onClick={(ev) => {\r\n            setLat(ev.latLng.lat());\r\n            setLng(ev.latLng.lng());\r\n\r\n            alert(\r\n              `you are selected lat- ${ev.latLng.lat()} long- ${ev.latLng.lng()} `\r\n            );\r\n          }}\r\n        >\r\n          <MarkerF\r\n            onLoad={onLoadHandler}\r\n            position={latLng != null ? latLng : center}\r\n          />\r\n        </GoogleMap>\r\n      </div>\r\n\r\n    </section>\r\n  );\r\n};\r\n\r\n\r\n\r\nexport default TrackMap","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\checkout\\TrackStep.jsx",[],[],"C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\checkout\\CancelOrderType.jsx",["1284","1285","1286","1287","1288","1289","1290","1291","1292","1293","1294","1295","1296"],[],"import React, { useEffect, useState } from \"react\";\r\nimport { Button, Divider, Form, Input, Modal, Popconfirm, Radio, Space, message, notification } from \"antd\";\r\nimport \"../../style/checkout.css\";\r\n\r\nimport { MdOutlineShoppingBag } from \"react-icons/md\";\r\nimport { useNavigate } from \"react-router-dom\";\r\nimport { CancelOrderProduct, cancelReason } from \"../apiService/api\";\r\nimport { useAuth } from \"../auth/context/authContext\";\r\n\r\nconst CancelOrderType = ({ orderId, ShowMyOrderDetails }) => {\r\n  const [isModalOpen, setIsModalOpen] = useState(false);\r\n  const { token } = useAuth()\r\n  const [reason, setReason] = useState(null)\r\n  const [value, setValue] = useState(null);\r\n  const navigate = useNavigate()\r\n\r\n\r\n  const onChange = (e) => {\r\n    console.log(\"radio checked\", e.target.value);\r\n    setValue(e.target.value);\r\n  };\r\n\r\n  // Data is present, retrieve and use it\r\n\r\n  const showModal = () => {\r\n    setIsModalOpen(true);\r\n  };\r\n  const handleOk = () => {\r\n    setIsModalOpen(false);\r\n  };\r\n  const handleCancel = () => {\r\n    setIsModalOpen(false);\r\n  };\r\n\r\n  const cancel = (e) => {\r\n    console.log(e);\r\n    message.error('You are click  no');\r\n  };\r\n  const handelReason = (e) => {\r\n    setReason(e.target.value)\r\n    console.log(\"reason\", reason)\r\n  }\r\n\r\n  const cancelOrderHandler = async () => {\r\n    const body = {\r\n      userOrderId: orderId,\r\n      reason: reason,\r\n    }\r\n    if (!reason) {\r\n      notification.warning({\r\n        placement: \"topRight\",\r\n        message: \"Please Enter Reason\",\r\n      });\r\n\r\n    } else {\r\n      try {\r\n        await CancelOrderProduct(token, body)\r\n          .then((res) => {\r\n            console.log(\"order cancel\", res);\r\n            if (res.status == 201) {\r\n              handleCancel()\r\n              ShowMyOrderDetails()\r\n              notification.success({\r\n                placement: \"topRight\",\r\n                message: res.data.message,\r\n              });\r\n            } else if (res.status == 200) {\r\n              notification.success({\r\n                placement: \"topRight\",\r\n                message: res.data.message,\r\n              });\r\n            }\r\n\r\n          })\r\n          .catch((err) => {\r\n            console.log(err);\r\n          });\r\n      } catch (error) {\r\n        console.log(error);\r\n      }\r\n    }\r\n  };\r\n\r\n  return (\r\n    <>\r\n      <div className=\"cancel_order\">\r\n        <Button type=\"primary\" danger onClick={showModal}>\r\n          {\" \"}\r\n          Cancel\r\n        </Button>\r\n      </div>\r\n      <Modal\r\n        title=\"Why you are cancel this Order ?\"\r\n        footer={false}\r\n        open={isModalOpen}\r\n        onOk={handleOk}\r\n        onCancel={handleCancel}\r\n        width={300}\r\n      >\r\n        <div className=\"order_type_list\">\r\n          <Form layout=\"vertical\">\r\n            <Form.Item label=\"Enter Your Reason\">\r\n\r\n              <Input.TextArea placeholder=\"Please Enter Reason\" onChange={handelReason} />\r\n            </Form.Item>\r\n            <Form.Item>\r\n              <div className=\"cencel_reason_btn\">\r\n\r\n                <Button type=\"round\" htmlType=\"submit\" onClick={cancelOrderHandler}>Submit</Button>\r\n\r\n              </div>\r\n            </Form.Item>\r\n          </Form>\r\n        </div>\r\n      </Modal>\r\n    </>\r\n  );\r\n};\r\n\r\nexport default CancelOrderType;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\checkout\\PartnerRating.jsx",["1297","1298","1299","1300","1301","1302"],[],"import React, { useState } from \"react\";\r\nimport { Button, Form, Input, message, Modal } from \"antd\";\r\nimport \"../../style/checkout.css\";\r\nimport { FrownOutlined, MehOutlined, SmileOutlined } from \"@ant-design/icons\";\r\nimport { Flex, Rate } from \"antd\";\r\nimport { BsEmojiLaughing, BsEmojiFrown, BsEmojiHeartEyes, BsEmojiSmile, BsEmojiAngry } from \"react-icons/bs\";\r\nimport { useNavigate, useParams } from \"react-router-dom\";\r\nimport { givenVendorRating } from \"../apiService/api\";\r\nimport { useAuth } from \"../auth/context/authContext\";\r\nimport RatingImage from \"../../assest/feature/confillti.gif\"\r\n\r\nconst PartnerRating = ({ ShowMyOrderDetails }) => {\r\n  const { token } = useAuth()\r\n  const { id } = useParams()\r\n  const navigate = useNavigate()\r\n  const [isModalOpen, setIsModalOpen] = useState(false);\r\n  const [isRating, setIsRating] = useState(false);\r\n  const [isLoading, setIsLoading] = useState(false);\r\n  const [value, setValue] = useState(0);\r\n  const [review, setReview] = useState(\"\")\r\n  const desc = ['terrible', 'bad', 'good', 'Very good', 'I loved It'];\r\n\r\n  const customIcons = {\r\n    1: <BsEmojiAngry className=\"rate_icon\" />,\r\n    2: <BsEmojiFrown className=\"rate_icon\" />,\r\n    3: <BsEmojiSmile className=\"rate_icon\" />,\r\n    4: <BsEmojiLaughing className=\"rate_icon\" />,\r\n    5: <BsEmojiHeartEyes className=\"rate_icon\" />,\r\n  };\r\n\r\n  const showModal = () => {\r\n    setIsModalOpen(true);\r\n  };\r\n  const handleOk = () => {\r\n    setIsModalOpen(false);\r\n  };\r\n  const handleCancel = () => {\r\n    setIsModalOpen(false);\r\n  };\r\n\r\n\r\n  const handleRatingSubmit = async () => {\r\n    const body = {\r\n      userOrderId: id,\r\n      rating: value,\r\n      review: review\r\n    }\r\n    setIsLoading(true)\r\n    try {\r\n      await givenVendorRating(token, body)\r\n        .then((res) => {\r\n          console.log(\"vendor rating\", res);\r\n          if (res.status == 201) {\r\n            message.success(res.data.message)\r\n            setIsRating(true)\r\n            setIsLoading(false)\r\n\r\n            setTimeout(() => {\r\n              ShowMyOrderDetails()\r\n              handleCancel()\r\n            }, 2000)\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          console.log(err);\r\n        });\r\n    } catch (error) {\r\n      console.log(error);\r\n      setIsLoading(false)\r\n\r\n    }\r\n  };\r\n  return (\r\n    <div className=\"partner_rate\">\r\n      <Button type=\"primary\" onClick={showModal} shape=\"round\"> Rating & Review</Button>\r\n      <Modal\r\n        open={isModalOpen}\r\n        onOk={handleOk}\r\n        onCancel={handleCancel}\r\n        footer={false}\r\n        width={300}\r\n        className=\"rating_modal\"\r\n      >\r\n        <div className=\"show_rates_icon\">\r\n          <div className=\"show_rating_img\">\r\n            {isRating ? <img src={RatingImage} /> : null}\r\n          </div>\r\n          <div className=\"show_coment\">\r\n            {value ? <p>{desc[value - 1]}</p> : null}\r\n          </div>\r\n          <Flex gap=\"middle\" vertical>\r\n            <Rate\r\n              onChange={setValue}\r\n              value={value}\r\n              character={({ index = 0 }) => customIcons[index + 1]}\r\n            />\r\n\r\n          </Flex>\r\n        </div>\r\n        <div className=\"feedback\">\r\n          <Form>\r\n            <Form.Item>\r\n              <Input variant=\"filled\" placeholder=\"Tell us what you like\" onChange={(e) => setReview(e.target.value)} />\r\n            </Form.Item>\r\n            <Button loading={isLoading} onClick={handleRatingSubmit} shape=\"round\">Submit Rating</Button>\r\n          </Form>\r\n        </div>\r\n      </Modal>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default PartnerRating;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\Racipe\\RecipesBanner.jsx",["1303","1304","1305"],[],"import React, { Component } from \"react\";\r\nimport Slider from \"react-slick\";\r\nimport \"../../style/product.css\"\r\nimport { Card } from \"antd\";\r\nimport defaultImg from \"../../assest/emptyImage.png\"\r\n\r\nfunction RecipesBanner({ racipeData }) {\r\n  const settings = {\r\n    dots: true,\r\n    adaptiveHeight: true,\r\n    infinite: true,\r\n    speed: 800,\r\n    arrows: false,\r\n    slidesToShow: 1,\r\n    slidesToScroll: 1,\r\n    autoplay: true,\r\n    loop: true,\r\n    autoplaySpeed: 2000,\r\n    draggable: true,\r\n    swipeToSlide: true,\r\n    swipe: true,\r\n  };\r\n  console.log(\"racipeData--->\", racipeData)\r\n\r\n  return (\r\n    <div className=\"recpes_scroll\">\r\n      <Card\r\n\r\n        cover={\r\n          <Slider {...settings}>\r\n            {racipeData?.recipeImages?.length === 0 ? <div className=\"recipes_banner_img\">\r\n              <img src={defaultImg} />\r\n            </div> : racipeData?.recipeImages?.map((url) => (\r\n              <div className=\"recipes_banner_img\">\r\n                <img\r\n                  src={url || defaultImg}\r\n                  onError={(e) => e.currentTarget.src = defaultImg}\r\n                />\r\n              </div>\r\n            ))}\r\n          </Slider>\r\n        }\r\n      >\r\n        <Card.Meta\r\n          title={<div>\r\n            <p>{racipeData?.recipeTitle}</p>\r\n          </div>}\r\n          description={racipeData?.cookingTime}\r\n        />\r\n      </Card>\r\n    </div>\r\n  );\r\n}\r\nexport default RecipesBanner;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\home\\HeroBanner.jsx",["1306","1307","1308","1309","1310","1311","1312"],[],"import React, { useEffect, useState } from \"react\";\r\nimport \"../../style/header.css\";\r\nimport \"react-responsive-carousel/lib/styles/carousel.min.css\";\r\nimport HeroBannerImg from \"../../assest/BG.jpg\";\r\nimport { useNavigate } from \"react-router-dom\";\r\nimport Slider from \"react-slick\";\r\nimport { encryptCategoryID } from \"../../config/encriptConfig\";\r\n\r\n\r\nfunction HeroBanner({ bannerList }) {\r\n  const navigate = useNavigate()\r\n\r\n  // console.log(\"bannerList\", bannerList)\r\n  const manageURl = (name) => {\r\n    const sanitizedCategory = name\r\n      .replace(/[,/&]/g, '') // Remove commas, slashes, ampersands\r\n      .replace(/\\s+/g, '-')  // Replace spaces with hyphens\r\n      .toLowerCase();\r\n    return sanitizedCategory\r\n  }\r\n  const handelNavigate = (item) => {\r\n    if (item.navigateTo === \"CATEGORY\") {\r\n      navigate(`/category/${manageURl(item.navigateToByName)}?uid=${encodeURIComponent(encryptCategoryID(item.navigateToId))}`);\r\n\r\n    } else if (item.navigateTo === \"BRAND\") {\r\n      navigate(`/brand-product/${manageURl(item.navigateToByName)}?uid=${encodeURIComponent(encryptCategoryID(item.navigateToId))}`);\r\n\r\n    } else if (item.navigateTo === \"PRODUCT\") {\r\n      navigate(`/product/${manageURl(item.navigateToByName)}?uid=${encodeURIComponent(encryptCategoryID(item.navigateToId))}`);\r\n\r\n    }\r\n  }\r\n\r\n  const settings = {\r\n    dots: true,\r\n    adaptiveHeight: true,\r\n    infinite: true,\r\n    speed: 800,\r\n    arrows: true,\r\n    slidesToShow: 1,\r\n    slidesToScroll: 1,\r\n    autoplay: true,\r\n    loop: true,\r\n    autoplaySpeed: 3000,\r\n    draggable: true,\r\n    swipeToSlide: true,\r\n    swipe: true,\r\n  };\r\n\r\n\r\n\r\n\r\n  return (\r\n    <div className=\"hero_banner_section\">\r\n\r\n      <div className=\" hero_bannner_slider\">\r\n        <Slider {...settings}>\r\n          {bannerList?.length == 0 ? <div className=\"hero_bg\" >\r\n            <img src={HeroBannerImg} />\r\n          </div> : bannerList.map((slide) => (\r\n            <div className=\"hero_bg\">\r\n              {slide.bannerUrl ?\r\n                <a href={slide.bannerUrl} target=\"_blank\">\r\n                  <img\r\n                    src={slide.bannerImage || HeroBannerImg}\r\n                    onError={(e) => e.currentTarget.src = HeroBannerImg}\r\n                    key={slide._id}\r\n                  />\r\n                </a>\r\n                :\r\n                <img\r\n                  src={slide.bannerImage || HeroBannerImg}\r\n                  onError={(e) => e.currentTarget.src = HeroBannerImg}\r\n                  key={slide._id}\r\n                  onClick={() => handelNavigate(slide)}\r\n                />\r\n              }\r\n            </div>\r\n          ))}\r\n        </Slider>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\nexport default HeroBanner;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\Racipe\\RecipesDetails.jsx",["1313","1314","1315"],[],"import { SettingOutlined } from '@ant-design/icons';\r\nimport React, { useState } from 'react';\r\nimport { Collapse, Select } from 'antd';\r\nimport Ingredient from './Ingredient';\r\nimport CookStep from './CookStep';\r\n\r\nconst { Option } = Select;\r\n\r\nconst RecipesDetails = ({ racipeData, ShowRacipeDetails }) => {\r\n  const [expandIconPosition, setExpandIconPosition] = useState('end');\r\n\r\n  const { recipeDescription } = racipeData\r\n  const onPositionChange = (newExpandIconPosition) => {\r\n    setExpandIconPosition(newExpandIconPosition);\r\n  };\r\n\r\n  const onChange = (key) => {\r\n    console.log(key);\r\n  };\r\n\r\n\r\n  const items = [\r\n    {\r\n      key: '1',\r\n      label: <strong>Ingredients</strong>,\r\n      children: <Ingredient ingredientData={racipeData.ingredients} ShowRacipeDetails={ShowRacipeDetails} />,\r\n    },\r\n    {\r\n      key: '2',\r\n      label: <strong>Dish description</strong>,\r\n      children: <div><p>{recipeDescription}</p></div>,\r\n    },\r\n    {\r\n      key: '3',\r\n      label: <strong>Cooking steps</strong>,\r\n\r\n      children: <CookStep racipeData={racipeData}/>\r\n    },\r\n  ];\r\n\r\n  return (\r\n    <>\r\n      <Collapse\r\n        defaultActiveKey={['1','3']}\r\n        bordered={false}\r\n        onChange={onChange}\r\n        expandIconPosition={expandIconPosition}\r\n        // expandIcon={({ isActive }) => <SettingOutlined rotate={isActive ? 90 : 0} />}\r\n        items={items}\r\n      />\r\n    </>\r\n  );\r\n};\r\n\r\nexport default RecipesDetails;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\Category\\ProductFilter.jsx",["1316"],[],"import React, { useRef, useState } from \"react\";\r\nimport { FilterOutlined } from \"@ant-design/icons\";\r\nimport { Button, Divider, Dropdown, Form, message, Modal, Select, Space, Spin } from \"antd\";\r\nimport { MdArrowDownward, MdArrowUpward } from \"react-icons/md\";\r\nimport { LuArrowUpAZ, LuArrowDownAZ } from \"react-icons/lu\";\r\nimport \"../../style/Category.css\";\r\nimport { FcCheckmark } from \"react-icons/fc\";\r\nimport { FetchbrandList } from \"../apiService/api\";\r\n\r\nfunction ProductFilter({ setItemType, setFilterBy, setBrandId, onBrandSelect }) {\r\n  const [form] = Form.useForm()\r\n  const [selectedKey, setSelectedKey] = useState(null);\r\n  const [open, setOpen] = useState(false);\r\n  const [selectedBrandId, setSelectedBrandId] = useState(\"\");\r\n  const [selectedBrandName, setSelectedBrandName] = useState(\"\");\r\n  const [isModalOpen, setIsModalOpen] = useState(false);\r\n  const [brandList, setBrandList] = useState([]);\r\n  const [isBrandLoading, setIsBrandLoading] = useState(false);\r\n  const debounceSearch = useRef(null);\r\n\r\n  const initialItems = [\r\n    {\r\n      key: \"1\",\r\n      label: \"Price high to low\",\r\n      sortby: \"bkdAmount\",\r\n      sortType: \"DESC\",\r\n      icon: <MdArrowUpward className=\"sort_icons\" />,\r\n      extra: \"⌘P\",\r\n    },\r\n    {\r\n      key: \"2\",\r\n      label: \"Price low to high\",\r\n      sortby: \"bkdAmount\",\r\n      sortType: \"ASC\",\r\n      icon: <MdArrowDownward className=\"sort_icons\" />,\r\n      extra: \"⌘B\",\r\n    },\r\n    {\r\n      key: \"3\",\r\n      label: \"A to Z\",\r\n      sortby: \"productName\",\r\n      sortType: \"ASC\",\r\n      icon: <LuArrowUpAZ className=\"sort_icons\" />,\r\n      extra: \"⌘S\",\r\n    },\r\n    {\r\n      key: \"4\",\r\n      label: \"Z to A\",\r\n      sortby: \"productName\",\r\n      sortType: \"DESC\",\r\n      icon: <LuArrowDownAZ className=\"sort_icons\" />,\r\n      extra: \"⌘S\",\r\n    },\r\n    {\r\n      key: \"5\",\r\n      label: selectedBrandName || \"Select Brand\",\r\n      sortby: \"productName\",\r\n      type: \"brand\",\r\n    }\r\n  ];\r\n\r\n  const showAllBrandList = async (search = \"\") => {\r\n    setIsBrandLoading(true)\r\n    try {\r\n      await FetchbrandList(1, search)\r\n        .then((res) => {\r\n          if (res.status == 200) {\r\n            setBrandList(res.data.data);\r\n            setIsBrandLoading(false)\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          message.error(err)\r\n          setIsBrandLoading(false)\r\n        });\r\n    } catch (error) {\r\n      message.error(error)\r\n      setIsBrandLoading(false)\r\n    }\r\n  };\r\n\r\n  const handleFilter = (info) => {\r\n    const { key } = info;\r\n    const selectedItem = initialItems.find((item) => item.key === key); // Find selected item by key\r\n\r\n    if (key === \"5\") {\r\n      setIsModalOpen(true);\r\n      setOpen(false);\r\n      showAllBrandList(\"\")\r\n      return;\r\n    }\r\n\r\n    setSelectedKey(key); // Update selected key\r\n    setItemType(selectedItem?.sortType);\r\n    setFilterBy(selectedItem?.sortby);\r\n    setSelectedBrandId(\"\");\r\n    setSelectedBrandName(\"\");\r\n    setOpen(false);\r\n  };\r\n\r\n  const submitHandler = () => {\r\n    if (!selectedBrandId) {\r\n      message.error(\"Please select brand\");\r\n      return;\r\n    }\r\n\r\n    setFilterBy(\"\");\r\n    setItemType(\"\");\r\n    if (setBrandId) {\r\n      setBrandId(selectedBrandId);\r\n    }\r\n    if (onBrandSelect) {\r\n      onBrandSelect(selectedBrandId, selectedBrandName);\r\n    }\r\n\r\n    setSelectedKey(\"5\");\r\n    setIsModalOpen(false);\r\n  };\r\n\r\n  const handleOk = () => {\r\n    setIsModalOpen(false);\r\n  };\r\n  const handleCancel = () => {\r\n    setIsModalOpen(false);\r\n  };\r\n\r\n  const handleSearch = (value) => {\r\n    clearTimeout(debounceSearch.current);\r\n\r\n    debounceSearch.current = setTimeout(() => {\r\n      showAllBrandList(value);\r\n    }, 400);\r\n  };\r\n\r\n  // Add a tick icon dynamically to the selected item\r\n  const itemsWithTick = initialItems.map((item) => ({\r\n    ...item,\r\n    label: (\r\n      <Space>\r\n        {item.key === \"5\" && selectedBrandName ? selectedBrandName : item.label}\r\n        {selectedKey === item.key && <FcCheckmark className=\"sort_icons\" />}\r\n      </Space>\r\n    ),\r\n  }));\r\n\r\n  return (\r\n    <>\r\n      <div className=\"filters\">\r\n        <Dropdown\r\n          open={open}\r\n          onOpenChange={(flag) => setOpen(flag)}\r\n          overlayClassName=\"product-filter-dropdown\"\r\n          menu={{\r\n            items: itemsWithTick,\r\n            onClick: handleFilter, // Pass the handler here\r\n          }}\r\n          trigger={[\"click\"]}\r\n          dropdownRender={(menuNode) => (\r\n            <div style={{ background: '#fff' }}>\r\n              {menuNode}\r\n              <Divider style={{ margin: 0 }} />\r\n              <div className=\"filter-reset\">\r\n                <Button\r\n                  size=\"small\"\r\n                  onClick={() => {\r\n                    setItemType(\"\");\r\n                    setFilterBy(\"\");\r\n                    setOpen(false);\r\n                    if (setBrandId && !onBrandSelect) {\r\n                      setBrandId(\"\");\r\n                    }\r\n                    if (!onBrandSelect) {\r\n                      setSelectedKey(null);\r\n                      setSelectedBrandId(\"\");\r\n                      setSelectedBrandName(\"\");\r\n                    }\r\n                  }}\r\n                >\r\n                  Reset\r\n                </Button>\r\n              </div>\r\n            </div>\r\n          )}\r\n        >\r\n          <Button shape=\"circel\" icon={<FilterOutlined />} type=\"primary\">\r\n            {/* <span className=\"filter_list\">Customer Favorites</span> */}\r\n          </Button>\r\n        </Dropdown>\r\n      </div>\r\n\r\n      <Modal width={400} title=\"Select Brand\" open={isModalOpen} onOk={handleOk} onCancel={handleCancel} footer={false}>\r\n        {isBrandLoading ? (\r\n          <div style={{ display: 'flex', justifyContent: 'center', alignItems: 'center', padding: '30px 0' }}>\r\n            <Spin size=\"small\" />\r\n          </div>\r\n        ) : (\r\n          <div className=\"vendor_search_form\">\r\n            <Form layout=\"vertical\" form={form} onFinish={submitHandler}>\r\n              <Form.Item name=\"branchId\">\r\n                <Select\r\n                  showSearch\r\n                  placeholder=\"Select Branch\"\r\n                  allowClear\r\n                  onSearch={handleSearch}\r\n                  filterOption={false}\r\n                  options={brandList.map(option => ({\r\n                    value: option.brandID,\r\n                    label: `${option.brandName}`,\r\n                  }))}\r\n                  onChange={(value, option) => {\r\n                    setSelectedBrandId(value);\r\n                    setSelectedBrandName(option?.label || \"\");\r\n                  }}\r\n                />\r\n              </Form.Item>\r\n              <Form.Item>\r\n                <div className=\"order_sent_btn\">\r\n                  <Button htmlType='submit'>Submit</Button>\r\n                </div>\r\n              </Form.Item>\r\n            </Form>\r\n          </div>\r\n        )}\r\n      </Modal>\r\n    </>\r\n  );\r\n}\r\n\r\nexport default ProductFilter;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\home\\BrandScroll.jsx",["1317","1318","1319","1320","1321","1322","1323","1324","1325","1326","1327","1328"],[],"import { Badge, Button, Card, Divider, Skeleton, Space, Tag, Tooltip } from \"antd\";\r\nimport React, { useEffect, useState } from \"react\";\r\nimport Slider from \"react-slick\";\r\nimport \"../../style/home.css\";\r\nimport { MdArrowRightAlt } from \"react-icons/md\";\r\nimport { useNavigate } from \"react-router-dom\";\r\nimport { FetchbrandList } from \"../apiService/api\";\r\nimport DefaultLogo from \"../../assest/bkdlogo.png\"\r\nimport { useCurrentLocation } from \"../auth/AuthScreen\";\r\nimport { DotChartOutlined, SearchOutlined } from '@ant-design/icons';\r\nimport { encryptCategoryID } from \"../../config/encriptConfig\";\r\n\r\nfunction BrandScroll({ screenWidth, title }) {\r\n  const { userLocation, setUserLocation } = useCurrentLocation();\r\n\r\n  const [brandList, setBrandList] = useState([]);\r\n  const [current, setCurrent] = useState(1)\r\n\r\n  const [loading, setLoading] = useState(false);\r\n  const titleCase = str => str.toLowerCase().split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');\r\n\r\n\r\n  const navigate = useNavigate()\r\n  const settings = {\r\n    dots: false,\r\n    adaptiveHeight: true,\r\n    infinite: true,\r\n    speed: 800,\r\n    arrows: true,\r\n    slidesToShow: screenWidth < 500 ? 4 : 12,\r\n    slidesToScroll: 1,\r\n    autoplay: true,\r\n    loop: true,\r\n    autoplaySpeed: 3000,\r\n    draggable: true,\r\n    swipeToSlide: true,\r\n    swipe: true,\r\n  };\r\n\r\n  const showAllBrandList = async () => {\r\n    try {\r\n      await FetchbrandList(current)\r\n        .then((res) => {\r\n          // console.log(\"brand scroll  lsit\", res);\r\n          if (res.status == 200) {\r\n            // setBrandList(res.data.data)\r\n            setBrandList(res.data.data);\r\n            setLoading(true)\r\n          }\r\n\r\n        })\r\n        .catch((err) => {\r\n          console.log(err);\r\n        });\r\n    } catch (error) {\r\n      console.log(error);\r\n    }\r\n  };\r\n  useEffect(() => {\r\n    showAllBrandList()\r\n  }, [userLocation])\r\n\r\n  const manageURl = (name) => {\r\n    const sanitizedCategory = name\r\n      .replace(/[,/&]/g, '') // Remove commas, slashes, ampersands\r\n      .replace(/\\s+/g, '-')  // Replace spaces with hyphens\r\n      .toLowerCase();\r\n    return sanitizedCategory\r\n  }\r\n\r\n  return (\r\n    <section>\r\n      <div className=\"card_section my-4\">\r\n        <div className=\"card_section_title\">\r\n          <p>{title}</p>\r\n          <Button type=\"link\" shape=\"round\"\r\n            onClick={() => navigate(\"/all_brand\")}>View All <MdArrowRightAlt className=\"view_icon\" /></Button>\r\n        </div>\r\n        <Slider {...settings}>\r\n          {!loading ? <div className=\"trending-brand\">\r\n            {new Array(12).fill(0).map((_, index) => (\r\n              <Skeleton.Node key={index} active style={{ borderRadius: \"100%\" }}>\r\n                <DotChartOutlined style={{ fontSize: 40, color: '#bfbfbf' }} />\r\n              </Skeleton.Node>\r\n            ))}\r\n          </div> : brandList.map((item) => (\r\n            <div className=\"brand_card\" key={item.brandID}>\r\n              <div className=\"brand\">\r\n                {item.imageUrl != null ?\r\n                  <img\r\n                    src={item.imageUrl || DefaultLogo}\r\n                    onError={(e) => e.currentTarget.src = DefaultLogo}\r\n                    onClick={() => navigate(`/brand-product/${manageURl(item.brandName)}?uid=${encodeURIComponent(encryptCategoryID(item.brandID))}`)}\r\n                  />\r\n                  : <img src={DefaultLogo} onClick={() => navigate(`/brand-product/${manageURl(item.brandName)}?uid=${encodeURIComponent(encryptCategoryID(item.brandID))}`)} />}\r\n              </div>\r\n              <div className=\"brand_title\">\r\n                <Tooltip title={titleCase(item.brandName)}>\r\n                  <p>{item.brandName.length > 8 ? titleCase(item.brandName.slice(0, 8)) + \"...\" : titleCase(item.brandName)}</p>\r\n                </Tooltip>\r\n              </div>\r\n\r\n            </div>\r\n          ))}\r\n        </Slider>\r\n      </div>\r\n    </section>\r\n  );\r\n}\r\n\r\nexport default BrandScroll;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\config\\common.js",[],[],"C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\home\\OffersSlider.jsx",["1329","1330"],[],"import React, { Component } from \"react\";\r\nimport Slider from \"react-slick\";\r\nimport \"../../style/header.css\"\r\nimport { useNavigate } from \"react-router-dom\";\r\nimport BKDLogo from \"../../assest/bkdlogo.png\";\r\n\r\nfunction OffersSlider({ screenWidth, offerList }) {\r\n\r\n  const navigate = useNavigate()\r\n  const settings = {\r\n    dots: false,\r\n    adaptiveHeight: true,\r\n    infinite: true,\r\n    speed: 800,\r\n    arrows: false,\r\n    slidesToShow: screenWidth < 500 ? 2 : 3,\r\n    slidesToScroll: 1,\r\n    autoplay: true,\r\n    loop: true,\r\n    autoplaySpeed: 3000,\r\n    draggable: true,\r\n    swipeToSlide: true,\r\n    swipe: true,\r\n  };\r\n\r\n  const handelNavigate = (item) => {\r\n    if (item.navigateTo === \"CATEGORY\") {\r\n      navigate(`/category/${item.navigateToId}`)\r\n    } else if (item.navigateTo === \"BRAND\") {\r\n      navigate(`/brand-product/${item.navigateToId}`)\r\n    } else if (item.navigateTo === \"PRODUCT\") {\r\n      navigate(`/product/${item.navigateToId}`)\r\n    }\r\n  }\r\n\r\n\r\n\r\n  return (\r\n    <div className=\"offer_scroll\">\r\n      {/* <h4>New Offer</h4> */}\r\n      <Slider {...settings}>\r\n        {offerList.map((item) => (\r\n          <div className=\"feature_slider_img\">\r\n            <img\r\n              src={item.bannerImage || BKDLogo}\r\n              onError={(e) => e.currentTarget.src = BKDLogo}\r\n              onClick={() => handelNavigate(item)}\r\n            />\r\n          </div>\r\n        ))}\r\n      </Slider>\r\n    </div>\r\n  );\r\n}\r\nexport default OffersSlider;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\utils\\couponUtils.js",[],[],"C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\poolOrder\\PoolOrder.jsx",["1331","1332","1333","1334"],[],"import { Button, Row, Col, Card } from \"antd\";\r\nimport React from \"react\";\r\n\r\nimport Slider from \"react-slick\";\r\nimport \"../../style/order.css\";\r\nimport logo from \"../../assest/logo.png\"\r\nimport { useNavigate } from \"react-router-dom\";\r\nimport PoolImage from \"../../assest/png/poolimg.png\"\r\n\r\n\r\n\r\nfunction PoolOrder({ screenWidth }) {\r\n  const navigate = useNavigate()\r\n  // const PoolImage=\"https://www.hechlerphotographers.com/wp-content/themes/hechler/library/images/shop-bkd.jpg\"\r\n\r\n  return (\r\n    <div className=\"pool_order\">\r\n      <div className=\"pool_title\">\r\n\r\n        <p>Pool Order</p>\r\n      </div>\r\n\r\n      <Row\r\n        gutter={{\r\n          xs: 8,\r\n          sm: 16,\r\n          md: 24,\r\n          lg: 32,\r\n        }}\r\n      >\r\n        <Col className=\"gutter-row\" span={24}>\r\n          <div className=\"pool_order_left\">\r\n            <div className=\"pool_slider_img\">\r\n              <img src={PoolImage} />\r\n            </div>\r\n          </div>\r\n          <div className=\"bkd_pool1\">\r\n            <img src={logo} />\r\n            <h1>BKD POOL ITEM</h1>\r\n            <p>Order Now !</p>\r\n            <div className=\"pool_order_btn\">\r\n\r\n              <Button size=\"large\" shape=\"round\" onClick={() => navigate(\"/pool-Order\")}>Order Now</Button>\r\n            </div>\r\n          </div>\r\n        </Col>\r\n\r\n\r\n\r\n\r\n        {/* {screenWidth > 800 ? <Col className=\"gutter-row\" span={10}>\r\n          <div className=\"pool_order_right\">\r\n            <Slider {...settings}>\r\n              {PoolSlider().map((item) => (\r\n                <div className=\"pool_slider_img\">\r\n                  <img src={item.urls} />\r\n                </div>\r\n              ))}\r\n            </Slider>\r\n          </div>\r\n          <div className=\"bkd_pool2\">\r\n            <img src={logo} />\r\n            <h1>BKD POOL ITEM</h1>\r\n            <p>Order Now !</p>\r\n            <Button shape=\"round\" onClick={() => navigate(\"/pool-Order\")}>Order Now</Button>\r\n          </div>\r\n        </Col> : null} */}\r\n      </Row>\r\n\r\n    </div >\r\n  );\r\n}\r\n\r\nexport default PoolOrder;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\home\\CategorySlider.jsx",["1335","1336","1337","1338","1339","1340","1341","1342","1343","1344","1345"],[],"import React, { useEffect, useState } from \"react\";\r\nimport \"../../style/header.css\";\r\nimport { Button, Card, Skeleton } from \"antd\";\r\nimport { Col, Row } from \"react-bootstrap\";\r\nimport { Link, useNavigate } from \"react-router-dom\";\r\nimport { MdArrowRightAlt } from \"react-icons/md\";\r\nimport { FetchCategoryList } from \"../apiService/api\";\r\nimport DefaultLogo from \"../../assest/logo.png\"\r\nimport { useCurrentLocation, useScreen } from \"../auth/AuthScreen\";\r\nimport { encryptCategoryID } from \"../../config/encriptConfig\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { setCategoriesData, setCategoriesLoading } from \"../../redux/CategoriesSlice\";\r\nimport Slider from \"react-slick\";\r\n\r\nfunction CategorySlider({screenWidth}) {\r\n  // const [catList, setCatList] = useState([]);\r\n  const [current, setCurrent] = useState(1)\r\n  const navigate = useNavigate()\r\n\r\n\r\n  // const [isLoading, setIsLoading] = useState(false);\r\n  const [searchInput, setSearchInput] = useState(\"\")\r\n  const { userLocation, setUserLocation } = useCurrentLocation();\r\n\r\n  const dispatch = useDispatch()\r\n\r\n  const categoriesState = useSelector((state) => state.categories || {});\r\n  const { categoriesData = [], isLoading = false, hasFetched = false } = categoriesState;\r\n\r\n  const skeletonArray = new Array(categoriesData?.length || 16).fill(0);\r\n\r\n  const titleCase = str => str.toLowerCase().split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');\r\n\r\n  const settings = {\r\n    dots: false,\r\n    adaptiveHeight: true,\r\n    infinite: true,\r\n    speed: 800,\r\n    arrows: true,\r\n    slidesToShow: screenWidth < 876 ? 4 : 8,\r\n\r\n    slidesToScroll: 1,\r\n    autoplay: true,\r\n    loop: true,\r\n    autoplaySpeed: 3000,\r\n    draggable: true,\r\n    swipeToSlide: true,\r\n    swipe: true,\r\n  };\r\n\r\n  const fetchCategories = async () => {\r\n    try {\r\n      if (!hasFetched) {\r\n        dispatch(setCategoriesLoading(true));\r\n      }\r\n\r\n      const res = await FetchCategoryList(searchInput);\r\n\r\n      if (res.status === 200) {\r\n        dispatch(setCategoriesData(res.data.data));\r\n      }\r\n    } catch (err) {\r\n      console.log(err);\r\n      dispatch(setCategoriesLoading(false));\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    fetchCategories();\r\n  }, [current, userLocation]);\r\n\r\n\r\n\r\n\r\n  const manageURl = (categoryName) => {\r\n    const sanitizedCategory = categoryName\r\n      .replace(/[,/&]/g, '') // Remove commas, slashes, ampersands\r\n      .replace(/\\s+/g, '-')  // Replace spaces with hyphens\r\n      .toLowerCase();\r\n    return sanitizedCategory\r\n  }\r\n\r\n\r\n  return (\r\n    <section>\r\n      <div className=\"category_slider\">\r\n        <div className=\"cat_title\">\r\n          <p>Shop by Category</p>\r\n          {/* <Button type=\"link\" onClick={() => navigate('/all_category')}>View All <MdArrowRightAlt className=\"view_icon\" /></Button> */}\r\n        </div>\r\n        <div className=\"\">\r\n          <Slider {...settings}>\r\n            {isLoading && !hasFetched ? (\r\n              skeletonArray.map(() => (\r\n                <Skeleton.Image active className=\"category_skelton\"/>\r\n              ))\r\n            ) : categoriesData.map((item) => (\r\n              <div className=\"cat_card\">\r\n                <Link\r\n                  // to={`/category/${item.categoryID}`}\r\n                  to={`/category/${manageURl(item.categoryName)}?uid=${encodeURIComponent(encryptCategoryID(item.categoryID))}`}\r\n                  target=\"_blank\"\r\n                  rel=\"noopener noreferrer\"\r\n                  onClick={(e) => {\r\n                    if (!e.ctrlKey && !e.metaKey) {\r\n                      e.preventDefault();\r\n                      // navigate(`/category/${manageURl(item.categoryName)}`, { state: item.categoryID });\r\n                      navigate(`/category/${manageURl(item.categoryName)}?uid=${encodeURIComponent(encryptCategoryID(item.categoryID))}`);\r\n                    }\r\n                  }}\r\n                >\r\n                  <Card hoverable >\r\n                    <div className=\"car_item\" key={item.categoryID}>\r\n                      {item.imageUrl != null ?\r\n                        <img\r\n                          src={item.imageUrl || DefaultLogo}\r\n                          onError={(e) => e.currentTarget.src = DefaultLogo}\r\n                        />\r\n                        :\r\n                        <img src={DefaultLogo} />\r\n                      }\r\n                    </div>\r\n                  </Card>\r\n                </Link>\r\n                <p>{titleCase(item.categoryName)}</p>\r\n              </div>\r\n            )\r\n            )}\r\n          </Slider>\r\n          {/* {categorySlice?.length != 0 && screenWidth < 1500 && !isLoading && !allView ? <div className=\"see_all\" >\r\n            <Card hoverable onClick={() => setAllView(true)}>\r\n              <h3>See All</h3>\r\n            </Card>\r\n            <p></p>\r\n          </div> : null} */}\r\n        </div>\r\n      </div>\r\n    </section >\r\n  );\r\n}\r\n\r\nexport default CategorySlider;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\segment\\ProductSegment.jsx",["1346","1347","1348","1349","1350","1351","1352","1353","1354","1355","1356","1357","1358","1359","1360","1361","1362","1363","1364","1365","1366","1367","1368"],[],"import { Badge, Button, Card, Divider, Radio, Skeleton, Space, Tag, Tooltip, notification } from \"antd\";\r\nimport React, { useEffect, useState } from \"react\";\r\nimport \"../../style/header.css\";\r\nimport { FaHeart } from \"react-icons/fa\";\r\nimport { FaRegHeart } from \"react-icons/fa\";\r\nimport { useNavigate } from \"react-router-dom\";\r\nimport { MdArrowRightAlt } from \"react-icons/md\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { addItem, removeItem, selectCartItems } from \"../../redux/CartSlice\";\r\n\r\nimport { AddProductWishlist, out_of_stock } from \"../apiService/api\";\r\nimport { useScreen } from \"../auth/AuthScreen\";\r\nimport { useAuth } from \"../auth/context/authContext\";\r\nimport BKDLogo from \"../../assest/bkdlogo.png\"\r\nimport offerAvailable from \"../../assest/png/offer_apply.png\"\r\n\r\nimport { encryptCategoryID } from \"../../config/encriptConfig\";\r\nimport { getOfferImage } from \"../../utils/offerUtils\";\r\n\r\n\r\n\r\nfunction ProductSegment({ title, showAllSegemtnList, layerDetails, isLoading }) {\r\n    const { screenWidth } = useScreen()\r\n    const { token } = useAuth()\r\n    const navigate = useNavigate();\r\n    const dispatch = useDispatch();\r\n    const cartItems = useSelector(selectCartItems);\r\n    const [wishlist, setWishlist] = useState({});\r\n    // const titleCase = str => str.replace(/\\b\\w/g, char => char.toUpperCase());\r\n    const titleCase = str => str.toLowerCase().split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');\r\n\r\n\r\n    const segmentId = layerDetails.map(item => item._id);\r\n    const titles = layerDetails.map(item => item.title);\r\n    const bannerTitle = layerDetails.flatMap(item => ({\r\n        banner: item.bigBanner,\r\n        title: item.title,\r\n    }));\r\n    const productCodes = layerDetails.flatMap(item => item.productCode);\r\n\r\n\r\n    // console.log(\"----------->products list\", productCodes)\r\n    // console.log(\"----------->layers data \", layerDetails)\r\n\r\n    // const showAllSegemtnList = async () => {\r\n    //     try {\r\n    //         await fetchBeforeCheckoutItem(nearStore?.branchCode,)\r\n    //             .then((res) => {\r\n    //                 console.log(\"segment lsit new\", res);\r\n    //                 if (res.status == 200) {\r\n    //                     // setBrandList(res.data.data)\r\n    //                     setSegmentData(res.data.data);\r\n    //                     setIsLoading(true)\r\n    //                 }\r\n    //             })\r\n    //             .catch((err) => {\r\n    //                 console.log(err);\r\n    //             });\r\n    //     } catch (error) {\r\n    //         console.log(error);\r\n    //         setIsLoading(true)\r\n    //     }\r\n    // };\r\n    // useEffect(() => {\r\n    //     if (nearStore != null) {\r\n    //         showAllSegemtnList()\r\n    //     }\r\n    // }, [])\r\n\r\n    const handleAddItem = (item) => {\r\n        dispatch(addItem(item))\r\n\r\n    };\r\n\r\n    useEffect(() => {\r\n        localStorage.setItem(\"cart\", JSON.stringify(cartItems));\r\n    }, [cartItems]);\r\n\r\n\r\n    const handleDelItem = (item) => {\r\n        dispatch(removeItem(item));\r\n        const cart = JSON.parse(localStorage.getItem(\"cart\")) || []; // Retrieve cart from localStorage\r\n        const updatedCart = cart.filter(cartItem => cartItem.productCode !== item.productCode); // Filter \r\n        localStorage.setItem(\"cart\", JSON.stringify(updatedCart))\r\n\r\n    };\r\n\r\n\r\n    const GoToSimilarProduct = (item) => {\r\n        navigate(`/product/${manageURl(item.productName)}?uid=${encodeURIComponent(encryptCategoryID(item.productCode))}`);\r\n        showAllSegemtnList()\r\n    }\r\n\r\n    const HnadleNotLogin = () => {\r\n        notification.error({\r\n            placement: \"topRight\",\r\n            message: \"Please login before add wishlist\",\r\n        });\r\n    }\r\n\r\n\r\n    const addToWishList = async (proCode) => {\r\n        setWishlist((prev) => ({ ...prev, [proCode.productCode]: true }));\r\n        const body = {\r\n            productCode: proCode.productCode,\r\n            productName: proCode.productName,\r\n            status: \"ACTIVE\"\r\n        }\r\n        try {\r\n            await AddProductWishlist(token, body)\r\n                .then((res) => {\r\n                    console.log(\"add to  wish\", res);\r\n                    if (res.status == 201) {\r\n\r\n\r\n                        if (res.data.data.whislistKey != true) {\r\n                            // notification.warning({\r\n                            //     placement: \"topRight\",\r\n                            //     message: \"Remove Product From Wishlist\",\r\n\r\n                            // });\r\n                            // showAllSegemtnList()\r\n                        } else {\r\n                            // notification.success({\r\n                            //     placement: \"topRight\",\r\n                            //     message: \"Add Product To  Wishlist\",\r\n\r\n                            // })\r\n                            // showAllSegemtnList()\r\n\r\n                        }\r\n\r\n\r\n                    }\r\n\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n                    setWishlist((prev) => ({ ...prev, [proCode]: false }));\r\n                });\r\n        } catch (error) {\r\n            setWishlist((prev) => ({ ...prev, [proCode]: false }));\r\n            console.log(error);\r\n\r\n        }\r\n    };\r\n\r\n\r\n\r\n    const RemoveToWishList = async (proCode) => {\r\n        setWishlist((prev) => ({ ...prev, [proCode.productCode]: false })); // Immediately update the icon\r\n        const body = { productCode: proCode.productCode, productName: proCode.productName, status: \"INACTIVE\" };\r\n        try {\r\n            await AddProductWishlist(token, body)\r\n                .then((res) => {\r\n                    if (res.status === 201) {\r\n\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n                    setWishlist((prev) => ({ ...prev, [proCode]: true })); // Revert the icon if the API call fails\r\n\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n            setWishlist((prev) => ({ ...prev, [proCode]: true })); // Revert the icon if the API call fails\r\n        }\r\n    };\r\n    const filterSegment = screenWidth < 1400 ? productCodes.slice(0, 6) : productCodes.slice(0, 7);\r\n    const filterSegment2 = screenWidth < 1400 ? productCodes.slice(0, 12) : productCodes.slice(0, 14);\r\n\r\n\r\n    const manageURl = (productName) => {\r\n        const sanitizedCategory = productName\r\n            .replace(/[,/&]/g, '') // Remove commas, slashes, ampersands\r\n            .replace(/\\s+/g, '-')  // Replace spaces with hyphens\r\n            .toLowerCase();\r\n        return sanitizedCategory\r\n    }\r\n    const goToProductDetails = (item) => {\r\n        navigate(`/product/${manageURl(item.productName)}?uid=${encodeURIComponent(encryptCategoryID(item.productCode))}`);\r\n    }\r\n    return (\r\n        isLoading ?\r\n            <section>\r\n                <div className=\"segment_1 my-4\">\r\n                    <Skeleton loading={true} active />\r\n                </div>\r\n            </section>\r\n            : (layerDetails?.length !== 0 && productCodes?.length !== 0) ?\r\n                <section>\r\n                    <div className=\"segment_1 my-4\">\r\n                        <div className=\"card_section\">\r\n                            <div className=\"card_section_title\">\r\n                                <p>{filterSegment?.length != 0 ? titles : null}</p>\r\n                                {filterSegment?.length != 0 ?\r\n                                    <Button\r\n                                        type=\"link\"\r\n                                        shape=\"round\"\r\n                                        onClick={() => navigate(`/segment-detials/${segmentId}`, { state: bannerTitle })}\r\n                                    >\r\n                                        View All <MdArrowRightAlt className=\"view_icon\" />\r\n                                    </Button>\r\n                                    : null\r\n                                }\r\n                            </div>\r\n                            <div className=\"prodcut_slider\">\r\n                                <div className={`${layerDetails?.length !== 0 && \"showing_pro_by_cat\"}`}>\r\n                                    {title == 1 ? filterSegment.map((item) => (\r\n                                        <div className=\"product_card individual_card\" key={item.productCode}>\r\n                                            <Card\r\n                                                hoverable\r\n                                                disabled={item.stockQty == 0 && true}\r\n                                            >\r\n                                                <div className=\"card_img\">\r\n                                                    {item.imageUrl[0] != null ?\r\n                                                        <img\r\n                                                            className={item.stockQty <= out_of_stock ? \"out_of_stock_img\" : \"\"}\r\n                                                            src={item.imageUrl[0] || BKDLogo}\r\n                                                            onError={(e) => e.currentTarget.src = BKDLogo}\r\n                                                            onClick={() => GoToSimilarProduct(item)}\r\n                                                        />\r\n                                                        :\r\n                                                        <img\r\n                                                            className={item.stockQty <= out_of_stock ? \"out_of_stock_img\" : \"\"}\r\n                                                            src={BKDLogo}\r\n                                                            onClick={() => GoToSimilarProduct(item)}\r\n                                                        />\r\n                                                    }\r\n                                                </div>\r\n\r\n                                                <div className=\"pro_name\" onClick={() => goToProductDetails(item)}>\r\n                                                    <Tooltip title={titleCase(item.productName)}>\r\n                                                        <p>\r\n                                                            {item.productName.length > 30\r\n                                                                ? titleCase(item.productName.slice(0, 36)) + \"...\"\r\n                                                                : titleCase(item.productName)}\r\n                                                        </p>\r\n                                                    </Tooltip>\r\n                                                </div>\r\n                                                <div className=\"show_variant_item\" onClick={() => goToProductDetails(item)}>\r\n                                                    {item.packSize && item.packSize !== \"(NIL)\" ? <Tag color='green'>{item.packSize}</Tag> : <p className=\"hidden_data\">N/A</p>}\r\n                                                    {item.stockQty <= out_of_stock ? <Tag color='red' className=\"stock_tag\">out of stock</Tag> : <p className='hidden_data'>N/A</p>}\r\n                                                </div>\r\n                                                <div className=\"show_price_mrp\">\r\n                                                    <p>BKD Price | MRP</p>\r\n                                                </div>\r\n                                                <div className=\"add_cart\">\r\n                                                    <p>{`₹ ${Math.round(item.bkdAmount)} `} <span>{item.bkdAmount != item.price && <del>₹ {item.price}</del>}</span> </p>\r\n                                                    {cartItems.find((cartItem) => cartItem.productCode === item.productCode) ? (\r\n                                                        cartItems.map((cartItem) => {\r\n                                                            if (cartItem.productCode === item.productCode) {\r\n                                                                return (\r\n                                                                    <Button.Group size={screenWidth < 800 ? \"\" : 'small'} key={cartItem.productCode}>\r\n                                                                        <Button className=\"add_to_carts add_to_cart_button\" onClick={() => handleDelItem(item)}>-</Button>\r\n                                                                        <Button className=\"add_to_carts add_to_cart_button\">{cartItem.unit}</Button> {/* Access quantity from cart item */}\r\n                                                                        <Button className=\"add_to_carts add_to_cart_button\" onClick={() => handleAddItem(item)}>+</Button>\r\n                                                                    </Button.Group>\r\n                                                                );\r\n                                                            }\r\n                                                            return null;\r\n                                                        })\r\n                                                    ) : (\r\n                                                        <Button className=\"add_to_carts\" disabled={item.stockQty <= out_of_stock} type=\"default\" onClick={() => handleAddItem(item)}>ADD</Button>\r\n                                                    )}\r\n                                                </div>\r\n                                            </Card>\r\n                                            {/* {item.bkdAmount != item.price ? <div className=\"cat_tags\">{Math.round((item.price - item.bkdAmount) * 100 / item.price)}% off</div> : null} */}\r\n                                            {item.billingQty === \"PROMOTIONS\" || item.billingQty === \"DISCOUNT\" || item.offerQty === \"PROMOTIONS\" || item.offerQty === \"DISCOUNT\" ?\r\n                                                <div className=\"discount_tags\">Super Saver Price</div>\r\n                                                :\r\n                                                item.billingQty !== \"\" && item.offerQty !== \"\" ?\r\n                                                    <div className=\"offer_Available\">\r\n                                                        {(item.billingQty === \"FOC\" || item.offerQty === \"FOC\") ?\r\n                                                            <>\r\n                                                                <img src={offerAvailable} />\r\n                                                                <div className=\"offer_types\">\r\n                                                                    <p>1 Item</p>\r\n                                                                    <p>Free </p>\r\n                                                                    <p>On MRP</p>\r\n                                                                </div>\r\n                                                            </>\r\n                                                            :\r\n                                                            <img src={getOfferImage(item?.offerQty)} />\r\n                                                        }\r\n                                                    </div>\r\n                                                    :\r\n                                                    Math.round(item.bkdAmount) != item.price ?\r\n                                                        <div className=\"cat_tags\">{Math.round((item.price - item.bkdAmount) * 100 / item.price)}% off</div>\r\n                                                        : null\r\n                                            }\r\n                                            <div className=\"wish_list\">\r\n                                                {token ?\r\n                                                    <div className='wish_list'>\r\n                                                        {\r\n                                                            wishlist[item.productCode] || item.isWhislist ? (\r\n                                                                <FaHeart\r\n                                                                    className=\"no_wish_icon\"\r\n                                                                    size={22}\r\n                                                                    color='red'\r\n                                                                    onClick={() => RemoveToWishList(item)}\r\n                                                                />\r\n                                                            ) : (\r\n                                                                <FaRegHeart\r\n                                                                    className=\"no_wish_icon\"\r\n                                                                    size={22}\r\n                                                                    onClick={() => addToWishList(item)}\r\n                                                                />\r\n                                                            )\r\n                                                        }\r\n                                                    </div>\r\n\r\n                                                    :\r\n                                                    <div className='wish_list'>\r\n                                                        <FaRegHeart\r\n                                                            className=\"no_wish_icon\"\r\n                                                            size={22}\r\n                                                            onClick={HnadleNotLogin}\r\n                                                        />\r\n                                                    </div>\r\n                                                }\r\n                                            </div>\r\n                                        </div>\r\n                                    )) : filterSegment2.map((item) => (\r\n                                        <div className=\"product_card individual_card\" key={item.productCode}>\r\n                                            <Card\r\n                                                hoverable\r\n                                                disabled={item.stockQty == 0 && true}\r\n                                            >\r\n                                                <div className=\"card_img\">\r\n                                                    {item?.imageUrl[0] != null ?\r\n                                                        <img\r\n                                                            className={item.stockQty <= out_of_stock ? \"out_of_stock_img\" : \"\"}\r\n                                                            src={item.imageUrl[0] || BKDLogo}\r\n                                                            onError={(e) => e.currentTarget.src = BKDLogo}\r\n                                                            onClick={() => GoToSimilarProduct(item)}\r\n                                                        />\r\n                                                        :\r\n                                                        <img\r\n                                                            className={item.stockQty <= out_of_stock ? \"out_of_stock_img\" : \"\"}\r\n                                                            src={BKDLogo}\r\n                                                            onClick={() => goToProductDetails(item)}\r\n                                                        />\r\n                                                    }\r\n                                                </div>\r\n\r\n                                                <div className=\"pro_name\" onClick={() => goToProductDetails(item)}>\r\n                                                    <Tooltip title={titleCase(item.productName)}>\r\n                                                        <p>{item.productName.length > 36 ? titleCase(item.productName.slice(0, 36)) + \"...\" : titleCase(item.productName)}</p>\r\n                                                    </Tooltip>\r\n                                                </div>\r\n                                                <div className=\"show_variant_item\" onClick={() => goToProductDetails(item)}>\r\n                                                    {item.packSize && item.packSize !== \"(NIL)\" ? <Tag color='green'>{item.packSize.substr(0, 10)}</Tag> : <p className=\"hidden_data\">N/A</p>}\r\n                                                    {item.stockQty <= out_of_stock ? <Tag color='red' className=\"stock_tag\">out of stock</Tag> : <p className='hidden_data'>N/A</p>}\r\n                                                </div>\r\n                                                <div className=\"show_price_mrp\">\r\n                                                    <p>BKD Price | MRP</p>\r\n                                                </div>\r\n                                                <div className=\"add_cart\">\r\n                                                    <p>{`₹ ${Math.round(item.bkdAmount)} `} <span>{item.bkdAmount != item.price && <del>₹ {item.price}</del>}</span> </p>\r\n\r\n                                                    {cartItems.find((cartItem) => cartItem.productCode === item.productCode) ? (\r\n                                                        cartItems.map((cartItem) => {\r\n                                                            if (cartItem.productCode === item.productCode) {\r\n                                                                return (\r\n                                                                    <Button.Group size={screenWidth < 800 ? \"\" : 'small'} key={cartItem.productCode}>\r\n                                                                        <Button className=\"add_to_carts add_to_cart_button\" onClick={() => handleDelItem(item)}>-</Button>\r\n                                                                        <Button className=\"add_to_carts add_to_cart_button\" >{cartItem.unit}</Button> {/* Access quantity from cart item */}\r\n                                                                        <Button className=\"add_to_carts add_to_cart_button\" onClick={() => handleAddItem(item)}>+</Button>\r\n                                                                    </Button.Group>\r\n                                                                );\r\n                                                            }\r\n                                                            return null;\r\n                                                        })\r\n                                                    ) : (\r\n                                                        <Button className=\"add_to_carts\" disabled={item.stockQty <= out_of_stock} type=\"default\" onClick={() => handleAddItem(item)}>ADD</Button>\r\n                                                    )}\r\n                                                </div>\r\n                                            </Card>\r\n                                            {/* {item.bkdAmount != item.price ? <div className=\"cat_tags\">{Math.round((item.price - item.bkdAmount) * 100 / item.price)}% off</div> : null} */}\r\n                                            {item.billingQty === \"PROMOTIONS\" || item.billingQty === \"DISCOUNT\" || item.offerQty === \"PROMOTIONS\" || item.offerQty === \"DISCOUNT\" ?\r\n                                                <div className=\"discount_tags\">Super Saver Price</div>\r\n                                                :\r\n                                                item.billingQty !== \"\" && item.offerQty !== \"\" ?\r\n                                                    <div className=\"offer_Available\">\r\n                                                        {(item.billingQty === \"FOC\" || item.offerQty === \"FOC\") ?\r\n                                                            <>\r\n                                                                <img src={offerAvailable} />\r\n                                                                <div className=\"offer_types\">\r\n                                                                    <p>1 Item</p>\r\n                                                                    <p>Free </p>\r\n                                                                    <p>On MRP</p>\r\n                                                                </div>\r\n                                                            </>\r\n                                                            :\r\n                                                            <img src={getOfferImage(item?.offerQty)} />\r\n                                                        }\r\n                                                    </div>\r\n                                                    :\r\n                                                    Math.round(item.bkdAmount) != item.price ?\r\n                                                        <div className=\"cat_tags\">{Math.round((item.price - item.bkdAmount) * 100 / item.price)}% off</div>\r\n                                                        : null\r\n                                            }\r\n                                            <div className=\"wish_list\">\r\n                                                {token ?\r\n                                                    <div className='wish_list'>\r\n                                                        {\r\n                                                            wishlist[item.productCode] || item.isWhislist ? (\r\n                                                                <FaHeart\r\n                                                                    className=\"no_wish_icon\"\r\n                                                                    size={22}\r\n                                                                    color='red'\r\n                                                                    onClick={() => RemoveToWishList(item)}\r\n                                                                />\r\n                                                            ) : (\r\n                                                                <FaRegHeart\r\n                                                                    className=\"no_wish_icon\"\r\n                                                                    size={22}\r\n                                                                    onClick={() => addToWishList(item)}\r\n                                                                />\r\n                                                            )\r\n                                                        }\r\n                                                    </div>\r\n                                                    :\r\n                                                    <div className='wish_list'>\r\n                                                        <FaRegHeart\r\n                                                            className=\"no_wish_icon\"\r\n                                                            size={22}\r\n                                                            onClick={HnadleNotLogin}\r\n                                                        />\r\n                                                    </div>\r\n                                                }\r\n                                            </div>\r\n                                        </div>\r\n                                    ))}\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </section>\r\n                :\r\n                null\r\n    );\r\n}\r\n\r\n\r\n\r\nexport default ProductSegment","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\home\\TrendingBrand.jsx",["1369","1370","1371","1372"],[],"import { Skeleton, Tooltip, } from \"antd\";\r\nimport React, { useEffect, useState } from \"react\";\r\nimport Slider from \"react-slick\";\r\nimport \"../../style/home.css\";\r\nimport { Link, useNavigate } from \"react-router-dom\";\r\nimport { TopTrendingBrand } from \"../apiService/api\";\r\nimport DefaultLogo from \"../../assest/bkdlogo.png\"\r\nimport { useCurrentLocation } from \"../auth/AuthScreen\";\r\nimport { DotChartOutlined } from '@ant-design/icons';\r\nimport { encryptCategoryID } from \"../../config/encriptConfig\";\r\n\r\n\r\nfunction TrendingBrand({ screenWidth, title }) {\r\n  const { userLocation } = useCurrentLocation();\r\n\r\n  const [brandList, setBrandList] = useState([]);\r\n\r\n  const [loading, setLoading] = useState(false);\r\n  const titleCase = str => str.toLowerCase().split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');\r\n\r\n\r\n  const navigate = useNavigate()\r\n  const settings = {\r\n    dots: false,\r\n    adaptiveHeight: true,\r\n    infinite: true,\r\n    speed: 800,\r\n    arrows: true,\r\n    slidesToShow: screenWidth < 876 ? 4 : 12,\r\n\r\n    slidesToScroll: 1,\r\n    autoplay: true,\r\n    loop: true,\r\n    autoplaySpeed: 3000,\r\n    draggable: true,\r\n    swipeToSlide: true,\r\n    swipe: true,\r\n  };\r\n\r\n  const showAllBrandList = async () => {\r\n    setLoading(true)\r\n    try {\r\n      await TopTrendingBrand()\r\n        .then((res) => {\r\n          // console.log(\"trending brand\", res);\r\n          if (res.status == 200) {\r\n            // setBrandList(res.data.data)\r\n            setBrandList(res.data.data);\r\n            setLoading(false)\r\n          }\r\n\r\n        })\r\n        .catch((err) => {\r\n          console.log(err);\r\n        });\r\n    } catch (error) {\r\n      console.log(error);\r\n      setLoading(false)\r\n\r\n    }\r\n  };\r\n  useEffect(() => {\r\n    showAllBrandList()\r\n  }, [userLocation])\r\n\r\n\r\n  const manageURl = (name) => {\r\n    const sanitizedCategory = name\r\n      .replace(/[,/&]/g, '') // Remove commas, slashes, ampersands\r\n      .replace(/\\s+/g, '-')  // Replace spaces with hyphens\r\n      .toLowerCase();\r\n    return sanitizedCategory\r\n  }\r\n  return (\r\n    <section>\r\n      <div className=\"card_section my-4\">\r\n        <div className=\"card_section_title\">\r\n          {brandList?.length != 0 ? <p>Trending Brand</p> : null}\r\n\r\n        </div>\r\n        <Slider {...settings}>\r\n          {loading ? (\r\n            <div className=\"trending-brand\">\r\n              {new Array(12).fill(0).map((_, index) => (\r\n                <Skeleton.Node key={index} active style={{ borderRadius: \"100%\" }}>\r\n                  <DotChartOutlined style={{ fontSize: 40, color: '#bfbfbf' }} />\r\n                </Skeleton.Node>\r\n              ))}\r\n            </div>\r\n          ) : brandList.map((item) => (\r\n            <div className=\"brand_card\" key={item.brandID}>\r\n              <Link\r\n                to={`/brand-product/${manageURl(item.brandName)}?uid=${encodeURIComponent(encryptCategoryID(item.brandId))}`}\r\n                target=\"_blank\"\r\n                rel=\"noopener noreferrer\"\r\n                onClick={(e) => {\r\n                  // Prevent default behavior for left-click\r\n                  if (!e.ctrlKey && !e.metaKey) {\r\n                    e.preventDefault();\r\n                    navigate(`/brand-product/${manageURl(item.brandName)}?uid=${encodeURIComponent(encryptCategoryID(item.brandId))}`)\r\n                  }\r\n                }}\r\n              >\r\n\r\n                <div className=\"brand\">\r\n                  {item.imageUrl != null ?\r\n                    <img\r\n                      src={item.imageUrl || DefaultLogo}\r\n                      onError={(e) => e.currentTarget.src = DefaultLogo}\r\n                    />\r\n                    :\r\n                    <img src={DefaultLogo} />\r\n                  }\r\n                </div>\r\n              </Link>\r\n              <div className=\"brand_title\">\r\n                <Tooltip title={titleCase(item.brandName)}>\r\n                  <p>{item.brandName.length > 8 ? titleCase(item.brandName.slice(0, 8)) + \"...\" : titleCase(item.brandName)}</p>\r\n                </Tooltip>\r\n              </div>\r\n\r\n            </div>\r\n          ))}\r\n        </Slider>\r\n      </div>\r\n    </section>\r\n  );\r\n}\r\n\r\n\r\n\r\nexport default TrendingBrand","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\segment\\AllSegment.jsx",["1373"],[],"// import React, { useEffect, useState } from 'react'\r\n// import FirstSegment from './ProductSegment'\r\n// import CardSegment from './CardSegment'\r\n// import BannerSegment from './BannerSegment'\r\n// import DualCardSegment from './DualCardSegment'\r\n// import { fetchCustomSegment } from '../apiService/api'\r\n// import { Card, Skeleton } from 'antd'\r\n// import { useCurrentLocation } from '../auth/AuthScreen'\r\n// import { useAuth } from '../auth/context/authContext'\r\n\r\n// function AllSegment() {\r\n//     const { nearStore } = useAuth()\r\n\r\n//     const { userLocation, setUserLocation } = useCurrentLocation();\r\n//     const [segmentData, setSegmentData] = useState([])\r\n//     const [isLoading, setIsLoading] = useState(false)\r\n//     const skeletonArray = new Array(18).fill(0);\r\n\r\n\r\n\r\n//     const showAllSegemtnList = async () => {\r\n//         setIsLoading(true)\r\n//         try {\r\n//             await fetchCustomSegment(nearStore?.branchCode,)\r\n//                 .then((res) => {\r\n//                     console.log(\"segment  list\", res);\r\n//                     if (res.status == 200) {\r\n//                         setSegmentData(res.data.data);\r\n//                         setIsLoading(false)\r\n//                     }\r\n//                 })\r\n//                 .catch((err) => {\r\n//                     console.log(err);\r\n//                 });\r\n//         } catch (error) {\r\n//             console.log(error);\r\n//             setIsLoading(false)\r\n//         }\r\n//     };\r\n//     useEffect(() => {\r\n//         if (nearStore) {\r\n//             showAllSegemtnList()\r\n//         }\r\n//     }, [userLocation, nearStore])\r\n\r\n//     return (\r\n//         <secton>\r\n//             {isLoading\r\n//                 ?\r\n//                 <div className='showing_pro_by_cat'>\r\n//                     {skeletonArray.map(() => (\r\n//                         <Card size='small' className='mt-3 mx-2'>\r\n//                             <Skeleton.Image active />\r\n//                             <Skeleton active paragraph={{ row: 6 }} />\r\n//                         </Card>\r\n//                     ))}\r\n//                 </div>\r\n//                 : <div className=\"show_all_segement\">\r\n//                     {segmentData?.map((item) => {\r\n//                         if (item.layer === \"Layer1\") {\r\n//                             return <FirstSegment layerDetails={item.layerDetails} title={1} showAllSegemtnList={showAllSegemtnList} isLoading={isLoading} />\r\n//                         } else if (item?.layer === \"Layer2\") {\r\n//                             return <CardSegment layerDetails={item.layerDetails} showAllSegemtnList={showAllSegemtnList} isLoading={isLoading} />\r\n//                         } else if (item?.layer === \"Layer3\") {\r\n//                             return <FirstSegment layerDetails={item.layerDetails} title={2} showAllSegemtnList={showAllSegemtnList} isLoading={isLoading} />\r\n//                         } else if (item?.layer === \"Layer4\") {\r\n//                             return <BannerSegment layerDetails={item.layerDetails} showAllSegemtnList={showAllSegemtnList} isLoading={isLoading} />\r\n//                         } else if (item?.layer === \"Layer5\") {\r\n//                             return <CardSegment layerDetails={item.layerDetails} showAllSegemtnList={showAllSegemtnList} isLoading={isLoading} />\r\n//                         } else if (item?.layer === \"Layer6\") {\r\n//                             return <FirstSegment layerDetails={item.layerDetails} title={1} showAllSegemtnList={showAllSegemtnList} isLoading={isLoading} />\r\n//                         } else if (item?.layer === \"Layer7\") {\r\n//                             return <DualCardSegment layerDetails={item.layerDetails} showAllSegemtnList={showAllSegemtnList} isLoading={isLoading} />\r\n//                         }\r\n//                         else if (item.layer === \"Layer8\") {\r\n//                             return <FirstSegment layerDetails={item.layerDetails} title={1} showAllSegemtnList={showAllSegemtnList} isLoading={isLoading} />\r\n//                         } else if (item?.layer === \"Layer9\") {\r\n//                             return <CardSegment layerDetails={item.layerDetails} showAllSegemtnList={showAllSegemtnList} isLoading={isLoading} />\r\n//                         } else if (item?.layer === \"Layer10\") {\r\n//                             return <FirstSegment layerDetails={item.layerDetails} title={2} showAllSegemtnList={showAllSegemtnList} isLoading={isLoading} />\r\n//                         } else if (item?.layer === \"Layer11\") {\r\n//                             return <BannerSegment layerDetails={item.layerDetails} showAllSegemtnList={showAllSegemtnList} isLoading={isLoading} />\r\n//                         } else if (item?.layer === \"Layer12\") {\r\n//                             return <CardSegment layerDetails={item.layerDetails} showAllSegemtnList={showAllSegemtnList} isLoading={isLoading} />\r\n//                         } else if (item?.layer === \"Layer13\") {\r\n//                             return <FirstSegment layerDetails={item.layerDetails} title={1} showAllSegemtnList={showAllSegemtnList} isLoading={isLoading} />\r\n//                         } else if (item?.layer === \"Layer14\") {\r\n//                             return <DualCardSegment layerDetails={item.layerDetails} showAllSegemtnList={showAllSegemtnList} isLoading={isLoading} />\r\n//                         }\r\n//                     })}\r\n\r\n//                 </div>\r\n//             }\r\n//         </secton>\r\n//     )\r\n// }\r\n\r\n// export default AllSegment\r\n\r\nimport React, { useEffect, useState, useRef } from 'react';\r\nimport FirstSegment from './ProductSegment';\r\nimport CardSegment from './CardSegment';\r\nimport BannerSegment from './BannerSegment';\r\nimport DualCardSegment from './DualCardSegment';\r\nimport { fetchCustomSegment } from '../apiService/api';\r\nimport { Card, Skeleton } from 'antd';\r\nimport { useCurrentLocation } from '../auth/AuthScreen';\r\nimport { useAuth } from '../auth/context/authContext';\r\n\r\nfunction AllSegment() {\r\n    const { nearStore } = useAuth();\r\n    const { userLocation } = useCurrentLocation();\r\n\r\n    const [segmentData, setSegmentData] = useState([]);\r\n    const [isLoading, setIsLoading] = useState(false);\r\n    const isFirstCall = useRef(true); // Prevent duplicate calls\r\n    const skeletonArray = new Array(18).fill(0);\r\n\r\n    const showAllSegmentList = async () => {\r\n        if (!nearStore?.branchCode || !isFirstCall.current) return; // Avoid duplicate API calls\r\n        isFirstCall.current = false; // Mark first API call as done\r\n        setIsLoading(true);\r\n\r\n        try {\r\n            const res = await fetchCustomSegment(nearStore.branchCode);\r\n            if (res.status === 200) {\r\n                setSegmentData(res.data.data);\r\n            }\r\n        } catch (error) {\r\n            console.error(error);\r\n        } finally {\r\n            setIsLoading(false);\r\n        }\r\n    };\r\n\r\n    useEffect(() => {\r\n        if (nearStore) {\r\n            showAllSegmentList();\r\n        }\r\n    }, [nearStore, userLocation]);\r\n\r\n\r\n    return (\r\n        <section>\r\n            {isLoading ? (\r\n                <div className=\"showing_pro_by_cat\">\r\n                    {skeletonArray.map((_, index) => (\r\n                        <Card key={index} size=\"small\" className=\"mt-3 mx-2\">\r\n                            <Skeleton.Image active />\r\n                            <Skeleton active paragraph={{ row: 6 }} />\r\n                        </Card>\r\n                    ))}\r\n                </div>\r\n            ) : (\r\n                <div className=\"show_all_segment\">\r\n                    {segmentData?.map((item, index) => {\r\n                        const commonProps = {\r\n                            key: index,\r\n                            layerDetails: item.layerDetails,\r\n                            showAllSegmentList,\r\n                            isLoading,\r\n                        };\r\n\r\n                        switch (item.layer) {\r\n                            case \"Layer1\":\r\n                            case \"Layer6\":\r\n                            case \"Layer8\":\r\n                            case \"Layer13\":\r\n                                return <FirstSegment {...commonProps} title={1} />;\r\n                            case \"Layer3\":\r\n                            case \"Layer10\":\r\n                                return <FirstSegment {...commonProps} title={2} />;\r\n                            case \"Layer2\":\r\n                            case \"Layer5\":\r\n                            case \"Layer9\":\r\n                            case \"Layer12\":\r\n                                return <CardSegment {...commonProps} />;\r\n                            case \"Layer4\":\r\n                            case \"Layer11\":\r\n                                return <BannerSegment {...commonProps} />;\r\n                            case \"Layer7\":\r\n                            case \"Layer14\":\r\n                                return <DualCardSegment {...commonProps} />;\r\n                            default:\r\n                                return null;\r\n                        }\r\n                    })}\r\n                </div>\r\n            )}\r\n        </section>\r\n    );\r\n}\r\n\r\nexport default AllSegment;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\checkout\\OrderPlace.jsx",["1374","1375","1376","1377"],[],"import React, { useEffect, useState } from \"react\";\r\nimport { Button, Divider, Modal } from \"antd\";\r\nimport \"../../style/checkout.css\";\r\n\r\nimport { useNavigate } from \"react-router-dom\";\r\nimport PaymentSuccess from \"../../assest/pay-success.gif\"\r\nimport { useDispatch } from \"react-redux\";\r\nimport { clearCart, setSelctedOffer } from \"../../redux/CartSlice\";\r\nimport { addProduct, setDeliveryCahrge, setDeliveryLocation, setDeliveryType, setDiscountAmount, setDiscountDetails, setPayableAmount, setPaymentMode, setSubTotalAmount } from \"../../redux/OrderSlice\";\r\n\r\nconst OrderPlace = ({ orderPlaced, orderPlaceData }) => {\r\n  const [isModalOpen, setIsModalOpen] = useState(false);\r\n  const [isOrderPlaced, setIsOrderPlaced] = useState(false);\r\n  const navigate = useNavigate();\r\n\r\n  const dispatch = useDispatch()\r\n\r\n  useEffect(() => {\r\n    if (orderPlaced == true) {\r\n      showModal()\r\n    }\r\n  }, [orderPlaced])\r\n\r\n  const showModal = () => {\r\n    setIsModalOpen(true);\r\n  };\r\n  const handleOk = () => {\r\n    setIsModalOpen(false);\r\n  };\r\n  const handleCancel = () => {\r\n    setIsModalOpen(false);\r\n    navigate('/')\r\n  };\r\n  setTimeout(() => {\r\n    setIsOrderPlaced(true);\r\n  }, 5000);\r\n\r\n  const handelgotoHome = () => {\r\n    localStorage.removeItem(\"delivery_location\")\r\n    localStorage.removeItem(\"orderType\")\r\n    localStorage.removeItem(\"payment_mode\")\r\n    localStorage.removeItem(\"cart\")\r\n    dispatch(clearCart())\r\n    dispatch(setDeliveryCahrge(0))\r\n\r\n    dispatch(setDeliveryLocation(null))\r\n    dispatch(setDiscountDetails(null))\r\n    dispatch(setDiscountAmount(0))\r\n    dispatch(addProduct(null))\r\n    dispatch(setSubTotalAmount(null))\r\n    dispatch(setDeliveryType(null))\r\n    dispatch(setPaymentMode(null))\r\n    dispatch(setPayableAmount(0))\r\n    dispatch(setSelctedOffer(null))\r\n    navigate('/')\r\n  }\r\n  const handlegotoOrder = () => {\r\n    localStorage.removeItem(\"delivery_location\")\r\n    localStorage.removeItem(\"orderType\")\r\n    localStorage.removeItem(\"payment_mode\")\r\n    localStorage.removeItem(\"cart\")\r\n    localStorage.removeItem(\"updatedeliveryCharge\")\r\n    localStorage.removeItem(\"selected_Store\")\r\n    localStorage.removeItem(\"saveAmount\")\r\n    localStorage.removeItem(\"payment_mode\")\r\n    localStorage.removeItem(\"paybleAmount\")\r\n    localStorage.removeItem(\"discountAmount\")\r\n    localStorage.removeItem(\"actualAmount\")\r\n    dispatch(clearCart())\r\n    dispatch(setDeliveryLocation(null))\r\n    dispatch(setDeliveryCahrge(0))\r\n    dispatch(setDiscountDetails(null))\r\n    dispatch(setDiscountAmount(0))\r\n    dispatch(addProduct(null))\r\n    dispatch(setSubTotalAmount(null))\r\n    dispatch(setDeliveryType(null))\r\n    dispatch(setPaymentMode(null))\r\n    dispatch(setPayableAmount(0))\r\n    dispatch(setSelctedOffer(null))\r\n    navigate(`/account/order`)\r\n  }\r\n\r\n  return (\r\n    <>\r\n\r\n      <Modal\r\n        footer={false}\r\n        closable={false}\r\n        open={isModalOpen}\r\n        closeIcon={false}\r\n        onOk={handleOk}\r\n        onCancel={handleCancel}\r\n        maskClosable={false}\r\n      >\r\n        <div className=\"order_place_data\">\r\n          <div className=\"order_place ordered_place\">\r\n            <img src={PaymentSuccess} />\r\n            <h4>Order Placed !!</h4>\r\n          </div>\r\n          <div className=\"loc_placeed\">\r\n            <p>Order Id: {orderPlaceData?.data?.orderCode}</p>\r\n            <p>{orderPlaceData?.message} </p>\r\n          </div>\r\n        </div>\r\n\r\n        <div className=\"ordered_track\">\r\n          <Button size=\"large\" onClick={handlegotoOrder}>My Order</Button>\r\n\r\n          <Button size=\"large\" onClick={handelgotoHome}>Go Home</Button>\r\n        </div >\r\n      </Modal >\r\n\r\n    </>\r\n  );\r\n};\r\n\r\nexport default OrderPlace;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\cart\\ShopCards.jsx",["1378","1379","1380","1381"],[],"\r\nimport React, { useEffect, useState } from 'react';\r\nimport { Button, Modal, Spin } from 'antd';\r\nimport \"../../style/order.css\"\r\nimport { MdStorefront } from 'react-icons/md';\r\nimport { Avatar, Card } from 'antd';\r\nimport { BKDNearSote } from '../apiService/api';\r\nimport ShowMoreText from 'react-show-more-text';\r\nimport { useDispatch } from 'react-redux';\r\nimport { setBranchDetails, setSelectedStore, setSlotDetails } from '../../redux/OrderSlice';\r\nimport { useCurrentLocation } from '../auth/AuthScreen';\r\nimport BKDLogo from \"../../assest/bkdlogo.png\";\r\n\r\nconst { Meta } = Card;\r\nconst ShopCards = ({ setSelectedShop }) => {\r\n  const [isModalOpen, setIsModalOpen] = useState(false);\r\n  const [storeList, setStoreList] = useState([])\r\n  const [isStoreLoading, setIsStoreLoading] = useState(false);\r\n  const dispatch = useDispatch()\r\n  const { userLocation } = useCurrentLocation()\r\n  function executeOnClick(isExpanded) {\r\n    console.log(isExpanded);\r\n  }\r\n  const showModal = () => {\r\n    setIsModalOpen(true);\r\n  };\r\n  const handleOk = () => {\r\n    setIsModalOpen(false);\r\n  };\r\n  const handleCancel = () => {\r\n    setIsModalOpen(false);\r\n  };\r\n\r\n  // const currentLocation = JSON.parse(localStorage.getItem(\"location\"))\r\n\r\n  const ShowBKDStoreList = async () => {\r\n    setIsStoreLoading(true);\r\n\r\n    try {\r\n      const res = await BKDNearSote(userLocation?.geometry?.location?.lat, userLocation?.geometry?.location?.lng);\r\n\r\n      if (res.status == 200) {\r\n        setStoreList(res.data.data);\r\n      }\r\n    } catch (error) {\r\n      console.log(error);\r\n    } finally {\r\n      setIsStoreLoading(false);\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    if (isModalOpen) {\r\n      ShowBKDStoreList();\r\n    }\r\n  }, [isModalOpen]);\r\n\r\n  const hanhleShopChoose = (store) => {\r\n    console.log(\"store\", store)\r\n    dispatch(setSelectedStore(store));\r\n    localStorage.setItem(\"selected_Store\", JSON.stringify(store))\r\n    setSelectedShop(true)\r\n    handleCancel()\r\n    dispatch(setSlotDetails(null))\r\n    localStorage.removeItem(\"selected_slot\")\r\n  }\r\n\r\n  return (\r\n    <>\r\n      <Button\r\n        block\r\n        icon={<MdStorefront className=\"chek_icon\" />}\r\n        onClick={showModal}\r\n      >\r\n        Choose Near BKD Store\r\n      </Button>\r\n\r\n      <Modal width={600} title=\"Select Nearest BKD Store\" open={isModalOpen} onOk={handleOk} onCancel={handleCancel} footer={false}>\r\n        {isStoreLoading ? (\r\n          <div className=\"text-center\" style={{ margin: '30px 0' }}>\r\n            <Spin />\r\n          </div>\r\n        ) : (\r\n          <div className=\"show_shop_list\">\r\n            {storeList.map((store) => (\r\n\r\n              <Card hoverable\r\n                style={{\r\n                  // background: \"#F2F2F3\"\r\n                }}\r\n                cover={\r\n                  <img\r\n                    alt=\"example\"\r\n                    src={store.branchImage || BKDLogo}\r\n                    onError={(e) => e.currentTarget.src = BKDLogo}\r\n                    id='shop_img'\r\n                  />\r\n                }\r\n                actions={[\r\n                  <span>{store.distance.toFixed(1)} KM</span>,\r\n                  <Button id='shop_choose_btn' shape='round' onClick={() => hanhleShopChoose(store)}>Choose</Button>\r\n\r\n                ]}\r\n              >\r\n                <Meta\r\n                  title={<div>\r\n                    <p>{store.branchCode}</p>\r\n                    <p>{store.branchName}</p>\r\n                  </div>}\r\n                  description={<div>\r\n                    <ShowMoreText\r\n                      lines={1} // Display only 2 lines before truncating\r\n                      more={<span className=\"View_more\">View more</span>}\r\n                      less={<span className=\"View_more\">View less</span>}\r\n\r\n                      anchorClass=\"show-more-less-clickable\"\r\n                      onClick={executeOnClick}\r\n                      expanded={false}\r\n                      //  width={200}\r\n                      truncatedEndingComponent={\"... \"}\r\n                    >\r\n\r\n                      <p>{store.fullAddress}</p>\r\n                    </ShowMoreText>\r\n                  </div>}\r\n                />\r\n              </Card>\r\n            ))}\r\n          </div>\r\n        )}\r\n      </Modal>\r\n    </>\r\n  );\r\n};\r\n\r\n\r\nexport default ShopCards;","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\Product\\ZoomProduct.jsx",["1382","1383","1384","1385","1386","1387","1388","1389","1390","1391"],[],"import React, { useEffect, useState } from \"react\";\r\nimport ReactImageZoom from \"react-image-zoom\";\r\nimport { Button, Card, Divider } from \"antd\";\r\nimport \"../../style/product.css\";\r\nimport { useScreen } from \"../auth/AuthScreen\";\r\nimport Slider from \"react-slick\";\r\nimport BKDLogo from \"../../assest/bkdlogo.png\"\r\nimport offerAvailable from \"../../assest/png/offer_apply.png\"\r\nimport { getOfferImage } from \"../../utils/offerUtils\";\r\n\r\nfunction ZoomProduct({ productInfo }) {\r\n  const { screenWidth } = useScreen()\r\n  const imageUrls = productInfo?.imageUrl ?? [];  // Ensure imageUrls is an array\r\n  const defaulturl = imageUrls.length > 0 ? imageUrls[0] : BKDLogo;\r\n  const [urls, setUrls] = useState(\"\");\r\n  const props = {\r\n    width: screenWidth < 500 ? 200 : 400,\r\n    height: screenWidth < 500 ? 200 : 450,\r\n    style: {\r\n      borderRadius: '10px',\r\n      // aspectRatio:\"2/4\",\r\n      objectFit: \"contain\",\r\n      zIndex: .8,\r\n    },\r\n    scale: 1,\r\n    img: urls == \"\" ? defaulturl : urls,\r\n    zoomPosition: screenWidth > 800 ? \"right\" : \"bottom\",\r\n\r\n  };\r\n  const settings = {\r\n    dots: false,\r\n    infinite: false,\r\n    speed: 800,\r\n    arrows: true,\r\n    slidesToShow: 4,\r\n    slidesToScroll: 1,\r\n    autoplay: false,\r\n    loop: true,\r\n    autoplaySpeed: 2000,\r\n    swipeToSlide: true,\r\n    vertical: screenWidth < 800 ? false : true, // Vertical based on screen width\r\n    verticalSwiping: screenWidth < 800 ? false : true, // Enable vertical swiping conditionally\r\n    adaptiveHeight: false,\r\n  };\r\n\r\n\r\n\r\n  // const settings = {\r\n  //   dots: true,\r\n  //   adaptiveHeight: true,\r\n  //   infinite: true,\r\n  //   speed: 800,\r\n  //   arrows: true,\r\n  //   slidesToShow: 4,\r\n  //   slidesToScroll: 1,\r\n  //   autoplay: false,\r\n  //   loop: true,\r\n  //   autoplaySpeed: 2000,\r\n  //   // draggable: true,\r\n  //   swipeToSlide: true,\r\n  //   vertical: true,\r\n  //   verticalSwiping: true,\r\n\r\n  // };\r\n\r\n  useEffect(() => {\r\n    if (imageUrls.length > 0) {\r\n      setUrls(imageUrls[0]);\r\n    }\r\n  }, [productInfo]);\r\n\r\n  return (\r\n    <div className=\"zoomItem\">\r\n      <div className=\"magnetic_product \">\r\n        <Card bordered>\r\n          <ReactImageZoom {...props} />\r\n          {productInfo.billingQty === \"PROMOTIONS\" || productInfo.billingQty === \"DISCOUNT\" || productInfo.offerQty === \"PROMOTIONS\" || productInfo.offerQty === \"DISCOUNT\" ?\r\n            <div className=\"discount_tags_details\">Super Saver Price</div> : productInfo.billingQty != \"\" && productInfo.offerQty != \"\" ?\r\n              <div className=\"offer_icons\">\r\n                {(productInfo.billingQty === \"FOC\" || productInfo.offerQty === \"FOC\") ?\r\n                  <>\r\n                    <img src={offerAvailable} />\r\n                    <div className=\"internal_offer_type\">\r\n                      <p>1 Item </p>\r\n                      <p>Free </p>\r\n                      <p>On MRP</p>\r\n                    </div>\r\n                  </>\r\n                  :\r\n                  <img src={getOfferImage(productInfo?.offerQty)} />\r\n                }\r\n              </div> : null}\r\n        </Card>\r\n        <div className=\"zoom_pro_item\">\r\n          {/* <Card size=\"small\" bordered={false}> */}\r\n\r\n          {productInfo?.imageUrl?.length != 0 ?\r\n            <Slider {...settings}>\r\n\r\n              {productInfo?.imageUrl?.map((item) => (\r\n                <div className=\"show_zoom_items\">\r\n\r\n                  <Card\r\n                    bordered={false}\r\n                    className={`zoom_Img ${urls === item ? \"active_zoom_img\" : \"\"}`}\r\n                    onClick={() => setUrls(item)}\r\n                  >\r\n                    <img\r\n                      src={item || BKDLogo}\r\n                      onError={(e) => e.currentTarget.src = BKDLogo}\r\n                    />\r\n                  </Card>\r\n\r\n                </div>\r\n              ))}\r\n\r\n            </Slider> : null}\r\n          {/* </Card> */}\r\n\r\n\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default ZoomProduct;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\Product\\ProductData.jsx",["1392","1393","1394","1395","1396","1397","1398","1399","1400","1401","1402","1403","1404","1405","1406","1407","1408","1409","1410","1411","1412"],[],"import { Alert, Avatar, Badge, Breadcrumb, Button, Card, Divider, List, Modal, Rate, Space, Tag, message, notification } from \"antd\";\r\nimport React, { useEffect, useState } from \"react\";\r\nimport \"../../style/product.css\";\r\nimport { MdLink, MdOutlineShoppingCart } from \"react-icons/md\";\r\nimport { MdOutlineShoppingBag } from \"react-icons/md\";\r\nimport { FaHeart, FaRegCreditCard, FaRegHeart } from \"react-icons/fa\";\r\nimport { MdOutlineContentCopy } from \"react-icons/md\";\r\nimport { FiHeart } from \"react-icons/fi\";\r\nimport { MdShare } from \"react-icons/md\";\r\nimport { Row, Col } from \"react-bootstrap\";\r\nimport { useScreen } from \"../auth/AuthScreen\";\r\nimport AppliedOfferImg from \"../../assest/png/offer_applied.png\"\r\nimport { addItem, removeItem, selectCartItems, selectedBillingQty, selectProductOffer, setBillingQty, setSelctedOffer } from \"../../redux/CartSlice\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { AddProductWishlist, fetchProductOffer, out_of_stock } from \"../apiService/api\";\r\nimport { useAuth } from \"../auth/context/authContext\";\r\nimport { useLocation, useNavigate } from \"react-router-dom\";\r\nimport AvailableOfferModeal from \"../offer/AvailableOfferModeal\";\r\nimport replaceImg from \"../../assest/png/replace.png\"\r\nimport retunImg from \"../../assest/png/return.png\"\r\nimport notReturnImg from \"../../assest/png/no return.png\"\r\nimport notReplaceImg from \"../../assest/png/no replace.png\"\r\n// import { selectProductOffer } from \"../../redux/OrderSlice\";\r\n\r\n\r\nfunction ProductData({ productId, productInfo, ShowProductDetails }) {\r\n  const dispatch = useDispatch();\r\n  const [isOfferLoading, setIsOfferLoading] = useState(false)\r\n  const [offerData, setOfferData] = useState(null)\r\n  const [variant, setvariant] = useState(null)\r\n  const cartItems = useSelector(selectCartItems);\r\n  const selectedOffers = useSelector(selectProductOffer);\r\n  const selectedBilQty = useSelector(selectedBillingQty);\r\n  const { token, nearStore } = useAuth()\r\n  const [wishlist, setWishlist] = useState({}); // State to manage wishlist status\r\n  const fullUrl = window.location.href;\r\n  const titleCase = str => str?.toLowerCase()?.split(' ').map(word => word?.charAt(0)?.toUpperCase() + word?.slice(1))?.join(' ');\r\n\r\n\r\n\r\n  console.log(\"fullUrl\", fullUrl);\r\n\r\n  // const handleActive = (item) => {\r\n  //   setvariant(item)\r\n  //   console.warn(\"item\", item)\r\n  //   setActiveId(item.productCode)\r\n  //   // setActiveCard(true)\r\n  //   navigate(`/product/${item.productCode}`)\r\n  //   // ShowProductDetails()\r\n\r\n  // }\r\n\r\n  // const settings = {\r\n  //   dots: false,\r\n  //   adaptiveHeight: true,\r\n  //   arrows: screenWidth < 800 ? false : true,\r\n  //   slidesToShow: screenWidth < 500 ? 2 : screenWidth < 1300 ? 3 : 4,\r\n  //   slidesToScroll: 1,\r\n  //   autoplay: false,\r\n  //   autoplaySpeed: 3000,\r\n  //   draggable: true,\r\n  //   swipeToSlide: true,\r\n  //   swipe: true,\r\n  // };\r\n\r\n  const handleAddItem = (item, selected_offer) => {\r\n    const cartFilter = {\r\n      isDeliveryChargeAllowed: item.isDeliveryChargeAllowed,\r\n      bkdAmount: item.bkdAmount,\r\n      brandID: item.brandID,\r\n      brandName: item.brandName,\r\n      categoryID: item.categoryID,\r\n      categoryName: item.categoryName,\r\n      imageUrl: item.imageUrl,\r\n      isPoolProduct: item.isPoolProduct,\r\n      isRefridgerator: item.isRefridgerator,\r\n      isWhislist: item.isWhislist,\r\n      mrp_total_price: item.mrp_total_price,\r\n      nonReplaceable: item.nonReplaceable,\r\n      nonReturnable: item.nonReturnable,\r\n      packSize: item.packSize,\r\n      price: item.price,\r\n      productCode: item.productCode,\r\n      productName: item.productName,\r\n      productType: item.productType,\r\n      stockQty: item.stockQty,\r\n      sub_total: item.sub_total,\r\n      unit: item.unit,\r\n\r\n    };\r\n    dispatch(addItem({ ...cartFilter, selected_offer: selectedOffers || selected_offer }));\r\n    dispatch(setBillingQty(1))\r\n    localStorage.setItem(\"cart\", JSON.stringify(item))\r\n\r\n  };\r\n\r\n  const handleDelItem = (item, cartItem) => {\r\n    dispatch(removeItem(item));\r\n    console.log(\"selectedBilQty > cartItem?.unit\", selectedBilQty, cartItem?.unit)\r\n    if (selectedBilQty >= cartItem?.unit) {\r\n      dispatch(setSelctedOffer(null))\r\n    }\r\n    const cart = JSON.parse(localStorage.getItem(\"cart\")) || []; // Retrieve cart from localStorage\r\n    const updatedCart = cart.filter(cartItem => cartItem.productCode !== item.productCode); // Filter out the item to be removed\r\n    localStorage.setItem(\"cart\", JSON.stringify(updatedCart))\r\n\r\n  };\r\n  useEffect(() => {\r\n    localStorage.setItem(\"cart\", JSON.stringify(cartItems));\r\n  }, [cartItems]);\r\n\r\n  const addToWishList = async (proCode) => {\r\n    setWishlist((prev) => ({ ...prev, [proCode.productCode]: true })); // Immediately update the icon\r\n    const body = { productCode: proCode.productCode, productName: proCode.productName, status: \"ACTIVE\" };\r\n    try {\r\n      await AddProductWishlist(token, body)\r\n        .then((res) => {\r\n          if (res.status === 201) {\r\n            // ShowProductDetails(); // Trigger fetch after adding to wishlist\r\n            notification['success']({\r\n              placement: \"topRight\",\r\n              message: \"Added Product To Wishlist\",\r\n            });\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          console.log(err.message);\r\n          setWishlist((prev) => ({ ...prev, [proCode]: false })); // Revert the icon if the API call fails\r\n          notification['error']({\r\n            placement: \"topRight\",\r\n            message: \"Failed to Add Product To Wishlist\",\r\n          });\r\n        });\r\n    } catch (error) {\r\n      console.log(error);\r\n      setWishlist((prev) => ({ ...prev, [proCode]: false })); // Revert the icon if the API call fails\r\n    }\r\n  };\r\n\r\n  const RemoveToWishList = async (proCode) => {\r\n    setWishlist((prev) => ({ ...prev, [proCode.productCode]: false })); // Immediately update the icon\r\n    const body = { productCode: proCode.productCode, productName: proCode.productName, status: \"INACTIVE\" };\r\n    try {\r\n      await AddProductWishlist(token, body)\r\n        .then((res) => {\r\n          if (res.status === 201) {\r\n            // ShowProductDetails(); // Trigger fetch after removing from wishlist\r\n            notification['warning']({\r\n              placement: \"topRight\",\r\n              message: \"Removed Product From Wishlist\",\r\n            });\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          console.log(err.message);\r\n          setWishlist((prev) => ({ ...prev, [proCode]: true })); // Revert the icon if the API call fails\r\n          notification['error']({\r\n            placement: \"topRight\",\r\n            message: \"Failed to Remove Product From Wishlist\",\r\n          });\r\n        });\r\n    } catch (error) {\r\n      console.log(error);\r\n      setWishlist((prev) => ({ ...prev, [proCode]: true })); // Revert the icon if the API call fails\r\n    }\r\n  };\r\n\r\n\r\n  const handleItemIncrement = (item) => {\r\n    dispatch(addItem(item));\r\n    localStorage.setItem(\"cart\", JSON.stringify(cartItems))\r\n  };\r\n\r\n  const handleNotLogin = () => {\r\n    notification.error({\r\n      placement: \"topRight\",\r\n      message: \"You need to login to add items to your wishlist.\",\r\n    });\r\n  }\r\n\r\n  const ShowOfferPorduct = async () => {\r\n    setIsOfferLoading(true)\r\n    try {\r\n      await fetchProductOffer(nearStore?.branchCode, productId)\r\n        .then((res) => {\r\n          console.log(\"offer Information\", res);\r\n          if (res.status == 200) {\r\n            setOfferData(res.data.data);\r\n            setIsOfferLoading(false)\r\n            dispatch(setSelctedOffer(null));\r\n\r\n          }\r\n        })\r\n\r\n        .catch((err) => {\r\n          console.log(err.message);\r\n        });\r\n    } catch (error) {\r\n      console.log(error);\r\n      setIsOfferLoading(false)\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    if (productInfo.length != 0) {\r\n      ShowOfferPorduct();\r\n    }\r\n  }, [productId]);\r\n\r\n  const copyToClipboard = () => {\r\n    navigator.clipboard.writeText(fullUrl)\r\n      .then(() => {\r\n        message.success('Link copied!');\r\n      })\r\n      .catch(() => {\r\n        message.error('Failed to copy!');\r\n      });\r\n  };\r\n\r\n  const info = () => {\r\n    Modal.confirm({\r\n      title: 'Share',\r\n      content: (\r\n        <div>\r\n          <List\r\n          >\r\n            <List.Item\r\n              actions={[<Button type=\"link\" onClick={copyToClipboard} icon={<MdOutlineContentCopy />}>Copy</Button>]}\r\n            >\r\n\r\n              <List.Item.Meta\r\n                avatar={<Avatar icon={<MdLink className=\"share_icons\" />} />}\r\n                title={\r\n                  <span>onbkd.in</span>\r\n                }\r\n                description={<p>{fullUrl.substring(0, 36)}...</p>}\r\n              />\r\n\r\n\r\n            </List.Item>\r\n          </List>\r\n        </div>\r\n      ),\r\n      width: 500,\r\n      icon: null, // This removes the icon\r\n      footer: null,     // Hides OK/Cancel buttons\r\n      closable: true,   // Optional: allows user to close via \"X\"\r\n      maskClosable: true, // Optional: allows closing by clicking outside\r\n    });\r\n  };\r\n\r\n\r\n  return (\r\n    <div className=\"single_product_info\">\r\n      <Card bordered={false}>\r\n        <div className=\"pro_data_title\">\r\n          <Breadcrumb\r\n            items={[\r\n              {\r\n                title: productInfo?.categoryName,\r\n              },\r\n              {\r\n                title: productInfo?.itemCategoryName,\r\n\r\n              },\r\n              {\r\n                title: productInfo?.subCategoryName,\r\n              },\r\n\r\n            ]}\r\n          />\r\n          <p>\r\n            {titleCase(productInfo?.productName)}\r\n          </p>\r\n          <p>{productInfo?.stockQty === out_of_stock ? <Tag color=\"red\" bordered={false}>Out Of Stock</Tag> : null}</p>\r\n\r\n        </div>\r\n        {/* <div className=\"pro_rate\"> */}\r\n        {/* <Space>\r\n            <Rate disabled defaultValue={productInfo?.averageRating} allowHalf />\r\n            <span className=\"rating_count\">({productInfo?.totalReviews})</span>\r\n          </Space> */}\r\n\r\n        {/* <div className=\"wish_share\">\r\n            <Space>\r\n              <Button type=\"link\" icon={<div className=\"pro_details_wish_list\">\r\n                {token ?\r\n                  <div className='wish_list'>\r\n                    {\r\n                      wishlist[productInfo.productCode] || productInfo?.isWhislist ? (\r\n                        <FaHeart\r\n                          className=\"no_wish_icon\"\r\n                          size={22}\r\n                          color='red'\r\n                          onClick={() => RemoveToWishList(productInfo)}\r\n                        />\r\n                      ) : (\r\n                        <FaRegHeart\r\n                          className=\"no_wish_icon\"\r\n                          size={22}\r\n                          onClick={() => addToWishList(productInfo)}\r\n                        />\r\n                      )\r\n                    }\r\n                  </div>\r\n\r\n                  :\r\n                  <div className='wish_list'>\r\n                    <FaRegHeart\r\n                      className=\"no_wish_icon\"\r\n                      size={22}\r\n                      onClick={handleNotLogin}\r\n                    />\r\n                  </div>\r\n                }\r\n              </div>}>\r\n              </Button>\r\n\r\n              <div className=\"pro_wish\">\r\n\r\n                <Button type=\"link\" icon={<MdShare className=\"pro_icon\" />} onClick={info}></Button>\r\n              </div>\r\n            </Space>\r\n          </div> */}\r\n        {/* </div> */}\r\n\r\n        {/* <Divider dashed style={{ marginBottom: \"0\" }} /> */}\r\n\r\n        {/* <div className=\"variant_lists\">\r\n          <p>Select Unit</p>\r\n          <div className=\"show_variant_slide\">\r\n\r\n            <Slider {...settings}>\r\n              {productInfo?.differentPackSize?.map((item) => (\r\n\r\n\r\n                <div className={activeId == item.productCode || productId === item.productCode ? \"active_card\" : \"variant_card\"}>\r\n\r\n                  <Card bordered onClick={() => handleActive(item)}>\r\n\r\n                    <div className=\"variant_content\">\r\n                      <p>{item.packSize != \"\" ? item.packSize : \"N/A\"}</p>\r\n                      <Space direction=\"horizontal\">\r\n                        <p><b>₹ {item.bkdAmount}</b></p>\r\n                        {item.bkdAmount != item.price && <p><del>₹ {item.price}</del></p>}\r\n                      </Space>\r\n                    </div>\r\n                    {item.bkdAmount != item.price ? <span class=\"ribbon1\"><span style={{ fontSize: \".8rem\" }}> {item.price ? Math.round((item.price - item.bkdAmount) * 100 / item.price) : \"\"}% Off</span></span> : null}\r\n                  </Card>\r\n                </div>\r\n              ))}\r\n            </Slider>\r\n          </div>\r\n        </div>\r\n        {variant != null ? <div className=\"multiple_variant\">\r\n          <p><b>{variant?.packSize}</b></p>\r\n          <div className=\"pro_varient_prices\">\r\n            <p>₹{variant?.bkdAmount}</p>\r\n            {variant?.bkdAmount != variant?.price && <del>₹ {variant?.price}</del>}\r\n          </div>\r\n        </div> : */}\r\n        <div className=\"regular_variant\">\r\n          <p><b>{productInfo?.packSize}</b></p>\r\n          <div className=\"pro_price\">\r\n            <p>₹{productInfo?.bkdAmount}</p>\r\n            {productInfo?.bkdAmount != productInfo?.price && <span><del>₹ {productInfo?.price}</del></span>}\r\n          </div>\r\n        </div>\r\n        <p>Inclusive of All Taxes.\r\n        </p>\r\n        <div className=\"mt-2 product_details_block\">\r\n          <div className=\"product_details_wish\">\r\n            <Space>\r\n              <p><img src={productInfo.nonReturnable ? notReturnImg : retunImg} className=\"retun_img\" /> {productInfo.nonReturnable ? \"No Return\" : \"Return Available\"}</p>\r\n              <p><img src={productInfo.nonReplaceable ? notReplaceImg : replaceImg} className=\"retun_img\" /> {productInfo.nonReplaceable ? \"No Replacement\" : \" Replacement Available\"}</p>\r\n            </Space>\r\n\r\n            <div className=\"product_details_wish_div\">\r\n              <Space >\r\n                <Button type=\"link\" icon={<div className=\"pro_details_wish_list\">\r\n                  {token ?\r\n                    <div className='wish_list'>\r\n                      {\r\n                        wishlist[productInfo.productCode] || productInfo?.isWhislist ? (\r\n                          <FaHeart\r\n                            className=\"no_wish_icon\"\r\n                            size={22}\r\n                            color='red'\r\n                            onClick={() => RemoveToWishList(productInfo)}\r\n                          />\r\n                        ) : (\r\n                          <FaRegHeart\r\n                            className=\"no_wish_icon\"\r\n                            size={22}\r\n                            onClick={() => addToWishList(productInfo)}\r\n                          />\r\n                        )\r\n                      }\r\n                    </div>\r\n\r\n                    :\r\n                    <div className='wish_list'>\r\n                      <FaRegHeart\r\n                        className=\"no_wish_icon\"\r\n                        size={22}\r\n                        onClick={handleNotLogin}\r\n                      />\r\n                    </div>\r\n                  }\r\n                </div>}>\r\n                </Button>\r\n\r\n                <div className=\"pro_wish\">\r\n\r\n                  <Button type=\"link\" icon={<MdShare className=\"pro_icon\" />} onClick={info}></Button>\r\n                </div>\r\n              </Space>\r\n            </div>\r\n          </div>\r\n\r\n          {cartItems?.find((cartItem) => cartItem.productCode === productInfo.productCode) ? (\r\n            <div className=\"add_to_cart_btn \">\r\n              {cartItems?.map((cartItem) => {\r\n                if (cartItem.productCode === productInfo.productCode) {\r\n                  return (\r\n                    <div className=\"add_to_cart_section\">\r\n                      <div className=\"cart_btn\">\r\n                        <Button.Group size='large' key={cartItem.productCode} >\r\n                          <Button type=\"primary\" className=\"product_details_btn\" onClick={() => handleDelItem(productInfo, cartItem)}\r\n                          >-</Button>\r\n                          <Button type=\"primary\" className=\"product_details_btn\">{cartItem.unit}</Button> {/* Access quantity from cart item */}\r\n                          <Button type=\"primary\" className=\"product_details_btn\" onClick={() => handleItemIncrement(cartItem)}>+</Button>\r\n                        </Button.Group>\r\n                      </div>\r\n                    </div>\r\n                  );\r\n                }\r\n                return null;\r\n              })}\r\n            </div>\r\n          ) : (\r\n            <div className=\"add_to_cart_btn \">\r\n              {offerData?.length !== 0 ?\r\n                <div className=\"pro_order\">\r\n                  <AvailableOfferModeal productId={productId}\r\n                    ShowProductDetails={ShowProductDetails}\r\n                    productInfo={productInfo} variant={variant}\r\n                    isOfferLoading={isOfferLoading}\r\n                    offerData={offerData} /> </div>\r\n                :\r\n                <div className=\"pro_order\">\r\n                  <Button\r\n                    disabled={productInfo?.stockQty <= out_of_stock}\r\n                    size=\"large\"\r\n                    id=\"add_To_Carts\"\r\n                    onClick={() => handleAddItem(productInfo)}\r\n                  >\r\n                    Add to Cart\r\n                  </Button>\r\n                </div>}\r\n            </div>\r\n          )}\r\n        </div>\r\n\r\n        {cartItems?.find((cartItem) => cartItem.productCode === productInfo.productCode) && (\r\n          <div className=\"add_to_cart_btn \">\r\n            {cartItems?.map((cartItem) => {\r\n              if (cartItem.productCode === productInfo.productCode) {\r\n                const [billingQtyStr, offerQtyStr] = (cartItem.offerTypeName || \"0+0\").split('+');\r\n                const billingQty = parseInt(billingQtyStr, 10);\r\n                const offerQty = parseInt(offerQtyStr, 10);\r\n\r\n                return (\r\n                  <div className=\"add_to_cart_section\">\r\n                    {cartItem.selected_offer ?\r\n                      <div className=\"show_apply_offer\">\r\n                        <img src={AppliedOfferImg} />\r\n                        <div className=\"combo_price\">\r\n                          <p>Offer Price</p>\r\n                          <p>₹ {cartItem?.selected_offer?.comboPrice}</p>\r\n                        </div>\r\n                        {cartItem?.selected_offer?.promoType === \"FOC\" ?\r\n                          <div className=\"details_soffer_types\">\r\n                            <p>1 Item</p>\r\n                            <p>Free </p>\r\n                          </div>\r\n                          :\r\n                          <div className=\"details_soffer_types\">\r\n                            <p>Buy {billingQty} </p>\r\n                            <p>Get {offerQty} </p>\r\n                          </div>\r\n                        }\r\n\r\n                      </div>\r\n                      : null}\r\n                  </div>\r\n                );\r\n              }\r\n              return null;\r\n            })}\r\n          </div>\r\n        )}\r\n\r\n        <div className=\"product_details_des\">\r\n          <div className=\"product_details_des_title\">About the Product</div>\r\n          <p className=\"product_details_des_par\">{productInfo?.productDescription}</p>\r\n        </div >\r\n\r\n        {/* <div className=\"pros_offer\">\r\n          <List bordered>\r\n            <List.Item>\r\n              <List.Item.Meta avatar={<FaRegCreditCard className=\"pro_pay_icon\" />}\r\n                title=\"Payment :\"\r\n                description=\"Corewave is a leading mobile app development Noida, We have a team of experienced and skilled\r\n          developers \"\r\n              ></List.Item.Meta>\r\n            </List.Item>\r\n\r\n            <List.Item>\r\n              <List.Item.Meta avatar={<MdOutlineSecurity className=\"pro_pay_icon\" />}\r\n                title=\"Warring :\"\r\n                description=\"who can create custom mobile apps for businesses of all sizes. We specialize in\"\r\n              ></List.Item.Meta>\r\n            </List.Item>\r\n          </List>\r\n        </div> */}\r\n      </Card >\r\n    </div >\r\n  );\r\n}\r\n\r\nexport default ProductData;","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\Product\\ProductDetailTabs.jsx",["1413","1414"],[],"import { Tabs } from 'antd'\r\nimport React from 'react'\r\nimport RatingReview from './RatingReview'\r\nimport RacipiSlider from '../Racipe/RacipiSlider'\r\nimport ProductDescript from './ProductDescript'\r\n\r\nfunction ProductDetailTabs({productInfo,ShowProductDetails}) {\r\n  return (\r\n    <div className=\"pro_review_summary\">\r\n    <Tabs defaultActiveKey=\"1\"  >\r\n    <Tabs.TabPane tab=\"DESCRIPTION\" key=\"1\">\r\n        <ProductDescript productInfo={productInfo}/>\r\n      </Tabs.TabPane>\r\n      {/* <Tabs.TabPane tab=\"RATING\" key=\"2\">\r\n        <RatingReview productInfo={productInfo} ShowProductDetails={ShowProductDetails}/>\r\n      </Tabs.TabPane> */}\r\n     \r\n    </Tabs>\r\n  </div>\r\n  )\r\n}\r\n\r\nexport default ProductDetailTabs","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\footer\\Footers.jsx",["1415","1416","1417","1418","1419","1420"],[],"import React, { useEffect, useState } from \"react\";\r\nimport \"../../style/footer.css\";\r\nimport { FaFacebookF, FaInstagram, FaLinkedinIn } from \"react-icons/fa\";\r\nimport { BsTwitterX } from \"react-icons/bs\";\r\nimport { FetchCategoryList } from \"../apiService/api\";\r\nimport { encryptCategoryID } from \"../../config/encriptConfig\";\r\nimport { Skeleton } from \"antd\";\r\n\r\nconst usefulLinksColumn1 = [\r\n  { label: \"Blog\", path: \"/blog\" },\r\n  { label: \"Privacy\", path: \"/policy\" },\n  { label: \"Terms\", path: \"/terms\" },\n  { label: \"FAQs\", path: \"/faq\" },\n  { label: \"Security\", path: \"/security\" },\n  { label: \"Contact\", path: \"/contact-us\" },\n];\n\r\nconst usefulLinksColumn2 = [\r\n  // \"Partner\", \"Franchise\", \"Seller\", \"Warehouse\", \"Deliver\", \"Resources\"\r\n];\r\n\r\nconst usefulLinksColumn3 = [\r\n  // \"Recipes\", \"Bistro\", \"District\", \"Blinkit Ambulance\"\r\n];\r\n\r\nexport default function Footer() {\r\n  const [catList, setCatList] = useState([]);\r\n  const [isLoading, setIsLoading] = useState(false);\r\n\r\n  const showAllCategoryList = async () => {\r\n    setIsLoading(true)\r\n    try {\r\n      await FetchCategoryList('')\r\n        .then((res) => {\r\n          if (res.status == 200) {\r\n            setCatList(res.data.data);\r\n            setIsLoading(false)\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          console.log(err);\r\n        });\r\n    } catch (error) {\r\n      setIsLoading(false)\r\n\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    showAllCategoryList()\r\n  }, [])\r\n\r\n  const manageURl = (categoryName) => {\r\n    const sanitizedCategory = categoryName\r\n      .replace(/[,/&]/g, '')\r\n      .replace(/\\s+/g, '-')\r\n      .toLowerCase();\r\n    return sanitizedCategory\r\n  }\r\n\r\n  const formatCategoryName = (text) => {\r\n    return text\r\n      .toLowerCase()\r\n      .replace(/\\b\\w/g, (char) => char.toUpperCase());\r\n  };\r\n\r\n  return (\r\n    <div className=\"footer\">\r\n      <div className=\"footer-top container\">\r\n        <div className=\"footer-col\">\r\n          <h3>Useful Links</h3>\r\n          <div className=\"link-columns\">\r\n            <div>\r\n              {usefulLinksColumn1.map((item, i) => (\r\n                <a key={i} href={item.path} target=\"_blank\" className=\"footer-link\">\r\n                  {item.label}\r\n                </a>\r\n              ))}\r\n            </div>\r\n            <div>\r\n              {usefulLinksColumn2.map((item, i) => (\r\n                <p key={i}>{item}</p>\r\n              ))}\r\n            </div>\r\n            <div>\r\n              {usefulLinksColumn3.map((item, i) => (\r\n                <p key={i}>{item}</p>\r\n              ))}\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <div className=\"footer-col categories\">\r\n          <div className=\"category-header\">\r\n            <h3>Categories</h3>\r\n          </div>\r\n          <div className=\"category-grid\">\r\n            {isLoading ?\r\n              Array.from({ length: 16 }).map((_, i) => (\r\n                <Skeleton.Input\r\n                  key={i}\r\n                  active\r\n                  size=\"small\"\r\n                  style={{ width: \"100%\", height: 14 }}\r\n                />\r\n              )) :\r\n              catList?.map((item, i) => (\r\n                <a\r\n                  key={i}\r\n                  href={`/category/${manageURl(item.categoryName)}?uid=${encodeURIComponent(encryptCategoryID(item.categoryID))}`}\r\n                  className=\"category-link\"\r\n                >\r\n                  {item?.categoryName && formatCategoryName(item.categoryName)}\r\n                </a>\r\n              ))\r\n            }\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"footer-bottom container\">\r\n        {/* <p className=\"copyright\">\r\n          © Blink Commerce Private Limited, 2016-2026\r\n        </p> */}\r\n\r\n        <div className=\"store-buttons\">\r\n          <div className=\"download\">\r\n            Download App\r\n          </div>\r\n          <div className=\"store-btn\">\r\n            <img src=\"app-store.svg\" alt=\"App Store\" />\r\n          </div>\r\n          <div className=\"store-btn\">\r\n            <img src=\"google-play.svg\" alt=\"Google Play\" />\r\n          </div>\r\n        </div>\r\n\r\n        <div className=\"social-icons\">\r\n          <a href=\"https://www.facebook.com/Baniyakidukan12/\" target=\"_blank\">\r\n            <div className=\"icon-circle\">\r\n              <FaFacebookF />\r\n            </div>\r\n          </a>\r\n          <a href=\"https://www.instagram.com/baniyakidukan/\" target=\"_blank\">\r\n            <div className=\"icon-circle\">\r\n              <BsTwitterX />\r\n            </div>\r\n          </a>\r\n          <a href=\"https://www.instagram.com/baniyakidukan/\" target=\"_blank\">\r\n            <div className=\"icon-circle\">\r\n              <FaInstagram />\r\n            </div>\r\n          </a>\r\n          <a href=\"https://whatsapp.com/channel/0029VaAknSM4Y9lo9GuJXy1a\" target=\"_blank\">\r\n            <div className=\"icon-circle\">\r\n              <FaLinkedinIn />\r\n            </div>\r\n          </a>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\Racipe\\RacipiSlider.jsx",["1421","1422","1423","1424","1425","1426","1427","1428","1429","1430","1431"],[],"import React, { Component, useEffect, useState } from \"react\";\r\nimport Slider from \"react-slick\";\r\nimport \"../../style/home.css\";\r\nimport { Button, Card } from \"antd\";\r\nimport { MdOutlineTimer } from \"react-icons/md\";\r\nimport { MdOutlineLocationOn } from \"react-icons/md\";\r\nimport { useNavigate, useParams } from \"react-router-dom\";\r\nimport { fetchAllRacipe } from \"../apiService/api\";\r\nimport DefaultImg from '../../assest/emptyImage.png'\r\n\r\n\r\n\r\nfunction RacipiSlider({ screenWidth, productCode }) {\r\n  const [racipeList, setRacipeList] = useState([])\r\n  const [isLoading, setIsLoading] = useState(false)\r\n  const navigate = useNavigate()\r\n\r\n\r\n  const settings = {\r\n    dots: false,\r\n    adaptiveHeight: true,\r\n    infinite: true,\r\n    speed: 800,\r\n    arrows: false,\r\n    slidesToShow: screenWidth < 500 ? 1 : 4,\r\n    slidesToScroll: 1,\r\n    autoplay: true,\r\n    loop: true,\r\n    autoplaySpeed: 3000,\r\n    draggable: true,\r\n    swipeToSlide: true,\r\n    swipe: true,\r\n\r\n\r\n  };\r\n\r\n  const showRacipeSlider = async () => {\r\n    try {\r\n      await fetchAllRacipe(productCode)\r\n        .then((res) => {\r\n          console.log(\"racipe slider\", res);\r\n          if (res.status == 200) {\r\n            setRacipeList(res.data.data);\r\n            setIsLoading(true)\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          console.log(err.message);\r\n        });\r\n    } catch (error) {\r\n      console.log(error);\r\n      setIsLoading(true)\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    showRacipeSlider();\r\n  }, []);\r\n\r\n\r\n\r\n\r\n\r\n  return (\r\n    <div className=\"shop_scroll mt-3\">\r\n\r\n      <Slider {...settings}>\r\n        {racipeList.map((item) => (\r\n          <div className=\"shop_slider\">\r\n            <div className=\"shop_image\">\r\n              <img\r\n                src={item.recipeImages?.length != 0 ? item.recipeImages[0] : DefaultImg}\r\n                onError={(e) => e.currentTarget.src = DefaultImg}\r\n                onClick={() => navigate(`/recipes-detials/${item._id}`)}\r\n              />\r\n              <div className=\"recipes_titles\">\r\n                <p>Cooking Time : {item.cookingTime.substr(0, 15)}</p>\r\n              </div>\r\n            </div>\r\n            <div className=\"shop_loc\">\r\n              <p>{item.recipeTitle}</p>\r\n            </div>\r\n          </div>\r\n        ))}\r\n      </Slider>\r\n    </div>\r\n  );\r\n}\r\n\r\n\r\n\r\nexport default RacipiSlider","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\Product\\SimilarProduct.jsx",["1432","1433","1434","1435","1436","1437","1438","1439","1440","1441","1442","1443","1444","1445","1446","1447","1448","1449","1450","1451","1452"],[],"import { Badge, Button, Card, Divider, Radio, Skeleton, Space, Tag, Tooltip, notification } from \"antd\";\r\nimport React, { useEffect, useState } from \"react\";\r\nimport Slider from \"react-slick\";\r\nimport \"../../style/header.css\";\r\nimport { FaHeart } from \"react-icons/fa\";\r\nimport { FaRegHeart } from \"react-icons/fa\";\r\nimport { useNavigate } from \"react-router-dom\";\r\nimport { MdArrowRightAlt } from \"react-icons/md\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { addItem, removeItem, selectCartItems } from \"../../redux/CartSlice\";\r\nimport { AddProductWishlist, fetchSimelarProduct, out_of_stock } from \"../apiService/api\";\r\nimport { useScreen } from \"../auth/AuthScreen\";\r\nimport { useAuth } from \"../auth/context/authContext\";\r\nimport BKDLogo from \"../../assest/bkdlogo.png\"\r\nimport offerAvailable from \"../../assest/png/offer_apply.png\"\r\nimport { encryptCategoryID } from \"../../config/encriptConfig\";\r\nimport { getOfferImage } from \"../../utils/offerUtils\";\r\n\r\nfunction SimilarProduct({ productInfo, ShowProductDetails }) {\r\n    const { screenWidth } = useScreen()\r\n    const { token } = useAuth()\r\n    const navigate = useNavigate();\r\n    const dispatch = useDispatch();\r\n    const cartItems = useSelector(selectCartItems);\r\n    const [similarData, setSimilarData] = useState([])\r\n    const [isLoading, setIsLoading] = useState(false)\r\n    const [current, setCurrent] = useState(1)\r\n    const nearStore = JSON.parse(localStorage.getItem(\"near store\"));\r\n\r\n    const [wishlist, setWishlist] = useState({});\r\n    const titleCase = str => str.toLowerCase().split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');\r\n\r\n\r\n\r\n\r\n    const settings = {\r\n        dots: false,\r\n        adaptiveHeight: true,\r\n        infinite: true,\r\n        speed: 800,\r\n        arrows: screenWidth < 500 ? false : true,\r\n        slidesToShow: screenWidth < 500 ? 2 : screenWidth < 1500 ? 6 : 8,\r\n\r\n        slidesToScroll: 1,\r\n        autoplay: true,\r\n        loop: true,\r\n        autoplaySpeed: 3000,\r\n        draggable: true,\r\n        swipeToSlide: true,\r\n        swipe: true,\r\n    };\r\n\r\n\r\n\r\n\r\n    const ShowSimilarPorduct = async () => {\r\n        setIsLoading(true)\r\n        try {\r\n            await fetchSimelarProduct(nearStore?.branchCode, productInfo?.subCategoryID, current, token)\r\n                .then((res) => {\r\n                    console.log(\"similar product Information\", res);\r\n                    if (res.status == 200) {\r\n                        const filtered = res.data.data.filter(\r\n                            (p) => p.productCode !== productInfo?.productCode\r\n                        );\r\n\r\n                        setSimilarData(filtered);\r\n                        setIsLoading(false)\r\n                    }\r\n                })\r\n\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n                    setIsLoading(false)\r\n\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n            setIsLoading(false)\r\n\r\n        }\r\n    };\r\n\r\n    useEffect(() => {\r\n        if (productInfo?.length != 0) {\r\n\r\n            ShowSimilarPorduct();\r\n        }\r\n    }, [productInfo]);\r\n\r\n    const handleAddItem = (item) => {\r\n        dispatch(addItem(item))\r\n\r\n    };\r\n\r\n    useEffect(() => {\r\n        localStorage.setItem(\"cart\", JSON.stringify(cartItems));\r\n    }, [cartItems]);\r\n\r\n\r\n    const handleDelItem = (item) => {\r\n        dispatch(removeItem(item));\r\n        const cart = JSON.parse(localStorage.getItem(\"cart\")) || []; // Retrieve cart from localStorage\r\n        const updatedCart = cart.filter(cartItem => cartItem.productCode !== item.productCode); // Filter \r\n        localStorage.setItem(\"cart\", JSON.stringify(updatedCart))\r\n\r\n    };\r\n\r\n\r\n    const GoToSimilarProduct = (item) => {\r\n        navigate(`/product/${manageURl(item.productName)}?uid=${encodeURIComponent(encryptCategoryID(item.productCode))}`);\r\n        // ShowProductDetails()\r\n    }\r\n    const goToProductDetails = (item) => {\r\n        navigate(`/product/${manageURl(item.productName)}?uid=${encodeURIComponent(encryptCategoryID(item.productCode))}`);\r\n    }\r\n    const HnadleNotLogin = () => {\r\n        notification.error({\r\n            placement: \"topRight\",\r\n            message: \"Please login before add wishlist\",\r\n        });\r\n    }\r\n\r\n    const addToWishList = async (proCode) => {\r\n        setWishlist((prev) => ({ ...prev, [proCode.productCode]: true }));\r\n        const body = {\r\n            productCode: proCode.productCode,\r\n            productName: proCode.productName,\r\n            status: \"ACTIVE\"\r\n        }\r\n        try {\r\n            await AddProductWishlist(token, body)\r\n                .then((res) => {\r\n                    console.log(\"add to  wish\", res);\r\n                    if (res.status == 201) {\r\n\r\n\r\n                        if (res.data.data.whislistKey != true) {\r\n                            // notification.warning({\r\n                            //     placement: \"topRight\",\r\n                            //     message: \"Remove Product From Wishlist\",\r\n\r\n                            // });\r\n                            ShowSimilarPorduct()\r\n                        } else {\r\n                            // notification.success({\r\n                            //     placement: \"topRight\",\r\n                            //     message: \"Add Product To  Wishlist\",\r\n\r\n                            // })\r\n                            ShowSimilarPorduct()\r\n\r\n                        }\r\n\r\n\r\n                    }\r\n\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n                    setWishlist((prev) => ({ ...prev, [proCode]: false }));\r\n                });\r\n        } catch (error) {\r\n            setWishlist((prev) => ({ ...prev, [proCode]: false }));\r\n            console.log(error);\r\n\r\n        }\r\n    };\r\n\r\n\r\n\r\n    const RemoveToWishList = async (proCode) => {\r\n        setWishlist((prev) => ({ ...prev, [proCode.productCode]: false })); // Immediately update the icon\r\n        const body = { productCode: proCode.productCode, productName: proCode.productName, status: \"INACTIVE\" };\r\n        try {\r\n            await AddProductWishlist(token, body)\r\n                .then((res) => {\r\n                    if (res.status === 201) {\r\n                        ShowSimilarPorduct();\r\n                        // notification['warning']({\r\n                        //     placement: \"topRight\",\r\n                        //     message: \"Removed Product From Wishlist\",\r\n                        // });\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n                    setWishlist((prev) => ({ ...prev, [proCode]: true })); // Revert the icon if the API call fails\r\n                    // notification['error']({\r\n                    //     placement: \"topRight\",\r\n                    //     message: \"Failed to Remove Product From Wishlist\",\r\n                    // });\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n            setWishlist((prev) => ({ ...prev, [proCode]: true })); // Revert the icon if the API call fails\r\n        }\r\n    };\r\n\r\n    const manageURl = (productName) => {\r\n        const sanitizedCategory = productName\r\n            .replace(/[,/&]/g, '') // Remove commas, slashes, ampersands\r\n            .replace(/\\s+/g, '-')  // Replace spaces with hyphens\r\n            .toLowerCase();\r\n        return sanitizedCategory\r\n    }\r\n\r\n\r\n    return (\r\n        <section>\r\n            {isLoading ? <Skeleton active /> : similarData.length == 0 ? null :\r\n                <div className=\"card_section\">\r\n                    <div className=\"card_section_title\">\r\n                        <p>Similar Product </p>\r\n\r\n                    </div>\r\n                    <div className=\"prodcut_slider_container\">\r\n                        <Slider {...settings}>\r\n                            {similarData.map((item) => (\r\n                                <div className=\"product_card\">\r\n                                    <Card\r\n                                        hoverable\r\n                                        disabled={item.stockQty == 0 && true}\r\n                                    >\r\n                                        <div className=\"card_img\">\r\n                                            {item.imageUrl[0] != null ?\r\n                                                <img\r\n                                                    className={item.stockQty <= out_of_stock ? \"out_of_stock_img\" : \"\"}\r\n                                                    src={item.imageUrl[0] || BKDLogo}\r\n                                                    onError={(e) => e.currentTarget.src = BKDLogo}\r\n                                                    onClick={() => GoToSimilarProduct(item)}\r\n                                                />\r\n                                                :\r\n                                                <img\r\n                                                    className={item.stockQty <= out_of_stock ? \"out_of_stock_img\" : \"\"}\r\n                                                    src={BKDLogo}\r\n                                                    onClick={() => goToProductDetails(item)}\r\n                                                />\r\n                                            }\r\n\r\n                                        </div>\r\n\r\n                                        <div className=\"pro_name\" onClick={() => goToProductDetails(item)}>\r\n                                            <Tooltip title={titleCase(item.productName)}>\r\n                                                <p>{item.productName.length > 36 ? titleCase(item.productName.slice(0, 36)) + \"...\" : titleCase(item.productName)}</p>\r\n                                            </Tooltip>\r\n                                        </div>\r\n                                        <div className=\"show_variant_item\" onClick={() => goToProductDetails(item)}>\r\n                                            {item.packSize && item.packSize !== \"(NIL)\" ? <Tag color=\"green\">{item.packSize.substr(0, 10)}</Tag> : <p className=\"hidden_data\">N/A</p>}\r\n                                            {item.stockQty <= out_of_stock ? <Tag color='red' className=\"stock_tag\">out of stock</Tag> : <p className='hidden_data'>N/A</p>}\r\n                                        </div>\r\n                                        <div className=\"show_price_mrp\">\r\n                                            <p>BKD Price | MRP</p>\r\n                                        </div>\r\n                                        <div className=\"add_cart\">\r\n                                            <p>{`₹ ${Math.round(item.bkdAmount)} `} <span>{item.bkdAmount != item.price && <del>₹ {item.price}</del>}</span> </p>\r\n\r\n                                            {cartItems.find((cartItem) => cartItem.productCode === item.productCode) ? (\r\n                                                cartItems.map((cartItem) => {\r\n                                                    if (cartItem.productCode === item.productCode) {\r\n                                                        return (\r\n                                                            <Button.Group className=\"add_to_carts\" size={screenWidth < 800 ? \"\" : 'small'} key={cartItem.productCode}>\r\n                                                                <Button className=\"add_to_carts add_to_cart_button\" onClick={() => handleDelItem(item)}>-</Button>\r\n                                                                <Button className=\"add_to_carts add_to_cart_button\">{cartItem.unit}</Button> {/* Access quantity from cart item */}\r\n                                                                <Button className=\"add_to_carts add_to_cart_button\" onClick={() => handleAddItem(item)}>+</Button>\r\n                                                            </Button.Group>\r\n                                                        );\r\n                                                    }\r\n                                                    return null;\r\n                                                })\r\n                                            ) : (\r\n                                                <Button disabled={item.stockQty <= out_of_stock} type=\"default\" onClick={() => handleAddItem(item)}>ADD</Button>\r\n                                            )}\r\n                                        </div>\r\n                                    </Card>\r\n                                    {item.billingQty === \"PROMOTIONS\" || item.billingQty === \"DISCOUNT\" || item.offerQty === \"PROMOTIONS\" || item.offerQty === \"DISCOUNT\" ?\r\n                                        <div className=\"discount_tags\">Super Saver Price</div> : item.billingQty != \"\" && item.offerQty != \"\" ?\r\n                                            <div className=\"offer_Available\">\r\n                                                {(item.billingQty === \"FOC\" || item.offerQty === \"FOC\") ?\r\n                                                    <>\r\n                                                        <img src={offerAvailable} />\r\n                                                        <div className=\"offer_types\">\r\n                                                            <p>1 Item</p>\r\n                                                            <p>Free </p>\r\n                                                            <p>On MRP</p>\r\n                                                        </div>\r\n                                                    </>\r\n                                                    :\r\n                                                    <img src={getOfferImage(item?.offerQty)} />\r\n                                                }\r\n\r\n                                            </div> : Math.round(item.bkdAmount) != item.price ? <div className=\"cat_tags\">{Math.round((item.price - item.bkdAmount) * 100 / item.price)}% off</div> : null}\r\n\r\n                                    <div className=\"wish_list\">\r\n\r\n\r\n                                        {token ?\r\n                                            <div className='wish_list'>\r\n                                                {\r\n                                                    wishlist[item.productCode] || item.isWhislist ? (\r\n                                                        <FaHeart\r\n                                                            className=\"no_wish_icon\"\r\n                                                            size={22}\r\n                                                            color='red'\r\n                                                            onClick={() => RemoveToWishList(item)}\r\n                                                        />\r\n                                                    ) : (\r\n                                                        <FaRegHeart\r\n                                                            className=\"no_wish_icon\"\r\n                                                            size={22}\r\n                                                            onClick={() => addToWishList(item)}\r\n                                                        />\r\n                                                    )\r\n                                                }\r\n                                            </div>\r\n\r\n                                            :\r\n                                            <div className='wish_list'>\r\n                                                <FaRegHeart\r\n                                                    className=\"no_wish_icon\"\r\n                                                    size={22}\r\n                                                    onClick={HnadleNotLogin}\r\n                                                />\r\n                                            </div>\r\n                                        }\r\n                                    </div>\r\n                                </div>\r\n                            ))}\r\n                        </Slider>\r\n                    </div>\r\n                </div>}\r\n        </section>\r\n    );\r\n}\r\n\r\n\r\n\r\nexport default SimilarProduct","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\kit\\ClearAllModal\\ClearAllModal.jsx",[],[],"C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\kit\\CouponModal\\CouponModal.jsx",[],[],"C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\Category\\HeaderTabs.jsx",["1453","1454","1455","1456","1457"],[],"\r\n\r\n\r\nimport React, { useCallback, useEffect, useMemo, useRef, useState } from \"react\";\r\nimport { Button, Card, Skeleton, Space, Tabs } from \"antd\";\r\nimport SideBar from \"./SideBar\";\r\nimport \"../../style/Category.css\";\r\nimport { FetchCategoryItem, FetchCategorySubItem } from \"../apiService/api\";\r\nimport { useParams } from \"react-router-dom\";\r\nimport { useCategotyLayout } from \"../auth/context/authContext\";\r\nimport ProductCard from \"./ProductCard\";\r\nimport ProductFilter from \"./ProductFilter\";\r\nimport { FaArrowLeft, FaArrowRight } from \"react-icons/fa\";\r\nimport { useScreen } from \"../auth/AuthScreen\";\r\nconst { TabPane } = Tabs;\r\n\r\nconst HeaderTabs = React.memo(() => {\r\n  const { screenWidth } = useScreen();\r\n\r\n  const [itemType, setItemType] = useState(\"\")\r\n  const [filterBy, setFilterBy] = useState(\"\")\r\n  const [brandId, setBrandId] = useState(\"\")\r\n  const [isSubLoading, setIsSubLoading] = useState(true); // Separate loading state for subcategories\r\n  const [subItemList, setSubItemList] = useState([]);\r\n  const [cachedSubCategories, setCachedSubCategories] = useState({});\r\n  const titleCase = str => str.toLowerCase().split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');\r\n\r\n  const {\r\n    storeSubCategoryId,\r\n    subCategoryId,\r\n    categoryItemId,\r\n    storeCategoryItemTitle,\r\n  } = useCategotyLayout();\r\n\r\n  const { id } = useParams();\r\n\r\n  const tabsRef = useRef(null);\r\n\r\n  const scrollTabs = (direction) => {\r\n    const wrap = tabsRef.current?.querySelector(\".ant-tabs-nav-wrap\");\r\n    if (wrap) {\r\n      wrap.scrollBy({\r\n        left: direction === \"right\" ? 200 : -200,\r\n        behavior: \"smooth\",\r\n      });\r\n    }\r\n  };\r\n\r\n\r\n  const subCategoryMap = subItemList.reduce((map, item) => {\r\n    map[item.subCategoryId] = item.subCategoryName;\r\n    return map;\r\n  }, {});\r\n\r\n  // const handleSubcategory = (key) => {\r\n  //   const subCategoryName = subCategoryMap[key];\r\n  //   storeSubCategoryId(key);\r\n  //   storeCategoryItemTitle(subCategoryName);\r\n  //   // Perform any other action here\r\n  // };\r\n\r\n  const handleSubcategory = useCallback(\r\n    (key) => {\r\n      // Look up the subcategory name from the cache or the current list\r\n      const subCategoryName = cachedSubCategories[key]?.subCategoryName || subCategoryMap[key];\r\n\r\n      // Store the selected subcategory ID and title if they have changed\r\n      storeSubCategoryId(key);\r\n      storeCategoryItemTitle(subCategoryName);\r\n\r\n      // Cache the selected subcategory if not already cached\r\n      if (!cachedSubCategories[key]) {\r\n        setCachedSubCategories((prevCache) => ({\r\n          ...prevCache,\r\n          [key]: { subCategoryName },\r\n        }));\r\n      }\r\n    },\r\n    [cachedSubCategories, storeSubCategoryId, storeCategoryItemTitle, subCategoryMap]\r\n  );\r\n\r\n\r\n  const fetchSubItems = async () => {\r\n    setIsSubLoading(true);\r\n    try {\r\n      const subCategoryResponse = await FetchCategorySubItem(categoryItemId ?? id);\r\n\r\n      if (subCategoryResponse.status === 200) {\r\n        const subCategoryData = [{ subCategoryId: 0, subCategoryName: \"All\" }, ...subCategoryResponse.data.data];\r\n        setSubItemList(subCategoryData);\r\n        storeSubCategoryId(subCategoryData[0]?.subCategoryId);\r\n        storeCategoryItemTitle(subCategoryData[0]?.subCategoryName);\r\n        setIsSubLoading(false);\r\n      }\r\n    } catch (error) {\r\n      console.error(\"Error fetching subcategories:\", error);\r\n      setIsSubLoading(false);\r\n    }\r\n  };\r\n\r\n  // Fetch subcategories whenever categoryItemId changes\r\n  useEffect(() => {\r\n    if (categoryItemId) {\r\n      fetchSubItems();\r\n    }\r\n  }, []);\r\n\r\n  const memoizedProduct = useMemo(() => {\r\n    return <ProductCard subItemList={subItemList} itemType={itemType} filterBy={filterBy} brandId={brandId} />;\r\n  }, [subCategoryId, itemType, filterBy, brandId]); // only re-render if categoryItemId\r\n\r\n\r\n\r\n  return (\r\n    <div className=\"header_tab\">\r\n      {isSubLoading ? <Tabs type=\"card\" className=\"header_tabs\">\r\n        {[...Array(10)].map((_, index) => (\r\n          <TabPane\r\n            key={index}\r\n            tab={\r\n              <div id=\"cateogry_header\">\r\n                <Skeleton.Button active />\r\n              </div>\r\n            }\r\n          />\r\n        ))}\r\n      </Tabs> :\r\n        <div ref={tabsRef} className={screenWidth > 800 && \"tabs-scroll-wrapper\"}>\r\n          <Tabs\r\n            type=\"card\"\r\n            defaultActiveKey={categoryItemId}\r\n            className=\"header_tabs\"\r\n            onChange={handleSubcategory}\r\n            tabBarExtraContent={{\r\n              left: screenWidth > 800 && (\r\n                <Button\r\n                  type=\"primary\"\r\n                  icon={<FaArrowLeft />}\r\n                  onClick={() => scrollTabs(\"left\")}\r\n                />\r\n              ),\r\n              right: (\r\n                <Space>\r\n                  {screenWidth > 800 && (\r\n                    <Button\r\n                      type=\"primary\"\r\n                      icon={<FaArrowRight />}\r\n                      onClick={() => scrollTabs(\"right\")}\r\n                    />\r\n                  )}\r\n                  <ProductFilter setFilterBy={setFilterBy} setItemType={setItemType} setBrandId={setBrandId} />\r\n                </Space>\r\n              ),\r\n            }}\r\n          >\r\n            {subItemList.map((item) => (\r\n              <TabPane\r\n                tab={<div id=\"cateogry_header\">\r\n                  <span>{titleCase(item.subCategoryName)}</span>\r\n                </div>}\r\n                key={item.subCategoryId}\r\n                className=\"show_sub_category\"\r\n              >\r\n                <div className=\"allProduct\">\r\n                  {memoizedProduct}\r\n                </div>\r\n              </TabPane>\r\n            ))}\r\n\r\n          </Tabs>\r\n        </div>\r\n      }\r\n    </div>\r\n  );\r\n});\r\n\r\nexport default HeaderTabs;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\Category\\SideBar.jsx",["1458","1459","1460","1461","1462","1463","1464","1465","1466","1467","1468","1469","1470","1471","1472","1473","1474"],[],"\r\n\r\n// import React, { useCallback, useEffect, useState } from \"react\";\r\n// import { Badge, Button, Card, Divider, Radio, Select, Tabs, Skeleton } from \"antd\";\r\n// import { Navigate, useNavigate, useParams } from \"react-router-dom\";\r\n// import Logo from \"../../assest/bkdlogo.png\";\r\n// import ProductCard from \"./ProductCard\";\r\n// import { useCategotyLayout } from \"../auth/context/authContext\";\r\n// import HeaderTabs from \"./HeaderTabs\";\r\n// import { FetchCategoryItem } from \"../apiService/api\";\r\n\r\n// const { TabPane } = Tabs;\r\n\r\n// function SideBar() {\r\n//   const navigate=useNavigate()\r\n//   const { id } = useParams();\r\n//   const [loading, setLoading] = useState(false)\r\n//     const [current, setCurrent] = useState(1);\r\n//     const [catItemList, s
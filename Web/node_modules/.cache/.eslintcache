ar, FloatButton, List, notification } from \"antd\";\r\nimport Hearder from \"./component/header/Hearder\";\r\nimport { useEffect, useState } from \"react\";\r\nimport { useScreen } from \"./component/auth/AuthScreen\";\r\nimport Logo from \"./assest/bkdlogo.png\"\r\n\r\nimport BottomTabs from \"./component/home/BottomTabs\";\r\nimport { GetUserProfile } from \"./component/apiService/api\";\r\nimport PrivateRoute from \"./page/PrivateRoute\";\r\nimport { useAuth } from \"./component/auth/context/authContext\";\r\nimport TermHeader from \"./component/header/TermHeader\";\r\nimport { initializeSecurity } from \"./utils/securityUtils\";\r\n\r\nfunction App() {\r\n  const location = useLocation();\r\n  const { pathname } = location;\r\n  const [isLoading, setIsLoading] = useState(true);\r\n  const { screenWidth } = useScreen();\r\n  const { token, CurrentUserInfo, logout, getFcmToken, fcmtoken, nearStore } = useAuth();\r\n  const FcmAccessTokens = process.env.REACT_APP_FCM_TOKEN;\r\n\r\n  const [isOnline, setIsOnline] = useState(navigator.onLine);\r\n\r\n  // Initialize security measures (disable console, devtools shortcuts, etc.)\r\n  useEffect(() => {\r\n    initializeSecurity();\r\n  }, []);\r\n\r\n  const updateNetworkStatus = () => {\r\n    setIsOnline(navigator.onLine);\r\n  };\r\n\r\n  useEffect(() => {\r\n    window.addEventListener('online', updateNetworkStatus);\r\n    window.addEventListener('offline', updateNetworkStatus);\r\n\r\n    // Cleanup the event listeners\r\n    return () => {\r\n      window.removeEventListener('online', updateNetworkStatus);\r\n      window.removeEventListener('offline', updateNetworkStatus);\r\n    };\r\n  }, []);\r\n\r\n  const navigate = useNavigate();\r\n\r\n  useEffect(() => {\r\n    if (!isOnline) {\r\n      navigate('/NoInternet')\r\n    }\r\n  }, [isOnline])\r\n\r\n  useEffect(() => {\r\n    window.scrollTo(0, 0);\r\n  }, [location]);\r\n\r\n  useEffect(() => {\r\n    const requestPermissionAndToken = async () => {\r\n      try {\r\n        // Check if Firebase messaging is supported\r\n        if (!messaging || !getToken) {\r\n          return;\r\n        }\r\n\r\n        // Check if we're in a secure context (HTTPS or localhost)\r\n        if (!window.isSecureContext) {\r\n          return;\r\n        }\r\n\r\n        // Check current notification permission\r\n        const currentPermission = Notification.permission;\r\n\r\n        // If permission is not \"granted\", we show a prompt (e.g., custom popup) to encourage users\r\n        if (!nearStore && (currentPermission === \"default\" || currentPermission === \"denied\")) {\r\n          const permission = await Notification.requestPermission();\r\n          if (permission === \"granted\") {\r\n            const tokens = await getToken(messaging, {\r\n              vapidKey: FcmAccessTokens,\r\n            });\r\n            // Send token to your server or store it for future use\r\n            getFcmToken(tokens);\r\n          }\r\n        } else if (currentPermission === \"granted\") {\r\n          // If permission is already granted, just get the token\r\n          const tokens = await getToken(messaging, {\r\n            vapidKey: FcmAccessTokens,\r\n          });\r\n          getFcmToken(tokens);\r\n        }\r\n      } catch (error) {\r\n        // Don't break the app if FCM fails\r\n      }\r\n    };\r\n\r\n    requestPermissionAndToken();\r\n  }, [nearStore, getFcmToken, FcmAccessTokens]);\r\n\r\n  useEffect(() => {\r\n    // Check if Firebase messaging is supported\r\n    if (!messaging || !onMessage) {\r\n      return;\r\n    }\r\n\r\n    const handleMessage = (payload) => {\r\n      notification.open({\r\n        placement: \"topRight\",\r\n        message: (\r\n          <List itemLayout=\"horizontal\">\r\n            <List.Item onClick={() => navigate(`/account/order-detail/${payload.data.userOrderId}`)}>\r\n              <List.Item.Meta\r\n                avatar={<Avatar src={Logo} />}\r\n                title={<span>{payload?.notification?.title}</span>}\r\n                description={payload?.notification?.body}\r\n              />\r\n            </List.Item>\r\n          </List>\r\n        ),\r\n      });\r\n    };\r\n\r\n    let unsubscribe;\r\n    try {\r\n      unsubscribe = onMessage(messaging, handleMessage);\r\n    } catch (error) {\r\n      // Silent fail for messaging setup\r\n    }\r\n\r\n    return () => {\r\n      if (unsubscribe) {\r\n        unsubscribe();\r\n      }\r\n    };\r\n  }, [navigate]);\r\n\r\n  const isSubdomainRoute = ['/terms', '/policy', '/abouts', '/faq'].includes(pathname);\r\n\r\n  const ShowProfileInfo = async () => {\r\n    try {\r\n      await GetUserProfile(token)\r\n        .then((res) => {\r\n          if (res.status == 200) {\r\n            CurrentUserInfo(res.data.data);\r\n            localStorage.setItem(\"userData\", JSON.stringify(res.data.data));\r\n          } else if (res.status == 283) {\r\n            logout();\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          // Handle error silently\r\n        });\r\n    } catch (error) {\r\n      // Handle error silently\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    if (token != null) {\r\n      ShowProfileInfo();\r\n    }\r\n  }, [token]);\r\n\r\n  //always scroll up\r\n  useEffect(() => {\r\n    window.scrollTo(0, 0);\r\n  }, [navigate]);\r\n\r\n  useEffect(() => {\r\n    // const timer = setTimeout(() => {\r\n    //   setIsLoading(false);\r\n    // }, 3000);\r\n\r\n    // return () => clearTimeout(timer);\r\n    setIsLoading(false);\r\n  }, []);\r\n\r\n  if (isLoading) {\r\n    return (\r\n      <div className=\"loadingScreen\">\r\n        <span className=\"loader1\">BKD</span>\r\n      </div>\r\n    );\r\n  } else {\r\n    return (\r\n      <div className=\"App\">\r\n        <div className=\"head\"> {pathname === '/search' ? null : pathname === '/handleJuspayResponse' || !isOnline ? null : isSubdomainRoute ? <TermHeader /> : <Hearder />}</div>\r\n        <div className={isSubdomainRoute ? \" \" : \"main\"}>\r\n          <Routes>\r\n            {Allroutes.map((route, index) => (\r\n              <Route\r\n                key={index}\r\n                path={route.path}\r\n                element={\r\n                  route.children ? (\r\n                    <PrivateRoute element={route.element}>\r\n                      <Outlet />\r\n                    </PrivateRoute>\r\n                  ) : (\r\n                    route.element\r\n                  )\r\n                }\r\n              >\r\n                {route.children &&\r\n                  route.children.map((childRoute, childIndex) => (\r\n                    <Route\r\n                      key={childIndex}\r\n                      path={childRoute.path}\r\n                      element={childRoute.element}\r\n                    />\r\n                  ))}\r\n              </Route>\r\n            ))}\r\n            <Route path=\"/\" element={<Navigate to=\"/home\" />} />\r\n          </Routes>\r\n        </div>\r\n        <div className=\"cat_bottom\">\r\n          {screenWidth > 800 ? (\r\n            <FloatButton.BackTop className=\"scrollTop\" />\r\n          ) : (\r\n            <BottomTabs token={token} />\r\n          )}\r\n        </div>\r\n      </div>\r\n    );\r\n  }\r\n}\r\n\r\nexport default App;","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\redux\\store.js",[],[],"C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\auth\\AuthScreen.js",[],[],"C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\auth\\context\\authContext.js",[],[],"C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\firebase.js",[],[],"C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\routes.js",["744"],[],"import ProductDetails from \"./component/Product/ProductDetails\";\r\nimport CheckOutProduct from \"./component/checkout/CheckOutProduct\";\r\nimport Home from \"./component/home/Home\";\r\nimport SearchProduct from \"./component/home/SearchProduct\";\r\nimport MyOrder from \"./component/account/order/MyOrder\";\r\nimport OrderDetails from \"./component/account/order/OrderDetails\";\r\nimport WishList from \"./component/account/wish/WishList\";\r\nimport AddressManage from \"./component/address/AddressManage\";\r\nimport Wollets from \"./component/account/wallet/Wollets\";\r\nimport Profile from \"./component/account/profile/MyProfile.jsx\";\r\nimport Support from \"./component/account/support/Support\";\r\nimport OrderTrack from \"./component/checkout/OrderTrack.jsx\";\r\nimport AllRecipes from \"./component/Racipe/AllRecipes.jsx\";\r\nimport ViewAllProduct from \"./component/Product/ViewAllProduct.jsx\";\r\nimport AllBrandList from \"./component/home/AllBrandList.jsx\";\r\nimport AllCategoryList from \"./component/Category/AllCategoryList.jsx\";\r\nimport WallletCheckout from \"./component/account/wallet/WallletCheckout.jsx\";\r\nimport PoolOrderProduct from \"./component/poolOrder/PoolOrderProduct.jsx\";\r\nimport MyAccounts from \"./component/account/accountMenu/MyAccounts.jsx\";\r\nimport SearchHearder from \"./component/header/SearchHeader.jsx\";\r\nimport NotFound from \"./page/NotFound.js\";\r\nimport BrandBaseProduct from \"./component/home/BrandBaseProduct.jsx\";\r\nimport TermCondition from \"./component/cms/TermCondition.jsx\";\r\nimport Aboutus from \"./component/cms/Aboutus.jsx\";\r\nimport PrivecyPolicy from \"./component/cms/PrivecyPolicy.jsx\";\r\nimport BankDetails from \"./component/account/bankDetails/BankDetails.jsx\";\r\nimport BeforeCheckoutAllView from \"./component/cart/BeforeCheckoutAllView.jsx\";\r\nimport ExploreCateory from \"./component/Category/ExploreCategory.jsx\";\r\nimport UserPayment from \"./component/checkout/UserPayment.jsx\";\r\nimport ReturnOrderDetails from \"./component/account/order/ReturnOrderDetails.jsx\";\r\nimport SegmentDetails from \"./component/segment/SegmentDetails.jsx\";\r\nimport ReturnReplaceTrack from \"./component/account/order/ReturnReplaceTrack.jsx\";\nimport NoConnection from \"./page/NoConnection.jsx\";\nimport FaqData from \"./component/cms/FaqData.jsx\";\nimport ContactUs from \"./component/cms/ContactUs.jsx\";\nimport GetShareLink from \"./component/shareLink/GetShareLink.jsx\";\nimport Offer from \"./component/referralOffer/Offer.jsx\";\n// import NewCheckOutProduct from \"./component/checkout/NewCheckOutProduct.jsx\";\r\n\r\n// Main routes object with child routes\r\n\r\nconst Allroutes = [\r\n  {\r\n    path: \"/home\",\r\n    element: <Home />,\r\n  },\r\n  {\r\n    path: \"/search\",\r\n    element: <SearchHearder />,\r\n  },\r\n  {\r\n    path: \"/category/:id\",\r\n    element: <ExploreCateory />\r\n  },\r\n  {\r\n    path: \"/product/:id\",\r\n    element: <ProductDetails />,\r\n  },\r\n\r\n  {\r\n    path: \"/all_see_product\",\r\n    element: <ViewAllProduct />,\r\n  },\r\n  {\r\n    path: \"/brand-product/:id\",\r\n    element: <BrandBaseProduct />,\r\n  },\r\n  {\r\n    path: \"/searchProduct\",\r\n    element: <SearchProduct />,\r\n  },\r\n\r\n  {\r\n    path: \"/checkout/:id\",\r\n    element: <CheckOutProduct />,\r\n  },\r\n  // {\r\n  //   path: \"/newCheckout/:id\",\r\n  //   element: <NewCheckOutProduct />,\r\n  // },\r\n  {\r\n    path: \"/all_brand\",\r\n    element: <AllBrandList />,\r\n  },\r\n  {\r\n    path: \"/terms\",\r\n    element: <TermCondition />,\r\n  },\r\n  {\r\n    path: \"/abouts\",\r\n    element: <Aboutus />,\r\n  },\r\n  {\n    path: \"/faq\",\n    element: <FaqData />,\n  },\n  {\n    path: \"/contact-us\",\n    element: <ContactUs />,\n  },\n  {\n    path: \"/policy\",\n    element: <PrivecyPolicy />,\n  },\n  {\r\n    path: \"/all_category\",\r\n    element: <AllCategoryList />,\r\n  },\r\n  {\r\n    path: \"/recipes-detials/:id\",\r\n    element: <AllRecipes />,\r\n  },\r\n  {\r\n    path: \"/view-before-checkout\",\r\n    element: <BeforeCheckoutAllView />,\r\n  },\r\n  {\r\n    path: \"/pool-Order\",\r\n    element: <PoolOrderProduct />,\r\n  },\r\n  {\r\n    path: \"/handleJuspayResponse\",\r\n    element: <UserPayment />,\r\n  },\r\n  {\r\n    path: \"/segment-detials/:id\",\r\n    element: <SegmentDetails />,\r\n  },\r\n  {\r\n    path: \"/share-link\",\r\n    element: <GetShareLink />,\r\n  },\r\n  {\r\n    path: \"/offer\",\r\n    element: <Offer />,\r\n  },\r\n  {\r\n    path: \"/account\",\r\n    element: <MyAccounts />,\r\n    children: [\r\n      {\r\n        path: \"/account/order\",\r\n        element: <MyOrder />,\r\n      },\r\n      {\r\n        path: \"/account/order-detail/:id\",\r\n        element: <OrderDetails />,\r\n      },\r\n      {\r\n        path: \"/account/return-order-detail/:id\",\r\n        element: <ReturnOrderDetails />,\r\n      },\r\n      {\r\n        path: \"/account/wishlist\",\r\n        element: <WishList />,\r\n      },\r\n      {\r\n        path: \"/account/bank\",\r\n        element: <BankDetails />,\r\n      },\r\n      {\r\n        path: \"/account/address\",\r\n        element: <AddressManage />,\r\n      },\r\n      {\r\n        path: \"/account/wallet\",\r\n        element: <Wollets />,\r\n      },\r\n\r\n      {\r\n        path: \"/account/profile\",\r\n        element: <Profile />,\r\n      },\r\n      {\r\n        path: \"/account/support\",\r\n        element: <Support />,\r\n      },\r\n      {\r\n        path: \"/account/track_order/:id\",\r\n        element: <OrderTrack />,\r\n      },\r\n      {\r\n        path: \"/account/return-track_order/:id\",\r\n        element: <ReturnReplaceTrack />,\r\n      },\r\n    ],\r\n  },\r\n  { path: \"*\", element: <NotFound /> },\r\n  { path: \"/NoInternet\", element: <NoConnection /> },\r\n];\r\n\r\nexport default Allroutes;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\redux\\CategoriesSlice.js",[],[],"C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\redux\\CartSlice.js",["745","746","747"],[],"// its working latest--------------------------------------------->\r\n\r\nimport { createSlice } from \"@reduxjs/toolkit\";\r\nimport { message, notification } from \"antd\";\r\nimport { calculateSubTotal } from \"../utils/CalculateSubTotal\";\r\n\r\nconst cartData = {\r\n  unit: 1,\r\n};\r\n\r\n\r\nconst calculateTotalAmount = (items) => {\r\n  if (!Array.isArray(items)) return 0; // Ensure items is an array before reducing\r\n  return items.reduce((total, item) => {\r\n    const comboTotal = item.combo_total ?? 0;  // Default to 0 if null/undefined\r\n    const subTotal = item.sub_total ?? 0;\r\n    return total + subTotal + comboTotal;\r\n  }, 0);\r\n  // return items.reduce((total, item) => total + (item.sub_total + item.combo_total || 0), 0);\r\n};\r\n\r\nconst calculateMrpTotalAmount = (items) => {\r\n  if (!Array.isArray(items)) return 0; // Ensure items is an array before reducing\r\n  return items.reduce((total, item) => {\r\n    const mrpOfferTotal = item.selected_offer?.mrp_offer_total ?? 0;  // Default to 0 if null/undefined\r\n    const mrpTotal = item.mrp_sub_total ?? 0;\r\n\r\n    return total + mrpTotal;\r\n  }, 0);\r\n};\r\n\r\n// Step-by-step offer calculation following exact user pattern\r\nconst calculateOfferDistribution = (userQuantity, offerDetails) => {\r\n  if (!offerDetails || !userQuantity) {\r\n    return {\r\n      regularQty: userQuantity || 0,\r\n      offerQty: 0,\r\n      totalQty: userQuantity || 0,\r\n      offerCycles: 0\r\n    };\r\n  }\r\n\r\n  const offerQty = parseInt(offerDetails?.promoType?.split('+')[1] || '0');\r\n\r\n  const { billingQty } = offerDetails;\r\n\r\n  // Based on your exact requirements:\r\n  // 1+1 offer: Buy 1, Get 1 Free (billingQty=1, offerQty=1)\r\n  // 2+1 offer: Buy 2, Get 1 Free (billingQty=2, offerQty=1)\r\n\r\n  if (billingQty === 1 && offerQty === 1) {\r\n    // Special case for 1+1 offers\r\n    if (userQuantity === 1) {\r\n      return {\r\n        regularQty: 1,  // User pays for 1\r\n        offerQty: 0,     // No free items yet\r\n        totalQty: 1,\r\n        offerCycles: 0\r\n      };\r\n    } else {\r\n      // For 2 or more items with 1+1\r\n      // User always pays for half (rounded up), gets half free\r\n      const pairs = Math.floor(userQuantity / 2);\r\n      const remainder = userQuantity % 2;\r\n      return {\r\n        regularQty: pairs + remainder,  // Items user pays for\r\n        offerQty: pairs,                // Free items (2nd item of each pair)\r\n        totalQty: userQuantity,         // Total is just what user requested\r\n        offerCycles: pairs\r\n      };\r\n    }\r\n  } else if (billingQty === 1 && offerQty === 2) {\r\n    if (userQuantity < 3) {\r\n      // Not enough to complete one full offer cycle\r\n      return {\r\n        regularQty: userQuantity,\r\n        offerQty: 0,\r\n        totalQty: userQuantity,\r\n        offerCycles: 0\r\n      };\r\n    } else {\r\n      const cycleSize = billingQty + offerQty; // 1 + 2 = 3\r\n      const completeCycles = Math.floor(userQuantity / cycleSize);\r\n      const remainder = userQuantity % cycleSize;\r\n\r\n      return {\r\n        regularQty: completeCycles * billingQty + remainder,\r\n        offerQty: completeCycles * offerQty,\r\n        totalQty: userQuantity,\r\n        offerCycles: completeCycles\r\n      };\r\n    }\r\n  } else if (billingQty === 1 && offerQty === 3) {\r\n    if (userQuantity < 4) {\r\n      // Not enough to complete one full offer cycle\r\n      return {\r\n        regularQty: userQuantity,\r\n        offerQty: 0,\r\n        totalQty: userQuantity,\r\n        offerCycles: 0\r\n      };\r\n    } else {\r\n      const cycleSize = billingQty + offerQty; // 1 + 3 = 4\r\n      const completeCycles = Math.floor(userQuantity / cycleSize);\r\n      const remainder = userQuantity % cycleSize;\r\n\r\n      return {\r\n        regularQty: completeCycles * billingQty + remainder,\r\n        offerQty: completeCycles * offerQty,\r\n        totalQty: userQuantity,\r\n        offerCycles: completeCycles\r\n      };\r\n    }\r\n  } else {\r\n    // Standard logic for other offers (2+1, 3+1, etc.)\r\n    const completeSets = Math.floor(userQuantity / billingQty);\r\n    const remainder = userQuantity % billingQty;\r\n\r\n    return {\r\n      regularQty: remainder + (completeSets * billingQty), // All items user requested\r\n      offerQty: completeSets * offerQty,                   // Free bonus items\r\n      totalQty: userQuantity + (completeSets * offerQty),\r\n      offerCycles: completeSets\r\n    };\r\n  }\r\n};\r\n\r\n// const calculateOfferDistribution = (userQuantity, offerDetails) => {\r\n//   if (!offerDetails || !userQuantity) {\r\n//     return {\r\n//       regularQty: userQuantity || 0,\r\n//       offerQty: 0,\r\n//       totalQty: userQuantity || 0,\r\n//       offerCycles: 0\r\n//     };\r\n//   }\r\n\r\n//   const [buy, free] = offerDetails?.promoType?.split('+').map(Number);\r\n\r\n//   const billingQty = buy;   // ✅ pay for this\r\n//   const offerQty = free;    // ✅ get this free\r\n\r\n//   const cycleSize = billingQty + offerQty;\r\n\r\n//   const completeCycles = Math.floor(userQuantity / cycleSize);\r\n//   const remainder = userQuantity % cycleSize;\r\n\r\n//   return {\r\n//     regularQty: completeCycles * billingQty + Math.min(remainder, billingQty),\r\n//     offerQty: completeCycles * offerQty,\r\n//     totalQty: userQuantity,\r\n//     offerCycles: completeCycles\r\n//   };\r\n// };\r\n\r\nconst calculateNewUpdateOfferQty = (unit, billingQty, offerQty) => {\r\n  // Use the new offer distribution calculation\r\n  const result = calculateOfferDistribution(unit, { billingQty, qty: offerQty });\r\n  return result.offerQty;\r\n};\r\n\r\nconst getSafeCart = () => {\r\n  try {\r\n    const data = JSON.parse(localStorage.getItem(\"cart\"));\r\n    return Array.isArray(data) ? data : [];\r\n  } catch (e) {\r\n    return [];\r\n  }\r\n};\r\n\r\nconst cartSlice = createSlice({\r\n  name: \"cart\",\r\n  initialState: {\r\n    items: getSafeCart(),\r\n    TotalAmount: calculateTotalAmount(\r\n      JSON.parse(localStorage.getItem(\"cart\")) || []\r\n    ),\r\n    MrpTotalAmount: calculateMrpTotalAmount(\r\n      JSON.parse(localStorage.getItem(\"cart\")) || []\r\n    ),\r\n    offerQty: 1,\r\n    billingQty: 1,\r\n    selectOffer: null, // Properly initialized to an empty object\r\n  },\r\n  reducers: {\r\n\r\n    addItem: (state, action) => {\r\n      const ItemIndex = state.items.findIndex(\r\n        (item) => item.productCode === action.payload.productCode\r\n      );\r\n\r\n      if (ItemIndex >= 0) {\r\n        const item = state.items[ItemIndex];\r\n        const { selected_offer, stockQty } = action.payload;\r\n        const newQuantity = item.unit + 1;\r\n\r\n        // Check stock availability\r\n        const offerCalc = calculateOfferDistribution(newQuantity, selected_offer);\r\n        if (stockQty && offerCalc.totalQty > stockQty) {\r\n          notification.warning({\r\n            placement: \"topRight\",\r\n            message: \"Limited stock available! Order soon.\",\r\n          });\r\n          return;\r\n        }\r\n\r\n        // Update quantity\r\n        state.items[ItemIndex].unit = newQuantity;\r\n        state.items[ItemIndex].calculated_offer_qty = offerCalc.offerQty;\r\n        state.items[ItemIndex].calculated_total_qty = offerCalc.totalQty;\r\n\r\n        // Calculate pricing - user only pays for regularQty\r\n        if (selected_offer) {\r\n\r\n          // Simple pricing: user pays for regularQty items only\r\n          state.items[ItemIndex].sub_total = calculateSubTotal({\r\n            offerCalc,\r\n            offer: selected_offer,\r\n            price: item.price,\r\n            bkdAmount: item.bkdAmount,\r\n          });\r\n          // state.items[ItemIndex].sub_total = regularQty * item.bkdAmount;\r\n          state.items[ItemIndex].combo_total = 0;\r\n\r\n          // MRP calculations (for all items user requested)\r\n          state.items[ItemIndex].mrp_sub_total = newQuantity * item.price;\r\n\r\n          // Update offer details\r\n          if (state.items[ItemIndex].selected_offer) {\r\n            state.items[ItemIndex].selected_offer.OfferQty = offerCalc.offerQty;\r\n            state.items[ItemIndex].selected_offer.mrp_offer_total = offerCalc.offerQty * item.price;\r\n          }\r\n        } else {\r\n          // No offer - simple calculation\r\n          state.items[ItemIndex].sub_total = newQuantity * item.bkdAmount;\r\n          state.items[ItemIndex].combo_total = 0;\r\n          state.items[ItemIndex].mrp_sub_total = newQuantity * item.price;\r\n        }\r\n      } else {\r\n        // New item\r\n        const newQuantity = action.payload.unit || 1;\r\n        const offerCalc = calculateOfferDistribution(newQuantity, action.payload.selected_offer);\r\n\r\n        // Check stock\r\n        if (action.payload.stockQty && offerCalc.totalQty > action.payload.stockQty) {\r\n          notification.warning({\r\n            placement: \"topRight\",\r\n            message: \"Limited stock available! Order soon.\",\r\n          });\r\n          return;\r\n        }\r\n\r\n        const temp = {\r\n          ...action.payload,\r\n          ...cartData,\r\n          unit: newQuantity,\r\n          calculated_offer_qty: offerCalc.offerQty,\r\n          calculated_total_qty: offerCalc.totalQty,\r\n          sub_total: action.payload.selected_offer\r\n            ? calculateSubTotal({ offerCalc, offer: action.payload.selected_offer, price: action.payload.price, bkdAmount: action.payload.bkdAmount })\r\n            : newQuantity * action.payload.bkdAmount,\r\n          combo_total: 0,\r\n          mrp_sub_total: newQuantity * action.payload.price,\r\n          selected_offer: action.payload.selected_offer\r\n            ? {\r\n              ...action.payload.selected_offer,\r\n              OfferQty: offerCalc.offerQty,\r\n              billingQty: action.payload.selected_offer.billingQty,\r\n              mrp_offer_total: offerCalc.offerQty * action.payload.price,\r\n            }\r\n            : null,\r\n        };\r\n        state.items.push(temp);\r\n      }\r\n\r\n      state.TotalAmount = calculateTotalAmount(state.items);\r\n      state.MrpTotalAmount = calculateMrpTotalAmount(state.items);\r\n    },\r\n\r\n    addAutoApplyOffer: (state, action) => {\r\n      state.items = action.payload.map(item => {\r\n        const userQuantity = item.qty || item.unit;\r\n        const offerCalc = calculateOfferDistribution(userQuantity, item.selected_offer);\r\n\r\n        return {\r\n          ...item,\r\n          unit: userQuantity,\r\n          calculated_offer_qty: offerCalc.offerQty,\r\n          calculated_total_qty: offerCalc.totalQty,\r\n          sub_total: item.selected_offer\r\n            ? calculateSubTotal({ offerCalc, offer: item.selected_offer, price: item.price, bkdAmount: item.bkdAmount })\r\n            : item.bkdAmount * userQuantity,\r\n          combo_total: 0,\r\n          mrp_sub_total: userQuantity * item.price,\r\n          selected_offer: item.selected_offer\r\n            ? {\r\n              ...item.selected_offer,\r\n              OfferQty: offerCalc.offerQty,\r\n              billingQty: item.selected_offer.billingQty,\r\n              mrp_offer_total: offerCalc.offerQty * item.price,\r\n            }\r\n            : null,\r\n        };\r\n      });\r\n      state.TotalAmount = calculateTotalAmount(state.items);\r\n      state.MrpTotalAmount = calculateMrpTotalAmount(state.items);\r\n    },\r\n\r\n\r\n    addShareCart: (state, action) => {\r\n      const newItems = action.payload;\r\n\r\n      newItems.forEach((newItem) => {\r\n        const existingItemIndex = state.items.findIndex(\r\n          (item) => item.productCode === newItem.productCode\r\n        );\r\n\r\n        const existingItem = existingItemIndex !== -1 ? state.items[existingItemIndex] : null;\r\n\r\n        const newQty = newItem.qty;\r\n        const newOfferQty = newItem.selected_offer?.offerQty || 0;\r\n        const existingQty = existingItem?.unit || 0;\r\n        const existingOfferQty = existingItem?.selected_offer?.OfferQty || 0;\r\n\r\n        const mergedQty = existingQty + newQty;\r\n        const mergedOfferQty = newOfferQty + existingOfferQty;\r\n\r\n        const totalRequiredQty = mergedQty + mergedOfferQty;\r\n        const availableStock = newItem.stockQty;\r\n\r\n        if (totalRequiredQty > availableStock) {\r\n          // Show error (in middleware or component — reducers should not trigger UI)\r\n          notification.warning({\r\n            placement: \"topRight\",\r\n            message: \"Some share product out of stock! Add new product.\",\r\n          })\r\n\r\n          return; // skip adding this item\r\n        }\r\n\r\n        const mergedOffer = newItem.selected_offer || existingItem?.selected_offer;\r\n\r\n        if (existingItemIndex !== -1) {\r\n          // Update existing item\r\n          state.items[existingItemIndex] = {\r\n            ...existingItem,\r\n            unit: mergedQty,\r\n            sub_total: mergedOffer ? 0 : newItem.bkdAmount * mergedQty,\r\n            combo_total: mergedOffer ? mergedOffer.comboPrice * mergedQty : 0,\r\n            mrp_sub_total: newItem.price * mergedQty,\r\n            selected_offer: mergedOffer\r\n              ? {\r\n                ...mergedOffer,\r\n                OfferQty: mergedOfferQty,\r\n                billingQty: mergedOffer.billingQty,\r\n                mrp_offer_total: mergedOfferQty * mergedOffer.price,\r\n              }\r\n              : null,\r\n\r\n          }\r\n          state.TotalAmount = calculateTotalAmount(state.items);\r\n          state.MrpTotalAmount = calculateMrpTotalAmount(state.items);\r\n        } else {\r\n          // Add new item\r\n          state.items.push({\r\n            ...newItem,\r\n            unit: newQty,\r\n            sub_total: newItem.selected_offer ? 0 : newItem.bkdAmount * newQty,\r\n            combo_total: newItem.selected_offer ? newItem.selected_offer.comboPrice : 0,\r\n            mrp_sub_total: newItem.price * newQty,\r\n            selected_offer: newItem.selected_offer\r\n              ? {\r\n                ...newItem.selected_offer,\r\n                OfferQty: newOfferQty,\r\n                billingQty: newItem.selected_offer.billingQty,\r\n                mrp_offer_total: newOfferQty * newItem.selected_offer.price,\r\n              }\r\n              : null,\r\n          });\r\n          state.TotalAmount = calculateTotalAmount(state.items);\r\n          state.MrpTotalAmount = calculateMrpTotalAmount(state.items);\r\n        }\r\n\r\n        // Update totals\r\n        // state.TotalAmount = calculateTotalAmount(state.items);\r\n        // state.MrpTotalAmount = calculateMrpTotalAmount(state.items);\r\n      });\r\n    },\r\n\r\n\r\n    removeItem: (state, action) => {\r\n      const itemIndex = state.items.findIndex(\r\n        (item) => item.productCode === action.payload.productCode\r\n      );\r\n\r\n      if (itemIndex >= 0) {\r\n        if (state.items[itemIndex].unit > 1) {\r\n          const newQuantity = state.items[itemIndex].unit - 1;\r\n          const item = state.items[itemIndex];\r\n\r\n          // Recalculate offer distribution with new quantity\r\n          const offerCalc = calculateOfferDistribution(newQuantity, item.selected_offer);\r\n\r\n          // Update quantity and offer calculations\r\n          state.items[itemIndex].unit = newQuantity;\r\n          state.items[itemIndex].calculated_offer_qty = offerCalc.offerQty;\r\n          state.items[itemIndex].calculated_total_qty = offerCalc.totalQty;\r\n\r\n\r\n          // Recalculate pricing\r\n          if (item.selected_offer) {\r\n\r\n            // Simple pricing: user pays for regularQty items only\r\n            state.items[itemIndex].sub_total = calculateSubTotal({\r\n              offerCalc,\r\n              offer: item.selected_offer,\r\n              price: item.price,\r\n              bkdAmount: item.bkdAmount,\r\n            });\r\n            // state.items[itemIndex].sub_total = regularQty * item.bkdAmount;\r\n            state.items[itemIndex].combo_total = 0;\r\n\r\n            // Update offer details\r\n            if (state.items[itemIndex].selected_offer) {\r\n              state.items[itemIndex].selected_offer.OfferQty = offerCalc.offerQty;\r\n              state.items[itemIndex].selected_offer.mrp_offer_total = offerCalc.offerQty * item.price;\r\n            }\r\n          } else {\r\n            state.items[itemIndex].sub_total = newQuantity * item.bkdAmount;\r\n            state.items[itemIndex].combo_total = 0;\r\n          }\r\n\r\n          state.items[itemIndex].mrp_sub_total = newQuantity * item.price;\r\n        } else if (state.items[itemIndex].unit === 1) {\r\n          state.items.splice(itemIndex, 1);\r\n        }\r\n\r\n        state.TotalAmount = calculateTotalAmount(state.items);\r\n        state.MrpTotalAmount = calculateMrpTotalAmount(state.items);\r\n      }\r\n    },\r\n\r\n    updateCartRemoveItem: (state, action) => {\r\n      const itemIndex = state.items.filter((item) => item.productCode !== action.payload.productCode)\r\n      state.items = itemIndex\r\n\r\n      state.TotalAmount = calculateTotalAmount(state.items);\r\n      state.MrpTotalAmount = calculateMrpTotalAmount(state.items);\r\n    },\r\n\r\n\r\n\r\n    setBillingQty(state, action) {\r\n      state.billingQty = action.payload;\r\n    },\r\n    setCartItem(state, action) {\r\n      state.items = action.payload;\r\n    },\r\n    setOfferProductQty(state, action) {\r\n      state.offerQty = action.payload;\r\n    },\r\n    setMRPTotalAmount(state, action) {\r\n      state.MrpTotalAmount = action.payload;\r\n    },\r\n\r\n    setSelctedOffer(state, action) {\r\n      state.selectOffer = action.payload;\r\n    },\r\n\r\n    clearCart: (state) => {\r\n      state.items = [];\r\n      state.offerQty = 0;\r\n      state.selectOffer = {}; // Clear selectOffer to an empty object\r\n      state.TotalAmount = 0;\r\n    },\r\n  },\r\n});\r\n\r\nexport const {\r\n  addItem,\r\n  addShareCart,\r\n  removeItem,\r\n  updateCartRemoveItem,\r\n  clearCart,\r\n  setBillingQty,\r\n  setOfferProductQty,\r\n  setSelctedOffer,\r\n  setMRPTotalAmount,\r\n  setCartItem,\r\n  addAutoApplyOffer,\r\n  updateCartAutoCalc,\r\n} = cartSlice.actions;\r\n\r\nexport const selectCartItems = (state) => state.cart.items;\r\nexport const selectTotalAmount = (state) => state.cart.TotalAmount;\r\nexport const selectMrpTotalAmount = (state) => state.cart.MrpTotalAmount;\r\nexport const selectedOfferQty = (state) => state.cart.offerQty;\r\nexport const selectedBillingQty = (state) => state.cart.billingQty;\r\nexport const selectNewUpdateOfferQty = (state) => state.cart.newUpdateOfferQty;\r\nexport const selectedOfferType = (state) => state.cart.offerType;\r\nexport const selectProductOffer = (state) => state.cart.selectOffer; // Correct state reference\r\n\r\nexport default cartSlice.reducer;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\page\\PrivateRoute.js",["748","749"],[],"import React from \"react\";\r\nimport { BrowserRouter as Router, Route, Navigate } from \"react-router-dom\";\r\nimport { useAuth } from \"../component/auth/context/authContext\";\r\n\r\n// PrivateRoute component for rendering private routes\r\nconst PrivateRoute = ({ element }) => {\r\n  const { token } = useAuth();\r\n\r\n  return !token ? <Navigate to=\"/home\" /> : element;\r\n};\r\n\r\nexport default PrivateRoute;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\redux\\BannerSlice.js",[],[],"C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\redux\\OrderSlice.js",[],[],"C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\utils\\securityUtils.js",[],[],"C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\redux\\ReturnCartSlice.js",[],[],"C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\apiService\\api.js",[],[],"C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\header\\TermHeader.jsx",["750"],[],"import Container from 'react-bootstrap/Container';\r\nimport Nav from 'react-bootstrap/Nav';\r\nimport Navbar from 'react-bootstrap/Navbar';\r\nimport Logo from \"../../assest/logo.png\"\r\nimport { NavLink } from 'react-router-dom';\r\nimport '../../style/header.css'\r\n\r\nfunction TermHeader() {\r\n    return (\r\n        <Navbar collapseOnSelect expand=\"lg\" className=\"bg-body-tertiary\" bg=\"light\" data-bs-theme=\"light\">\r\n            <Container>\r\n                <Navbar.Brand href=\"/\"><img src={Logo} className='header2_logo' /></Navbar.Brand>\r\n                <Navbar.Toggle aria-controls=\"responsive-navbar-nav\" />\r\n                <Navbar.Collapse id=\"responsive-navbar-nav\">\r\n                    <div className=\"show_tabs\">\r\n                        <Nav>\r\n                            <NavLink to=\"/\" >Home</NavLink>\r\n                            <NavLink to=\"/terms\">Terms & Conditions</NavLink>\r\n                            <NavLink to=\"/policy\">Privacy Policy</NavLink>\r\n                            <NavLink to=\"/abouts\">About us</NavLink>\r\n                            <NavLink to=\"/faq\">FAQ's</NavLink>\r\n                        </Nav>\r\n                    </div>\r\n                </Navbar.Collapse>\r\n            </Container>\r\n        </Navbar>\r\n    );\r\n}\r\n\r\nexport default TermHeader;","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\home\\BottomTabs.jsx",[],[],"C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\header\\Hearder.jsx",["751","752","753","754","755","756","757","758","759","760","761","762","763","764","765","766","767","768","769","770","771","772"],[],"import React, { useEffect, useRef, useState } from \"react\";\r\nimport { Col, Row } from \"react-bootstrap\";\r\nimport \"../../style/header.css\";\r\nimport Logo from \"../../assest/logo.png\";\r\nimport DropdownMenu from \"./DropdownMenu\";\r\nimport { Avatar, Badge, Button, Card, Dropdown, Input, Space } from \"antd\";\r\nimport CartMenu from \"../cart/CartMenu\";\r\nimport Login from \"../auth/Login\";\r\nimport UserMenu from \"./UserMenu\";\r\nimport { Navigate, useLocation, useNavigate } from \"react-router-dom\";\r\nimport axios from \"axios\";\r\nimport { SearchOutlined } from \"@ant-design/icons\";\r\nimport { AiFillHeart, AiOutlineShoppingCart } from \"react-icons/ai\";\r\nimport { MdOutlineAccountBalanceWallet } from \"react-icons/md\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { selectCartItems } from \"../../redux/CartSlice\";\r\nimport { FaHeart } from \"react-icons/fa\";\r\nimport LocationModal from \"./LocationModal\";\r\nimport { useCurrentLocation, useScreen } from \"../auth/AuthScreen\";\r\nimport MenuDrawer from \"./MenuDrawer\";\r\nimport CategoryDwader from \"./CategoryDwader\";\r\nimport { useAuth } from \"../auth/context/authContext\";\r\nimport { GetNearBranch, GetUserProfile } from \"../apiService/api\";\r\nimport { setBranchDetails } from \"../../redux/OrderSlice\";\r\nimport Signup from \"../auth/Signup\";\r\n\r\n\r\n\r\nfunction Hearder() {\r\n  const searchRef = useRef(null);\r\n  const { token, CurrentUserInfo, logout } = useAuth()\r\n  const location = useLocation();\r\n  const searchParams = new URLSearchParams(location.search);\r\n  const referralCode = searchParams.get('referralCode');\r\n  const shouldOpenSignup = !!referralCode;\r\n\r\n  const [initLoading, setInitLoading] = useState(true);\r\n  const navigate = useNavigate();\r\n  const [scrolling, setScrolling] = useState(false);\r\n  const { screenWidth } = useScreen()\r\n  const { userLocation, setUserLocation } = useCurrentLocation()\r\n  const [searchInput, setSearchInput] = useState(\"\")\r\n  const [isLoad, setIsLoad] = useState(false)\r\n  const [locationError, setLocationError] = useState(\"\");\r\n\r\n  // const {userLocation}=useCurrentLocation()\r\n  const mapKey = process.env.REACT_APP_GOOGLE_MAPS_API_KEY\r\n  const navbarClass = scrolling ? \"header header_scroll\" : \"header\";\r\n\r\n  const words = [\"Search... 🍛 Rice\", \"Search... 🛢️ Oil\", \"Search... 🥛 Milk\", \"Search... 🌶️ Masala\", \"Search... 🧈 Butter\", \"Search... 🍞 Bread\"];\r\n  const [currentWordIndex, setCurrentWordIndex] = useState(0);\r\n\r\n  useEffect(() => {\r\n    const interval = setInterval(() => {\r\n      setCurrentWordIndex((prevIndex) => (prevIndex + 1) % words.length);\r\n    }, 3000); // Change word every 2 seconds\r\n\r\n    return () => clearInterval(interval); // Cleanup on unmount\r\n  }, [words.length]);\r\n\r\n  const handleScroll = () => {\r\n    if (window.scrollY > 50) {\r\n      setScrolling(true);\r\n    } else {\r\n      setScrolling(false);\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    window.addEventListener(\"scroll\", handleScroll);\r\n    return () => {\r\n      window.removeEventListener(\"scroll\", handleScroll);\r\n    };\r\n  }, []);\r\n\r\n\r\n\r\n\r\n  const checkPermission = async () => {\r\n    // Check if the site is running on HTTP (not HTTPS)\r\n    const isSecureContext = window.isSecureContext;\r\n    const isLocalhost = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';\r\n\r\n    if (!isSecureContext && !isLocalhost) {\r\n      setLocationError(\"Location access requires HTTPS. Please use a secure connection or enter your location manually.\");\r\n      return;\r\n    }\r\n\r\n    if (!navigator.permissions) {\r\n      // If Permissions API is not supported (older browsers), fallback to direct geolocation access\r\n      getLocationHandle();\r\n      return;\r\n    }\r\n\r\n    try {\r\n      const permission = await navigator.permissions.query({ name: \"geolocation\" });\r\n      if (permission.state === \"granted\") {\r\n        getLocationHandle();\r\n        setLocationError(\"\")\r\n      } else if (permission.state === \"prompt\") {\r\n        getLocationHandle(); // Trigger the geolocation prompt\r\n        setLocationError(\"\")\r\n      } else if (permission.state === \"denied\") {\r\n        setLocationError(\"We do not have permission to determine your location. Please enter manually.\")\r\n      }\r\n    } catch (error) {\r\n      console.error(\"Error checking geolocation permissions:\", error);\r\n      setLocationError(\"Unable to check location permissions. Please enter your location manually.\");\r\n    }\r\n  };\r\n\r\n  async function getLocationHandle() {\r\n    // Check if the site is running on HTTP (not HTTPS)\r\n    const isSecureContext = window.isSecureContext;\r\n    const isLocalhost = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';\r\n\r\n    if (!isSecureContext && !isLocalhost) {\r\n      setLocationError(\"Location access requires HTTPS. Please use a secure connection or enter your location manually.\");\r\n      setIsLoad(false);\r\n      return;\r\n    }\r\n\r\n    if (\"geolocation\" in navigator) {\r\n      setIsLoad(true);\r\n      // Clear previous location cache\r\n      localStorage.removeItem(\"location\");\r\n\r\n      navigator.geolocation.getCurrentPosition(\r\n        async (position) => {\r\n          const latitude = position.coords.latitude;\r\n          const longitude = position.coords.longitude;\r\n\r\n          try {\r\n            const response = await axios.get(\r\n              `https://maps.googleapis.com/maps/api/geocode/json?latlng=${latitude},${longitude}&key=${mapKey}`\r\n            );\r\n\r\n            if (response.data.status === \"OK\") {\r\n              const userLocation = response.data.results[0];\r\n              setUserLocation(userLocation); // Set the state with the user’s location data\r\n              localStorage.setItem(\"location\", JSON.stringify(userLocation)); // Cache new location data\r\n            } else {\r\n              setLocationError(\"Failed to fetch location details.\")\r\n            }\r\n          } catch (error) {\r\n            setLocationError(\"An error occurred while retrieving location details.\")\r\n          } finally {\r\n            setIsLoad(false);\r\n          }\r\n        },\r\n        (error) => {\r\n          handleLocationError(error);\r\n          setIsLoad(false);\r\n        },\r\n        {\r\n          enableHighAccuracy: true, // Enables high-accuracy GPS, if available\r\n          timeout: 5000, // Sets maximum time to wait for location\r\n          maximumAge: 0, // Prevents caching of location\r\n        }\r\n      );\r\n    } else {\r\n      console.error(\"Geolocation is not supported by this browser.\");\r\n      setLocationError(\"Geolocation is not supported by your browser.\");\r\n      setIsLoad(false);\r\n    }\r\n  }\r\n\r\n  function handleLocationError(error) {\r\n    switch (error.code) {\r\n      case error.PERMISSION_DENIED:\r\n        setLocationError(\"We do not have permission to determine your location. Please enter manually.\")\r\n        break;\r\n      case error.POSITION_UNAVAILABLE:\r\n        alert(\"Location information is unavailable.\");\r\n        break;\r\n      case error.TIMEOUT:\r\n        alert(\"Request to fetch location timed out. Please try again.\");\r\n        break;\r\n      default:\r\n        alert(\"An unknown error occurred while fetching location.\");\r\n        break;\r\n    }\r\n    setIsLoad(false); // Reset loading state if an error occurs\r\n  }\r\n\r\n\r\n  const productSearchHandle = (query = \"\") => {\r\n    const target = \"/search\" + (query ? `?q=${encodeURIComponent(query)}` : \"\");\r\n    navigate(target);\r\n  };\r\n\r\n\r\n\r\n  //show current user  \r\n  const ShowProfileInfo = async () => {\r\n    try {\r\n      await GetUserProfile(token)\r\n        .then((res) => {\r\n          // console.log(\"user profile\", res);\r\n          if (res.status == 200) {\r\n            CurrentUserInfo(res.data.data)\r\n            localStorage.setItem(\"userData\", JSON.stringify(res.data.data));\r\n          } else if (res.status == 283) {\r\n            logout()\r\n          }\r\n\r\n        })\r\n        .catch((err) => {\r\n          console.log(err.message);\r\n        });\r\n    } catch (error) {\r\n      console.log(error);\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    if (token) {\r\n      ShowProfileInfo();\r\n    }\r\n  }, [token]);\r\n\r\n\r\n  const handleSearch = (e) => {\r\n    setSearchInput(e.target.value);\r\n  };\r\n\r\n  const handleSearchKey = (e) => {\r\n    if (e.key === \"Enter\") {\r\n      productSearchHandle(e.target.value);\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    if (locationError) {\r\n      const timer = setTimeout(() => {\r\n        setLocationError(\"\"); // clear after 3 sec\r\n      }, 4000);\r\n\r\n      return () => clearTimeout(timer); // cleanup\r\n    }\r\n  }, [locationError]);\r\n\r\n  return (\r\n    <div className={navbarClass}>\r\n      <Row>\r\n        <Col lg={2} sm={12}>\r\n          <div className=\"nav_left_side\">\r\n\r\n            <div className=\"grnad_logo\">\r\n\r\n              <img src={Logo} onClick={() => navigate(\"/\")} />\r\n            </div>\r\n\r\n            {screenWidth < 876 ? <div className=\"carts_sect\" style={{ gap: '0.5rem' }}>\r\n\r\n\r\n\r\n              {screenWidth < 876 ? <Button shape=\"circle\" onClick={productSearchHandle} size=\"large\" icon={<SearchOutlined className=\"search_icon\" />}></Button> : null}\r\n\r\n              <div className=\"mobile_view_card\">\r\n\r\n                <CartMenu />\r\n              </div>\r\n              {screenWidth < 876 ?\r\n                !token ?\r\n                  <div className=\"logins\">\r\n                    <Login />\r\n                  </div>\r\n                  :\r\n                  <div className=\"loggedUser\">\r\n                    <MenuDrawer />\r\n                  </div>\r\n\r\n                : null}\r\n\r\n            </div> : null}\r\n\r\n          </div>\r\n        </Col>\r\n        <Col lg={2}>\r\n          <div className=\"location\">\r\n            <DropdownMenu getLocationHandle={checkPermission} isLoad={isLoad} locationError={locationError} />\r\n            <LocationModal getLocationHandle={checkPermission} isLoad={isLoad} locationError={locationError} />\r\n          </div>\r\n        </Col>\r\n\r\n        <Col lg={6}>\r\n          {screenWidth > 876 ?\r\n            <div className=\"menu\" ref={searchRef}>\r\n              <div className=\"searchs\">\r\n                <Input\r\n                  allowClear\r\n                  placeholder={words[currentWordIndex]}\r\n                  prefix={<SearchOutlined />}\r\n                  className=\"animated-placeholder\"\r\n                  onFocus={() => productSearchHandle(searchInput)}\r\n                  onKeyDown={handleSearchKey}\r\n                  onChange={handleSearch}\r\n                  variant=\"filled\"\r\n                />\r\n              </div>\r\n            </div> : null}\r\n        </Col>\r\n        <Col lg={2}>\r\n\r\n\r\n          {screenWidth > 876 ?\r\n            <div className=\"carts_sect\">\r\n              {!token ? (\r\n                <div className=\"logins\">\r\n                  <Login />\r\n                </div>\r\n              ) : (\r\n                <div className=\"loggedUser\">\r\n                  <UserMenu />\r\n                </div>\r\n              )}\r\n\r\n              <CategoryDwader />\r\n              <CartMenu />\r\n            </div>\r\n            : null}\r\n\r\n        </Col>\r\n      </Row>\r\n      {shouldOpenSignup &&\r\n        <div>\r\n          <Signup\r\n            isNewUser={true}\r\n            hideSignupTrigger={true}\r\n            newNumber=\"\"\r\n            setIsNewUser={() => { }}\r\n            handleCancel={() => { }}\r\n          />\r\n        </div>}\r\n    </div>\r\n  );\r\n}\r\nexport default Hearder;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\page\\NotFound.js",[],[],"C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\home\\AllBrandList.jsx",["773","774","775","776","777"],[],"// import React, { useCallback, useEffect, useState, useRef } from \"react\";\r\n// import { Card, Input } from \"antd
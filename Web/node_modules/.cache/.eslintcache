hCategoryItems();\r\n//   }, [id]);\r\n\r\n//   const sideHandleChange = useCallback(\r\n//     (key) => {\r\n//       const selectedItem = catItemList.find((item) => item.itemCategoryId === key);\r\n\r\n//       if (categoryItemId !== key) {\r\n//         storeCategoryItemId(key);\r\n//       }\r\n\r\n//       if (categoryItemTitle !== selectedItem?.itemCategoryName) {\r\n//         storeCategoryItemTitle(selectedItem?.itemCategoryName);\r\n//       }\r\n//     },\r\n//     [, categoryItemId]\r\n//   );\r\n\r\n//   return (\r\n//     <div className=\"sidebar\">\r\n//       {loading ? (\r\n//         <Skeleton active />\r\n//       ) : (\r\n//         <Tabs\r\n//           defaultActiveKey={categoryItemId}\r\n//           onChange={sideHandleChange}\r\n//           tabPosition=\"left\"\r\n//         >\r\n//           {catItemList.map((item, index) => (\r\n//             <TabPane\r\n//               tab={\r\n//                 <div\r\n//                   className=\"tabs_img\"\r\n//                   // onClick={() => storeCategoryItemTitle(item.itemCategoryName)}\r\n//                 >\r\n//                   {item.imageUrl != null ? (\r\n//                     <img src={item.imageUrl} />\r\n//                   ) : (\r\n//                     <img src={Logo} />\r\n//                   )}\r\n//                   <p>{item.itemCategoryName}</p>{\" \"}\r\n//                 </div>\r\n//               }\r\n//               key={item.itemCategoryId}\r\n//             >\r\n//               <div className=\"cantent_tabs\">\r\n//                   <HeaderTabs />\r\n//               </div>\r\n//             </TabPane>\r\n//           ))}\r\n//         </Tabs>\r\n//       )}\r\n//     </div>\r\n//   );\r\n// }\r\n\r\n// export default SideBar;\r\n\r\n\r\nimport React, { useCallback, useEffect, useMemo, useState } from \"react\";\r\nimport { Badge, Button, Card, Divider, Radio, Select, Tabs, Skeleton } from \"antd\";\r\nimport { Navigate, useLocation, useNavigate, useParams } from \"react-router-dom\";\r\nimport Logo from \"../../assest/bkdlogo.png\";\r\nimport ProductCard from \"./ProductCard\";\r\nimport { useCategotyLayout } from \"../auth/context/authContext\";\r\nimport HeaderTabs from \"./HeaderTabs\";\r\nimport { FetchCategoryItem } from \"../apiService/api\";\r\nimport { decryptCategoryID } from \"../../config/encriptConfig\";\r\n\r\nconst { TabPane } = Tabs;\r\n\r\nconst SideBar = React.memo(() => {\r\n\r\n  const [cachedCategoryData, setCachedCategoryData] = useState({});\r\n  const [loading, setLoading] = useState(false);\r\n  const [current, setCurrent] = useState(1);\r\n  const [catItemList, setCatItemList] = useState([]);\r\n  const titleCase = str => str.toLowerCase().split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');\r\n  // const { state } = useLocation();\r\n  // const { id } = useParams()\r\n  // const location = useLocation()\r\n\r\n  // console.log(\"location\", location)\r\n\r\n  // const { id } = useParams();\r\n  const searchParams = new URLSearchParams(useLocation().search);\r\n  const encryptedCode = searchParams.get(\"uid\");\r\n\r\n  const state = encryptedCode ? decryptCategoryID(decodeURIComponent(encryptedCode)) : null;\r\n  console.log(\"decode state\", state)\r\n\r\n  const {\r\n    storeCategoryItemId,\r\n    categoryItemTitle,\r\n    categoryItemId,\r\n    storeCategoryItemTitle,\r\n  } = useCategotyLayout();\r\n\r\n  const activeTabKey = categoryItemId\r\n    ? String(categoryItemId)\r\n    : String(catItemList[0]?.itemCategoryId ?? \"\");\r\n\r\n  const handleScroll = () => {\r\n    const scrollTop = document.documentElement.scrollTop;\r\n    const scrollHeight = document.documentElement.scrollHeight;\r\n    const clientHeight = document.documentElement.clientHeight;\r\n\r\n    // Check if user has scrolled to the bottom\r\n    if (scrollTop + clientHeight >= scrollHeight - 10) {\r\n      setCurrent((prevPage) => prevPage + 1); // Load next page\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    // Add event listener for scrolling\r\n    window.addEventListener(\"scroll\", handleScroll);\r\n    return () => {\r\n      // Remove event listener when component unmounts\r\n      window.removeEventListener(\"scroll\", handleScroll);\r\n    };\r\n  }, []);\r\n\r\n  const shortHandler = (value) => {\r\n    console.log(value);\r\n  };\r\n\r\n  const filterOpt = [\r\n    { key: 1, values: \"Relevant\" },\r\n    { key: 2, values: \"Price (Low to High)\" },\r\n    { key: 3, values: \"Price (High to Low)\" },\r\n    { key: 4, values: \"Discount (Less 20%)\" },\r\n    { key: 5, values: \"Name (A to Z)\" },\r\n  ];\r\n\r\n  const fetchCategoryItems = async () => {\r\n    setLoading(true);\r\n    try {\r\n      const categoryItemResponse = await FetchCategoryItem(state);\r\n\r\n      if (categoryItemResponse.status === 200) {\r\n        const categoryData = categoryItemResponse.data.data;\r\n        setCatItemList(categoryData);\r\n\r\n        const currentCategoryExists = categoryItemId && categoryData.some(\r\n          (item) => String(item.itemCategoryId) === String(categoryItemId)\r\n        );\r\n\r\n        if (!categoryItemId || !currentCategoryExists) {\r\n          const firstItem = categoryData[0];\r\n          if (firstItem) {\r\n            storeCategoryItemId(firstItem.itemCategoryId);\r\n            storeCategoryItemTitle(firstItem.itemCategoryName);\r\n          }\r\n        } else {\r\n          const currentItem = categoryData.find(\r\n            (item) => String(item.itemCategoryId) === String(categoryItemId)\r\n          );\r\n          if (currentItem && categoryItemTitle !== currentItem.itemCategoryName) {\r\n            storeCategoryItemTitle(currentItem.itemCategoryName);\r\n          }\r\n        }\r\n\r\n        setLoading(false);\r\n      }\r\n    } catch (error) {\r\n      console.error(\"Error fetching category items:\", error);\r\n      setLoading(false);\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    fetchCategoryItems();\r\n  }, [state]);\r\n\r\n  // const sideHandleChange = useCallback(\r\n  //   (key) => {\r\n  //     const selectedItem = catItemList.find((item) => item.itemCategoryId === key);\r\n\r\n  //     if (categoryItemId !== key) {\r\n  //       storeCategoryItemId(key);\r\n  //     }\r\n\r\n  //     if (categoryItemTitle !== selectedItem?.itemCategoryName) {\r\n  //       storeCategoryItemTitle(selectedItem?.itemCategoryName);\r\n  //     }\r\n  //   },\r\n  //   [catItemList, categoryItemId, categoryItemTitle, storeCategoryItemId, storeCategoryItemTitle]\r\n  // );\r\n\r\n\r\n  const sideHandleChange = useCallback(\r\n    (key) => {\r\n      const selectedItem = catItemList.find(\r\n        (item) => String(item.itemCategoryId) === String(key)\r\n      );\r\n      const selectedId = selectedItem?.itemCategoryId ?? key;\r\n\r\n      if (categoryItemId !== selectedId) {\r\n        storeCategoryItemId(selectedId);\r\n      }\r\n      if (categoryItemTitle !== selectedItem?.itemCategoryName) {\r\n        storeCategoryItemTitle(selectedItem?.itemCategoryName);\r\n      }\r\n\r\n      if (!cachedCategoryData[selectedId]) {\r\n        setCachedCategoryData((prevCache) => ({\r\n          ...prevCache,\r\n          [selectedId]: selectedItem,\r\n        }));\r\n      }\r\n\r\n      window.scrollTo({\r\n        top: 0,\r\n        behavior: \"smooth\",\r\n      });\r\n    },\r\n    [catItemList, categoryItemId, categoryItemTitle, storeCategoryItemId, storeCategoryItemTitle, cachedCategoryData]\r\n  );\r\n\r\n  const memoizedHeaderTabs = useMemo(() => {\r\n    return <HeaderTabs />;\r\n  }, [categoryItemId]); // only re-render if categoryItemId changes\r\n\r\n  return (\r\n    <div className=\"sidebar\">\r\n      {loading ? (\r\n        <Skeleton active />\r\n      ) : (\r\n        <Tabs\r\n          activeKey={activeTabKey}\r\n          onChange={sideHandleChange}\r\n          tabPosition=\"left\"\r\n          className=\"sidebar_tabs_container\"\r\n        >\r\n          {catItemList.map((item, index) => (\r\n            <TabPane\r\n              tab={\r\n                <div className=\"tabs_img\">\r\n                  {item.imageUrl != null ? (\r\n                    <img\r\n                      src={item.imageUrl || Logo}\r\n                      onError={(e) => e.currentTarget.src = Logo}\r\n                    />\r\n                  ) : (\r\n                    <img src={Logo} />\r\n                  )}\r\n                  <p>{titleCase(item.itemCategoryName)}</p>\r\n                </div>\r\n              }\r\n              key={String(item.itemCategoryId)}\r\n            >\r\n              <div className=\"cantent_tabs\">\r\n                {/* <HeaderTabs /> */}\r\n                {memoizedHeaderTabs}\r\n              </div>\r\n            </TabPane>\r\n          ))}\r\n        </Tabs>\r\n      )}\r\n    </div>\r\n  );\r\n});\r\n\r\nexport default SideBar;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\account\\wallet\\WalletRedeem.jsx",[],[],"C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\account\\accountMenu\\SideBarRoute.jsx",["1475","1476"],[],"import AddressManage from \"../../address/AddressManage\";\r\nimport MyOrder from \"../order/MyOrder\";\r\nimport MyProfile from \"../profile/MyProfile\";\r\nimport Support from \"../support/Support\";\r\nimport Wollets from \"../wallet/Wollets\";\r\nimport WishList from \"../wish/WishList\";\r\nimport { FiHeart } from \"react-icons/fi\";\r\nimport { MdOutlineShoppingBag ,MdOutlineLocationOn ,MdOutlineAccountBalanceWallet  } from \"react-icons/md\";\r\nimport { FaRegUserCircle  } from \"react-icons/fa\";\r\nimport { BiSupport } from \"react-icons/bi\";\r\nimport { AiOutlineBank } from \"react-icons/ai\";\r\nimport \"../../../style/account.css\"\r\n// Main routes object with sub-menu items\r\nconst routes = [\r\n  \r\n  {\r\n    key: 1,\r\n    path: \"/account/profile\",\r\n    label: \"Profile\",\r\n    icons: <FaRegUserCircle  className=\"acc_icon\"/>,\r\n\r\n    component: MyProfile,\r\n  },\r\n      {\r\n\r\n        key: 2,\r\n        path: \"/account/order\",\r\n        label: \"Order\",\r\n        icons: <MdOutlineShoppingBag  className=\"acc_icon\"/>,\r\n\r\n        component: MyOrder,\r\n      },\r\n      {\r\n        key: 3,\r\n        path: \"/account/wishlist\",\r\n        label: \" Wishlist\",\r\n        icons: <FiHeart className=\"acc_icon\"/>,\r\n\r\n        component: WishList,\r\n      },\r\n      {\r\n        key: 4,\r\n        path: \"/account/address\",\r\n        label: \"Manage Addresses\",\r\n        icons:<MdOutlineLocationOn  className=\"acc_icon\"/>,\r\n\r\n        component: AddressManage,\r\n      },\r\n      {\r\n        key: 5,\r\n        path: \"/account/bank\",\r\n        label: \" Bank Details\",\r\n        icons: <AiOutlineBank className=\"acc_icon\"/>,\r\n\r\n        component: Support,\r\n      },\r\n      // {\r\n      //   key: 6,\r\n      //   path: \"/account/wallet\",\r\n      //   label: \"Wallet\",\r\n      //   icons: <MdOutlineAccountBalanceWallet  className=\"acc_icon\"/>,\r\n\r\n      //   component: Wollets,\r\n      // },\r\n      \r\n      {\r\n        key: 7,\r\n        path: \"/account/support\",\r\n        label: \" Support\",\r\n        icons: <BiSupport className=\"acc_icon\"/>,\r\n\r\n        component: Support,\r\n      },\r\n      \r\n    \r\n   \r\n  \r\n  \r\n  \r\n  \r\n  \r\n \r\n];\r\n\r\nexport default routes;","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\address\\AddressDrawer.jsx",["1477","1478","1479","1480","1481","1482","1483","1484","1485","1486","1487","1488"],[],"import React, { useEffect, useState } from \"react\";\r\nimport {\r\n  Alert,\r\n  Badge,\r\n  Button,\r\n  Card,\r\n  Checkbox,\r\n  Divider,\r\n  Drawer,\r\n  Form,\r\n  Input,\r\n  message,\r\n  notification,\r\n  Skeleton,\r\n  Space,\r\n} from \"antd\";\r\nimport { MdOutlineHome, MdOutlineHomeWork, MdOutlineLocationOn } from \"react-icons/md\";\r\nimport \"../../style/header.css\";\r\nimport axios from \"axios\"\r\nimport { MdMyLocation } from \"react-icons/md\";\r\nimport ShowMap from \"../cart/ShowMap\";\r\nimport { Col, Row } from \"react-bootstrap\"\r\nimport { AddAddress } from \"../apiService/api\";\r\nimport { useAuth } from \"../auth/context/authContext\";\r\nimport NotImage from \"../../assest/png/notdeliverd.png\"\r\n\r\nconst AddressDrawer = ({ ShowSaveAddress }) => {\r\n  const [open, setOpen] = useState(false);\r\n  const [lat, setLat] = useState(\"\")\r\n  const [lng, setLng] = useState(\"\")\r\n  const [form] = Form.useForm();\r\n  const [pinLocation, setPinLocation] = useState([])\r\n  const [formLoader, setFormLoader] = useState(false)\r\n  // const [typeSelect,setTypeSelect]=useState(false)\r\n  const [addTypes, setAddsType] = useState(\"\")\r\n  const { token } = useAuth()\r\n  const [alerts, setAlerts] = useState(false)\r\n  const [noService, setNoService] = useState(null)\r\n  const [isLoading, setIsLoading] = useState(false)\r\n\r\n\r\n  const { address } = pinLocation\r\n  // const { suburb, state_district, state, postcode } = address\r\n  console.log(\"address\", address)\r\n\r\n  const showDrawer = () => {\r\n    setOpen(true);\r\n  };\r\n\r\n  const cartClose = () => {\r\n    setOpen(false);\r\n  };\r\n\r\n\r\n  useEffect(() => {\r\n    async function getPinLocation() {\r\n      const apiKey = process.env.REACT_APP_GOOGLE_MAPS_API_KEY;\r\n\r\n      const response = await axios.get(\r\n        `https://maps.googleapis.com/maps/api/geocode/json?latlng=${lat},${lng}&key=${apiKey}`\r\n      );\r\n      setFormLoader(true)\r\n      if (response.data.status === \"OK\") {\r\n        const userLocation = response.data.results[0];\r\n        setPinLocation(userLocation);  // Set the state with the user’s location data\r\n        setFormLoader(false)\r\n      }\r\n\r\n    }\r\n    if (lat != \"\" && lng != \"\") {\r\n      getPinLocation()\r\n    }\r\n\r\n\r\n  }, [lat, lng]);\r\n\r\n\r\n  useEffect(() => {\r\n    if (pinLocation.length != 0) {\r\n      form.setFieldsValue({\r\n        area: pinLocation?.formatted_address\r\n      })\r\n    }\r\n  }, [pinLocation])\r\n\r\n  const onFinish = async (value) => {\r\n    const body = {\r\n\r\n      latitude: lat,\r\n      longitude: lng,\r\n      area: value.area,\r\n      flatNumber: value.flatNumber,\r\n      floorNumber: value.floorNumber,\r\n      apartmentName: value.apartmentName,\r\n      howToReach: value.howToReach,\r\n      mobileNo: value.mobileNo,\r\n      profileName: value.profileName,\r\n      addressName: value.addressName,\r\n      addressType: addTypes\r\n    }\r\n\r\n    if (addTypes == \"\") {\r\n      notification.warning({\r\n        placement: \"topLeft\",\r\n        message: \"Please Select Address Type !\",\r\n      });\r\n    } else {\r\n\r\n      setIsLoading(true)\r\n      try {\r\n        await AddAddress(token, body)\r\n          .then((res) => {\r\n            console.log(\"add address\", res);\r\n            if (res.status == 201) {\r\n              notification.success({\r\n                placement: \"topRight\",\r\n                message: \"Address added Successfully !\",\r\n              });\r\n              setPinLocation([])\r\n              setAddsType(\"\")\r\n              setOpen(false);\r\n              onReset()\r\n              setIsLoading(false)\r\n              ShowSaveAddress()\r\n              setAlerts(false)\r\n            } else if (res.status === 202) {\r\n              setOpen(true)\r\n              setNoService(res.data.message)\r\n              setIsLoading(false)\r\n            } else if (res.status === 200) {\r\n              // setOpen(true)\r\n              message.warning(res.data.message)\r\n              setIsLoading(false)\r\n            }\r\n\r\n          })\r\n          .catch((err) => {\r\n            console.log(err);\r\n          });\r\n      } catch (error) {\r\n        console.log(error);\r\n        setIsLoading(false)\r\n      }\r\n    }\r\n  };\r\n\r\n  const onReset = () => {\r\n    form.resetFields();\r\n  };\r\n  const onFinishFailed = (value) => {\r\n    console.log(value)\r\n  }\r\n  const addressType = [\r\n    {\r\n      id: 1,\r\n      title: \"HOME\",\r\n      icon: <MdOutlineHome />\r\n    },\r\n    {\r\n      id: 2,\r\n      title: \"OFFICE\",\r\n      icon: <MdOutlineHomeWork />\r\n\r\n    },\r\n    {\r\n      id: 2,\r\n      title: \"OTHERS\",\r\n      icon: <MdOutlineLocationOn />\r\n\r\n    },\r\n  ]\r\n\r\n  const handleAddress = (add) => {\r\n    setAddsType(add)\r\n    console.log(add)\r\n  }\r\n\r\n  const validateMaxLength = (_, value) => {\r\n    if (value && value.length > 10) {\r\n      return Promise.reject(new Error('Please Enter Valid Number !'));\r\n    }\r\n    return Promise.resolve();\r\n  };\r\n\r\n  return (\r\n    <>\r\n      <div className=\"Add_Addre\">\r\n        <Button onClick={showDrawer} shape=\"round\" block>\r\n          <MdMyLocation className=\"loc_iocns\" /> Add New  Address\r\n        </Button>\r\n      </div>\r\n      <Drawer\r\n        title=\"Fill Complete address\"\r\n        onClose={cartClose}\r\n        open={open}\r\n        // placement=\"left\"\r\n        width={600}\r\n      >\r\n        {alerts ? <Alert message=\"Note : Please Drag Map Your exact Location\" type=\"info\" showIcon closable /> : null}\r\n        <Card>\r\n          <ShowMap setLat={setLat} setLng={setLng} lat={lat} lng={lng} setAlerts={setAlerts} />\r\n          <div className=\"add_form\">\r\n            {formLoader == true ? <Skeleton /> :\r\n              <Form\r\n                form={form}\r\n                layout=\"vertical\"\r\n                name=\"basic\"\r\n                style={{\r\n                  maxWidth: 600,\r\n                }}\r\n                onFinish={onFinish}\r\n                onFinishFailed={onFinishFailed}\r\n              >\r\n                <Form.Item\r\n                  label=\"Area/Locality\"\r\n                  name=\"area\"\r\n                  rules={[\r\n                    {\r\n                      required: true,\r\n                      message: \"Please Search you area on on Map\",\r\n                    },\r\n                  ]}\r\n                >\r\n                  <Input placeholder=\"Enter Area\" disabled />\r\n                </Form.Item>\r\n                <Row>\r\n                  <Col md={6}>\r\n\r\n                    <Form.Item\r\n                      label=\"House/Flat Number\"\r\n                      name=\"flatNumber\"\r\n                      rules={[\r\n                        {\r\n                          required: true,\r\n                          message: \"Please Enter your flatNumber!\",\r\n                        },\r\n                      ]}\r\n                    >\r\n                      <Input placeholder=\"Enter Flat Number\" />\r\n                    </Form.Item>\r\n                  </Col>\r\n                  <Col md={6}>\r\n                    <Form.Item\r\n                      label=\"Floor Number\"\r\n                      name=\"floorNumber\"\r\n\r\n                    >\r\n                      <Input placeholder=\"Enter Floor Number \" />\r\n                    </Form.Item>\r\n\r\n                  </Col>\r\n                </Row>\r\n\r\n\r\n                <Row>\r\n                  <Col md={6}>\r\n\r\n                    <Form.Item\r\n                      label=\"Apartment/Building Name\"\r\n                      name=\"apartmentName\"\r\n                    // rules={[\r\n                    //   {\r\n                    //     required: true,\r\n                    //     message: \"Please Enter your apartment Name\",\r\n                    //   },\r\n                    // ]}\r\n                    >\r\n                      <Input placeholder=\"Enter Apartment\" />\r\n                    </Form.Item>\r\n                  </Col>\r\n                  <Col md={6}>\r\n\r\n                    <Form.Item\r\n                      label=\"Mobile Number\"\r\n                      name=\"mobileNo\"\r\n                      rules={[\r\n\r\n                        {\r\n                          pattern: /^[0-9]*$/,\r\n                          message: 'Please Enter only Numbers!',\r\n                        },\r\n                        { validator: validateMaxLength }\r\n                      ]}\r\n                    >\r\n                      <Input placeholder=\"Enter Mobile Number\" />\r\n                    </Form.Item>\r\n                  </Col>\r\n                </Row>\r\n\r\n                <Row>\r\n                  <Col md={6}>\r\n                    <Form.Item\r\n                      label=\"Profile Name\"\r\n                      name=\"profileName\"\r\n                    >\r\n                      <Input placeholder=\"Enter Profile Name (e.g. My Home)\" />\r\n                    </Form.Item>\r\n                  </Col>\r\n                  <Col md={6}>\r\n                    <Form.Item\r\n                      label=\"Address Name\"\r\n                      name=\"addressName\"\r\n                    >\r\n                      <Input placeholder=\"Enter Address Name (e.g. Dad's place)\" />\r\n                    </Form.Item>\r\n                  </Col>\r\n                </Row>\r\n\r\n                <Row>\r\n                  <Col md={12}>\r\n\r\n                    <Form.Item\r\n                      label=\"How to reach\"\r\n                      name=\"howToReach\"\r\n                      rules={[\r\n                        {\r\n                          required: true,\r\n                          message: \"Please Enter How To Reach\",\r\n                        },\r\n                      ]}\r\n                    >\r\n                      <Input placeholder=\"Enter Landmark \" />\r\n                    </Form.Item>\r\n                  </Col>\r\n\r\n\r\n                  <Col md={12}>\r\n\r\n                    <Form.Item\r\n                      label=\"Save address as a\"\r\n                      name=\"addressType\"\r\n\r\n\r\n                    >\r\n                      <div className=\"show_loc_type\" >\r\n                        {addressType.map((add) => (\r\n                          <div className={` ${addTypes == add.title && \"homeSelected\"}`}>\r\n                            <Card key={add.id} hoverable onClick={() => handleAddress(add.title)}>\r\n                              <Space>\r\n                                <span >{add.icon}</span>\r\n                                <p>{add.title}</p>\r\n                              </Space>\r\n                            </Card>\r\n                          </div>\r\n                        ))}\r\n                      </div>\r\n                    </Form.Item>\r\n                  </Col>\r\n                </Row>\r\n\r\n                <Form.Item>\r\n                  <div className=\"add_address_btn\">\r\n                    <Button loading={isLoading} type=\"primary\" htmlType=\"submit\" shape=\"round\">\r\n                      Submit\r\n                    </Button>\r\n                  </div>\r\n                </Form.Item>\r\n              </Form>}\r\n          </div>\r\n          {\r\n            noService ? <div className=\"no_service\">\r\n              <img src={NotImage} />\r\n              <p>{noService}</p>\r\n            </div> : null}\r\n        </Card >\r\n      </Drawer >\r\n    </>\r\n  );\r\n};\r\n\r\nexport default AddressDrawer;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\address\\UpdateAddress.jsx",["1489","1490","1491","1492","1493","1494","1495","1496","1497","1498","1499","1500","1501","1502","1503","1504"],[],"import React, { useEffect, useState } from \"react\";\r\nimport {\r\n    Alert,\r\n    Badge,\r\n    Button,\r\n    Card,\r\n    Checkbox,\r\n    Divider,\r\n    Drawer,\r\n    Form,\r\n    Input,\r\n    message,\r\n    notification,\r\n    Skeleton,\r\n    Space,\r\n} from \"antd\";\r\nimport { MdOutlineHome, MdOutlineHomeWork, MdOutlineLocationOn } from \"react-icons/md\";\r\nimport \"../../style/header.css\";\r\nimport axios from \"axios\"\r\nimport { MdMyLocation } from \"react-icons/md\";\r\nimport ShowMap from \"../cart/ShowMap\";\r\nimport { Col, Row } from \"react-bootstrap\"\r\nimport { AddAddress, UpdateUserLocation } from \"../apiService/api\";\r\nimport { useAuth } from \"../auth/context/authContext\";\r\nimport NotImage from \"../../assest/png/notdeliverd.png\"\r\n\r\nconst UpdateAddress = ({ editData, ShowSaveAddress }) => {\r\n    const [open, setOpen] = useState(false);\r\n    const [lat, setLat] = useState(\"\")\r\n    const [lng, setLng] = useState(\"\")\r\n    const [form] = Form.useForm();\r\n    const [pinLocation, setPinLocation] = useState([])\r\n    const [formLoader, setFormLoader] = useState(false)\r\n    // const [typeSelect,setTypeSelect]=useState(false)\r\n    const [addTypes, setAddsType] = useState(\"\")\r\n    const { token } = useAuth()\r\n    const [alerts, setAlerts] = useState(false)\r\n    const [noService, setNoService] = useState(null)\r\n    const [isLoading, setIsLoading] = useState(false)\r\n\r\n\r\n    const { address } = pinLocation\r\n    // const { suburb, state_district, state, postcode } = address\r\n    console.log(\"address\", address)\r\n\r\n    const showDrawer = () => {\r\n        setOpen(true);\r\n        setIsLoading(false)\r\n\r\n    };\r\n\r\n    const cartClose = () => {\r\n        setOpen(false);\r\n    };\r\n    console.log(\"editData\", editData)\r\n\r\n    useEffect(() => {\r\n        setLat(editData.location.coordinates[1])\r\n        setLng(editData.location.coordinates[0])\r\n        setAddsType(editData.addressType)\r\n        form.setFieldsValue({\r\n            latitude: lat,\r\n            longitude: lng,\r\n            area: editData.area,\r\n            flatNumber: editData.flatNumber,\r\n            floorNumber: editData.floorNumber,\r\n            apartmentName: editData.apartmentName,\r\n            howToReach: editData.howToReach,\r\n            mobileNo: editData.mobileNo,\r\n            profileName: editData.profileName,\r\n            addressName: editData.addressName,\r\n            addressType: addTypes\r\n        })\r\n    }, [editData])\r\n\r\n    useEffect(() => {\r\n        async function getPinLocation() {\r\n            const apiKey = process.env.REACT_APP_GOOGLE_MAPS_API_KEY;\r\n\r\n            const response = await axios.get(\r\n                `https://maps.googleapis.com/maps/api/geocode/json?latlng=${lat},${lng}&key=${apiKey}`\r\n            );\r\n            setFormLoader(true)\r\n            if (response.data.status === \"OK\") {\r\n                const userLocation = response.data.results[0];\r\n                setPinLocation(userLocation);  // Set the state with the user’s location data\r\n                setFormLoader(false)\r\n            }\r\n\r\n        }\r\n        if (lat != \"\" && lng != \"\") {\r\n            getPinLocation()\r\n        }\r\n\r\n\r\n    }, [lat, lng]);\r\n\r\n\r\n    useEffect(() => {\r\n        if (pinLocation.length != 0) {\r\n            form.setFieldsValue({\r\n                area: pinLocation?.formatted_address\r\n            })\r\n        }\r\n    }, [pinLocation])\r\n\r\n\r\n\r\n    const onFinish = async (value) => {\r\n        const body = {\r\n\r\n            latitude: lat,\r\n            longitude: lng,\r\n            area: value.area,\r\n            flatNumber: value.flatNumber,\r\n            floorNumber: value.floorNumber,\r\n            apartmentName: value.apartmentName,\r\n            howToReach: value.howToReach,\r\n            mobileNo: value.mobileNo,\r\n            profileName: value.profileName,\r\n            addressName: value.addressName,\r\n            addressType: addTypes,\r\n            locationId: editData?._id,\r\n        }\r\n\r\n        if (addTypes == \"\") {\r\n            notification.warning({\r\n                placement: \"topLeft\",\r\n                message: \"Please Select Address Type !\",\r\n            });\r\n        } else {\r\n\r\n            setIsLoading(true)\r\n            try {\r\n                await UpdateUserLocation(token, body)\r\n                    .then((res) => {\r\n                        console.log(\"add address\", res);\r\n                        if (res.status == 201) {\r\n                            notification.success({\r\n                                placement: \"topRight\",\r\n                                message: \"Address added Successfully !\",\r\n                            });\r\n                            setPinLocation([])\r\n                            setAddsType(\"\")\r\n                            setOpen(false);\r\n                            onReset()\r\n                            setIsLoading(false)\r\n                            ShowSaveAddress()\r\n                            setAlerts(false)\r\n                        } else if (res.status === 202) {\r\n                            setOpen(true)\r\n                            setNoService(res.data.message)\r\n                            setIsLoading(false)\r\n                        }\r\n\r\n                    })\r\n                    .catch((err) => {\r\n                        console.log(err);\r\n                    });\r\n            } catch (error) {\r\n                console.log(error);\r\n                setIsLoading(false)\r\n            }\r\n        }\r\n    };\r\n\r\n    const onReset = () => {\r\n        form.resetFields();\r\n    };\r\n    const onFinishFailed = (value) => {\r\n        console.log(value)\r\n    }\r\n    const addressType = [\r\n        {\r\n            id: 1,\r\n            title: \"HOME\",\r\n            icon: <MdOutlineHome />\r\n        },\r\n        {\r\n            id: 2,\r\n            title: \"OFFICE\",\r\n            icon: <MdOutlineHomeWork />\r\n\r\n        },\r\n        {\r\n            id: 2,\r\n            title: \"OTHERS\",\r\n            icon: <MdOutlineLocationOn />\r\n\r\n        },\r\n    ]\r\n\r\n    const handleAddress = (add) => {\r\n        setAddsType(add)\r\n        console.log(add)\r\n    }\r\n\r\n    const validateMaxLength = (_, value) => {\r\n        if (value && value.length > 10) {\r\n            return Promise.reject(new Error('Please Enter Valid Number !'));\r\n        }\r\n        return Promise.resolve();\r\n    };\r\n\r\n    return (\r\n        <>\r\n            <div className=\"Add_Addres\">\r\n                <Button type=\"primary\" onClick={showDrawer}>\r\n                    Edit\r\n                </Button>\r\n            </div>\r\n            <Drawer\r\n                title=\"Edit Address\"\r\n                onClose={cartClose}\r\n                open={open}\r\n                placement=\"left\"\r\n                width={600}\r\n            >\r\n                {alerts ? <Alert message=\"Note : Please Drag Map Your exact Location\" type=\"info\" showIcon closable /> : null}\r\n                <Card>\r\n                    <ShowMap setLat={setLat} setLng={setLng} lat={lat} lng={lng} setAlerts={setAlerts} />\r\n                    <div className=\"add_form\">\r\n                        {formLoader == true ? <Skeleton /> :\r\n                            <Form\r\n                                form={form}\r\n                                layout=\"vertical\"\r\n                                name=\"basic\"\r\n                                style={{\r\n                                    maxWidth: 600,\r\n                                }}\r\n                                onFinish={onFinish}\r\n                                onFinishFailed={onFinishFailed}\r\n                            >\r\n                                <Form.Item\r\n                                    label=\"Area/Locality\"\r\n                                    name=\"area\"\r\n                                    rules={[\r\n                                        {\r\n                                            required: true,\r\n                                            message: \"Please Search you area on on Map\",\r\n                                        },\r\n                                    ]}\r\n                                >\r\n                                    <Input placeholder=\"Enter Area\" disabled />\r\n                                </Form.Item>\r\n                                <Row>\r\n                                    <Col md={6}>\r\n\r\n                                        <Form.Item\r\n                                            label=\"House/Flat Number\"\r\n                                            name=\"flatNumber\"\r\n                                            rules={[\r\n                                                {\r\n                                                    required: true,\r\n                                                    message: \"Please Enter your flat Number!\",\r\n                                                },\r\n                                            ]}\r\n                                        >\r\n                                            <Input placeholder=\"Enter Flat Number\" />\r\n                                        </Form.Item>\r\n                                    </Col>\r\n                                    <Col md={6}>\r\n                                        <Form.Item\r\n                                            label=\"Floor Number\"\r\n                                            name=\"floorNumber\"\r\n\r\n                                        >\r\n                                            <Input placeholder=\"Enter Floor Number \" />\r\n                                        </Form.Item>\r\n\r\n                                    </Col>\r\n                                </Row>\r\n\r\n\r\n                                <Row>\r\n                                    <Col md={6}>\r\n\r\n                                        <Form.Item\r\n                                            label=\"Apartment/Building Name\"\r\n                                            name=\"apartmentName\"\r\n                                        // rules={[\r\n                                        //   {\r\n                                        //     required: true,\r\n                                        //     message: \"Please Enter your apartment Name\",\r\n                                        //   },\r\n                                        // ]}\r\n                                        >\r\n                                            <Input placeholder=\"Enter Appartment\" />\r\n                                        </Form.Item>\r\n                                    </Col>\r\n                                    <Col md={6}>\r\n\r\n                                        <Form.Item\r\n                                            label=\"Mobile Number\"\r\n                                            name=\"mobileNo\"\r\n                                            rules={[\r\n\r\n                                                {\r\n                                                    pattern: /^[0-9]*$/,\r\n                                                    message: 'Please Enter only Numbers!',\r\n                                                },\r\n                                                { validator: validateMaxLength }\r\n                                            ]}\r\n                                        >\r\n                                            <Input placeholder=\"Enter Mobile Numner\" />\r\n                                        </Form.Item>\r\n                                    </Col>\r\n                                </Row>\r\n\r\n                                <Row>\r\n                                    <Col md={6}>\r\n                                        <Form.Item\r\n                                            label=\"Profile Name\"\r\n                                            name=\"profileName\"\r\n                                        >\r\n                                            <Input placeholder=\"Enter Profile Name (e.g. My Home)\" />\r\n                                        </Form.Item>\r\n                                    </Col>\r\n                                    <Col md={6}>\r\n                                        <Form.Item\r\n                                            label=\"Address Name\"\r\n                                            name=\"addressName\"\r\n                                        >\r\n                                            <Input placeholder=\"Enter Address Name (e.g. Dad's place)\" />\r\n                                        </Form.Item>\r\n                                    </Col>\r\n                                </Row>\r\n\r\n                                <Row>\r\n                                    <Col md={12}>\r\n\r\n                                        <Form.Item\r\n                                            label=\"How to reach\"\r\n                                            name=\"howToReach\"\r\n                                            rules={[\r\n                                                {\r\n                                                    required: true,\r\n                                                    message: \"Please Enter How To Reach\",\r\n                                                },\r\n                                            ]}\r\n                                        >\r\n                                            <Input placeholder=\"Enter Landmark \" />\r\n                                        </Form.Item>\r\n                                    </Col>\r\n\r\n\r\n                                    <Col md={12}>\r\n\r\n                                        <Form.Item\r\n                                            label=\"Save address as a\"\r\n                                            name=\"addressType\"\r\n\r\n\r\n                                        >\r\n                                            <div className=\"show_loc_type\" >\r\n                                                {addressType.map((add) => (\r\n                                                    <div className={` ${addTypes == add.title && \"homeSelected\"}`}>\r\n                                                        <Card key={add.id} hoverable onClick={() => handleAddress(add.title)}>\r\n                                                            <Space>\r\n                                                                <span >{add.icon}</span>\r\n                                                                <p>{add.title}</p>\r\n                                                            </Space>\r\n                                                        </Card>\r\n                                                    </div>\r\n                                                ))}\r\n                                            </div>\r\n                                        </Form.Item>\r\n                                    </Col>\r\n                                </Row>\r\n\r\n                                <Form.Item>\r\n                                    <div className=\"add_address_btn\">\r\n                                        <Button loading={isLoading} type=\"primary\" htmlType=\"submit\" shape=\"round\">\r\n                                            Submit\r\n                                        </Button>\r\n                                    </div>\r\n                                </Form.Item>\r\n                            </Form>}\r\n                    </div>\r\n                    {\r\n                        noService ? <div className=\"no_service\">\r\n                            <img src={NotImage} />\r\n                            <p>{noService}</p>\r\n                        </div> : null}\r\n                </Card >\r\n            </Drawer >\r\n        </>\r\n    );\r\n};\r\n\r\nexport default UpdateAddress;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\cart\\ApplyCoupon.jsx",["1505","1506","1507","1508","1509","1510"],[],"import React, { useEffect, useState } from \"react\";\r\nimport { Badge, Button, Card, Divider, Modal, notification, Space, Tag } from \"antd\";\r\nimport { GiStarFormation } from \"react-icons/gi\";\r\nimport \"../../style/home.css\";\r\nimport { useAuth } from \"../auth/context/authContext\";\r\nimport { fetchAllDiscountList } from \"../apiService/api\";\r\nimport FlateImage from \"../../assest/png/ruppeess.webp\"\r\nimport DiscountImage from \"../../assest/png/percent.webp\"\r\nimport DiscountBg from \"../../assest/discount.png\"\r\nimport { selectDiscount, selectPayableAmount, setDiscountDetails } from \"../../redux/OrderSlice\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport ApplyCouponImg from '../../assest/png/output-onlinegiftools (15).gif'\r\nimport BKDLogo from \"../../assest/bkdlogo.png\";\r\n\r\nconst ApplyCoupon = () => {\r\n  const { token } = useAuth()\r\n  const [isModalOpen, setIsModalOpen] = useState(false);\r\n  const [discountData, setDiscountData] = useState([])\r\n  const [isLoading, setIsLoading] = useState(false)\r\n  const selectedCoupon = useSelector(selectDiscount)\r\n  const payabmeAmount = useSelector(selectPayableAmount)\r\n\r\n\r\n  const dispatch = useDispatch()\r\n  const showModal = () => {\r\n    setIsModalOpen(true);\r\n  };\r\n  const handleOk = () => {\r\n    setIsModalOpen(false);\r\n  };\r\n  const handleCancel = () => {\r\n    setIsModalOpen(false);\r\n  };\r\n\r\n\r\n  const ShowDiscountList = async () => {\r\n    try {\r\n      await fetchAllDiscountList(token)\r\n        .then((res) => {\r\n          console.log(\"discount list\", res);\r\n          if (res.status == 200) {\r\n            setDiscountData(res.data.data)\r\n            setIsLoading(true)\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          console.log(err.message);\r\n        });\r\n    } catch (error) {\r\n      console.log(error);\r\n      setIsLoading(true)\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    if (token != null) {\r\n      ShowDiscountList();\r\n    }\r\n  }, []);\r\n\r\n  const ApplyCouponHandler = (item) => {\r\n    if (payabmeAmount < item.minCartAmount) {\r\n      notification.warning({\r\n        placement: \"topRight\",\r\n        message: ` Please add products worth ₹${item.minCartAmount - payabmeAmount} or more to reach the minimum cart value of ₹${item.minCartAmount}.`,\r\n      });\r\n    }\r\n    if (payabmeAmount >= item.minCartAmount) {\r\n      dispatch(setDiscountDetails(item))\r\n      console.log(\"select offer\", item)\r\n    }\r\n  }\r\n\r\n\r\n\r\n  return (\r\n    <div className=\"apply_coupon\">\r\n      <Button type=\"primary\" onClick={showModal} icon={<GiStarFormation />} disabled={discountData?.length === 0 || payabmeAmount <= selectedCoupon?.details?.minCartAmount}>\r\n        Coupon\r\n      </Button>\r\n      <Modal\r\n        footer={false}\r\n        title=\"Available Coupon\"\r\n        open={isModalOpen}\r\n        onOk={handleOk}\r\n        onCancel={handleCancel}\r\n      >\r\n        <div className=\"show_all_coupon\">\r\n          {discountData?.map((item) => {\r\n            const isSelected = selectedCoupon?.details?._id === item._id;\r\n            const discountImage = item.discountType !== \"FLAT\" ? DiscountImage : FlateImage;\r\n            const bgImage = isSelected ? ApplyCouponImg : DiscountBg;\r\n            const bgclass = isSelected ? \"apply_discount_img\" : \"bg_discount_img\";\r\n            const selectCard = isSelected ? \"selected_card\" : \"\";\r\n\r\n\r\n            return (\r\n              // <Badge.Ribbon text={`Min.Cart ₹ ${item.minCartAmount}`} color=\"green\">\r\n              <Card\r\n                onClick={() => ApplyCouponHandler(item)}\r\n                // className={selectCard}\r\n                className={selectCard}\r\n\r\n                hoverable={payabmeAmount < item.minCartAmount}\r\n\r\n              >\r\n                <div className=\"coupon_image\">\r\n                  <img src={discountImage} alt=\"Discount\" />\r\n                </div>\r\n                <div className=\"coupon_contents\">\r\n                  <h2>{item.discountType === \"FLAT\" ? <span>₹{item.discountValue}</span> : <span> {item.discountValue}%</span>}   </h2>\r\n                  <h6> {item.discountName?.length > 12\r\n                    ? `${item.discountName.slice(0, 12)}...`\r\n                    : item.discountName}</h6>\r\n                  <p>Minimum Cart :  ₹{item.minCartAmount}</p>\r\n                  <Tag color=\"green\">\r\n                    {item.discountCode?.length > 15\r\n                      ? `${item.discountCode.slice(0, 15)}...`\r\n                      : item.discountCode}\r\n                  </Tag>\r\n\r\n                </div>\r\n                <div className={bgclass}>\r\n                  <img src={bgImage} alt=\"Background\" />\r\n                </div>\r\n              </Card>\r\n              // </Badge.Ribbon>\r\n\r\n\r\n            );\r\n          })}\r\n\r\n\r\n        </div>\r\n        <Divider />\r\n        <div className=\"offer_continue\" >\r\n          <Button shape=\"round\" onClick={() => handleOk()}>Continue</Button>\r\n        </div >\r\n\r\n\r\n      </Modal >\r\n    </div >\r\n  );\r\n};\r\nexport default ApplyCoupon;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\cart\\BeforeCheckProductList.jsx",["1511","1512","1513","1514","1515","1516","1517","1518","1519","1520","1521","1522","1523","1524","1525"],[],"import { Badge, Button, Card, Divider, notification, Skeleton, Space, Tag, Tooltip } from \"antd\";\r\nimport React, { useEffect, useState } from \"react\";\r\nimport Slider from \"react-slick\";\r\nimport \"../../style/header.css\";\r\nimport { FaHeart } from \"react-icons/fa\";\r\nimport { FaRegHeart } from \"react-icons/fa\";\r\nimport { useAuth } from \"../auth/context/authContext\";\r\nimport BKDLogo from \"../../assest/bkdlogo.png\"\r\nimport { AddProductWishlist, fetchBeforeCheckoutItem, out_of_stock } from \"../apiService/api\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { addItem, removeItem, selectCartItems } from \"../../redux/CartSlice\";\r\nimport { useScreen } from \"../auth/AuthScreen\";\r\nimport { useNavigate } from \"react-router-dom\";\r\nimport offerAvailable from \"../../assest/png/offer_apply.png\"\r\nimport { encryptCategoryID } from \"../../config/encriptConfig\";\r\nimport { getOfferImage } from \"../../utils/offerUtils\";\r\n\r\n\r\nfunction BeforeCheckProductList({ setOpen, open }) {\r\n  const { nearStore, token } = useAuth()\r\n  const [wishlist, setWishlist] = useState({})\r\n  const [beforeCheckout, setBeforeCheckout] = useState([])\r\n  const [isLoading, setIsLoading] = useState(false)\r\n  const cartItems = useSelector(selectCartItems);\r\n  const { screenWidth } = useScreen()\r\n  const dispatch = useDispatch()\r\n  const navigate = useNavigate()\r\n  const skeletonArray = new Array(beforeCheckout?.length || 12).fill(0);\r\n  const titleCase = str => str.toLowerCase().split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');\r\n\r\n\r\n  const settings = {\r\n    dots: false,\r\n    adaptiveHeight: true,\r\n    infinite: true,\r\n    speed: 800,\r\n    arrows: true,\r\n    slidesToShow: 2,\r\n\r\n    slidesToScroll: 1,\r\n    autoplay: true,\r\n    loop: true,\r\n    autoplaySpeed: 3000,\r\n    draggable: true,\r\n    swipeToSlide: true,\r\n    swipe: true,\r\n  };\r\n\r\n  const handleAddItem = (item) => {\r\n    dispatch(addItem({ ...item, selected_variant: null }));\r\n  };\r\n\r\n  useEffect(() => {\r\n    localStorage.setItem(\"cart\", JSON.stringify(cartItems));\r\n  }, [cartItems]);\r\n\r\n  const handleDelItem = (item) => {\r\n    dispatch(removeItem(item));\r\n    const cart = JSON.parse(localStorage.getItem(\"cart\")) || [];\r\n    const updatedCart = cart.filter(cartItem => cartItem.productCode !== item.productCode);\r\n    localStorage.setItem(\"cart\", JSON.stringify(updatedCart));\r\n  };\r\n\r\n  const handleNotLogin = () => {\r\n    notification.error({\r\n      placement: \"topRight\",\r\n      message: \"Please login before adding to wishlist\",\r\n    });\r\n  };\r\n\r\n  const ShowBeforCheckout = async () => {\r\n    setIsLoading(true)\r\n    try {\r\n      await fetchBeforeCheckoutItem(nearStore?.branchCode)\r\n        .then((res) => {\r\n          console.log(\"before checkout\", res);\r\n          if (res.status == 200) {\r\n            setBeforeCheckout(res.data.data);\r\n            setIsLoading(false)\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          console.log(err.message);\r\n        });\r\n    } catch (error) {\r\n      console.log(error);\r\n      setIsLoading(false)\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    ShowBeforCheckout();\r\n  }, [open]);\r\n  const addToWishList = async (proCode) => {\r\n    setWishlist((prev) => ({ ...prev, [proCode.productCode]: true }));\r\n    const body = {\r\n      productCode: proCode.productCode,\r\n      productName: proCode.productName,\r\n      status: \"ACTIVE\"\r\n    }\r\n    try {\r\n      await AddProductWishlist(token, body)\r\n        .then((res) => {\r\n          console.log(\"add to  wish\", res);\r\n          if (res.status == 201) {\r\n\r\n\r\n            if (res.data.data.whislistKey != true) {\r\n              // notification.warning({\r\n              //   placement: \"topRight\",\r\n              //   message: \"Remove Product From Wishlist\",\r\n\r\n              // });\r\n              ShowBeforCheckout()\r\n            } else {\r\n              // notification.success({\r\n              //   placement: \"topRight\",\r\n              //   message: \"Add Product To  Wishlist\",\r\n\r\n              // })\r\n              ShowBeforCheckout()\r\n\r\n            }\r\n\r\n\r\n          }\r\n\r\n        })\r\n        .catch((err) => {\r\n          console.log(err.message);\r\n          setWishlist((prev) => ({ ...prev, [proCode]: false }));\r\n        });\r\n    } catch (error) {\r\n      setWishlist((prev) => ({ ...prev, [proCode]: false }));\r\n      console.log(error);\r\n\r\n    }\r\n  };\r\n\r\n\r\n\r\n  const RemoveToWishList = async (proCode) => {\r\n    setWishlist((prev) => ({ ...prev, [proCode.productCode]: false })); // Immediately update the icon\r\n    const body = { productCode: proCode.productCode, productName: proCode.productName, status: \"INACTIVE\" };\r\n    try {\r\n      await AddProductWishlist(token, body)\r\n        .then((res) => {\r\n          if (res.status === 201) {\r\n            ShowBeforCheckout();\r\n            // notification['warning']({\r\n            //   placement: \"topRight\",\r\n            //   message: \"Removed Product From Wishlist\",\r\n            // });\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          console.log(err.message);\r\n          setWishlist((prev) => ({ ...prev, [proCode]: true })); // Revert the icon if the API call fails\r\n          // notification['error']({\r\n          //   placement: \"topRight\",\r\n          //   message: \"Failed to Remove Product From Wishlist\",\r\n          // });\r\n        });\r\n    } catch (error) {\r\n      console.log(error);\r\n      setWishlist((prev) => ({ ...prev, [proCode]: true })); // Revert the icon if the API call fails\r\n    }\r\n  };\r\n\r\n  const goToProductDetails = (item) => {\r\n    navigate(`/product/${manageURl(item.productName)}?uid=${encodeURIComponent(encryptCategoryID(item.productCode))}`);\r\n\r\n    setOpen(false)\r\n  }\r\n\r\n  const manageURl = (productName) => {\r\n    const sanitizedCategory = productName\r\n      .replace(/[,/&]/g, '') // Remove commas, slashes, ampersands\r\n      .replace(/\\s+/g, '-')  // Replace spaces with hyphens\r\n      .toLowerCase();\r\n    return sanitizedCategory\r\n  }\r\n\r\n\r\n  return (\r\n    <section>\r\n      {beforeCheckout?.length != 0 ?\r\n        <div style={{ margin: '0 auto', width: '90%' }}>\r\n          <div className=\"card_section\">\r\n            <div className=\"card_section_title\">\r\n              <h6>Explore before checkout</h6>\r\n              {/* <Button type=\"link\" size=\"large\" onClick={handleAllView}>\r\n              See All\r\n            </Button> */}\r\n            </div>\r\n            <Slider {...settings}>\r\n              {isLoading ? <div className=\"showing_pro_by_cat d-flex\">\r\n                {skeletonArray.map((_, index) => (\r\n                  <Card size=\"small\" className=\"loading mx-2 mb-2\" key={index}>\r\n                    <Skeleton.Image active />\r\n                    <Skeleton active paragraph={{ row: 6 }} />\r\n                  </Card>\r\n                ))}\r\n              </div> : beforeCheckout.map((item) => (\r\n                <div className=\"product_card individual_card\" key={item.productCode}>\r\n                  <Card\r\n                    hoverable\r\n                    disabled={item.stockQty === 0}\r\n                  >\r\n                    <div className=\"card_img\">\r\n                      <img\r\n                        className={item.stockQty <= out_of_stock ? \"out_of_stock_img\" : \"\"}\r\n                        src={item.imageUrl[0] ? item.imageUrl[0] : BKDLogo}\r\n                        onError={(e) => e.currentTarget.src = BKDLogo}\r\n                        onClick={() => goToProductDetails(item)}\r\n                        alt={item.productName}\r\n                      />\r\n                    </div>\r\n\r\n                    <div className=\"pro_name\" onClick={() => goToProductDetails(item)}>\r\n                      <Tooltip title={titleCase(item.productName)}>\r\n                        <p>{item.productName.length > 36 ? titleCase(item.productName.slice(0, 36)) + \"...\" : titleCase(item.productName)}</p>\r\n                      </Tooltip>\r\n                    </div>\r\n                    <div className=\"show_variant_item\" onClick={() => goToProductDetails(item)}>\r\n                      {item.packSize && item.packSize !== \"(NIL)\" ? <Tag color=\"green\">{item.packSize.substr(0, 10)}</Tag> : <span className=\"hidden_data\">N/A</span>}\r\n                      {item.stockQty <= out_of_stock && <Tag color='red' className=\"stock_tag\">out of stock</Tag>}\r\n                    </div>\r\n                    <div className=\"show_price_mrp\">\r\n                      <p>BKD Price | MRP</p>\r\n                    </div>\r\n                    <div className=\"add_cart\">\r\n                      <p>{`₹ ${Math.round(item.bkdAmount)} `} <span>{item.bkdAmount != item.price && <del>₹ {item.price}</del>}</span> </p>\r\n\r\n                      {cartItems.find((cartItem) => cartItem.productCode === item.productCode) ? (\r\n                        cartItems.map((cartItem) => {\r\n                          if (cartItem.productCode === item.productCode) {\r\n                            return (\r\n                              <Button.Group key={cartItem.productCode} size={screenWidth < 800 ? 'default' : 'small'}>\r\n                                <Button onClick={() => handleDelItem(item)}>-</Button>\r\n                                <Button>{cartItem.unit}</Button>\r\n                                <Button onClick={() => handleAddItem(item)}>+</Button>\r\n                              </Button.Group>\r\n                            );\r\n                          }\r\n                        })\r\n                      ) : (\r\n                        <Button disabled={item.stockQty <= out_of_stock} onClick={() => handleAddItem(item)} className='add_card_btn'>\r\n                          ADD\r\n                        </Button>\r\n                      )}\r\n                    </div>\r\n                  </Card>\r\n                  {item.billingQty === \"PROMOTIONS\" || item.billingQty === \"DISCOUNT\" || item.offerQty === \"PROMOTIONS\" || item.offerQty === \"DISCOUNT\" ?\r\n                    <div className=\"discount_tags\">Super Saver Price</div> : item.billingQty != \"\" && item.offerQty != \"\" ?\r\n                      <div className=\"offer_Available\">\r\n                        {(item.billingQty === \"FOC\" || item.offerQty === \"FOC\") ?\r\n                          <>\r\n                            <img src={offerAvailable} />\r\n                            <div className=\"offer_types\">\r\n                              <p>1 Item</p>\r\n                              <p>Free </p>\r\n                              <p>On MRP</p>\r\n                            </div>\r\n                          </>\r\n                          :\r\n                          <img src={getOfferImage(item?.offerQty)} />\r\n                        }\r\n\r\n                      </div> : Math.round(item.bkdAmount) != item.price ? <div className=\"cat_tags\">{Math.round((item.price - item.bkdAmount) * 100 / item.price)}% off</div> : null}\r\n                  {token ?\r\n                    <div className='wish_list'>\r\n                      {\r\n                        wishlist[item.productCode] || item.isWhislist ? (\r\n                          <FaHeart\r\n                            className=\"no_wish_icon\"\r\n                            size={22}\r\n                            color='red'\r\n                            onClick={() => RemoveToWishList(item)}\r\n                          />\r\n                        ) : (\r\n                          <FaRegHeart\r\n                            className=\"no_wish_icon\"\r\n                            size={22}\r\n                            onClick={() => addToWishList(item)}\r\n                          />\r\n                        )\r\n                      }\r\n                    </div>\r\n\r\n                    :\r\n                    <div className='wish_list'>\r\n                      <FaRegHeart\r\n                        className=\"no_wish_icon\"\r\n                        size={22}\r\n                        onClick={handleNotLogin}\r\n                      />\r\n                    </div>\r\n                  }\r\n                </div>\r\n              ))}\r\n            </Slider>\r\n          </div>\r\n        </div> : null}\r\n    </section>\r\n  );\r\n}\r\n\r\nexport default BeforeCheckProductList;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\account\\order\\OrderReturn.jsx",["1526","1527","1528","1529","1530","1531","1532","1533","1534","1535","1536","1537"],[],"import React, { useEffect, useState } from 'react';\r\nimport { Alert, Button, Card, Checkbox, Divider, Empty, Form, Image, Input, List, message, Modal, notification, Radio, Skeleton, Space, Tag, Upload } from 'antd';\r\nimport DefaultImg from \"../../../assest/bkdlogo.png\"\r\nimport { UploadOutlined } from '@ant-design/icons';\r\nimport { AddNewBankDetails, FetchReturnAndReplaceProduct, fetchUserBankDetails, ReturnAndReplacement, getSloteList, fetchHomeDeliverySlot, fetchReturnSlots, fetchReplacementSlots } from '../../apiService/api';\r\nimport '../../../style/order.css'\r\nimport { useAuth } from '../../auth/context/authContext';\r\nimport { useNavigate } from 'react-router-dom';\r\nimport { selectBranch } from '../../../redux/OrderSlice';\r\nimport { useDispatch, useSelector } from 'react-redux';\r\nimport { FcOk } from \"react-icons/fc\";\r\nimport { MdOutlineCameraAlt } from \"react-icons/md\";\r\nimport { Col, Row } from 'react-bootstrap';\r\nimport { addReturnItem, fetchReturnCartProducts, removeReturnCartItem, selectreturnCartItems } from '../../../redux/ReturnCartSlice';\r\n\r\n\r\nconst OrderReturn = ({ orderId, title }) => {\r\n    const navigate = useNavigate()\r\n    const { token, logout } = useAuth()\r\n    const dispatch = useDispatch()\r\n    const [isLoading, setIsLoading] = useState(false);\r\n    const [isReturn, setIsReturn] = useState(false)\r\n    const [isModalOpen, setIsModalOpen] = useState(false);\r\n    const [reason, setReason] = useState(null);\r\n    const [returnProduct, setReturnProduct] = useState([]);\r\n    const [returnImg, setReturnImg] = useState([]);\r\n    const [enabledIndex, setEnabledIndex] = useState(false);\r\n    const [uploadedImages, setUploadedImages] = useState({});\r\n    const [bankDetails, setbankDetails] = useState(null)\r\n    const [value, setValue] = useState(\"ONLINEPAYMENT\");\r\n    const [selectedProducts, setSelectedProducts] = useState([]);\r\n    const [totalRetunAmonut, setTotalReturnAmont] = useState(0)\r\n    const [returnSlot, setReturnSlot] = useState([])\r\n    const [selectedSlot, setSelectedSlot] = useState(null);\r\n    const [isSloteConfirm, setIsSlotConfirm] = useState(false)\r\n    const [selectedSlotData, setSelectSlotData] = useState(null);\r\n    const returnReplaceSlote = title === \"RETURN\" ? fetchReturnSlots : fetchReplacementSlots\r\n    const returnCartItem = useSelector(selectreturnCartItems);\r\n    const capitalize = (str) => str.charAt(0).toUpperCase() + str.slice(1).toLowerCase();\r\n\r\n\r\n\r\n    console.log(\"reutnimage\", returnImg)\r\n    console.log(\"totalRetunAmonut\", totalRetunAmonut)\r\n    console.log(\"uploadedImages\", uploadedImages)\r\n    console.log(\"selectedProducts\", selectedProducts)\r\n\r\n    const handleRadioChange = (e) => {\r\n        setValue(e.target.value);\r\n    };\r\n\r\n\r\n    const showModal = () => {\r\n        setIsModalOpen(true);\r\n        ShowMyOrderList();\r\n        setEnabledIndex(false)\r\n        setUploadedImages({})\r\n\r\n    };\r\n\r\n    const handleOk = () => {\r\n        setIsModalOpen(false);\r\n    };\r\n\r\n    const handleCancel = () => {\r\n        setIsReturn(false)\r\n        setIsModalOpen(false);\r\n        setSelectedProducts([])\r\n        setReturnImg([])\r\n        setUploadedImages({})\r\n    };\r\n\r\n    const handleInputChange = (e) => {\r\n        setReason(e.target.value);\r\n    };\r\n\r\n    const showDeliverySlot = async () => {\r\n        try {\r\n            await returnReplaceSlote(token, returnProduct?.branchId)\r\n                .then((res) => {\r\n                    console.log(\"return & replace slote list\", res);\r\n                    if (res.status == 200) {\r\n                        const slots = res.data.data\r\n                        setReturnSlot(slots)\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err);\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n        }\r\n    };\r\n    useEffect(() => {\r\n        if (returnProduct?.length != 0) {\r\n            showDeliverySlot()\r\n\r\n        }\r\n    }, [returnProduct])\r\n\r\n\r\n    const ShowMyOrderList = async () => {\r\n        setIsLoading(true);\r\n        try {\r\n            const res = await FetchReturnAndReplaceProduct(token, orderId, title);\r\n            console.log(\"return product\", res)\r\n            if (res.status === 200) {\r\n                setReturnProduct(res.data.data);\r\n                ShowUserBankData()\r\n                const ProductItem = res.data.data.productInfo\r\n                const productUnit = ProductItem.map((item) => ({\r\n                    ...item,\r\n                    unit: item.quantity,\r\n                    offerProduct: item.offerProduct\r\n\r\n                        ? {\r\n                            ...item.offerProduct,\r\n                            OfferQty: item.offerProduct.quantity,\r\n                            billingQty: item.requiredOfferedBillingQty,\r\n                        }\r\n                        : null, // Keep offerProduct as it is if it doesn't exist\r\n                }));\r\n\r\n                dispatch(fetchReturnCartProducts(productUnit));\r\n                localStorage.setItem(\"retunCart\", JSON.stringify(productUnit));\r\n            } else if (res.status === 283) {\r\n                message.error(res.data.message)\r\n                logout(navigate)\r\n            }\r\n        } catch (error) {\r\n            console.error(error);\r\n        } finally {\r\n            setIsLoading(false);\r\n        }\r\n    };\r\n\r\n\r\n    // const handleSelectProduct = (e, item, index) => {\r\n    //     const isChecked = e.target.checked;\r\n    //     console.log(\"selected item\", item)\r\n\r\n    //     if (isChecked) {\r\n    //         // Add product to selected products list\r\n    //         setSelectedProducts((prevSelected) => [...prevSelected, {\r\n    //             _id: item._id,\r\n    //             quantity: item.unit,\r\n    //             productCode: item.productCode,\r\n    //         }]);\r\n\r\n    //         // Disable all checkboxes except the selected one\r\n    //         setEnabledIndex((pre) => !pre); // Disable all checkboxes\r\n    //         setTotalReturnAmont((pre) => pre + item.productPrice)\r\n    //         // Once the number of selected products equals the number of uploaded images\r\n    //         if (selectedProducts.length + 1 === returnImg.length) {\r\n    //             setEnabledIndex((pre) => !pre); // Enable all checkboxes when condition is met\r\n    //         }\r\n    //     } else {\r\n    //         // Remove product from selected products list\r\n    //         setSelectedProducts((prevSelected) => prevSelected.filter((prod) => prod !== item._id));\r\n    //         setTotalReturnAmont((pre) => pre - item.productPrice)\r\n    //         returnImg.pop()\r\n    //         // Remove the uploaded image for the deselected product\r\n    //         setUploadedImages((prevImages) => {\r\n    //             const updatedImages = { ...prevImages };\r\n    //             delete updatedImages[item._id];\r\n    //             return updatedImages;\r\n    //         });\r\n\r\n    //         // If unchecking, check the condition again\r\n    //         if (selectedProducts.length - 1 === returnImg.length) {\r\n    //             setEnabledIndex((pre) => !pre); // Enable all checkboxes\r\n    //             notification.warning({\r\n    //                 placement: \"topRight\",\r\n    //                 message: \"Please select image of selected item \",\r\n    //             });\r\n    //         } else {\r\n    //             setEnabledIndex((pre) => !pre); // Disable checkboxes again\r\n    //         }\r\n    //     }\r\n    // };\r\n\r\n    const handleSelectProduct = (e, item, index) => {\r\n        const isChecked = e.target.checked;\r\n\r\n        if (isChecked) {\r\n            // Add product to selected products list\r\n            setSelectedProducts((prevSelected) => {\r\n\r\n                const updatedSelected = [\r\n                    ...prevSelected,\r\n                    {\r\n                        _id: item._id,\r\n                        quantity: item.unit,\r\n                        productCode: item.productCode,\r\n                    },\r\n                ];\r\n\r\n                // Check if condition is met\r\n                if (updatedSelected.length === returnImg.length) {\r\n                    setEnabledIndex(false); // Enable all checkboxes\r\n                } else {\r\n                    setEnabledIndex(true); // Disable all checkboxes\r\n                }\r\n\r\n                return updatedSelected;\r\n            });\r\n\r\n            setTotalReturnAmont((prevAmount) => prevAmount + item.productPrice);\r\n        } else {\r\n            // Remove product from selected products list\r\n            setSelectedProducts((prevSelected) => {\r\n                const updatedSelected = prevSelected.filter(\r\n                    (prod) => prod._id !== item._id\r\n                );\r\n\r\n                // Check if condition is met after removal\r\n                if (updatedSelected.length === returnImg.length) {\r\n                    setEnabledIndex(false); // Enable all checkboxes\r\n                    notification.warning({\r\n                        placement: \"topRight\",\r\n                        message: \"Please select an image for the selected item\",\r\n                    });\r\n                } else {\r\n                    setEnabledIndex(true); // Disable all checkboxes\r\n                }\r\n\r\n                return updatedSelected;\r\n            });\r\n\r\n            setTotalReturnAmont((prevAmount) => prevAmount - item.productPrice);\r\n\r\n            // Remove the uploaded image for the deselected product\r\n            setUploadedImages((prevImages) => {\r\n                const updatedImages = { ...prevImages };\r\n                setEnabledIndex(false);\r\n                delete updatedImages[item._id];\r\n                return updatedImages;\r\n            });\r\n            // Update `returnImg` array\r\n            setReturnImg((prevReturnImg) => prevReturnImg.slice(0, -1)); // Remove the last image\r\n        }\r\n    };\r\n\r\n    const handleImageUpload = (file, productId) => {\r\n        // Update uploaded images state\r\n        setUploadedImages((prevImages) => ({\r\n            ...prevImages,\r\n            [productId]: file.fileList,\r\n        }));\r\n\r\n        // Update returnImg immutably by spreading the array\r\n        setReturnImg((prevReturnImg) => {\r\n            // Avoid duplicates by filtering existing ones\r\n            const updatedReturnImages = prevReturnImg.filter(img => img.uid !== file.file.uid);\r\n            return [...updatedReturnImages, file.file];\r\n        });\r\n\r\n        console.log(\"returnImg---------->\", returnImg);\r\n\r\n        // Check if the number of selected products equals the number of images\r\n        if (selectedProducts.length === returnImg.length + 1) {\r\n            setEnabledIndex((pre) => !pre); // Enable remaining checkboxes\r\n        }\r\n    };\r\n\r\n\r\n\r\n    const handelReturnSubmit = async () => {\r\n        setIsReturn(true)\r\n\r\n        if (!value && !returnProduct.paymentCredential && returnProduct?.orderType !== \"REPLACEMENT\") {\r\n            notification.warning({\r\n                placement: \"topRight\",\r\n                message: \"Please Select Refund Option \",\r\n            });\r\n            setIsReturn(false)\r\n\r\n        } else if (!reason) {\r\n            notification.warning({\r\n                placement: \"topRight\",\r\n                message: \"Please Enter Reason ! \",\r\n            });\r\n            setIsReturn(false)\r\n\r\n        } else if (selectedProducts.length != returnImg.length) {\r\n            console.log(\"selectedProducts.length\", selectedProducts.length)\r\n            console.log(\"returnImg.length\", returnImg.length)\r\n            notification.warning({\r\n                placement: \"topRight\",\r\n                message: \"Please Select Return Image \",\r\n            });\r\n            setIsReturn(false)\r\n\r\n        } else if (!selectedSlot) {\r\n            notification.warning({\r\n                placement: \"topRight\",\r\n                message: \"Please Select  Slot \",\r\n            });\r\n            setIsReturn(false)\r\n\r\n        } else {\r\n\r\n            const formData = new FormData();\r\n            formData.append('userOrderId', orderId);\r\n            formData.append('reason', reason);\r\n            formData.append('type', title);\r\n            formData.append('timeSlotDate', selectedSlotData.availableSlotDate);\r\n            formData.append('branchSlotId', selectedSlot._id);\r\n            formData.append('paymentOn', title === \"REPLACEMENT\" ? \"\" : value);\r\n            formData.append('paymentOnId', title === \"RETURN\" ? value === \"BANK\" ? bankDetails?._id : value === \"UPI\" ? bankDetails?.upi_id : returnProduct?.userOrderPgResponseId\r\n                : \"\"\r\n                // && value === \"BANK\" ? bankDetails?._id : value === \"UPI\" ? bankDetails?.upi_id : returnProduct.\r\n                // paymentCredential._id\r\n            );\r\n            formData.append('returnAmount', \"\");\r\n            formData.append('retOrRepProductIds', JSON.stringify(selectedProducts));\r\n            returnImg.forEach((file) => {\r\n                console.log(\"file----------------====\", file)\r\n                formData.append('retOrRepProductImages', file); // Add image file to FormData\r\n            });\r\n            // returnImg.forEach((file) => {\r\n            //     const imageFile = file.file || file.originFileObj;  // Handle different structures\r\n            //     if (imageFile) {\r\n            //         formData.append('retOrRepProductImages', imageFile);\r\n            //     } else {\r\n            //         console.error(\"File missing for:\", file);\r\n            //     }\r\n            // });\r\n            try {\r\n                const res = await ReturnAndReplacement(token, formData);\r\n                if (res.status === 201) {\r\n                    setSelectedProducts([]);\r\n                    setReturnImg({});\r\n                    handleCancel()\r\n                    notification.success({\r\n                        placement: \"topRight\",\r\n                        message: res.data.message,\r\n                    });\r\n                    navigate(`/account/order`)\r\n                    setIsReturn(false)\r\n                    setValue(\"\")\r\n                    setSelectedSlot(null)\r\n                    setSelectSlotData(null)\r\n                } else if (res.status === 200) {\r\n                    setIsReturn(false)\r\n\r\n                    notification.error({\r\n                        placement: \"topRight\",\r\n                        message: res.data.message,\r\n                    });\r\n                }\r\n            } catch (error) {\r\n                console.error(error);\r\n                setIsReturn(false)\r\n\r\n            }\r\n        }\r\n    };\r\n\r\n    const ShowUserBankData = async () => {\r\n        try {\r\n            await fetchUserBankDetails(token)\r\n                .then((res) => {\r\n                    console.log(\"user bank\", res);\r\n                    if (res.status == 200) {\r\n                        setbankDetails(res.data.data)\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n        }\r\n    };\r\n    const handleSlotClick = (slot, item) => {\r\n        setSelectedSlot(slot);\r\n        console.log(\"slote\", slot)\r\n        console.log(\"item\", item)\r\n        setSelectSlotData(item)\r\n        setIsSlotConfirm(true)\r\n\r\n    };\r\n\r\n    const handleAddItem = (item) => {\r\n        console.log(\"selected incress item -sdf-sd-fds\", item)\r\n        dispatch(addReturnItem(item));\r\n        // setSelectedProducts(\r\n        //    [ {\r\n        //         _id: item._id,\r\n        //         quantity: item.isReturnQry,\r\n        //         productCode: item.productCode,\r\n        //     }]\r\n        // )\r\n\r\n    };\r\n    useEffect(() => {\r\n        localStorage.setItem(\"retunCart\", JSON.stringify(returnCartItem));\r\n    }, [returnCartItem]);\r\n\r\n    // const handleDelItem = (item) => {\r\n    //     console.log(\"selected descress item -sdf-sd-fds\", item)\r\n    //     dispatch(removeReturnCartItem(item));\r\n    //     const cart = JSON.parse(localStorage.getItem(\"cremoveCart\")) || []; // Retrieve cart from localStorage\r\n    //     const updatedCart = cart.filter((cartItem) => cartItem.productCode !== item.productCode); // Filter out the item to be removed\r\n    //     localStorage.setItem(\"cart\", JSON.stringify(updatedCart));\r\n\r\n    //         setSelectedProducts((prevSelected) =>\r\n    //             prevSelected.map((product) =>\r\n    //                 product._id === item._id\r\n    //                     ? { ...product, quantity: item.unit } // Update quantity for the matching item\r\n    //                     : product // Keep other products unchanged\r\n    //             )\r\n    //         );\r\n\r\n    // };\r\n    const handleDelItem = (item) => {\r\n        // setSelectedProducts(\r\n            \r\n        //    [ {\r\n        //         _id: item._id,\r\n        //         quantity: item.isReturnQry,\r\n        //         productCode: item.productCode,\r\n        //     }]\r\n        // )\r\n        console.log(\"selected descress item\", selectedProducts);\r\n        // Dispatch the Redux action\r\n        dispatch(removeReturnCartItem(item));\r\n\r\n        // Update localStorage\r\n        const cart = JSON.parse(localStorage.getItem(\"cremoveCart\")) || [];\r\n        const updatedCart = cart.filter((cartItem) => cartItem.productCode !== item.productCode);\r\n        localStorage.setItem(\"retunCart\", JSON.stringify(updatedCart));\r\n    };\r\n\r\n    // Listen for Redux state changes or localStorage updates\r\n    useEffect(() => {\r\n        const updatedCart = JSON.parse(localStorage.getItem(\"retunCart\")) || [];\r\n        setSelectedProducts((prevSelected) =>\r\n            prevSelected.map((product) =>\r\n                updatedCart.find((cartItem) => cartItem._id === product._id)\r\n                    ? { ...product, quantity: updatedCart.find((cartItem) => cartItem._id === product._id).isReturnQry }\r\n                    : product\r\n            )\r\n        );\r\n    }, [returnCartItem]); // Replace `dispatchState` with your Redux state slice\r\n\r\n    return (\r\n        <>\r\n            <Button type='primary' onClick={showModal}>{title}</Button>\r\n            <Modal style={{\r\n                top: 10\r\n            }} width={800} footer={false} title={<div className='show_return_title'>\r\n                <p>Select {capitalize(title)} Product with Image</p>\r\n\r\n            </div>} open={isModalOpen} onOk={handleOk} onCancel={handleCancel}>\r\n                {isLoading ? <Skeleton active /> :\r\n                    <>\r\n                        <div className=\"show_return_pro\">\r\n                            <List\r\n                                bordered\r\n                                className=\"demo-loadmore-list\"\r\n                                itemLayout=\"horizontal\"\r\n                                // dataSource={returnProduct?.productInfo}\r\n                                dataSource={returnCartItem}\r\n                                renderItem={(item, index) => (\r\n                                    <List.Item actions={[\r\n\r\n                                        selectedProducts?.some((product) => product._id === item._id) &&\r\n                                        returnCartItem.map((cartItem) => {\r\n                                            if (cartItem.productCode === item.productCode) {\r\n                                                return (\r\n                                                    <Button.Group key={cartItem.productCode}>\r\n                                                        <Button type=\"primary\" disabled={returnCartItem.unit === 0} onClick={() => handleDelItem(item)}>\r\n                                                            -\r\n                                                        </Button>\r\n                                                        <Button type=\"primary\">\r\n                                                            {cartItem.unit}\r\n                                                        </Button>{\" \"}\r\n                                                        {/* Access quantity from cart item */}\r\n                                                        <Button type=\"primary\" onClick={() => handleAddItem(item)}>\r\n                                                            +\r\n                                                        </Button>\r\n                                                    </Button.Group>\r\n                                                );\r\n                                            }\r\n                                            return null;\r\n                                        }),\r\n\r\n                                        <Checkbox\r\n                                            checked={selectedProducts.some((product) => product._id === item._id)} // Check if the item is in the selectedProducts array\r\n                                            onChange={(e) => handleSelectProduct(e, item, index)}\r\n                                            disabled={enabledIndex && !selectedProducts.some((product) => product._id === item._id)} // Update disable logic\r\n                                        />\r\n                                    ]}>\r\n                                        <List.Item.Meta\r\n                                            avatar={item.imageUrl != null\r\n                                                ? <Image src={item.imageUrl} width={50} />\r\n                                                : <Image width={50} src=\"error\" fallback={DefaultImg} />\r\n                                            }\r\n                                            title={<div className=\"item_title\"><p>{item.productName}</p></div>}\r\n                                            description={\r\n                                                <div className=\"order_data\">\r\n                                                    <p>{item.packSize} </p>\r\n                                                    <Space>\r\n                                                        <span>Qty. {item.unit}</span>\r\n                                                        <span>X</span>\r\n                                                        <span>₹ {item.offerProduct ? item.requiredOfferedBillingPrice : item.productPrice}</span>=\r\n                                                        <strong>₹{item.unit * (item.offerProduct ? item.requiredOfferedBillingPrice : item.productPrice)}</strong>\r\n                                                    </Space>\r\n\r\n                                                    {item.offerProduct ? (\r\n                                                        <List\r\n                                                            size=\"small\"\r\n                                                            className=\"demo-loadmore-list\"\r\n                                                            itemLayout=\"horizontal\"\r\n                                                        >\r\n                                                            <List.Item>\r\n                                                                <List.Item.Meta\r\n                                                                    avatar={item.offerProduct.imageUrl != null\r\n                                                                        ? <Image src={item.offerProduct.imageUrl} width={45} />\r\n                                                                        : <Image width={45} src=\"error\" fallback={DefaultImg} />\r\n                                                                    }\r\n                                                                    title={\r\n                                                                        <div className=\"item_title\">\r\n                                                                            <p>{item.offerProduct.productName}\r\n                                                                                <span className=\"mx-2\"><Tag color=\"green\" bordered={false}>Offer</Tag></span>\r\n                                                                            </p>\r\n                                                                        </div>\r\n                                                                    }\r\n                                                                    description={\r\n                                                                        <div className=\"order_datas\">\r\n                                                                            <p>{item.offerProduct.packSize} . <span>Qty. {item.offerProduct.OfferQty}</span> .   <strong className=\"order_Data_price\">Free</strong></p>\r\n                                                                        </div>\r\n                                                                    }\r\n                                                                />\r\n                                                            </List.Item>\r\n                                                        </List>\r\n                                                    ) : null\r\n                                                        //  <Button type='link' onClick={() => ShowMyOrderList()}>Undo Offer</Button>\r\n                                                    }\r\n                                                </div>\r\n                                            }\r\n                                        />\r\n                                        <div className=\"uplaod_img\">\r\n                                            {selectedProducts?.some((product) => product._id === item._id) && (\r\n                                                <div className='mt-2'>\r\n                                                    <Upload\r\n                                                        multiple={false}\r\n                                                        listType=\"picture-card\"\r\n                                                        onChange={(file) => handleImageUpload(file, item._id)}\r\n                                                        beforeUpload={() => false}\r\n                                                        fileList={uploadedImages[item._id] || []} // Display uploaded image\r\n                                                        accept=\"image/*\"\r\n                                                    >\r\n                                                        {uploadedImages[item._id] && uploadedImages[item._id].length === 1 ? null : (\r\n                                                            <Button type='link' icon={<MdOutlineCameraAlt className='h3' />}></Button>\r\n                                                        )}\r\n                                                    </Upload>\r\n                                                </div>\r\n                                            )}\r\n                                        </div>\r\n                                    </List.Item>\r\n                                )}\r\n                            />\r\n                            <div className=\"show_credential mt-2\">\r\n                                {!returnProduct.paymentCredential && returnProduct?.orderType !== \"REPLACEMENT\" ? <Card title={<div className='add_new_bank'>\r\n                                    <p>Select Refund Credential</p>\r\n                                </div>} >\r\n                                    {bankDetails === null ? <Empty image={Empty.PRESENTED_IMAGE_SIMPLE}> <Button onClick={() => navigate(\"/account/bank\")}>Add</Button></Empty> :\r\n                                        <Radio.Group onChange={handleRadioChange} value={value} style={{ width: \"100%\" }}>\r\n                                            <Row>\r\n                                                <Col md={6}>\r\n                                                    <Radio disabled={bankDetails?.bankAccountNo == \"\"} value=\"BANK\">Bank</Radio>\r\n                                                    {value === \"BANK\" && <Alert showIcon={false} message={\r\n                                                        <div>\r\n                                                            <p>Name : {bankDetails?.bankAccountHolder}</p>\r\n                                                            <p>Account No : {bankDetails?.bankAccountNo}</p>\r\n                                                            <p>Bank : {bankDetails?.bankName}</p>\r\n                                                            <p>IFSC : {bankDetails?.ifscCode}</p>\r\n                                                        </div>\r\n                                                    } type=\"info\" banner />}\r\n\r\n\r\n                                                </Col>\r\n                                                <Col>\r\n                                                    {bankDetails?.upiId != \"\" ?\r\n                                                        <>\r\n                                                            <Radio value=\"UPI\">UPI\r\n                                                            </Radio>\r\n                                                            {value === \"UPI\" ? <Alert showIcon={false} message={\r\n                                                                <div>\r\n                                                                    <p>UPI : {bankDetails?.upiId}</p>\r\n\r\n                                                                </div>\r\n                                                            } type=\"info\" banner /> : null}\r\n                                                        </>\r\n\r\n                                                        : null}\r\n                                                </Col>\r\n                                            </Row>\r\n                                        </Radio.Group>\r\n\r\n                                    }\r\n\r\n                                </Card> : <p className='refund_credential'>*{returnProduct?.paymentCredential}</p>}\r\n                            </div>\r\n                            <div className=\"retur_slot mt-2\">\r\n                                <Card title=\"Please choose available slot\">\r\n                                    {returnSlot?.length === 0 ? <div className=\"text-center\">\r\n                                        <Empty image={Empty.PRESENTED_IMAGE_SIMPLE} description=\"Please contact with BKD customer care.\" />\r\n                                    </div> :\r\n\r\n                                        returnSlot?.map((item) => (\r\n                                            <div className='show_slots'>\r\n                                                <p>{item.availableSlotFor}</p>\r\n                                                <div className='show_availabel_slots'>\r\n                                                    {item.availableSlot?.map((slot) => (\r\n                                                        <Button\r\n                                                            key={slot._id}\r\n                                                            className={isSloteConfirm && selectedSlot._id === slot._id && selectedSlotData.availableSlotDate === item.availableSlotDate ? \"Selected_btn\" : \"\"}\r\n                                                            icon={isSloteConfirm && selectedSlot._id === slot._id && selectedSlotData.availableSlotDate === item.availableSlotDate ? <FcOk /> : null}\r\n\r\n                                                            onClick={() => handleSlotClick(slot, item)}\r\n                                                        >\r\n                                                            {slot.timeSlotFrom} - {slot.timeSlotTo}\r\n                                                        </Button>\r\n                                                    ))}\r\n                                                </div>\r\n                                            </div>\r\n                                        ))\r\n                                    }\r\n                                </Card>\r\n                            </div>\r\n                            <Divider dashed />\r\n                            <Form.Item\r\n                                name=\"reason\"\r\n                                rules={[\r\n                                    {\r\n                                        required: true,\r\n                                        message: \"Please Enter  reason\",\r\n                                    },\r\n                                ]}\r\n                            >\r\n                                <Input.TextArea\r\n                                    placeholder=\"Write Reason...\"\r\n                                    onChange={handleInputChange}\r\n                                />\r\n                            </Form.Item>\r\n                        </div>\r\n                        <div className=\"return_replace\">\r\n                            <Space>\r\n\r\n                                <Button danger onClick={() => setIsModalOpen(false)}>CANCEL</Button>\r\n                                <Button type='primary' loading={isReturn} className='submit_btn' onClick={handelReturnSubmit}>{title}</Button>\r\n                            </Space>\r\n                        </div>\r\n                    </>\r\n                }\r\n            </Modal>\r\n        </>\r\n    );\r\n};\r\n\r\nexport default OrderReturn\r\n\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\account\\order\\RemoveItemDetails.jsx",["1538","1539","1540","1541","1542","1543","1544"],[],"\r\n\r\nimport React, { useEffect, useState } from 'react';\r\nimport { Alert, Button, Divider, message, Modal, Radio, Space } from 'antd';\r\nimport { fetchRemoveItemData, fetchUserBankDetails, RemoveOrderProduct } from '../../apiService/api';\r\nimport { useAuth } from '../../auth/context/authContext';\r\nimport { v4 as uuidv4 } from 'uuid';\r\nimport RefundRemenning from './RefundRemenning';\r\nimport { useNavigate } from 'react-router-dom';\r\nimport { useSelector } from 'react-redux';\r\nimport { selectedRefund } from '../../../redux/OrderSlice';\r\nimport PaymentRemenning from './PaymentRemenning';\r\n\r\nconst RemoveItemDetails = ({ ShowMyOrderDetails, setRemoveData, removeData, UserOrderId }) => {\r\n    const { token } = useAuth();\r\n    const navigate = useNavigate()\r\n\r\n    const [value, setValue] = useState(\"BANK\");\r\n    const [isModalOpen, setIsModalOpen] = useState(false);\r\n    const [removeReview, setRemoveReview] = useState([]);\r\n    const [isLoading, setIsLoading] = useState(false);\r\n\r\n    const [bankData, setBankData] = useState([])\r\n    const ShowUserBankData = async () => {\r\n        try {\r\n            await fetchUserBankDetails(token)\r\n                .then((res) => {\r\n                    console.log(\"user bank\", res);\r\n                    if (res.status == 200) {\r\n                        setIsLoading(true)\r\n                        setBankData(res.data.data)\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n            setIsLoading(true)\r\n        }\r\n    };\r\n\r\n    useEffect(() => {\r\n        ShowUserBankData();\r\n    }, []);\r\n\r\n    const showModal = () => {\r\n        setIsModalOpen(true);\r\n    };\r\n\r\n    const handleOk = () => {\r\n        setIsModalOpen(false);\r\n    };\r\n\r\n    const handleCancel = () => {\r\n        setIsModalOpen(false);\r\n    };\r\n\r\n    const ShowRemoveOrderReview = async () => {\r\n        setIsLoading(true);\r\n        const body = {\r\n            userOrderId: UserOrderId,\r\n            userOrderProductId: removeData\r\n        };\r\n        try {\r\n            await fetchRemoveItemData(token, body)\r\n                .then((res) => {\r\n                    if (res.status === 200) {\r\n                        setRemoveReview(res.data.data);\r\n                        setIsLoading(false);\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n            setIsLoading(false);\r\n        }\r\n    };\r\n\r\n    useEffect(() => {\r\n        if (isModalOpen) {\r\n            ShowRemoveOrderReview();\r\n        }\r\n    }, [isModalOpen]);\r\n\r\n    const removeOrderHandler = async () => {\r\n        const body = {\r\n            userOrderId: UserOrderId,\r\n            userOrderProductId: removeData,\r\n            transactionId: removeReview?.isPaymentGatewayRequired ? uuidv4() : \"\",\r\n            paymentOn: !removeReview?.isPaymentGatewayRequired ? value : \"\",\r\n        };\r\n        try {\r\n            await RemoveOrderProduct(token, body)\r\n                .then((res) => {\r\n                    if (res.status === 201) {\r\n                        message.success(res.data.message);\r\n                        ShowMyOrderDetails();\r\n                        setRemoveData([]);\r\n                        setIsModalOpen(false);\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err);\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n        }\r\n    };\r\n\r\n\r\n\r\n   \r\n\r\n    const newPaymentHandler = () => {\r\n        Modal.info({\r\n            title: 'Please Payment Your Remaining Amount',\r\n            content: (\r\n                <div>\r\n                    <p>₹ 10</p>\r\n                </div>\r\n            ),\r\n            onOk() {\r\n                removeOrderHandler()\r\n             },\r\n        });\r\n    };\r\n\r\n    return (\r\n        <>\r\n            <Button type=\"primary\" onClick={showModal} danger disabled={removeData?.length === 0}>Remove Request</Button>\r\n\r\n            <Modal loading={isLoading}\r\n                footer={false} title=\"Remove Item After Calculate\" open={isModalOpen} onOk={handleOk} onCancel={handleCancel}>\r\n                <div className=\"show_data\">\r\n                    <Divider>Before Remove Item</Divider>\r\n\r\n                    <Alert showIcon={false} type=\"error\" message={\r\n                        <>\r\n                            <div className=\"calculat_item\">\r\n                                <p>Sub Total Amount</p>\r\n                                <p>₹{removeReview?.oldTotalProductAmount}</p>\r\n                            </div>\r\n                            <div className=\"calculat_item\">\r\n                                <p>Delivery Charge</p>\r\n                                <p>₹{removeReview?.deliveryCharge}</p>\r\n                            </div>\r\n                            <div className=\"calculat_item\">\r\n                                <p>Discount Amount</p>\r\n                                <p>₹{removeReview?.oldDiscountAmount}</p>\r\n                            </div>\r\n                            <div className=\"calculat_item total_amt\">\r\n                                <p>Total Payable Amount</p>\r\n                                <p>₹{removeReview?.oldTotalPayableAmount}</p>\r\n                            </div>\r\n                            <Alert type=\"info\" message={<div className=\"saved_item\">\r\n                                <p>Saved Amount</p>\r\n                                <p>₹{removeReview?.oldTotalSaving}</p>\r\n                            </div>} />\r\n                        </>\r\n                    } banner />\r\n\r\n                    <Divider>After Remove Item</Divider>\r\n                    <Alert type=\"error\" message={<div className=\"calculat_item\">\r\n                        <p>Your Remove Item Amount</p>\r\n                        <p>₹{removeReview?.totalRemovedProductAmount}</p>\r\n                    </div>} banner />\r\n                    <Alert showIcon={false} type=\"success\" message={\r\n                        <>\r\n                            <div className=\"calculat_item\">\r\n                                <p>Sub Total Amount</p>\r\n                                <p>₹{removeReview?.totalProductAmount}</p>\r\n                            </div>\r\n                            <div className=\"calculat_item\">\r\n                                <p>Delivery Charge</p>\r\n                                <p>₹{removeReview?.deliveryCharge}</p>\r\n                            </div>\r\n                            <div className=\"calculat_item\">\r\n                                <p>Discount Amount</p>\r\n                                <p>₹{removeReview?.discountAmount}</p>\r\n                            </div>\r\n                            {removeReview?.discountAmount === 0 && removeReview?.oldDiscountAmount > 0 ? (\r\n                                <Alert type=\"error\" message={\r\n                                    <div className='calculat_item'>\r\n                                        <p>After Remove Item Discount is Not Valid</p>\r\n                                        <p>+(₹{removeReview?.oldDiscountAmount})</p>\r\n                                    </div>\r\n                                } banner />\r\n                            ) : null}\r\n                            <div className=\"calculat_item total_amt\">\r\n                                <p>Total Payable Amount</p>\r\n                                <p>₹{removeReview?.totalPayableAmount}</p>\r\n                            </div>\r\n                            <Alert type=\"info\" message={<div className=\"saved_item\">\r\n                                <p>New Saved Amount</p>\r\n                                <p>₹{removeReview?.totalSaving}</p>\r\n                            </div>} />\r\n                        </>\r\n                    } banner />\r\n\r\n                    {removeReview?.balanceAmount !== 0 ? (\r\n                        <Alert type={removeReview?.balanceAmount < 0 ? \"success\" : \"info\"} message={<div className=\"calculat_item\">\r\n                            <p>{removeReview?.balanceAmount < 0 ? \"Your Refund Amount\" : \"New Remaining Payable Amount\"}</p>\r\n                            <p>₹{Math.abs(removeReview?.balanceAmount)}</p>\r\n                        </div>} banner />\r\n                    ) : <Alert message=\"Your payable amount is balanced, no refund and no extra pay\" banner />}\r\n\r\n                    <Divider dashed />\r\n                    {removeReview?.isPaymentGatewayRequired ? <PaymentRemenning /> : <RefundRemenning bankData={bankData} navigate={navigate} value={value} setValue={setValue} />}\r\n                    <div className=\"remove_item_btn\">\r\n                        {removeReview?.isPaymentGatewayRequired ? <Button onClick={newPaymentHandler}>Pay Now </Button> : <Button loading={isLoading} onClick={removeOrderHandler}>Submit</Button>}\r\n\r\n                    </div>\r\n                </div>\r\n            </Modal>\r\n        </>\r\n    );\r\n};\r\n\r\nexport default RemoveItemDetails;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\account\\bankDetails\\BankData.jsx",["1545","1546"],[],"import React, { useEffect } from \"react\";\r\nimport { Button, Form, Input, Skeleton, notification } from \"antd\";\r\n\r\nimport \"../../../style/account.css\";\r\nimport { AddNewBankDetails } from \"../../apiService/api\";\r\nimport { useAuth } from \"../../auth/context/authContext\";\r\n\r\n\r\nfunction BankData({ bankData, isLoading, ShowUserBankData }) {\r\n    const { token } = useAuth()\r\n    const [form] = Form.useForm();\r\n\r\n\r\n    useEffect(() => {\r\n        form.setFieldsValue({\r\n            bankAccountNo: bankData?.bankAccountNo,\r\n            bankName: bankData?.bankName,\r\n            bankAccountHolder: bankData?.bankAccountHolder,\r\n            ifscCode: bankData?.ifscCode,\r\n        });\r\n\r\n    }, [bankData])\r\n\r\n\r\n    const onFinish = async (value) => {\r\n        try {\r\n\r\n            await AddNewBankDetails(token, value)\r\n                .then((res) => {\r\n                    if (res.status == 201) {\r\n                        notification.success({\r\n                            placement: \"topRight\",\r\n                            message: res.data.message,\r\n                        });\r\n                        ShowUserBankData()\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n\r\n        }\r\n    };\r\n    const onFinishFailed = (errorInfo) => {\r\n        console.log(\"Failed:\", errorInfo);\r\n    };\r\n\r\n\r\n\r\n\r\n    return (\r\n        <div className=\"pro_forms\">\r\n            {isLoading ? <Skeleton active title={false} paragraph={{ rows: 6 }} /> :\r\n                <Form\r\n                    form={form}\r\n                    name=\"basic\"\r\n                    layout=\"vertical\"\r\n\r\n                    onFinish={onFinish}\r\n                    onFinishFailed={onFinishFailed}\r\n                    autoComplete=\"off\"\r\n                >\r\n                    <Form.Item\r\n                        label=\"Bank Name\"\r\n                        name=\"bankName\"\r\n                        rules={[\r\n                            {\r\n                                required: true,\r\n                                message: \"Please Enter  Your Bank Name!\",\r\n                            },\r\n                        ]}\r\n                    >\r\n                        <Input placeholder=\"Enter Bank Name\" variant=\"filled\" />\r\n                    </Form.Item>\r\n                    <Form.Item\r\n                        label=\"Account Number\"\r\n                        name=\"bankAccountNo\"\r\n                        rules={[\r\n                            {\r\n                                required: true,\r\n                                message: \"Please Enter  Your Account Number!\",\r\n                            },\r\n                        ]}\r\n                    >\r\n                        <Input placeholder=\"Enter Account Number\" variant=\"filled\" />\r\n                    </Form.Item>\r\n\r\n                    <Form.Item\r\n                        label=\"Bank Account Holder\"\r\n                        name=\"bankAccountHolder\"\r\n                        rules={[\r\n                            {\r\n                                required: true,\r\n                                message: \"Please Enter  Bank Account Holder\",\r\n                            },\r\n                        ]}\r\n                    >\r\n                        <Input placeholder=\"Enter Bank Account Holder\" variant=\"filled\" />\r\n                    </Form.Item>\r\n\r\n                    <Form.Item\r\n                        label=\"IFSC Code\"\r\n                        name=\"ifscCode\"\r\n                        rules={[\r\n                            {\r\n                                required: true,\r\n                                message: \" Enter Your IFSC Code!\",\r\n                            },\r\n                        ]}\r\n                    >\r\n\r\n                        <Input maxLength={11} placeholder=\"Enter Bank IFSC Code\" variant=\"filled\" />\r\n                    </Form.Item>\r\n\r\n\r\n                    <Form.Item>\r\n                        <div className=\"profile_tbn\">\r\n                            <Button type=\"primary\" htmlType=\"submit\">\r\n                                Update\r\n                            </Button>\r\n                        </div>\r\n                    </Form.Item>\r\n                </Form>}\r\n        </div>\r\n    );\r\n}\r\n\r\n\r\n\r\n\r\n\r\nexport default BankData","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\account\\bankDetails\\UPIIDData.jsx",["1547","1548","1549","1550","1551","1552","1553","1554","1555","1556","1557","1558","1559","1560","1561"],[],"import React, { useEffect, useState } from \"react\";\r\nimport { Button, Card, Checkbox, DatePicker, Form, Input, Segmented, Select, Skeleton, Upload, notification } from \"antd\";\r\n\r\nimport \"../../../style/account.css\";\r\nimport { AddNewBankDetails, GetUserProfile, UpdateUserProfile, fetchUserBankDetails, genders } from \"../../apiService/api\";\r\nimport { useAuth } from \"../../auth/context/authContext\";\r\nimport moment from 'moment';\r\n\r\n\r\nfunction UPIIDData({ onClose, isAddModal, bankData, ShowUserBankData, isLoading }) {\r\n\r\n    const { token, CurrentUserInfo } = useAuth()\r\n    const [form] = Form.useForm();\r\n\r\n\r\n\r\n    useEffect(() => {\r\n\r\n        form.setFieldsValue({\r\n            upiId: bankData?.upiId,\r\n        });\r\n\r\n    }, [bankData]);\r\n\r\n\r\n\r\n    const onFinish = async (value) => {\r\n        try {\r\n\r\n            await AddNewBankDetails(token, value)\r\n                .then((res) => {\r\n                    // console.log(\"user profile\", res);\r\n                    if (res.status === 201) {\r\n                        ShowUserBankData()\r\n                        notification.success({\r\n                            placement: \"topRight\",\r\n                            message: res.data.message,\r\n                        });\r\n\r\n                    }\r\n\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n\r\n        }\r\n    };\r\n    const onFinishFailed = (errorInfo) => {\r\n        console.log(\"Failed:\", errorInfo);\r\n    };\r\n\r\n    const onReset = () => {\r\n        form.resetFields()\r\n    }\r\n    return (\r\n        <div className=\"pro_forms\">\r\n            {isLoading ? <Skeleton active title={false} paragraph={{ rows: 6 }} /> :\r\n                <Form\r\n                    form={form}\r\n                    name=\"basic\"\r\n                    layout=\"vertical\"\r\n                    // style={{\r\n                    //     maxWidth: 600,\r\n                    // }}\r\n\r\n                    onFinish={onFinish}\r\n                    onFinishFailed={onFinishFailed}\r\n                    autoComplete=\"off\"\r\n                >\r\n\r\n                    <Form.Item\r\n                        label=\"UPI ID\"\r\n                        name=\"upiId\"\r\n                        rules={[\r\n                            {\r\n                               \r\n                                required: true,\r\n                                message: \"Please Enter your UPI ID  \",\r\n                            },\r\n                            {\r\n                                pattern: /@/,\r\n                                message: \"Must contain @ symbol!\",\r\n                              },\r\n                        ]}\r\n                    >\r\n                        <Input placeholder=\"Enter your UPI ID\" variant=\"filled\" />\r\n                    </Form.Item>\r\n\r\n                    <Form.Item>\r\n                        <div className=\"profile_tbn\">\r\n                            <Button type=\"primary\" htmlType=\"submit\">\r\n                                Update\r\n                            </Button>\r\n                        </div>\r\n                    </Form.Item>\r\n                </Form>}\r\n\r\n        </div>\r\n\r\n    );\r\n}\r\n\r\n\r\n\r\n\r\nexport default UPIIDData","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\shareLink\\ShareCartModal.jsx",["1562","1563","1564","1565","1566","1567"],[],"import React, { useEffect, useState } from 'react';\r\nimport { Button, Divider, Modal, Space } from 'antd';\r\nimport '../../style/order.css'\r\nimport { useNavigate } from 'react-router-dom';\r\nimport { FaCartPlus } from 'react-icons/fa';\r\nimport LZString from 'lz-string'\r\n\r\n\r\nconst ShareCartModal = ({ cartItems }) => {\r\n\r\n\r\n\r\n    // const handleNativeShare = () => {\r\n    //     if (navigator.share) {\r\n    //         navigator.share({\r\n    //             title: 'My Cart',\r\n    //             text: 'Check out the cart I created!',\r\n    //             url: window.location.href, // or your share link\r\n    //         })\r\n    //             .then(() => console.log('Shared successfully'))\r\n    //             .catch((err) => console.error('Share failed:', err));\r\n    //     } else {\r\n    //         alert('Web Share API not supported on this browser.');\r\n    //     }\r\n    // };\r\n\r\n    const generateCartShareLink = () => {\r\n        const cart = cartItems.map((item) => ({ productCode: item.productCode, qty: item.unit, offer: item.selected_offer ? { offerId: item.selected_offer?.offerId, productCode: item.selected_offer?.productCode } : null }))\r\n        console.log(\"cart---\", cart)\r\n        const cartData = JSON.stringify(cart);\r\n        const encoded = LZString.compressToEncodedURIComponent(cartData);\r\n        return `${window.location.origin}/share-link?data=${encoded}`;\r\n    };\r\n\r\n    const handleNativeShare = async () => {\r\n        const shareLink = generateCartShareLink();\r\n        console.log(\"shareLink\", shareLink)\r\n        const totalAmount = cartItems.reduce((sum, item) => sum + item.unit * item.price, 0);\r\n        const productSummary = cartItems.map(p => `${p.productName} (${p.unit})`).join(\", \");\r\n\r\n        const message = `Hi, I have created a cart with ${cartItems.length} items worth ₹${totalAmount}.\r\n    ${productSummary}\r\n    Please review and make the payment.\r\n    `;\r\n\r\n        if (navigator.share) {\r\n            navigator.share({\r\n                title: 'My Cart',\r\n                text: message,\r\n                url: shareLink,\r\n            }).catch((err) => console.error('Share failed:', err));\r\n        } else {\r\n            window.open(`https://wa.me/?text=${encodeURIComponent(message)}`, '_blank');\r\n        }\r\n    };\r\n\r\n\r\n\r\n    // const saveCartToServer = async () => {\r\n    //     const cart = cartItems.map((item) => ({ productCode: item.productCode, qty: item.unit }))\r\n    //     try {\r\n    //         const resposne = await ShareCartLink(cart)\r\n    //         console.log(\"resposne\", resposne)\r\n    //     } catch (error) {\r\n    //         console.log(error)\r\n    //     }\r\n\r\n    //     return resposne;\r\n    // };\r\n\r\n\r\n    //     const handleNativeShare = async () => {\r\n    //         const cart = cartItems.map((item) => ({ productCode: item.productCode, qty: item.unit }))\r\n    //         const shareLink = await ShareCartLink({ cartItem: cart }); // or use static one\r\n    //         console.log(\"shareLink\", shareLink)\r\n    //         const totalAmount = cart.reduce((sum, item) => sum + item.qty * item.price, 0);\r\n    //         const productSummary = cart.map(p => `${p.name} (${p.qty})`).join(\", \");\r\n\r\n    //         const message = `Hi, I have created a cart with ${cart.length} items worth ₹${totalAmount}.\r\n    // ${productSummary}\r\n    // Please review and make the payment.\r\n    // ${shareLink.data.urlshort}`;\r\n\r\n    //         if (navigator.share) {\r\n    //             navigator.share({\r\n    //                 title: 'My Cart',\r\n    //                 text: message,\r\n    //                 url: `${message}/\\n ${shareLink.data.urlshort}`,\r\n    //             }).catch((err) => console.error('Share failed:', err));\r\n    //         } else {\r\n    //             // fallback: WhatsApp or copy\r\n    //             window.open(`https://wa.me/?text=${encodeURIComponent(message)}`);\r\n    //         }\r\n    //     };\r\n\r\n    return (\r\n        <>\r\n            <Button disabled={cartItems.length === 0} type=\"primary\" icon={<FaCartPlus />} onClick={handleNativeShare}>\r\n                Share\r\n            </Button>\r\n\r\n        </>\r\n    );\r\n};\r\n\r\n\r\nexport default ShareCartModal","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\cart\\ShowApplyOffer.jsx",["1568","1569","1570","1571"],[],"import React, { useState } from 'react';\r\nimport { Avatar, Button, Card, Modal } from 'antd';\r\nimport BKDLogo from \"../../assest/bkdlogo.png\";\r\nimport \"../../style/product.css\"\r\n// import { selectNewUpdateOfferQty } from '../../redux/CartSlice';\r\n\r\n\r\nconst ShowApplyOffer = ({ offerItem }) => {\r\n    const [isModalOpen, setIsModalOpen] = useState(false);\r\n    // const selectOfferNewQty = useSelector(selectNewUpdateOfferQty);\r\n    // console.log(\"selectOfferNewQty\", selectOfferNewQty)\r\n\r\n    const showModal = () => {\r\n        setIsModalOpen(true);\r\n    };\r\n    const handleOk = () => {\r\n        setIsModalOpen(false);\r\n    };\r\n    const handleCancel = () => {\r\n        setIsModalOpen(false);\r\n    };\r\n\r\n    return (\r\n        <>\r\n            {/* <span className='free_amount' onClick={showModal}>{`Added Offer Product Qty. ${selectOfferNewQty != null ? selectOfferNewQty : offerItem?.selected_offer.qty}`}</span> */}\r\n            <span className='free_amount' onClick={showModal}>{`Added Offer  Qty. ${offerItem?.selected_offer.OfferQty}`}</span>\r\n            <Modal footer={false} width={300} title=\"Offer Product\" open={isModalOpen} onOk={handleOk} onCancel={handleCancel}>\r\n                <Card\r\n                    cover={\r\n                        <img\r\n                            src={offerItem?.selected_offer?.imageUrl?.length != 0 ? offerItem?.selected_offer?.imageUrl[0] : BKDLogo}\r\n                            onError={(e) => e.currentTarget.src = BKDLogo}\r\n                        />\r\n                    }\r\n                >\r\n                    <Card.Meta\r\n\r\n                        title={offerItem?.selected_offer.productName}\r\n                        description={<div className='offer_data'>\r\n                            <div className=\"offer_title\">\r\n\r\n                                <p>{offerItem?.selected_offer.packSize}</p>\r\n                                <p><b><span className='free_amount'>Free</span></b> . <span><del>{offerItem?.selected_offer.price}</del></span></p>\r\n                            </div>\r\n                            <div className=\"offer_qty\">\r\n                                {/* <p>Qty. <span className=\"free_amount\">{selectOfferNewQty!==null ? selectOfferNewQty :offerItem?.selected_offer.qty}</span></p> */}\r\n                                <p>Qty. <span className=\"free_amount\">{offerItem?.selected_offer.OfferQty}</span></p>\r\n                            </div>\r\n                        </div>}\r\n                    />\r\n\r\n                </Card>\r\n\r\n            </Modal>\r\n        </>\r\n    );\r\n};\r\n\r\nexport default ShowApplyOffer","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\cart\\DescribeOffer.jsx",[],[],"C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\cart\\ReferralCouponCard.jsx",[],[],"C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\segment\\SegmentProductItem.jsx",["1572","1573","1574","1575","1576","1577","1578","1579","1580","1581","1582","1583","1584","1585","1586","1587","1588","1589","1590"],[],"import { Badge, Button, Card, Divider, Radio, Skeleton, Space, Tag, Tooltip, notification } from \"antd\";\r\nimport React, { useEffect, useState } from \"react\";\r\nimport \"../../style/header.css\";\r\nimport { FaHeart } from \"react-icons/fa\";\r\nimport { FaRegHeart } from \"react-icons/fa\";\r\nimport { useNavigate } from \"react-router-dom\";\r\nimport { MdArrowRightAlt } from \"react-icons/md\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { addItem, removeItem, selectCartItems } from \"../../redux/CartSlice\";\r\nimport { SmileOutlined } from '@ant-design/icons';\r\nimport { AddProductWishlist, out_of_stock } from \"../apiService/api\";\r\nimport { useScreen } from \"../auth/AuthScreen\";\r\nimport { useAuth } from \"../auth/context/authContext\";\r\nimport BKDLogo from \"../../assest/bkdlogo.png\"\r\nimport NotFoundProduct from \"../../assest/not-found.jpg\"\r\nimport offerAvailable from \"../../assest/png/offer_apply.png\"\r\nimport { encryptCategoryID } from \"../../config/encriptConfig\";\r\nimport { getOfferImage } from \"../../utils/offerUtils\";\r\n\r\nfunction SegmentProductItem({ isLoading, segmentData, showSegmentDetails }) {\r\n    const { screenWidth } = useScreen()\r\n    const { token } = useAuth()\r\n    const navigate = useNavigate();\r\n    const dispatch = useDispatch();\r\n    const cartItems = useSelector(selectCartItems);\r\n    const titleCase = str => str.toLowerCase().split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');\r\n\r\n\r\n    const [wishlist, setWishlist] = useState({});\r\n\r\n\r\n\r\n    const handleAddItem = (item) => {\r\n        dispatch(addItem(item))\r\n\r\n    };\r\n\r\n    useEffect(() => {\r\n        localStorage.setItem(\"cart\", JSON.stringify(cartItems));\r\n    }, [cartItems]);\r\n\r\n\r\n    const handleDelItem = (item) => {\r\n        dispatch(removeItem(item));\r\n        const cart = JSON.parse(localStorage.getItem(\"cart\")) || []; // Retrieve cart from localStorage\r\n        const updatedCart = cart.filter(cartItem => cartItem.productCode !== item.productCode); // Filter \r\n        localStorage.setItem(\"cart\", JSON.stringify(updatedCart))\r\n\r\n    };\r\n\r\n\r\n    const GoToSimilarProduct = (item) => {\r\n        navigate(`/product/${manageURl(item.productName)}?uid=${encodeURIComponent(encryptCategoryID(item.productCode))}`);\r\n        showSegmentDetails()\r\n    }\r\n\r\n    const goToProductDetails = (item) => {\r\n        navigate(`/product/${manageURl(item.productName)}?uid=${encodeURIComponent(encryptCategoryID(item.productCode))}`);\r\n\r\n    }\r\n\r\n    const HnadleNotLogin = () => {\r\n        notification.error({\r\n            placement: \"topRight\",\r\n            message: \"Please login before add wishlist\",\r\n        });\r\n    }\r\n\r\n\r\n    const addToWishList = async (proCode) => {\r\n        setWishlist((prev) => ({ ...prev, [proCode.productCode]: true }));\r\n        const body = {\r\n            productCode: proCode.productCode,\r\n            productName: proCode.productName,\r\n            status: \"ACTIVE\"\r\n        }\r\n        try {\r\n            await AddProductWishlist(token, body)\r\n                .then((res) => {\r\n                    console.log(\"add to  wish\", res);\r\n                    if (res.status == 201) {\r\n\r\n\r\n                        if (res.data.data.whislistKey != true) {\r\n                            // notification.warning({\r\n                            //     placement: \"topRight\",\r\n                            //     message: \"Remove Product From Wishlist\",\r\n\r\n                            // });\r\n                            showSegmentDetails()\r\n                        } else {\r\n                            // notification.success({\r\n                            //     placement: \"topRight\",\r\n                            //     message: \"Add Product To  Wishlist\",\r\n\r\n                            // })\r\n                            showSegmentDetails()\r\n\r\n                        }\r\n\r\n\r\n                    }\r\n\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n                    setWishlist((prev) => ({ ...prev, [proCode]: false }));\r\n                });\r\n        } catch (error) {\r\n            setWishlist((prev) => ({ ...prev, [proCode]: false }));\r\n            console.log(error);\r\n\r\n        }\r\n    };\r\n    const RemoveToWishList = async (proCode) => {\r\n        setWishlist((prev) => ({ ...prev, [proCode.productCode]: false })); // Immediately update the icon\r\n        const body = { productCode: proCode.productCode, productName: proCode.productName, status: \"INACTIVE\" };\r\n        try {\r\n            await AddProductWishlist(token, body)\r\n                .then((res) => {\r\n                    if (res.status === 201) {\r\n                        showSegmentDetails();\r\n                        // notification['warning']({\r\n                        //     placement: \"topRight\",\r\n                        //     message: \"Removed Product From Wishlist\",\r\n                        // });\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n                    setWishlist((prev) => ({ ...prev, [proCode]: true })); // Revert the icon if the API call fails\r\n                    // notification['error']({\r\n                    //     placement: \"topRight\",\r\n                    //     message: \"Failed to Remove Product From Wishlist\",\r\n                    // });\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n            setWishlist((prev) => ({ ...prev, [proCode]: true })); // Revert the icon if the API call fails\r\n        }\r\n    };\r\n\r\n    const manageURl = (productName) => {\r\n        const sanitizedCategory = productName\r\n            .replace(/[,/&]/g, '') // Remove commas, slashes, ampersands\r\n            .replace(/\\s+/g, '-')  // Replace spaces with hyphens\r\n            .toLowerCase();\r\n        return sanitizedCategory\r\n    }\r\n\r\n    return (\r\n        <div className=\"segment_1\">\r\n            <div className=\"prodcut_slider\">\r\n                <div className={`${segmentData?.length !== 0 && \"showing_pro_by_cat\"}`}>\r\n                    {segmentData?.length === 0 ? <div className='text-center'>\r\n                        <img src={NotFoundProduct} width=\"50%\" />\r\n                    </div> : segmentData.map((item) => (\r\n                        <div className=\"product_card individual_card\" key={item.productCode}>\r\n                            <Card\r\n                                hoverable\r\n                                disabled={item.stockQty == 0 && true}\r\n                            >\r\n                                <div className=\"card_img\">\r\n                                    {item.imageUrl[0] != null ?\r\n                                        <img\r\n                                            className={item.stockQty <= out_of_stock ? \"out_of_stock_img\" : \"\"}\r\n                                            src={item.imageUrl[0] || BKDLogo}\r\n                                            onError={(e) => e.currentTarget.src = BKDLogo}\r\n                                            onClick={() => GoToSimilarProduct(item)}\r\n                                        />\r\n                                        :\r\n                                        <img\r\n                                            className={item.stockQty <= out_of_stock ? \"out_of_stock_img\" : \"\"}\r\n                                            src={BKDLogo}\r\n                                            onClick={() => goToProductDetails(item)} />\r\n                                    }\r\n\r\n                                </div>\r\n\r\n                                <div className=\"pro_name\" onClick={() => goToProductDetails(item)}>\r\n                                    <Tooltip title={titleCase(item.productName)}>\r\n                                        <p>{item.productName.length > 36 ? titleCase(item.productName.slice(0, 36)) + \"...\" : titleCase(item.productName)}</p>\r\n                                    </Tooltip>\r\n                                </div>\r\n                                <div className=\"show_variant_item\" onClick={() => goToProductDetails(item)} >\r\n                                    {item.packSize && item.packSize !== \"(NIL)\" ? <Tag color=\"green\">{item.packSize.substr(0, 10)}</Tag> : <p className=\"hidden_data\">N/A</p>}\r\n                                    {item.stockQty <= out_of_stock ? <Tag color='red' className=\"stock_tag\">out of stock</Tag> : <p className='hidden_data'>N/A</p>}\r\n                                </div>\r\n                                <div className=\"show_price_mrp\">\r\n                                    <p>BKD Price | MRP</p>\r\n                                </div>\r\n                                <div className=\"add_cart\">\r\n                                    <p>{`₹ ${Math.round(item.bkdAmount)} `} <span>{item.bkdAmount != item.price && <del>₹ {item.price}</del>}</span> </p>\r\n\r\n                                    {cartItems.find((cartItem) => cartItem.productCode === item.productCode) ? (\r\n                                        cartItems.map((cartItem) => {\r\n                                            if (cartItem.productCode === item.productCode) {\r\n                                                return (\r\n                                                    <Button.Group className=\"add_to_carts\" size={screenWidth < 800 ? \"\" : 'small'} key={cartItem.productCode}>\r\n                                                        <Button className=\"add_to_carts add_to_cart_button\" onClick={() => handleDelItem(item)}>-</Button>\r\n                                                        <Button className=\"add_to_carts add_to_cart_button\">{cartItem.unit}</Button> {/* Access quantity from cart item */}\r\n                                                        <Button className=\"add_to_carts add_to_cart_button\" onClick={() => handleAddItem(item)}>+</Button>\r\n                                                    </Button.Group>\r\n                                                );\r\n                                            }\r\n                                            return null;\r\n                                        })\r\n                                    ) : (\r\n                                        <Button disabled={item.stockQty <= out_of_stock} type=\"default\" onClick={() => handleAddItem(item)}>ADD</Button>\r\n                                    )}\r\n                                </div>\r\n                            </Card>\r\n                            {item.billingQty === \"PROMOTIONS\" || item.billingQty === \"DISCOUNT\" || item.offerQty === \"PROMOTIONS\" || item.offerQty === \"DISCOUNT\" ?\r\n                                <div className=\"discount_tags\">Super Saver Price</div> : item.billingQty != \"\" && item.offerQty != \"\" ?\r\n                                    <div className=\"offer_Available\">\r\n                                        {(item.billingQty === \"FOC\" || item.offerQty === \"FOC\") ?\r\n                                            <>\r\n                                                <img src={offerAvailable} />\r\n                                                <div className=\"offer_types\">\r\n                                                    <p>1 Item</p>\r\n                                                    <p>Free </p>\r\n                                                </div>\r\n                                            </>\r\n                                            :\r\n                                            <img src={getOfferImage(item?.offerQty)} />\r\n                                        }\r\n\r\n                                    </div> : Math.round(item.bkdAmount) != item.price ? <div className=\"cat_tags\">{Math.round((item.price - item.bkdAmount) * 100 / item.price)}% off</div> : null}\r\n\r\n                            <div className=\"wish_list\">\r\n\r\n                                {token ?\r\n                                    <div className='wish_list'>\r\n                                        {\r\n                                            wishlist[item.productCode] || item.isWhislist ? (\r\n                                                <FaHeart\r\n                                                    className=\"no_wish_icon\"\r\n                                                    size={22}\r\n                                                    color='red'\r\n                                                    onClick={() => RemoveToWishList(item)}\r\n                                                />\r\n                                            ) : (\r\n                                                <FaRegHeart\r\n                                                    className=\"no_wish_icon\"\r\n                                                    size={22}\r\n                                                    onClick={() => addToWishList(item)}\r\n                                                />\r\n                                            )\r\n                                        }\r\n                                    </div>\r\n\r\n                                    :\r\n                                    <div className='wish_list'>\r\n                                        <FaRegHeart\r\n                                            className=\"no_wish_icon\"\r\n                                            size={22}\r\n                                            onClick={HnadleNotLogin}\r\n                                        />\r\n                                    </div>\r\n                                }\r\n                            </div>\r\n                        </div>\r\n                    ))}\r\n                </div>\r\n            </div>\r\n        </div>\r\n    );\r\n}\r\n\r\n\r\n\r\nexport default SegmentProductItem\r\n\r\n\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\segment\\BannerSegment.jsx",["1591","1592"],[],"import React from 'react'\r\nimport '../../style/segment.css'\r\nimport { useNavigate } from 'react-router-dom'\r\nimport BKDLogo from \"../../assest/bkdlogo.png\";\r\n\r\nfunction BannerSegment({ title, showAllSegemtnList, layerDetails, isLoading }) {\r\n    const segmentId = layerDetails.map(item => item._id);\r\n    const bannerTitle = layerDetails.flatMap(item => ({\r\n        banner: item.bigBanner,\r\n        title: item.title,\r\n    }));\r\n\r\n    const navigate = useNavigate()\r\n    return (\r\n        layerDetails?.length != 0 ?\r\n            <div className='banenr_segment my-4'>\r\n                {layerDetails?.map((url) => (\r\n                    <img\r\n                        src={url.bigBanner || BKDLogo}\r\n                        onError={(e) => e.currentTarget.src = BKDLogo}\r\n                        onClick={() => navigate(`/segment-detials/${segmentId}`, { state: bannerTitle })}\r\n                    />\r\n                ))}\r\n            </div>\r\n            : null\r\n    )\r\n}\r\n\r\nexport default BannerSegment","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\auth\\OptVerifiy.jsx",["1593","1594"],[],"import { Button, Form, Input, message, notification } from \"antd\";\r\nimport React, { useEffect, useRef, useState } from \"react\";\r\nimport OtpInput from \"react-otp-input\";\r\nimport \"../../style/login.css\";\r\nimport { ReSendOTP, VerifyOTPS } from \"../apiService/api\";\r\nimport { useAuth } from \"./context/authContext\";\r\nimport { useNavigate } from \"react-router-dom\";\r\n\r\nfunction OptVerifiy({ isOtpSent, setIsModalOpen, number }) {\r\n  const navigate = useNavigate();\r\n  const focusOtp = useRef()\r\n  const { login, fcmtoken } = useAuth();\r\n  const [otp, setOtp] = useState(\"\");\r\n  const [minutes, setMinutes] = useState(0);\r\n  const [seconds, setSeconds] = useState(30);\r\n  const [isLoading, setIsLoading] = useState(false)\r\n\r\n  useEffect(() => {\r\n\r\n    const interval = setInterval(() => {\r\n      if (seconds > 0) {\r\n        setSeconds(seconds - 1);\r\n      }\r\n\r\n      if (seconds === 0) {\r\n        if (minutes === 0) {\r\n          clearInterval(interval);\r\n        } else {\r\n          setSeconds(59);\r\n          setMinutes(minutes - 1);\r\n        }\r\n      }\r\n    }, 1000);\r\n\r\n    return () => {\r\n      clearInterval(interval);\r\n    };\r\n  }, [seconds]);\r\n\r\n  const resendOTP = () => {\r\n    setMinutes(0);\r\n    setSeconds(30);\r\n    resendOtpHandler()\r\n  };\r\n\r\n  const resendOtpHandler = async () => {\r\n    try {\r\n      await ReSendOTP({ mobileNo: number, }).then((res) => {\r\n        if (res.status === 201) {\r\n          message.success(res.data.message)\r\n        }\r\n      }).catch((err) => {\r\n        // Error handled silently\r\n      })\r\n\r\n    } catch (error) {\r\n      // Error handled silently\r\n    }\r\n  }\r\n\r\n  useEffect(() => {\r\n    if (focusOtp.current) {\r\n      focusOtp.current.focus();\r\n    }\r\n  }, []);\r\n\r\n  const body = {\r\n    mobileNo: number,\r\n    fcmToken: fcmtoken,\r\n    otp: otp,\r\n  }\r\n\r\n  const submitHandler = async () => {\r\n    setIsLoading(true)\r\n    if (!otp) {\r\n      notification.warning({\r\n        placement: \"topRight\",\r\n        message: \"Please Enter OTP \",\r\n\r\n      });\r\n    }\r\n\r\n    try {\r\n      await VerifyOTPS(body)\r\n        .then((res) => {\r\n          if (res.status == 201) {\r\n            localStorage.setItem(\"token\", res.data.data.accessToken);\r\n            login(res.data.data.accessToken);\r\n            navigate(window.location.pathname, { replace: true });\r\n            setIsModalOpen(false)\r\n            setIsLoading(false)\r\n            notification.success({\r\n              placement: \"topRight\",\r\n              message: \"Login Successfull \",\r\n            });\r\n\r\n          } else if (res.status === 200) {\r\n            setIsLoading(false)\r\n            notification.error({\r\n              placement: \"topRight\",\r\n              message: res.data.message,\r\n            });\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          setIsLoading(false)\r\n        });\r\n    } catch (error) {\r\n      setIsLoading(false)\r\n    }\r\n  };\r\n\r\n  const handleKeyDown = (e) => {\r\n    if (e.key === \"Enter\") {\r\n      submitHandler();\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    if (isOtpSent && focusOtp.current) {\r\n      focusOtp.current.focus();\r\n    }\r\n  }, [isOtpSent]); // Focus input when OTP is sent\r\n\r\n  return (\r\n    <div className=\"otp_verification\">\r\n      <div className=\"otp_vefiyed\">\r\n        <OtpInput\r\n          value={otp}\r\n          onChange={setOtp}\r\n          numInputs={4}\r\n          placeholder={0}\r\n          inputType=\"numeric\"\r\n          renderInput={(props, index) => (\r\n            <div className=\"ot_field\">\r\n              <Form.Item>\r\n\r\n                <Input\r\n                  ref={index === 0 ? focusOtp : null}\r\n                  {...props} style={{ width: \"3rem\", height: \"3rem\" }} placeholder=\"0\" variant=\"filled\"\r\n                  // type=\"number\"\r\n                  inputMode=\"numeric\"\r\n                  pattern=\"[0-9]*\"\r\n                  onKeyDown={handleKeyDown}\r\n\r\n                />\r\n              </Form.Item>\r\n            </div>\r\n          )}\r\n        />\r\n        {isOtpSent && (\r\n          <div className=\"countdown_text\">\r\n            {seconds > 0 || minutes > 0 ? (\r\n              <p>\r\n                Time Remaining: {minutes < 10 ? `0${minutes}` : minutes}:\r\n                {seconds < 10 ? `0${seconds}` : seconds}\r\n              </p>\r\n            ) : (\r\n              <div className=\"not_recived_otp\">\r\n                <p>Didn't recieve OTP?</p>\r\n                <Button\r\n                  type=\"link\"\r\n                  disabled={seconds > 0 || minutes > 0}\r\n                  style={{\r\n                    color: seconds > 0 || minutes > 0 ? \"#DFE3E8\" : \"#5AC268\",\r\n                  }}\r\n                  onClick={() => resendOTP()}\r\n                >\r\n                  Resend\r\n                </Button>\r\n              </div>\r\n            )}\r\n\r\n          </div>\r\n        )}\r\n\r\n        <div className=\"verify_continue\">\r\n          <Button loading={isLoading} size=\"large\" type=\"primary\" onClick={submitHandler}>Verify & Continue</Button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default OptVerifiy;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\account\\bankDetails\\AddUpi.jsx",["1595","1596","1597","1598"],[],"import React, { useState } from 'react';\r\nimport { Button, Drawer, Form, Input, notification, Segmented } from 'antd';\r\nimport BankData from './BankData';\r\nimport UPIIDData from './UPIIDData';\r\nimport '../../../style/account.css'\r\nimport { AddNewBankDetails } from '../../apiService/api';\r\nimport { useAuth } from '../../auth/context/authContext';\r\n\r\n\r\nconst AddUpi = ({ ShowUserBankData }) => {\r\n    const [open, setOpen] = useState(false);\r\n    const [form] = Form.useForm();\r\n    const { token } = useAuth()\r\n\r\n\r\n    const showDrawer = () => {\r\n        setOpen(true);\r\n    };\r\n    const onClose = () => {\r\n        setOpen(false);\r\n    };\r\n\r\n\r\n    const onFinish = async (value) => {\r\n        try {\r\n\r\n            await AddNewBankDetails(token, value)\r\n                .then((res) => {\r\n                    // console.log(\"user profile\", res);\r\n                    if (res.status == 201) {\r\n                        notification.success({\r\n                            placement: \"topRight\",\r\n                            message: res.data.message,\r\n                        });\r\n                        // onReset()\r\n                        onClose()\r\n                        ShowUserBankData()\r\n                    }\r\n\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n\r\n        }\r\n    };\r\n    const onFinishFailed = (errorInfo) => {\r\n        console.log(\"Failed:\", errorInfo);\r\n    };\r\n\r\n\r\n    return (\r\n        <>\r\n            <Button type='primary' onClick={showDrawer} className='add_btns'>\r\n                Add\r\n            </Button>\r\n            <Drawer title=\"Add Bank Details\" onClose={onClose} open={open}>\r\n                <div className=\"add_bank\">\r\n                    <div className=\"bank_segment\">\r\n                        <Form\r\n                            form={form}\r\n                            name=\"basic\"\r\n                            layout=\"vertical\"\r\n                            onFinish={onFinish}\r\n                            onFinishFailed={onFinishFailed}\r\n                            autoComplete=\"off\"\r\n                        >\r\n\r\n                            <Form.Item\r\n                                label=\"UPI ID\"\r\n                                name=\"upiId\"\r\n                                rules={[\r\n                                    \r\n                                    {\r\n                                    \r\n                                        required: true,\r\n                                        message: \"Please Enter your UPI ID  \",\r\n                                    },\r\n                                    {\r\n                                        pattern: /@/,\r\n                                        message: \"Must contain @ symbol!\",\r\n                                      },\r\n                                ]}\r\n                            >\r\n                                <Input placeholder=\"Enter your UPI ID\" variant=\"filled\" />\r\n                            </Form.Item>\r\n                            <Form.Item>\r\n                                <div className=\"profile_tbn\">\r\n                                    <Button type=\"primary\" htmlType=\"submit\">\r\n                                        Submit\r\n                                    </Button>\r\n                                </div>\r\n                            </Form.Item>\r\n                        </Form>\r\n                    </div>\r\n                </div>\r\n            </Drawer>\r\n        </>\r\n    );\r\n};\r\nexport default AddUpi;","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\account\\bankDetails\\AddBankDetails.jsx",["1599"],[],"import React, { useState } from 'react';\r\nimport { Button, Drawer, Form, Input, notification } from 'antd';\r\n\r\nimport '../../../style/account.css'\r\nimport { AddNewBankDetails } from '../../apiService/api';\r\nimport { useAuth } from '../../auth/context/authContext';\r\n\r\n\r\nconst AddBankDetails = ({ ShowUserBankData }) => {\r\n    const [open, setOpen] = useState(false);\r\n    const [form] = Form.useForm();\r\n    const { token } = useAuth()\r\n\r\n    const showDrawer = () => {\r\n        setOpen(true);\r\n    };\r\n    const onClose = () => {\r\n        setOpen(false);\r\n    };\r\n\r\n\r\n    const onFinish = async (value) => {\r\n        try {\r\n            await AddNewBankDetails(token, value)\r\n                .then((res) => {\r\n                    if (res.status == 201) {\r\n                        notification.success({\r\n                            placement: \"topRight\",\r\n                            message: res.data.message,\r\n                        });\r\n                        // onReset()\r\n                        onClose()\r\n                        ShowUserBankData()\r\n                    }\r\n\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n\r\n        }\r\n    };\r\n    const onFinishFailed = (errorInfo) => {\r\n        console.log(\"Failed:\", errorInfo);\r\n    };\r\n\r\n\r\n    return (\r\n        <>\r\n            <Button type='primary' onClick={showDrawer} className='add_btns'>\r\n                Add\r\n            </Button>\r\n            <Drawer title=\"Add Bank/UPI Details\" onClose={onClose} open={open}>\r\n                <div className=\"add_bank\">\r\n                    <div className=\"bank_segment\">\r\n                        <Form\r\n                            form={form}\r\n                            name=\"basic\"\r\n                            layout=\"vertical\"\r\n                            onFinish={onFinish}\r\n                            onFinishFailed={onFinishFailed}\r\n                            autoComplete=\"off\"\r\n                        >\r\n                            <Form.Item\r\n                                label=\"Bank Name\"\r\n                                name=\"bankName\"\r\n                                rules={[\r\n                                    {\r\n                                        required: true,\r\n                                        message: \"Please Enter  Your Bank Name!\",\r\n                                    },\r\n                                ]}\r\n                            >\r\n                                <Input placeholder=\"Enter Bank Name\" variant=\"filled\" />\r\n                            </Form.Item>\r\n                            <Form.Item\r\n                                label=\"Account Number\"\r\n                                name=\"bankAccountNo\"\r\n                                rules={[\r\n                                    {\r\n                                        required: true,\r\n                                        message: \"Please Enter  Your Account Number!\",\r\n                                    },\r\n                                ]}\r\n                            >\r\n                                <Input placeholder=\"Enter Account Number\" variant=\"filled\" />\r\n                            </Form.Item>\r\n                            <Form.Item\r\n                                label=\"Bank Account Holder\"\r\n                                name=\"bankAccountHolder\"\r\n                                rules={[\r\n                                    {\r\n                                        required: true,\r\n                                        message: \"Please Enter  Bank Account Holder\",\r\n                                    },\r\n                                ]}\r\n                            >\r\n                                <Input placeholder=\"Enter Bank Account Holder\" variant=\"filled\" />\r\n                            </Form.Item>\r\n                            <Form.Item\r\n                                label=\"IFSC Code\"\r\n                                name=\"ifscCode\"\r\n                                rules={[\r\n                                    {\r\n                                        required: true,\r\n                                        message: \" Enter Your IFSC Code!\",\r\n                                    },\r\n                                ]}\r\n                            >\r\n                                <Input maxLength={11} placeholder=\"Enter Bank IFSC Code\" variant=\"filled\" />\r\n                            </Form.Item>\r\n                            <Form.Item>\r\n                                <div className=\"profile_tbn\">\r\n                                    <Button type=\"primary\" htmlType=\"submit\">\r\n                                        Submit\r\n                                    </Button>\r\n                                </div>\r\n                            </Form.Item>\r\n                        </Form>\r\n                    </div>\r\n                </div>\r\n            </Drawer>\r\n        </>\r\n    );\r\n};\r\nexport default AddBankDetails;","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\Racipe\\CookStep.jsx",["1600"],[],"import React from 'react'\r\nimport \"../../style/product.css\"\r\nimport { List, Space } from 'antd'\r\n\r\nfunction CookStep({ racipeData }) {\r\n\r\n    const { cookingSteps } = racipeData\r\n\r\n    return (\r\n        <div className='cooking_step'>\r\n             <List\r\n          dataSource={cookingSteps}\r\n          renderItem={(item,index) => (\r\n            <List.Item key={index}>\r\n              <List.Item.Meta\r\n                avatar=\"🥘\"\r\n                title={`Step ${index + 1}`}\r\n                description={item}\r\n              />\r\n            </List.Item>\r\n          )}\r\n        />\r\n        </div>\r\n    )\r\n}\r\n\r\nexport default CookStep","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\segment\\DualCardSegment.jsx",["1601","1602","1603","1604"],[],"import React, { Component } from \"react\";\r\nimport Slider from \"react-slick\";\r\nimport \"../../style/segment.css\"\r\nimport { useNavigate } from \"react-router-dom\";\r\nimport { Col, Row } from \"react-bootstrap\";\r\nimport BKDLogo from \"../../assest/bkdlogo.png\";\r\n\r\nfunction DualCardSegment({ title, showAllSegemtnList, layerDetails, isLoading }) {\r\n  const navigate = useNavigate()\r\n\r\n  const handleViewDetails = (id) => {\r\n    // Filter layerDetails to include only the clicked _id\r\n    const selectedData = layerDetails\r\n      .filter((item) => item._id === id)\r\n      .map((item) => ({\r\n        banner: item.bigBanner,\r\n        title: item.title,\r\n      }))[0]; // Get the first (and only) item in the filtered list\r\n\r\n    // console.log(\"Selected Data------>\", selectedData);\r\n\r\n    // Navigate and pass the selected banner and title in the state\r\n    navigate(`/segment-detials/${id}`, { state: selectedData });\r\n  };\r\n\r\n  // console.log(\"dual layer Details----------> \", layerDetails)\r\n  return (\r\n    layerDetails?.length != 0 ?\r\n      <div className=\"dual_card_segment mt-2\">\r\n        <Row>\r\n          {layerDetails.map((item) => (\r\n            <Col md={6}>\r\n              <div className=\"dual_segment_img mt-2\">\r\n                <img\r\n                  src={item.middleBanner || BKDLogo}\r\n                  onError={(e) => e.currentTarget.src = BKDLogo}\r\n                  onClick={() => handleViewDetails(item._id)}\r\n                />\r\n              </div>\r\n            </Col>\r\n          ))}\r\n        </Row>\r\n      </div>\r\n      : null\r\n  );\r\n}\r\n\r\nexport default DualCardSegment","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\Racipe\\Ingredient.jsx",["1605","1606","1607","1608","1609","1610","1611","1612","1613","1614","1615"],[],"\r\n\r\nimport { Button, Card, Skeleton, Space, Tag, Tooltip, notification } from 'antd';\r\nimport React, { useEffect, useState, useRef } from 'react';\r\nimport { useNavigate, useParams } from 'react-router-dom';\r\nimport { AddProductWishlist, FetchAllProduct, out_of_stock } from '../apiService/api';\r\nimport { useDispatch, useSelector } from 'react-redux';\r\nimport { addItem, removeItem, selectCartItems } from '../../redux/CartSlice';\r\nimport { FaHeart, FaRegHeart } from 'react-icons/fa';\r\nimport { useAuth, useCategotyLayout } from '../auth/context/authContext';\r\nimport { useScreen } from '../auth/AuthScreen';\r\nimport BKDLogo from \"../../assest/bkdlogo.png\";\r\nimport offerAvailable from \"../../assest/png/offer_apply.png\"\r\nimport '../../style/Category.css';\r\n\r\nfunction Ingredient({ ingredientData, ShowRacipeDetails }) {\r\n\r\n\r\n\r\n    const selected_variant = null;\r\n    const { screenWidth } = useScreen();\r\n\r\n    const { token } = useAuth();\r\n\r\n    const [wishlist, setWishlist] = useState({}); // State to manage wishlist status\r\n    const navigate = useNavigate();\r\n    const dispatch = useDispatch();\r\n    const cartItems = useSelector(selectCartItems);\r\n    const titleCase = str => str.toLowerCase().split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');\r\n\r\n\r\n    const observerRef = useRef(null);\r\n\r\n    console.log(\"racipeData==============>\", ingredientData)\r\n\r\n    const addToWishList = async (proCode) => {\r\n        setWishlist((prev) => ({ ...prev, [proCode]: true })); // Immediately update the icon\r\n        const body = { productCode: proCode, status: \"ACTIVE\" };\r\n        try {\r\n            await AddProductWishlist(token, body)\r\n                .then((res) => {\r\n                    if (res.status === 201) {\r\n                        ShowRacipeDetails();\r\n                        notification['success']({\r\n                            placement: \"topRight\",\r\n                            message: \"Added Product To Wishlist\",\r\n                        });\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n                    setWishlist((prev) => ({ ...prev, [proCode]: false })); // Revert the icon if the API call fails\r\n                    notification['error']({\r\n                        placement: \"topRight\",\r\n                        message: \"Failed to Add Product To Wishlist\",\r\n                    });\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n            setWishlist((prev) => ({ ...prev, [proCode]: false })); // Revert the icon if the API call fails\r\n        }\r\n    };\r\n\r\n    const RemoveToWishList = async (proCode) => {\r\n        setWishlist((prev) => ({ ...prev, [proCode]: false })); // Immediately update the icon\r\n        const body = { productCode: proCode, status: \"INACTIVE\" };\r\n        try {\r\n            await AddProductWishlist(token, body)\r\n                .then((res) => {\r\n                    if (res.status === 201) {\r\n                        ShowRacipeDetails();\r\n                        notification['warning']({\r\n                            placement: \"topRight\",\r\n                            message: \"Removed Product From Wishlist\",\r\n                        });\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n                    setWishlist((prev) => ({ ...prev, [proCode]: true })); // Revert the icon if the API call fails\r\n                    notification['error']({\r\n                        placement: \"topRight\",\r\n                        message: \"Failed to Remove Product From Wishlist\",\r\n                    });\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n            setWishlist((prev) => ({ ...prev, [proCode]: true })); // Revert the icon if the API call fails\r\n        }\r\n    };\r\n\r\n\r\n\r\n\r\n\r\n\r\n    const handleAddItem = (item) => {\r\n        dispatch(addItem({ ...item, selected_variant }));\r\n    };\r\n\r\n    useEffect(() => {\r\n        localStorage.setItem(\"cart\", JSON.stringify(cartItems));\r\n    }, [cartItems]);\r\n\r\n    const handleDelItem = (item) => {\r\n        dispatch(removeItem(item));\r\n        const cart = JSON.parse(localStorage.getItem(\"cart\")) || [];\r\n        const updatedCart = cart.filter(cartItem => cartItem.productCode !== item.productCode);\r\n        localStorage.setItem(\"cart\", JSON.stringify(updatedCart));\r\n    };\r\n\r\n    const handleNotLogin = () => {\r\n        notification.error({\r\n            placement: \"topRight\",\r\n            message: \"Please login before adding to wishlist\",\r\n        });\r\n    };\r\n\r\n    const manageURl = (productName) => {\r\n        const sanitizedCategory = productName\r\n            .replace(/[,/&]/g, '') // Remove commas, slashes, ampersands\r\n            .replace(/\\s+/g, '-')  // Replace spaces with hyphens\r\n            .toLowerCase();\r\n        return sanitizedCategory\r\n    }\r\n    return (\r\n        <div className='all_product_list'>\r\n            <div className={`${ingredientData?.length != 0 && \"showing_pro_by_cat\"}`}>\r\n                {\r\n                    ingredientData?.length === 0 ? (\r\n                        <div className='text-center'>\r\n                            <img src=\"https://www.aamtrading.com/assets/img/nproduct.png\" width=\"50%\" />\r\n                        </div>\r\n                    ) : (\r\n                        ingredientData?.map((item) => (\r\n                            <div className=\"product_card individual_card\" key={item.productCode}>\r\n                                <Card\r\n                                    hoverable\r\n                                    disabled={item.stockQty === 0}\r\n                                >\r\n                                    <div className=\"card_img\">\r\n\r\n                                        <img\r\n                                            src={Array.isArray(item.imageUrl) && item.imageUrl.length > 0 ? item.imageUrl[0] : BKDLogo}\r\n                                            onError={(e) => e.currentTarget.src = BKDLogo}\r\n                                            onClick={() => navigate(`/product/${manageURl(item.productName)}`, { state: item.productCode })}\r\n                                            alt={item.productName}\r\n                                        />\r\n                                    </div>\r\n\r\n                                    <div className=\"pro_name\" onClick={() => navigate(`/product/${manageURl(item.productName)}`, { state: item.productCode })}>\r\n                                        <Tooltip title={titleCase(item.productName)}>\r\n                                            <p>{item.productName.length > 36 ? titleCase(item.productName.slice(0, 36)) + \"...\" : titleCase(item.productName)}</p>\r\n                                        </Tooltip>\r\n                                    </div>\r\n                                    <div className=\"show_variant_item\" onClick={() => navigate(`/product/${manageURl(item.productName)}`, { state: item.productCode })}>\r\n                                        {item.packSize && item.packSize !== \"(NIL)\" ? <Tag color=\"green\">{item.packSize.substr(0, 10)}</Tag> : <p className=\"hidden_data\">N/A</p>}\r\n                                        {item.stockQty <= out_of_stock ? <Tag color='red' className=\"stock_tag\">out of stock</Tag> : <p className='hidden_data'>N/A</p>}\r\n                                    </div>\r\n                                    <div className=\"add_cart\">\r\n                                        <Space>\r\n                                            <p>{`₹ ${Math.round(item.bkdAmount)}`}</p>\r\n                                            {item.bkdAmount !== item.price && <p><del>₹ {item.price}</del></p>}\r\n                                        </Space>\r\n                                        {cartItems.find((cartItem) => cartItem.productCode === item.productCode) ? (\r\n                                            cartItems.map((cartItem) => {\r\n                                                if (cartItem.productCode === item.productCode) {\r\n                                                    return (\r\n                                                        <Button.Group key={cartItem.productCode} size={screenWidth < 800 ? 'default' : 'small'}>\r\n                                                            <Button onClick={() => handleDelItem(item)}>-</Button>\r\n                                                            <Button>{cartItem.unit}</Button>\r\n                                                            <Button onClick={() => handleAddItem(item)}>+</Button>\r\n                                                        </Button.Group>\r\n                                                    );\r\n                                                }\r\n                                            })\r\n                                        ) : (\r\n                                            <Button disabled={item.stockQty <= out_of_stock} onClick={() => handleAddItem(item)} className='add_card_btn'>\r\n                                                ADD\r\n                                            </Button>\r\n                                        )}\r\n                                    </div>\r\n                                </Card>\r\n                                {item.billingQty != \"\" && item.offerQty != \"\" ?\r\n                                    <div className=\"offer_Available\">\r\n                                        <img src={offerAvailable} />\r\n                                        {item.billingQty === \"FOC\" ? <div className=\"offer_types\">\r\n                                            <p>1 Item</p>\r\n                                            <p>Free </p>\r\n                                        </div> : <div className=\"offer_types\">\r\n                                            <p>Buy {item.billingQty} </p>\r\n                                            <p>Get {item.offerQty} </p>\r\n                                        </div>}\r\n\r\n                                    </div> : Math.round(item.bkdAmount) != item.price ? <div className=\"cat_tags\">{Math.round((item.price - item.bkdAmount) * 100 / item.price)}% off</div> : null}\r\n\r\n                                {token ?\r\n                                    <div className='wish_list'>\r\n                                        {\r\n                                            wishlist[item.productCode] ? (\r\n                                                <FaHeart\r\n                                                    className=\"no_wish_icon\"\r\n                                                    size={22}\r\n                                                    color='red'\r\n                                                    onClick={() => RemoveToWishList(item.productCode)}\r\n                                                />\r\n                                            ) : (\r\n                                                <FaRegHeart\r\n                                                    className=\"no_wish_icon\"\r\n                                                    size={22}\r\n                                                    onClick={() => addToWishList(item.productCode)}\r\n                                                />\r\n                                            )\r\n                                        }\r\n                                    </div>\r\n\r\n                                    :\r\n                                    <div className='wish_list'>\r\n                                        <FaRegHeart\r\n                                            className=\"no_wish_icon\"\r\n                                            size={22}\r\n                                            onClick={handleNotLogin}\r\n                                        />\r\n                                    </div>\r\n                                }\r\n                            </div>\r\n                        ))\r\n                    )}\r\n            </div>\r\n            <div ref={observerRef}></div>\r\n        </div>\r\n    );\r\n}\r\n\r\n\r\n\r\nexport default Ingredient","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\segment\\CardSegment.jsx",["1616","1617"],[],"// import React, { Component } from \"react\";\r\n// import Slider from \"react-slick\";\r\n// import \"../../style/segment.css\"\r\n// import { useNavigate } from \"react-router-dom\";\r\n// import { offerSlider, offerSlider2 } from \"../../DummyData\";\r\n\r\n// function CardSegment({ title, showAllSegemtnList, layerDetails, isLoading }) {\r\n\r\n//     const navigate = useNavigate()\r\n//     const cardId=layerDetails.flatMap((item)=>item._id)\r\n//     console.log(\"cardId------>\",cardId)\r\n//     console.log(\"--------->\", layerDetails)\r\n//     const bannerTitle = layerDetails.flatMap(item => ({\r\n//         banner: item.bigBanner,\r\n//         title: item.title,\r\n//     }));\r\n//     // const segmentId = layerDetails.map(item => item._id);\r\n//     const handleViewDetails = (id) => {\r\n//         console.log(\"id--------->\",id)\r\n\r\n//         // navigate(`/segment-detials/${item._id}`,{state:bannerTitle})\r\n//     }\r\n//     return (\r\n//         <div className=\"card_segment\">\r\n//             {layerDetails?.length != 0 ? layerDetails.map((item) => (\r\n//                 <div className=\"segment_img\">\r\n//                     <img src={item.smallBanner} onClick={() => handleViewDetails(item._id)} />\r\n//                 </div>\r\n//             )) : null}\r\n//         </div>\r\n//     );\r\n// }\r\n\r\n// export default CardSegment\r\n\r\nimport React from \"react\";\r\nimport \"../../style/segment.css\";\r\nimport { useNavigate } from \"react-router-dom\";\r\nimport { Col, Row } from \"react-bootstrap\";\r\nimport BKDLogo from \"../../assest/bkdlogo.png\";\r\n\r\nfunction CardSegment({ title, showAllSegemtnList, layerDetails, isLoading }) {\r\n  const navigate = useNavigate();\r\n\r\n  const handleViewDetails = (id) => {\r\n    // Filter layerDetails to include only the clicked _id\r\n    const selectedData = layerDetails\r\n      .filter((item) => item._id === id)\r\n      .map((item) => ({\r\n        banner: item.bigBanner,\r\n        title: item.title,\r\n      }))[0]; // Get the first (and only) item in the filtered list\r\n\r\n    console.log(\"Selected Data------>\", selectedData);\r\n\r\n    // Navigate and pass the selected banner and title in the state\r\n    navigate(`/segment-detials/${id}`, { state: selectedData });\r\n  };\r\n\r\n  return (\r\n    layerDetails?.length !== 0 ?\r\n      <div className=\"card_segment my-4\">\r\n        {layerDetails.map((item) => (\r\n          <div className=\"segment_img\" key={item._id}>\r\n            <img\r\n              src={item.smallBanner || BKDLogo}\r\n              onError={(e) => e.currentTarget.src = BKDLogo}\r\n              alt={item.title}\r\n              onClick={() => handleViewDetails(item._id)}\r\n            />\r\n          </div>\r\n        ))}\r\n      </div>\r\n      : null\r\n  );\r\n}\r\n\r\nexport default CardSegment;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\Product\\RatingReview.jsx",["1618","1619","1620","1621","1622","1623"],[],"import React, { useEffect, useState } from \"react\";\r\nimport { Avatar, Button, Divider, List, Rate, Skeleton, Tag } from \"antd\";\r\nimport \"../../style/product.css\";\r\nimport { fetchUserRating } from \"../apiService/api\";\r\nimport { FaUser } from \"react-icons/fa\";\r\nimport { useAuth } from \"../auth/context/authContext\";\r\nimport PartnerRating from \"../checkout/PartnerRating\";\r\nimport UserRating from \"./UserRating\";\r\nimport Login from \"../auth/Login\";\r\n\r\nfunction RatingReview({ productInfo, ShowProductDetails }) {\r\n  const [rateList, setRateList] = useState([])\r\n  const [isLoading, setIsLoading] = useState(false)\r\n  const { token, currentUser } = useAuth()\r\n  const [current, setCurrent] = useState(1)\r\n\r\n\r\n  const showAllReviewRating = async () => {\r\n    try {\r\n      await fetchUserRating(productInfo?.productCode, current)\r\n        .then((res) => {\r\n          console.log(\"product user review\", res);\r\n          if (res.status == 200) {\r\n            setRateList(res.data.data.data);\r\n            setIsLoading(true)\r\n          }\r\n        })\r\n        .catch((err) => {\r\n          console.log(err.message);\r\n        });\r\n    } catch (error) {\r\n      console.log(error);\r\n      setIsLoading(true)\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    showAllReviewRating();\r\n  }, []);\r\n\r\n\r\n  return (\r\n    <div className=\"rating\">\r\n      <div className=\"rating_header\">\r\n\r\n        <div className=\"rating_title\">\r\n          <p>Rating & Review</p>\r\n          <p>({productInfo?.totalRatings}) rating & ({productInfo?.totalReviews}) review</p>\r\n        </div>\r\n        <div className=\"user_rating\">\r\n          {!token ? <div><p>Write Review </p><Login /></div> : <UserRating productInfo={productInfo} showAllReviewRating={showAllReviewRating} ShowProductDetails={ShowProductDetails} />}\r\n        </div>\r\n      </div>\r\n      <Divider />\r\n      <div className=\"view_all_rating\">\r\n        {rateList.length >5 ? <Button type=\"link\">View All Rating</Button> : null}\r\n      </div>\r\n\r\n      <>\r\n        {!isLoading ? <Skeleton active avatar={{ shape: 'circle' }} title={true} paragraph={{ rows: 6 }} /> :\r\n          <div className=\"rating_lists\">\r\n            <List\r\n              itemLayout=\"vertical\"\r\n\r\n              dataSource={rateList}\r\n\r\n              renderItem={(item) => (\r\n                <List.Item\r\n                  key={item.productCode}\r\n\r\n\r\n                >\r\n                  <List.Item.Meta\r\n                    avatar={item.userId.profilePic != null ? <Avatar src={item.userId.profilePic} /> : <Avatar icon={<FaUser />} />}\r\n                    title={<div className=\"rate_show\"><h5>{item.userId?.fullName} </h5>\r\n                      <p>{item.ratingStatus}</p>\r\n                    </div>}\r\n                    description={<div>\r\n                      <span> <Rate count={item.rating} disabled allowHalf value={item.rating} />  ({item.rating})</span>\r\n                      {item.review != null && <p>{item.review}</p>}\r\n\r\n                    </div>}\r\n                  />\r\n                </List.Item>\r\n              )}\r\n            />\r\n          </div>}\r\n        {/* <Divider style={{ margin: \"0\" }} /> */}\r\n      </>\r\n\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default RatingReview;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\Product\\ProductDescript.jsx",[],[],"C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\offer\\AvailableOfferModeal.jsx",["1624","1625","1626","1627","1628","1629","1630","1631","1632","1633","1634"],[],"import React, { useEffect, useState } from 'react';\r\nimport { Avatar, Badge, Button, Card, Divider, List, Modal, Skeleton, Space, Spin, Tag } from 'antd';\r\nimport { fetchProductOffer, fetchProductOfferDetails, out_of_stock } from '../apiService/api';\r\nimport \"../../style/product.css\"\r\nimport offerImage from \"../../assest/png/percent.webp\"\r\nimport { useDispatch, useSelector } from 'react-redux';\r\nimport { addItem, selectProductOffer, setBillingQty, setOfferProductQty, setSelctedOffer } from '../../redux/CartSlice';\r\nimport { useAuth } from '../auth/context/authContext';\r\nimport { MdOutlineShoppingCart } from 'react-icons/md';\r\nimport OfferApplyModal from './OfferApplyModal';\r\nimport { LoadingOutlined } from '@ant-design/icons';\r\n\r\n\r\n\r\nconst AvailableOfferModeal = ({ productId, variant, productInfo, offerData, isOfferLoading }) => {\r\n    const dispatch = useDispatch();\r\n    const { nearStore } = useAuth()\r\n    const [isModalOpen, setIsModalOpen] = useState(false);\r\n    const [offerList, setOfferList] = useState([])\r\n    const [isLoading, setIsLoading] = useState(false)\r\n    const [offerId, setOfferId] = useState(null)\r\n    const [selectedOfferId, setSelectedOfferId] = useState(null)\r\n    const selectedOffers = useSelector(selectProductOffer);\r\n    const [isOfferApply, setIsOfferApply] = useState(false);\r\n    // const [showModalTrigger, setShowModalTrigger] = useState(false);\r\n\r\n    const showModal = (id) => {\r\n        setIsModalOpen(true);\r\n        setOfferId(id)\r\n    };\r\n    const handleOk = () => {\r\n        setIsModalOpen(false);\r\n    };\r\n\r\n    const handleCancel = () => {\r\n        setIsModalOpen(false);\r\n\r\n    };\r\n\r\n    const maxSelectable = parseInt(offerList?.promoType?.split('+')[1] || '0');\r\n\r\n    const handleAddItem = (item) => {\r\n        // setIsOfferApply(true);\r\n        dispatch(addItem({ ...item, unit: maxSelectable + 1, selected_variant: variant, selected_offer: selectedOffers }));\r\n        dispatch(setBillingQty(1))\r\n    };\r\n\r\n\r\n\r\n    const ShowOfferPorductDetails = async () => {\r\n        setIsLoading(true)\r\n        try {\r\n            await fetchProductOfferDetails(nearStore?.branchCode, productId, offerId)\r\n                .then((res) => {\r\n                    console.log(\"offer details\", res);\r\n                    if (res.status == 200) {\r\n                        setOfferList(res.data.data);\r\n                        dispatch(setBillingQty(res.data.data.billingQty))\r\n                        setIsLoading(false)\r\n                        // dispatch(setBillingQty(res.data.data.billingQty))\r\n                    }\r\n                })\r\n\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n            setIsLoading(false)\r\n        }\r\n    };\r\n\r\n    useEffect(() => {\r\n        if (offerId) {\r\n            ShowOfferPorductDetails();\r\n        }\r\n    }, [isModalOpen]);\r\n\r\n    const selectOfferHandler = (item) => {\r\n        if (selectedOffers != null && selectedOfferId === item.productCode) {\r\n            // If the clicked item is already selected, deselect it\r\n            setSelectedOfferId(null);  // Clear the selected offer\r\n            dispatch(setSelctedOffer(null));  // Clear the selected offer in the store\r\n            dispatch(setOfferProductQty(0));  // Reset the quantity\r\n            setIsOfferApply(false)\r\n\r\n        } else {\r\n            // If the clicked item is not selected, select it\r\n            setIsOfferApply(true)\r\n            setSelectedOfferId(item.productCode);  // Set the selected offer ID\r\n            dispatch(setSelctedOffer({ ...item, comboPrice: offerList.comboPrice, offerId: offerList.offerId, offerName: offerList.offerName }));\r\n            dispatch(setOfferProductQty(item.qty));  // Set the quantity of the selected offer\r\n        }\r\n    };\r\n\r\n\r\n    return (\r\n        <>\r\n            {/* <Modal style={{ top: 20 }}\r\n                className='offer_confitti' footer={false} width={400} open={isOfferApply} onOk={handleOffereOk} onCancel={handleOfferCancel}>\r\n               \r\n            </Modal> */}\r\n            {/* <div className=\"card_section_title\">\r\n                        <p>Available Offers </p>\r\n                    </div> */}\r\n            {isOfferLoading\r\n                ?\r\n                <Spin indicator={<LoadingOutlined spin />} size=\"large\" />\r\n                :\r\n                offerData?.map((item) => (\r\n\r\n                    <div>\r\n                        <Button disabled={productInfo?.stockQty <= out_of_stock} size=\"large\" id=\"add_To_Carts\" onClick={() => showModal(item.offerId)}>\r\n                            Add to Cart\r\n                        </Button>\r\n\r\n                        <Modal width={500}\r\n                            style={{\r\n                                top: 20\r\n                            }}\r\n                            // title={`Add Available Offer ${item.offer}`}\r\n                            title=\"Choose Offer Product\"\r\n                            // loading={isLoading}\r\n                            open={isModalOpen}\r\n                            onOk={handleOk}\r\n                            footer={false}\r\n                            onCancel={handleCancel}>\r\n                            {isLoading ? <Skeleton active /> : isOfferApply ? <OfferApplyModal setIsOfferApply={setIsOfferApply} /> :\r\n                                <div className=\"show_product_list\">\r\n                                    <List\r\n                                        className=\"demo-loadmore-list\"\r\n                                        itemLayout=\"horizontal\"\r\n                                        // loadMore={loadMore}\r\n                                        dataSource={offerList?.promoProductList\r\n                                        }\r\n                                        renderItem={(item) => (\r\n                                            <List.Item\r\n                                                actions={[\r\n                                                    <Button\r\n                                                        className={selectedOffers != null && item.productCode === selectedOfferId ? \"select_offer\" : \"selected_item_offer\"}\r\n                                                        onClick={() => selectOfferHandler(item)}>{item.productCode === selectedOfferId ? \"Added Offer\" : \"Add Offer\"}\r\n                                                    </Button>\r\n                                                ]}\r\n                                            >\r\n                                                <List.Item.Meta\r\n                                                    avatar={\r\n                                                        <img\r\n                                                            src={item.imageUrl?.length != 0 ? item.imageUrl[0] : offerImage}\r\n                                                            onError={(e) => e.currentTarget.src = offerImage}\r\n                                                            className='offer_img_show'\r\n                                                        />\r\n                                                    }\r\n                                                    title={item.productName}\r\n                                                    description={<div>\r\n                                                        <p>{item.packSize}</p>\r\n                                                        <p>  ₹<del>{item.bkdAmount}</del> <span className='free'>Free</span></p>\r\n                                                    </div>}\r\n                                                />\r\n                                            </List.Item>\r\n                                        )}\r\n                                    />\r\n                                    <Divider dashed />\r\n                                    <div className=\"selectedOffer\">\r\n                                        <Button onClick={() => handleAddItem(productInfo)} >Add To Cart</Button>\r\n                                    </div>\r\n                                </div>}\r\n\r\n\r\n                        </Modal>\r\n                    </div>\r\n                ))}\r\n        </>\r\n    );\r\n};\r\n\r\nexport default AvailableOfferModeal","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\Category\\ProductCard.jsx",["1635","1636","1637","1638","1639","1640","1641","1642","1643","1644","1645","1646","1647","1648","1649","1650"],[],"\r\n\r\nimport { Button, Card, Skeleton, Space, Tag, Tooltip, notification } from 'antd';\r\nimport React, { useEffect, useState, useRef } from 'react';\r\nimport { useLocation, useNavigate, useParams } from 'react-router-dom';\r\nimport { AddProductWishlist, FetchAllProduct, out_of_stock, ProdductLimit, ProdductLimits } from '../apiService/api';\r\nimport { useDispatch, useSelector } from 'react-redux';\r\nimport { addItem, removeItem, selectCartItems } from '../../redux/CartSlice';\r\nimport { FaHeart, FaRegHeart } from 'react-icons/fa';\r\nimport { useAuth, useCategotyLayout } from '../auth/context/authContext';\r\nimport { useScreen } from '../auth/AuthScreen';\r\nimport BKDLogo from \"../../assest/bkdlogo.png\";\r\nimport { selectBranch } from '../../redux/OrderSlice';\r\nimport '../../style/Category.css';\r\nimport NotFoundProduct from \"../../assest/not-found.jpg\"\r\nimport offerAvailable from \"../../assest/png/offer_apply.png\"\r\nimport { decryptCategoryID, encryptCategoryID } from '../../config/encriptConfig';\r\nimport { getOfferImage } from '../../utils/offerUtils';\r\n\r\n\r\nfunction ProductCard({ subItemList, itemType, filterBy, brandId }) {\r\n    const selected_variant = null;\r\n    const { screenWidth } = useScreen();\r\n    const [productList, setProductList] = useState([]);\r\n    const { token, nearStore } = useAuth();\r\n    const [isInitialRender, setIsInitialRender] = useState(true);\r\n\r\n    const [current, setCurrent] = useState(1);\r\n    const [loading, setLoading] = useState(false);\r\n    const [noData, setNoData] = useState(true);\r\n    const [isLoading, setIsLoading] = useState(false);\r\n    const [wishlist, setWishlist] = useState(JSON.parse(sessionStorage.getItem(\"wishlist\")) || {});\r\n    const navigate = useNavigate();\r\n    const dispatch = useDispatch();\r\n    const cartItems = useSelector(selectCartItems);\r\n    const { categoryItemId, subCategoryId } = useCategotyLayout();\r\n\r\n    // const { state } = useLocation();\r\n    // const { id } = useParams()\r\n\r\n    const searchParams = new URLSearchParams(useLocation().search);\r\n    const encryptedCode = searchParams.get(\"uid\");\r\n    const state = encryptedCode ? decryptCategoryID(decodeURIComponent(encryptedCode)) : null;\r\n\r\n\r\n    const nearBranch = useSelector(selectBranch);\r\n    const skeletonArray = new Array(productList?.length || screenWidth < 1400 ? 10 : 14).fill(0);\r\n    const titleCase = str => str.toLowerCase().split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');\r\n\r\n    const observerRef = useRef(null);\r\n\r\n\r\n    const addToWishList = async (proCode) => {\r\n        setWishlist((prev) => ({ ...prev, [proCode.productCode]: true })); // Immediately update the icon\r\n        localStorage.setItem(\"wishlist\", JSON.stringify(wishlist)); // Immediately update the icon\r\n        const body = { productCode: proCode.productCode, productName: proCode.productName, status: \"ACTIVE\" };\r\n        try {\r\n            await AddProductWishlist(token, body)\r\n                .then((res) => {\r\n                    if (res.status === 201) {\r\n                        // fetchProductList(); // Trigger fetch after adding to wishlist\r\n                        // notification['success']({\r\n                        //     placement: \"topRight\",\r\n                        //     message: \"Product Added To Wishlist\",\r\n                        // });\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n                    setWishlist((prev) => ({ ...prev, [proCode]: false })); // Revert the icon if the API call fails\r\n                    // notification['error']({\r\n                    //     placement: \"topRight\",\r\n                    //     message: \"Failed to Add Product To Wishlist\",\r\n                    // });\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n            setWishlist((prev) => ({ ...prev, [proCode]: false })); // Revert the icon if the API call fails\r\n        }\r\n    };\r\n\r\n    const RemoveToWishList = async (proCode) => {\r\n        setWishlist((prev) => ({ ...prev, [proCode.productCode]: false })); // Immediately update the icon\r\n        localStorage.setItem(\"wishlist\", JSON.stringify(wishlist));\r\n        const body = { productCode: proCode.productCode, productName: proCode.productName, status: \"INACTIVE\" };\r\n        try {\r\n            await AddProductWishlist(token, body)\r\n                .then((res) => {\r\n                    if (res.status === 201) {\r\n                        // fetchProductList(); // Trigger fetch after removing from wishlist\r\n                        // notification['warning']({\r\n                        //     placement: \"topRight\",\r\n                        //     message: \"Product Removed From Wishlist\",\r\n                        // });\r\n                    }\r\n                })\r\n                .catch((err) => {\r\n                    console.log(err.message);\r\n                    setWishlist((prev) => ({ ...prev, [proCode]: true })); // Revert the icon if the API call fails\r\n                    // notification['error']({\r\n                    //     placement: \"topRight\",\r\n                    //     message: \"Failed to Remove Product From Wishlist\",\r\n                    // });\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n            setWishlist((prev) => ({ ...prev, [proCode]: true })); // Revert the icon if the API call fails\r\n        }\r\n    };\r\n    console.log(\"wishlist,\", wishlist)\r\n\r\n\r\n\r\n    const fetchProductList = async (isInitial = false) => {\r\n        setLoading(true);\r\n        setIsLoading(isInitial); // Show skeleton loader only for initial load\r\n\r\n        const page = isInitial ? 1 : current + 1;\r\n\r\n        try {\r\n            const res = await FetchAllProduct(state, categoryItemId, subCategoryId, nearBranch?.details?.branchCode, page, token, itemType, filterBy, brandId);\r\n            if (res.status === 200) {\r\n                const products = res.data.data;\r\n                if (products.length === 0) {\r\n                    setNoData(false);\r\n                } else {\r\n                    setProductList((prevData) =>\r\n                        isInitial ? products : [...prevData, ...products]);\r\n                    setCurrent(page);\r\n                }\r\n            }\r\n        } catch (error) {\r\n            console.log(error);\r\n        } finally {\r\n            setLoading(false);\r\n            setIsLoading(false);\r\n            if (isInitialRender) setIsInitialRender(false)\r\n        }\r\n    };\r\n\r\n\r\n\r\n    useEffect(() => {\r\n        fetchProductList(true); // Load the initial product list\r\n    }, [nearStore, itemType, filterBy, brandId]);\r\n\r\n\r\n    useEffect(() => {\r\n        if (isInitialRender) return;\r\n        if (productList?.length == ProdductLimits * current) {\r\n\r\n            const observer = new IntersectionObserver(\r\n                (entries) => {\r\n                    if (entries[0].isIntersecting && !loading && noData) {\r\n                        fetchProductList(false); // Load the next page when intersecting\r\n                        setIsLoading(false)\r\n                    }\r\n                },\r\n                { threshold: 0.1 }\r\n            );\r\n\r\n            if (observerRef.current)\r\n                observer.observe(observerRef.current);\r\n\r\n            return () => {\r\n                if (observerRef.current)\r\n                    observer.unobserve(observerRef.current);\r\n\r\n            };\r\n        }\r\n\r\n    }, [loading, noData, isInitialRender]);\r\n\r\n\r\n    const handleAddItem = (item) => {\r\n        dispatch(addItem({ ...item, selected_variant }));\r\n    };\r\n\r\n    useEffect(() => {\r\n        localStorage.setItem(\"cart\", JSON.stringify(cartItems));\r\n    }, [cartItems]);\r\n\r\n    const handleDelItem = (item) => {\r\n        dispatch(removeItem(item));\r\n        const cart = JSON.parse(localStorage.getItem(\"cart\")) || [];\r\n        const updatedCart = cart.filter(cartItem => cartItem.productCode !== item.productCode);\r\n        localStorage.setItem(\"cart\", JSON.stringify(updatedCart));\r\n    };\r\n\r\n    const handleNotLogin = () => {\r\n        notification.error({\r\n            placement: \"topRight\",\r\n            message: \"Please login before adding to wishlist\",\r\n        });\r\n    };\r\n\r\n    useEffect(() => {\r\n        setCurrent(1);         // Reset current page to 1\r\n        setProductList([]);      // Clear the brand list\r\n        // setHasMore(true);      // Reset hasMore flag\r\n\r\n    }, [filterBy]);\r\n\r\n    const manageURl = (productName) => {\r\n        const sanitizedCategory = productName\r\n            .replace(/[,/&]/g, '') // Remove commas, slashes, ampersands\r\n            .replace(/\\s+/g, '-')  // Replace spaces with hyphens\r\n            .toLowerCase();\r\n        return sanitizedCategory\r\n    }\r\n\r\n    const goToProductDetails = (item) => {\r\n        // navigate(`/product/${manageURl(item.productName)}`, { state: item.productCode })\r\n        navigate(`/product/${manageURl(item.productName)}?uid=${encodeURIComponent(encryptCategoryID(item.productCode))}`);\r\n\r\n    }\r\n\r\n    const inStockProducts = productList?.filter(item => item.stockQty > 0);\r\n\r\n    return (\r\n        <div className='all_product_list'>\r\n            {isLoading ? (\r\n                <div className='showing_pro_by_cat'>\r\n                    {skeletonArray.map(() => (\r\n                        <Card size='small' className=' mx-2 mb-2'>\r\n                            <Skeleton.Image active />\r\n                            <Skeleton active paragraph={{ row: 6 }} />\r\n                        </Card>\r\n                    ))}\r\n                </div>\r\n            ) : isLoading && subItemList === 0 || inStockProducts.length === 0 ? (\r\n                <div className='text-center'>\r\n                    <img src={NotFoundProduct} width=\"50%\" />\r\n                </div>\r\n            ) :\r\n                <div className={`${inStockProducts?.length !== 0 && \"showing_pro_by_cat\"}`}>\r\n\r\n                    {inStockProducts.map((item) => (\r\n                        <div className=\"product_card individual_card\" key={item.productCode}>\r\n                            <Card\r\n                                hoverable\r\n                                disabled={item.stockQty === 0}\r\n                            >\r\n                                <div className=\"card_img\">\r\n                                    <img\r\n                                        className={item.stockQty <= out_of_stock ? \"out_of_stock_img\" : \"\"}\r\n                                        src={item.imageUrl[0] ? item.imageUrl[0] : BKDLogo}\r\n                                        onError={(e) => e.currentTarget.src = BKDLogo}\r\n                                        onClick={() => goToProductDetails(item)}\r\n                                        alt={item.productName}\r\n                                        onLoad={(e) => (e.target.style.opacity = 1)} // Fade-in effect\r\n                                        style={{ opacity: 0, transition: \"opacity 0.5s\" }}\r\n\r\n                                    />\r\n                                </div>\r\n\r\n                                <div className={screenWidth > 800 ? \"pro_name\" : \"pro_name_nowrap\"}>\r\n                                    <Tooltip title={titleCase(item.productName)}>\r\n                                        <p onClick={() => goToProductDetails(item)}>\r\n                                            {item.productName.length > 36 ? titleCase(item.productName.slice(0, 36)) + \"...\" : titleCase(item.productName)}\r\n                                        </p>\r\n                                    </Tooltip>\r\n                                </div>\r\n\r\n                                <div className=\"show_variant_item\" onClick={() => goToProductDetails(item)}>\r\n                                    {item.packSize && item.packSize.substr(0, 10) !== \"(NIL)\" ? <Tag color=\"green\">{item.packSize.substr(0, 10)}</Tag> : <p className=\"hidden_data\">N/A</p>}\r\n                                    {item.stockQty <= out_of_stock ? <Tag color='red' className=\"stock_tag\">out of stock</Tag> : <p className='hidden_data'>N/A</p>}\r\n                                </div>\r\n                                <div className=\"show_price_mrp\">\r\n                                    <p>BKD Price | MRP</p>\r\n                                </div>\r\n                                <div className=\"add_cart\">\r\n                                    <p>{`₹ ${Math.round(item.bkdAmount)} `} <span>{item.bkdAmount != item.price && <del>₹ {item.price}</del>}</span> </p>\r\n\r\n                                    {cartItems.find((cartItem) => cartItem.productCode === item.productCode) ? (\r\n                                        cartItems.map((cartItem) => {\r\n                                            if (cartItem.productCode === item.productCode) {\r\n                                                return (\r\n                                                    <Button.Group key={cartItem.productCode} className=\"add_to_carts\" size={screenWidth < 800 ? \"\" : 'small'}>\r\n                                                        <Button className=\"add_to_carts add_to_cart_button\" onClick={() => handleDelItem(item)}>-</Button>\r\n                                                        <Button className=\"add_to_carts add_to_cart_button\">{cartItem.unit}</Button>\r\n                                                        <Button className=\"add_to_carts add_to_cart_button\" onClick={() => handleAddItem(item)}>+</Button>\r\n                                                    </Button.Group>\r\n                                                );\r\n                                            }\r\n                                        })\r\n                                    ) : (\r\n                                        <Button disabled={item.stockQty <= out_of_stock} onClick={() => handleAddItem(item)} className='add_card_btn'>\r\n                                            ADD\r\n                                        </Button>\r\n                                    )}\r\n                                </div>\r\n                            </Card>\r\n\r\n                            {item.billingQty === \"PROMOTIONS\" || item.billingQty === \"DISCOUNT\" || item.offerQty === \"PROMOTIONS\" || item.offerQty === \"DISCOUNT\" ?\r\n                                <div className=\"discount_tags\">Super Saver Price</div> : item.billingQty != \"\" && item.offerQty != \"\" ?\r\n                                    <div className=\"offer_Available\">\r\n                                        {(item.billingQty === \"FOC\" || item.offerQty === \"FOC\") ?\r\n                                            <>\r\n                                                <img src={offerAvailable} />\r\n                                                <div className=\"offer_types\">\r\n                                                    <p>1 Item</p>\r\n                                                    <p>Free </p>\r\n                                                    <p>On MRP</p>\r\n                                                </div>\r\n                                            </>\r\n                                            :\r\n                                            <img src={getOfferImage(item?.offerQty)} />\r\n                                        }\r\n\r\n                                    </div>\r\n                                    :\r\n                                    Math.round(item.bkdAmount) !== item.price ?\r\n                                        <div className=\"cat_tags\">{Math.round((item.price - item.bkdAmount) * 100 / item.price)}% off</div>\r\n                                        :\r\n                                        null}\r\n                            {token ?\r\n                                <div className='wish_list'>\r\n                                    {\r\n                                        wishlist[item.productCode] || item.isWhislist ? (\r\n                                            <FaHeart\r\n                                                className=\"no_wish_icon\"\r\n                                                size={22}\r\n                                                color='red'\r\n                                                onClick={() => RemoveToWishList(item)}\r\n                                            />\r\n                                        ) : (\r\n                                            <FaRegHeart\r\n                                                className=\"no_wish_icon\"\r\n                                                size={22}\r\n                                                onClick={() => addToWishList(item)}\r\n                                            />\r\n                                        )\r\n                                    }\r\n                                </div>\r\n\r\n                                :\r\n                                <div className='wish_list'>\r\n                                    <FaRegHeart\r\n                                        className=\"no_wish_icon\"\r\n                                        size={22}\r\n                                        onClick={handleNotLogin}\r\n                                    />\r\n                                </div>\r\n                            }\r\n                        </div>\r\n                    ))}\r\n                </div>\r\n            }\r\n            <div ref={observerRef} >\r\n                {loading && <div className='text-center'><span className=\"loaderScroll\"></span></div>}\r\n                {/* {loading && <div className='showing_pro_by_cat'>\r\n                    {skeletonArray.map(() => (\r\n                        <Card size='small' className=' mx-2 mb-2'>\r\n                            <Skeleton.Image active />\r\n                            <Skeleton active paragraph={{ row: 6 }} />\r\n                        </Card>\r\n                    ))}\r\n                </div>} */}\r\n            </div>\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default ProductCard;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\account\\order\\RefundRemenning.jsx",["1651"],[],"import { Alert, Button, Divider, Radio, Space } from 'antd';\r\nimport React from 'react';\r\nimport { useNavigate } from 'react-router-dom';\r\n\r\nfunction RefundRemenning({ bankData, value, setValue, navigate }) {\r\n\r\n\r\n    const onChange = (e) => {\r\n        setValue(e.target.value);\r\n        console.log(e.target.value);\r\n    };\r\n\r\n    return (\r\n        <div>\r\n            {bankData ? (\r\n                <>\r\n                    <h6>Please select bank details</h6>\r\n                    <Radio.Group onChange={onChange} value={value}>\r\n                        <Space direction=\"vertical\">\r\n                            {bankData?.upiId && (\r\n                                <Radio value=\"UPI\" key=\"1\">\r\n                                    UPI Id\r\n                                </Radio>\r\n                            )}\r\n                            {bankData?.bankAccountNo && (\r\n                                <Radio value=\"BANK\" key=\"2\">\r\n                                    Bank Account\r\n                                </Radio>\r\n                            )}\r\n                        </Space>\r\n                    </Radio.Group>\r\n                    <Divider dashed>\r\n                        {bankData?.bankAccountNo || bankData?.upiId ?\r\n                            <Alert\r\n                                type=\"success\"\r\n                                message={value === \"UPI\" ? bankData?.upiId : bankData?.bankAccountNo}\r\n                                banner\r\n                            /> : null}\r\n                    </Divider>\r\n                </>\r\n            ) : (\r\n                <>\r\n                    <Button\r\n                        type=\"link\"\r\n                        className=\"newAddress\"\r\n                        shape=\"round\"\r\n                        onClick={() => navigate(\"/account/bank\")}\r\n                    >\r\n                        Add Bank Details\r\n                    </Button>\r\n                    <Divider dashed />\r\n                </>\r\n            )}\r\n        </div>\r\n    );\r\n}\r\n\r\nexport default RefundRemenning;\r\n","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\account\\order\\PaymentRemenning.jsx",[],[],"C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\offer\\OfferApplyModal.jsx",["1652","1653","1654","1655","1656"],[],"import React, { useEffect, useState } from 'react';\r\nimport { Button, Modal } from 'antd';\r\nimport ConfittiImg from '../../assest/png/output-onlinegiftools (15).gif'\r\nimport confittiBg from \"../../assest/feature/confillti.gif\"\r\nimport '../../style/product.css'\r\n\r\n\r\nconst OfferApplyModal = ({ setIsOfferApply }) => {\r\n\r\n    return (\r\n        <div className='offer_confitti' >\r\n\r\n            <img src={ConfittiImg} width={200} />\r\n            <p>Offer Added  Successfully !</p>\r\n            <div className=\"ok_btn\">\r\n                <Button type='primary' onClick={() => setIsOfferApply(false)}>OK</Button>\r\n            </div>\r\n\r\n        </div>\r\n    );\r\n};\r\nexport default OfferApplyModal;","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\Product\\UserRating.jsx",["1657","1658","1659","1660"],[],"import React, { useState } from \"react\";\r\nimport { Button, Form, Input, Modal, notification } from \"antd\";\r\nimport \"../../style/checkout.css\";\r\nimport { FrownOutlined, MehOutlined, SmileOutlined } from \"@ant-design/icons\";\r\nimport { Flex, Rate } from \"antd\";\r\nimport { BsEmojiLaughing, BsEmojiFrown, BsEmojiHeartEyes, BsEmojiSmile, BsEmojiAngry } from \"react-icons/bs\";\r\nimport { useAuth } from \"../auth/context/authContext\";\r\nimport { AddProductRating } from \"../apiService/api\";\r\n\r\nconst UserRating = ({ productInfo, showAllReviewRating,ShowProductDetails }) => {\r\n    const [form] = Form.useForm();\r\n    const [isModalOpen, setIsModalOpen] = useState(false);\r\n    const [rateing, setRating] = useState(0);\r\n    const { token } = useAuth()\r\n    const desc = ['terrible', 'bad', 'good', 'Very good', 'I loved It'];\r\n    const customIcons = {\r\n        1: <BsEmojiAngry className=\"rate_icon\" />,\r\n        2: <BsEmojiFrown className=\"rate_icon\" />,\r\n        3: <BsEmojiSmile className=\"rate_icon\" />,\r\n        4: <BsEmojiLaughing className=\"rate_icon\" />,\r\n        5: <BsEmojiHeartEyes className=\"rate_icon\" />,\r\n    };\r\n\r\n    const showModal = () => {\r\n        setIsModalOpen(true);\r\n    };\r\n    const handleOk = () => {\r\n        setIsModalOpen(false);\r\n    };\r\n    const handleCancel = () => {\r\n        setIsModalOpen(false);\r\n    };\r\n\r\n\r\n    const onFinish = async (value) => {\r\n        const body =\r\n        {\r\n            \"productCode\": productInfo.productCode,\r\n            \"rating\": rateing,\r\n            \"ratingStatus\": desc[rateing - 1],\r\n            \"review\": value.review\r\n        }\r\n        console.log(\"body\", body)\r\n        try {\r\n            await AddProductRating(token, body)\r\n                .then((res) => {\r\n                    console.log(\"product post rating\", res);\r\n                    if (res.status == 201) {\r\n                        onReset();\r\n                        setRating(0)\r\n                        notification.success({\r\n                            placement: \"topRight\",\r\n                            message: res.data.message,\r\n                            description: \"Thank you for the rating 😊\"\r\n\r\n                        });\r\n                        showAllReviewRating()\r\n                        ShowProductDetails()\r\n                        setIsModalOpen(false)\r\n                    } else if (res.status === 200) {\r\n                        notification.error({\r\n                            placement: \"topRight\",\r\n                            message: res.data.message,\r\n                            description: \"Not rating again\"\r\n\r\n                        });\r\n\r\n                    }\r\n\r\n                })\r\n                .catch((err) => {\r\n                    console.warn(err);\r\n                });\r\n        } catch (error) {\r\n            console.log(error);\r\n        }\r\n    };\r\n\r\n    const onReset = () => {\r\n        form.resetFields();\r\n    };\r\n    const onFinishFailed = (errorInfo) => {\r\n        console.log(\"Failed:\", errorInfo);\r\n    };\r\n\r\n\r\n    return (\r\n        <div className=\"user_rate\">\r\n            <Button type=\"link\" onClick={showModal}>Write Review</Button>\r\n            <Modal\r\n                open={isModalOpen}\r\n                onOk={handleOk}\r\n                onCancel={handleCancel}\r\n                footer={false}\r\n                width={300}\r\n            >\r\n                <div className=\"show_rates_icon\">\r\n                    <div className=\"show_coment\">\r\n                        {rateing ? <p>{desc[rateing - 1]}</p> : null}\r\n                    </div>\r\n                    <Flex gap=\"middle\" vertical>\r\n                        <Rate\r\n                            onChange={setRating}\r\n                            value={rateing}\r\n                            character={({ index = 0 }) => customIcons[index + 1]}\r\n                        />\r\n\r\n                    </Flex>\r\n                </div>\r\n                <div className=\"feedback\">\r\n                    <Form\r\n\r\n                        form={form}\r\n                        onFinish={onFinish}\r\n                        onFinishFailed={onFinishFailed}\r\n                    >\r\n                        <Form.Item name=\"review\">\r\n                            <Input variant=\"filled\" placeholder=\"Tell us what you like\" />\r\n                        </Form.Item>\r\n                        <Button onClick={handleCancel} htmlType=\"submit\">Submit your feedback</Button>\r\n                    </Form>\r\n                </div>\r\n            </Modal >\r\n        </div >\r\n    );\r\n};\r\n\r\n\r\n\r\nexport default UserRating","C:\\Users\\Dell\\onbkd_frontendwebsite\\src\\component\\cms\\ContactUs.jsx",[],[],{"ruleId":"1661","severity":1,"message":"1662","line":1,"column":17,"nodeType":"1663","messageId":"1664","endLine":1,"endColumn":23},{"ruleId":"1661","severity":1,"message":"1665","line":32,"column":56,"nodeType":